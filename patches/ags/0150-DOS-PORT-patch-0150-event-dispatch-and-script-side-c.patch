+                // measuring logging plus the RoomAfterFadein script
+                // dispatch. A single log line is 48 us (line_us=432 over
+                // nine), so ~40 of them cannot be 38 seconds, and that
+                // contradiction is what exposed the mis-scope.
+                _dp_log.close();
+                // patch 0159: total AND the nested-tick time inside it. If
+                // run_on_event's seconds are nearly all self with almost no
+                // nested ticks, the loop never ran and the screen was frozen
+                // -- which is a defect, not the game responding to a click.
+                extern long long dos_tick_nested_us;
+                const long long _dp_nest0 = dos_tick_nested_us;
+                struct _DpNest {
+                    const long long &now; long long before;
+                    ~_DpNest() { dos_port_afterfadein_nested_us += (now - before); }
+                } _dp_nest{dos_tick_nested_us, _dp_nest0};
+                // patch 0180: the script_vm delta INSIDE this dispatch, so
+                // the 570 ms decomposes rather than leaving a residual.
+                //   afterfadein total
+                //     - script_vm within it   = engine dispatch overhead
+                //   script_vm within it
+                //     - the three object calls = our script's own bytecode
+                // A residual is the error bar on coverage, not a term, so
+                // each piece gets measured instead of subtracted.
+                const long long _dp_sv0 = dos_port_tick_timing.script_vm.total_us;
+                struct _DpSv {
+                    const long long &now; long long before;
+                    ~_DpSv() { dos_port_afterfadein_script_us += (now - before); }
+                } _dp_sv{dos_port_tick_timing.script_vm.total_us, _dp_sv0};
+                DosPortNamedScope _dp_onevent(dos_port_afterfadein_onevent_us,
+                                              dos_port_afterfadein_onevent_n);
 #endif
                 run_on_event(kScriptEvent_RoomAfterFadein, displayed_room);
             }
@@ -323,6 +477,18 @@ void process_event(const AGSEvent *evp)
         }
 
         assert(obj_inter || obj_events);

 src/audio/dos/SDL_dosaudio_sb.c    | 22 +++++++++++++++++++++-
 src/core/dos/SDL_dos_audio_synth.c |  6 ++++++
 src/core/dos/SDL_dos_audio_synth.h |  5 +++++
 4 files changed, 52 insertions(+), 1 deletion(-)

diff --git a/include/SDL3/SDL_dosaudio_pump.h b/include/SDL3/SDL_dosaudio_pump.h
index 0275aec64..b1a5bd516 100644
--- a/include/SDL3/SDL_dosaudio_pump.h
+++ b/include/SDL3/SDL_dosaudio_pump.h
@@ -434,6 +434,26 @@ extern SDL_DECLSPEC int SDLCALL SDL_DOSAudioPhysicalCapacityFrames(void);
  */
 extern SDL_DECLSPEC int SDLCALL SDL_DOSAudioIsrRingWrite(void);
 
+/**
+ * DOS-PORT patch 0192: tell the SB driver whether sound content is playing.
+ *
+ * The driver's post-mix silence gate drops any buffer that is silent in the
+ * device format instead of writing it to the ring. Between sounds that is the
+ * point (the ring drains, the device idles). DURING a sound it removes time:
+ * a clip's own digital-zero pause, or on the 8-bit path any passage quieter
+ * than one U8 step, is dropped and the next audible chunk plays early -- the
+ * sound comes out shorter, with its pauses shortened.
+ *
+ * While `active` is true, silent buffers are written like any other. Set it
+ * true while the port's own mixer still has audio to deliver, false when
+ * everything it started has been fully handed to SDL. A port that never calls
+ * this gets the gate exactly as before (the default is false).
+ *
+ * \param active true while content is playing.
+ * \threadsafety Call from the thread that feeds the audio stream.
+ */
+extern SDL_DECLSPEC void SDLCALL SDL_DOSAudioSetContentActive(bool active);
+
 #ifdef __cplusplus
 }
 #endif
diff --git a/src/audio/dos/SDL_dosaudio_sb.c b/src/audio/dos/SDL_dosaudio_sb.c
index 7096279c5..a01e9d901 100644
--- a/src/audio/dos/SDL_dosaudio_sb.c
+++ b/src/audio/dos/SDL_dosaudio_sb.c
@@ -1091,6 +1091,17 @@ static void dos_sfx_synth_recompute_ratediv(void)
  * so a main-thread reader gets a consistent snapshot (a concurrent ISR drain
  * only makes the fill an instant smaller -- safe for a per-frame-resampled
  * setpoint). No lock needed. Returns 0 when no device is open. */
+/* DOS-PORT patch 0192: content-active flag for PlayDevice's silence gate.
+   Written by the engine's main thread, read by PlayDevice under
+   device->lock (audio thread or SDL_DOSAudioPump); a single aligned bool, so
+   a racing read sees either value, and either is safe. */
+static volatile bool g_dos_audio_content_active = false;
+
+void SDL_DOSAudioSetContentActive(bool active)
+{
+    g_dos_audio_content_active = active;
+}
+
 int SDL_DOSAudioRingFillFrames(void)
 {
     if (g_dos_audio_device == NULL) {
@@ -1901,6 +1912,7 @@ static void MaybeServiceIdlePauseRequests(void)
         WriteSoundBlasterDSP(cmd);
         isr_dsp_paused = true;
         g_dos_audio_pause_request = false;
+        dos_port_audio_idle_pause_count++; /* DOS-PORT patch 0192 */
     }
 }
 
@@ -4068,7 +4080,14 @@ static bool DOSSOUNDBLASTER_PlayDevice(SDL_AudioDevice *device, const Uint8 *buf
        g_dos_silence_detect_enabled (above the static decl) for the
        rationale on keeping the perf switch separate from the
        legacy-compat / shutdown flag. */
-    if (g_dos_silence_detect_enabled && !g_dos_audio_quiescence_gate_disabled) {
+    /* DOS-PORT patch 0192: while the port says content is playing
+       (SDL_DOSAudioSetContentActive(true)), a silent buffer is part of that
+       content -- a clip's own pause, or on the 8-bit path any passage quieter
+       than one U8 step -- and skipping it would remove its TIME from the
+       sound (the ring then plays the next audible chunk early). Write it like
+       any other buffer. Default false: a port that never calls the API gets
+       the gate exactly as before. */
+    if (g_dos_silence_detect_enabled && !g_dos_audio_quiescence_gate_disabled && !g_dos_audio_content_active) {
         bool all_silence;
         /* DOSKUTSU patch (Phase 11 patch 0057): Shape D mixer-flag
            fast-path. When SHAPE=D is engaged, replace the Shape A
@@ -4181,6 +4200,7 @@ static bool DOSSOUNDBLASTER_PlayDevice(SDL_AudioDevice *device, const Uint8 *buf
             }
         }
         if (all_silence) {
+            dos_port_audio_skipped_silent_count++; /* DOS-PORT patch 0192 */
             /* Skip the ring write -- ring continues to drain via IRQ ->
                ISR increments consecutive-silent-IRQ counter -> DSP
                auto-engage idle-pause fires when threshold met -> IRQ-5

-    // impossible if regwrite time is truly a subset of slots_us time).
-    // Reset here, before the slot loop, so only writes that happen
-    // DURING this call's own slot loop reach the real snapshot below.
-    SDL_DOSOpl3RegWriteDiagSnapshot(nullptr, nullptr, nullptr, nullptr);
-    // S7-GUS: same discard-snapshot reasoning -- SDL_DOSGusGetState() can
-    // also run from outside this function (e.g. any future direct engine
-    // poll of GUS state), so reset before the slot loop for the same
-    // attribution-correctness reason as the OPL3 regwrite discard above.
-    SDL_DOSGusGetStateDiagSnapshot(nullptr, nullptr, nullptr, nullptr);
-    // S7-GUS continuation: same discard-snapshot reasoning, one per
-    // SDL_DOSGus* voice-setup/-teardown function.
-    SDL_DOSGusSetVoiceFreqDiagSnapshot(nullptr, nullptr, nullptr, nullptr);
-    SDL_DOSGusSetVoiceVolDiagSnapshot(nullptr, nullptr, nullptr, nullptr);
-    SDL_DOSGusSetVoicePanDiagSnapshot(nullptr, nullptr, nullptr, nullptr);
-    SDL_DOSGusStartVoiceDiagSnapshot(nullptr, nullptr, nullptr, nullptr);
-    SDL_DOSGusStopVoiceDiagSnapshot(nullptr, nullptr, nullptr, nullptr);
-    // S7-GUS continuation: same discard-snapshot reasoning, for the
-    // midi_sched_tick() call-site bracket (audioplayer.cpp) -- it runs
-    // from inside this same slot loop below (AudioPlayer::Poll() ->
-    // MidiPoll()), so this reset is defensive symmetry with the others,
-    // not expected to discard anything real in practice.
-    DOSAGS_MidiTickDiagSnapshot(nullptr, nullptr, nullptr, nullptr);
-    // S7-GUS continuation: same discard-snapshot reasoning, for the
-    // .pat-upload PIO chain -- gus_sink_prepare_song() (and everything
-    // it triggers) runs from inside this same slot loop below, via
-    // AudioPlayer::Poll() -> Init() -> MidiInit(), on a song's first
-    // real tick.
-    SDL_DOSGusUploadPioDiagSnapshot(nullptr, nullptr, nullptr, nullptr, nullptr);
-    SDL_DOSGusUploadSampleDiagSnapshot(nullptr, nullptr, nullptr, nullptr, nullptr);
-    DOSAGS_MidiPrepSongDiagSnapshot(nullptr, nullptr, nullptr, nullptr);
+    // DOS-PORT patch 0218: no clock read and no snapshot unless the timing hint is set.
+    const bool diag = SDL_DOSAudioDiagTiming();
+    const uint64_t t_entry_us = diag ? dos_diag_now_us() : 0;
+    if (diag) {
+        // Discard-snapshot: SDL_DOSOpl3WriteRegister() can also be called from
+        // OUTSIDE this function entirely -- e.g. opl3_sink_open() ->
+        // SDL_DOSOpl3InitChip() at MIDI-slot-creation time
+        // (audio_core_slot_init_midi(), triggered by the engine's own music
+        // dispatch, not by this poll loop). Without this, that unrelated
+        // burst of writes sits in the SDL-side accumulator until whichever
+        // audio_core_entry_poll() call happens to run next, and gets folded
+        // into THAT call's regwrite snapshot even though its own slots_us
+        // never saw it -- a real bug this diagnostic's own first DOSBox-X
+        // smoke run caught directly (regwrite max_us=54950 exceeding that
+        // same window's own slots_us max=4807, which is structurally
+        // impossible if regwrite time is truly a subset of slots_us time).
+        // Reset here, before the slot loop, so only writes that happen
+        // DURING this call's own slot loop reach the real snapshot below.
+        SDL_DOSOpl3RegWriteDiagSnapshot(nullptr, nullptr, nullptr, nullptr);
+        // S7-GUS: same discard-snapshot reasoning -- SDL_DOSGusGetState() can
+        // also run from outside this function (e.g. any future direct engine
+        // poll of GUS state), so reset before the slot loop for the same

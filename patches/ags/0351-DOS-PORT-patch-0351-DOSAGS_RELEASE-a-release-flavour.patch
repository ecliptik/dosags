 // The setting is read once at startup (main.cpp's ags_entry_point sets the flag); every site tests one global,
 // so the switch costs a load and a branch per scope and no code per site beyond that.
 extern int dos_port_tick_fine_flag;
+#ifdef DOSAGS_RELEASE
+// DOS-PORT patch 0351: the release flavour has no tick timing at all. Every fine and coarse scope, manual
+// bracket and record below compiles to nothing (constant-false tests, empty RAII scope), so no site pays a
+// clock read, a load or a branch. The counters in DosPortTickTiming that are NOT timings (presents_real,
+// presents_skipped, blits_*, ... -- the yardstick's fps_basis line and the gate scorers read them) are plain
+// increments at their sites and are untouched. The yardstick itself (DosTickStallScope, game_run.cpp) keeps
+// its two clock reads per tick: tick_rate_steady comes from them.
+static inline bool dos_port_tick_fine_on() { return false; }
+static inline uclock_t dos_port_fine_uclock() { return 0; }
+static inline long long dos_port_fine_elapsed_us(uclock_t) { return 0; }
+#else
 static inline bool dos_port_tick_fine_on() { return dos_port_tick_fine_flag > 0; }
 static inline uclock_t dos_port_fine_uclock() { return dos_port_tick_fine_on() ? uclock() : 0; }
 static inline long long dos_port_fine_elapsed_us(uclock_t t0)
 {
     return dos_port_tick_fine_on() ? dos_port_tick_elapsed_us(t0) : 0;
 }
+#endif
 

+static void l1b_call_pre()
+{
+    if (!dos_l1_inwin()) return;
+    if (s_l1b_actn > 0) s_l1b_act[s_l1b_actn - 1].calls++;
+    if (s_l1b_actn >= 1024) { ++s_l1b_actover; return; }
+    L1bAct &a = s_l1b_act[s_l1b_actn++];
+    a.b = l1b_bucket(); a.ops = 0; a.calls = 0; a.apis = 0; a.entry = 0;   // b = the caller until post
+}
+static void l1b_call_post()
+{
+    if (!dos_l1_inwin() || s_l1b_actn <= 0) return;
+    L1bAct &a = s_l1b_act[s_l1b_actn - 1];
+    const int callee = l1b_bucket();
+    s_l1b_cp[(static_cast<uint32_t>(a.b) << 16) | static_cast<uint32_t>(callee)]++;
+    a.b = callee;
+}
+static void l1b_pop(int counted_ret)
+{
+    if (s_l1b_actn <= 0) return;
+    const L1bAct &a = s_l1b_act[--s_l1b_actn];
+    L1bAS &s = s_l1b_as[a.b];
+    if (!counted_ret) { s.unret++; return; }
+    s.acts++;
+    if (a.entry) s.entries++;
+    s.ops += a.ops; s.apis += a.apis; s.calls += a.calls;
+    if (a.calls == 0) { s.leaf++; s.leafops += a.ops; if (a.apis == 0) s.leaf0++; }
+}
+static void l1b_ret()
+{
+    if (!dos_l1_inwin()) return;
+    if (s_l1b_markn > 0 && s_l1b_actn <= s_l1b_mark[s_l1b_markn - 1]) return; // not ours
+    l1b_pop(1);

+++ b/src/audio/dos/SDL_dosaudio_sb.c
@@ -1752,7 +1752,7 @@ bool SDL_DOSMidiIsrTickActive(void)
 #define MIDI_DEFER_MAX_PER_IRQ 384u        /* bound on ISR time per IRQ */

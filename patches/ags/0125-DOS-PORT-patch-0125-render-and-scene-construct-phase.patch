+    long rb_gui_miss = 0, rb_gui_hit = 0;
+    long long rb_gui_hit_px = 0, rb_gui_full_px = 0;
+    long rb_gui_big_miss = 0, rb_gui_big_hit = 0;   // patch 0174: >=50,000 px only
+    long long rb_gui_big_isect_px = 0, rb_gui_big_full_px = 0;
+    long long rb_clear_px = 0;
+    long long rb_sprite_px = 0;          // patch 0125: measured composited area
+    // patch 0166: the largest sprite seen since the last skip report, so a
+    // tail frame's 107,625 px can be attributed to one element or to many.
+    long long rb_max_spr_px = 0;
+    long rb_max_spr_w = 0, rb_max_spr_h = 0;
+    DosPortTickPhaseStats rb_sprite_time;  // patch 0125: blitting half only
+    // patch 0126: scene_construct's background restore. Upstream's own
+    // comment above the call site (ac/draw.cpp, "by CJ") says this line
+    // "takes up to 50% of the game CPU time at high resolutions and

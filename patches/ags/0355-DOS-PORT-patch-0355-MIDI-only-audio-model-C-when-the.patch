     static char buf[1632];   // patch 0252: 512 -> 640; patch 0275: 640 -> 768; patch 0331: -> 1024; patch 0333: -> 1280; patch 0341: -> 1472; patch 0346: -> 1520; patch 0347: -> 1552; patch 0348: -> 1600; patch 0349: -> 1632 (see g_last_status)
     format_status_string(buf, sizeof(buf));

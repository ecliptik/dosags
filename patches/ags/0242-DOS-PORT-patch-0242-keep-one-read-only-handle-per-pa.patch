diff --git a/Common/util/file.cpp b/Common/util/file.cpp
index be919c84d..db20d4b93 100644
--- a/Common/util/file.cpp
+++ b/Common/util/file.cpp
@@ -259,8 +259,76 @@ std::unique_ptr<Stream> File::OpenFile(const String &filename, FileOpenMode open
     return std::make_unique<Stream>(std::make_unique<BufferedStream>(std::move(fs)));
 }
 
+#ifdef __DJGPP__
+// DOS-PORT patch 0242: keep ONE read-only FILE per library file across asset opens (opt-in, DOSAGS_PAKHANDLE=1).
+//
+// Every packaged asset is opened through here, and each open used to fopen the package again: on DJGPP that
+// is findfirst + open + IOCTL + truename, then a close later -- two directory lookups per open. On the 486 a
+// first play's asset_open is a fixed ~55 ms (AUDH16), and this reopen is part of it (docs/lab/io.md).
+//
+// Why sharing one FILE is exact: BufferedStream never relies on where the base FILE was left. Open() seeks
+// END then BEGIN, every buffer refill seeks to its absolute position first, and a direct large read seeks to
+// _position first, so any number of section streams on one read-only FILE -- interleaved or not -- read the
+// same bytes they would from their own FILE. WrapHandle streams never fclose it.
+//
+// Lifetime: a library change only RETIRES the table entry (later opens get a fresh handle) and the handle
+// stays open until exit, because a stream opened earlier (music streaming, say) may still read through it;
+// fclose-ing it under that stream is the one way this could go wrong. Retired handles are bounded; when the
+// bound is reached this path falls back to the plain fopen. All shared handles are closed at engine exit.
+namespace
+{
+    struct DosPakHandle { String Path; FILE *F = nullptr; bool Retired = false; };
+    DosPakHandle dos_pak_handles[8];
+    int dos_pak_mode = -1;
+}
+long dos_port_pak_opened = 0, dos_port_pak_reused = 0, dos_port_pak_fallback = 0, dos_port_pak_closed = 0;
+
+void File::RetireSharedPackageHandles()
+{
+    for (auto &h : dos_pak_handles)
+        if (h.F) h.Retired = true;
+}
+
+void File::CloseSharedPackageHandles()
+{
+    for (auto &h : dos_pak_handles)
+    {
+        if (h.F) { fclose(h.F); dos_port_pak_closed++; }
+        h = DosPakHandle();
+    }
+}
+
+static FILE *dos_pak_get(const String &filename)
+{
+    if (dos_pak_mode < 0)
+    {
+        const char *e = getenv("DOSAGS_PAKHANDLE");
+        dos_pak_mode = (e != nullptr && e[0] == '1') ? 1 : 0;   // default OFF
+    }
+    if (dos_pak_mode != 1)
+        return nullptr;
+    for (auto &h : dos_pak_handles)
+        if (h.F && !h.Retired && h.Path == filename) { dos_port_pak_reused++; return h.F; }
+    for (auto &h : dos_pak_handles)
+    {
+        if (h.F) continue;
+        FILE *f = ags_fopen(filename.GetCStr(), "rb");
+        if (!f) return nullptr;   // the plain path reports the error as before
+        h.Path = filename; h.F = f; h.Retired = false;
+        dos_port_pak_opened++;
+        return f;
+    }
+    dos_port_pak_fallback++;   // table full: plain fopen
+    return nullptr;
+}
+#endif
+
 std::unique_ptr<Stream> File::OpenFile(const String &filename, soff_t start_off, soff_t end_off)
 {
+#ifdef __DJGPP__
+    if (FILE *shared = dos_pak_get(filename))   // patch 0242
+        return std::make_unique<Stream>(std::make_unique<BufferedStream>(FileStream::WrapHandle(shared, kStream_Read), start_off, end_off));
+#endif
     auto fs = OpenFileStream(filename, kFile_Open, kStream_Read);
     if (!fs)
         return nullptr;

@@ -431,6 +494,8 @@ void dos_audio_mixer_voice_set_active(int voice, bool active)
     if (voice < 0 || voice >= DOS_AUDIO_MIXER_MAX_VOICES || !g_voices[voice].used)
         return;
     g_voices[voice].active = active;
+    if (g_null_open && active && g_null_vstart[voice] == 0) // DOS-PORT patch 0355: model C lifetime witness

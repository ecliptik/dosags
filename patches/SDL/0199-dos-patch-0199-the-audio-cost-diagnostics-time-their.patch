diff --git a/src/core/dos/SDL_dos.h b/src/core/dos/SDL_dos.h
index 39b8962e4..ca601574b 100644
--- a/src/core/dos/SDL_dos.h
+++ b/src/core/dos/SDL_dos.h
@@ -184,6 +184,13 @@ void DOS_HookInterruptReplace(int irq, DOS_InterruptHookFn fn, DOS_InterruptHook
 
 void DOS_UnhookInterrupt(DOS_InterruptHook *hook, bool disable_interrupt);
 
+/* DOS-PORT patch 0199: true when SDL_HINT_DOS_AUDIO_DIAG_TIMING is set, i.e. when the temporary audio cost
+   diagnostics (OPL3 register writes, SDL/0141; GUS state/voice/upload, SDL/0146-0147) should time their calls.
+   Default false: each of those timings is two PIT reads per call, taken whether or not anything consumes them.
+   Latched on the first call, which must be on the main thread (never from an ISR: it reads a hint); an
+   application that can reach these paths from an ISR calls it once at startup. */
+bool SDL_DOSAudioDiagTiming(void);
+
 // Ends C function definitions when using C++
 #ifdef __cplusplus
 }
diff --git a/src/core/dos/SDL_dos_audio_synth.c b/src/core/dos/SDL_dos_audio_synth.c
index 1120adeb3..5147f693d 100644
--- a/src/core/dos/SDL_dos_audio_synth.c
+++ b/src/core/dos/SDL_dos_audio_synth.c
@@ -1026,6 +1026,18 @@ static bool Opl3Detect_Impl(void)
    snapshots + resets this once per its own diagnostic window and folds
    the numbers into its own already-open log handle. Temporary -- revert
    once the investigation concludes. */
+/* DOS-PORT patch 0199: every timing in this diagnostic family is off unless SDL_HINT_DOS_AUDIO_DIAG_TIMING
+   is set. -1 = not read yet. See SDL_dos.h for the main-thread latch rule. */
+static int s_audio_diag_timing = -1;
+
+bool SDL_DOSAudioDiagTiming(void)
+{
+    if (s_audio_diag_timing < 0) {
+        s_audio_diag_timing = SDL_GetHintBoolean("SDL_HINT_DOS_AUDIO_DIAG_TIMING", false) ? 1 : 0;
+    }
+    return s_audio_diag_timing != 0;
+}
+
 static Uint32 s_opl3_regwrite_calls = 0;
 static Uint64 s_opl3_regwrite_sum_us = 0;
 static Uint64 s_opl3_regwrite_min_us = ~(Uint64)0;
@@ -1056,7 +1068,8 @@ void SDL_DOSOpl3WriteRegister(uint16_t reg, uint8_t value)
     }
     const Uint16 addr_port = (reg < 0x100) ? 0x388 : 0x38A;
     const Uint16 data_port = (reg < 0x100) ? 0x389 : 0x38B;
-    const uclock_t t0 = uclock(); /* TEMPORARY DIAGNOSTIC, see above */
+    const bool diag = SDL_DOSAudioDiagTiming(); /* patch 0199: off by default */
+    const uclock_t t0 = diag ? uclock() : 0; /* TEMPORARY DIAGNOSTIC, see above */
 
     outportb(addr_port, (Uint8)(reg & 0xFF));
     /* Inter-write delay: canonical Adlib 6 dummy status reads.
@@ -1072,7 +1085,7 @@ void SDL_DOSOpl3WriteRegister(uint16_t reg, uint8_t value)
         (void)inportb(0x388);
     }
 
-    { /* TEMPORARY DIAGNOSTIC, see above */
+    if (diag) { /* TEMPORARY DIAGNOSTIC, see above */
         const Uint64 call_us = (Uint64)((uclock() - t0) * 1000000ULL / UCLOCKS_PER_SEC);
         s_opl3_regwrite_calls++;
         s_opl3_regwrite_sum_us += call_us;

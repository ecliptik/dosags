+// DOS-PORT (Sound milestone, S4): MIDI-mode constructor -- see audioplayer.h.
+AudioPlayer::AudioPlayer(int handle, const AGS::Common::String &midi_path, bool repeat)
+    : handle_(handle), _isMidi(true), _midiRepeat(repeat), _midiPath(midi_path)
+{
+    _midiSched = midi_sched_open(_midiPath.GetCStr());
+    _midiSink = dos_midi_backend_open(&_midiBackendKind);
+    if (_midiSched && _midiSink)
+    {
+        midi_sched_sink sink;
+        opl3_sink_bind(_midiSink, &sink);
+        // Best-effort GM bank, staged alongside the exe -- same convention
+        // shared/tests/probes/opl3midi.c already established. Missing file
+        // or a bad header just keeps the sink's built-in 8-patch fallback
+        // (opl3_sink_load_bank()'s own documented contract); not fatal.
+        opl3_sink_load_bank(_midiSink, "OPL3BANK.DAT", nullptr);
+        midi_sched_set_sink(_midiSched, &sink);
+    }
+}
+
+AudioPlayer::~AudioPlayer()
+{
+    if (!_isMidi)
+        return;
+    if (_midiSched) midi_sched_close(_midiSched);
+    if (_midiSink)  opl3_sink_close(_midiSink);
+}
+
+uint64_t AudioPlayer::MidiNowMsRaw()
+{
+    // Same uclock()-based wall clock + engine-start epoch every other
+    // DOS-PORT timestamp in this engine uses (ac/event.cpp, ac/room.cpp,
+    // ac/sys_events.cpp) -- uclock() is PIT-based on this DJGPP target,
+    // already confirmed safe (not RDTSC) by patch 0042. The extern itself
+    // is declared at file (global) scope above -- see that comment.
+    return (uint64_t)((uclock() - dos_port_engine_start_uclock) * 1000 / UCLOCKS_PER_SEC);
+}

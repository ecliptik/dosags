+    for (int h = 0; h < kVmH_Count + 2; ++h)
+        fprintf(f, "H %d %s %lu %lu\n", h, s_l1b_hname[h], s_l1b_attempt[h], s_l1b_commit[h]);
+    for (int b = 0; b < kL1bNB; ++b)
+    {
+        for (int op = 0; op < CC_NUM_SCCMDS; ++op)
+            if (s_l1b_op[b * CC_NUM_SCCMDS + op]) fprintf(f, "O %d %d %lu\n", b, op, static_cast<unsigned long>(s_l1b_op[b * CC_NUM_SCCMDS + op]));
+        for (int h = 0; h < kVmH_Count + 2; ++h)
+            if (s_l1b_unit[b * (kVmH_Count + 2) + h]) fprintf(f, "U %d %d %lu\n", b, h, static_cast<unsigned long>(s_l1b_unit[b * (kVmH_Count + 2) + h]));
+        const L1bAS &a = s_l1b_as[b];
+        if (a.acts || a.unret)
+            fprintf(f, "A %d %lu %lu %lu %lu %lu %llu %llu %llu %llu\n", b, a.acts, a.leaf, a.leaf0, a.entries, a.unret,
+                static_cast<unsigned long long>(a.ops), static_cast<unsigned long long>(a.leafops),

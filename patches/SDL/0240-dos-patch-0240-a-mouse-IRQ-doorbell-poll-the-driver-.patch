 #include "../../events/default_cursor.h"
@@ -112,6 +113,8 @@ static bool DOSVESA_WarpMouseGlobal(float x, float y)
     regs.x.dx = (Uint16)y;
     __dpmi_int(0x33, &regs);
 
+    DOS_MouseNoteDriverChanged(); /* dosags patch 0240: the next pump polls the driver's new state */
+
     // Update internal mouse position.
     SDL_SendMouseMotion(0, mouse->focus, SDL_GLOBAL_MOUSE_ID, false, x, y);
 
@@ -158,11 +161,14 @@ void DOSVESA_InitMouse(SDL_VideoDevice *_this)
     mouse->WarpMouseGlobal = DOSVESA_WarpMouseGlobal;
 
     SDL_SetDefaultCursor(DOSVESA_CreateDefaultCursor());

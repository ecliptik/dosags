+                    sc.calls, sc.total_ms, sc.min_ms, sc.max_ms,
+                    sc.calls > 0 ? (double)sc.total_ms / (double)sc.calls : 0.0);
+                fprintf(run_manifest_log,
+                    "DOS-PORT tickstats_wait_next_frame calls=%ld total_ms=%ld min_ms=%ld max_ms=%ld mean_ms=%.2f\n",
+                    wf.calls, wf.total_ms, wf.min_ms, wf.max_ms,
+                    wf.calls > 0 ? (double)wf.total_ms / (double)wf.calls : 0.0);
+                fprintf(run_manifest_log,
+                    "DOS-PORT tickstats_wait_next_frame_requested sleep_calls=%ld requested_ms=%ld\n",
+                    dos_port_tick_timing.wait_next_frame_sleep_calls,
+                    dos_port_tick_timing.wait_next_frame_requested_ms);
             }
 

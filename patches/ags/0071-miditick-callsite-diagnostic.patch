             (unsigned long)w.voicestop_calls, (unsigned long)w.voicestop_min_us,
-            (unsigned long)w.voicestop_mean_us, (unsigned long)w.voicestop_max_us);
+            (unsigned long)w.voicestop_mean_us, (unsigned long)w.voicestop_max_us,
+            (unsigned long)w.miditick_calls, (unsigned long)w.miditick_min_us,

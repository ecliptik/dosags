+#ifdef DOSAGS_VMTRACE
+        dos_cm_pure_seen(fn);
+#endif
+        return;
+    }
+    dos_memo_bump();
 }
 bool dos_cmemo_curpure() { return dos_vm_curcall && s_pure_ready && VmIsPure(dos_vm_curcall); }
+#ifdef DOSAGS_VMTRACE
+// called by GetCharIDAtRoom on a miss whose (x, y, hit) matches a stale memo entry
+struct DosCmMiss { int site; const void *fn; unsigned n; };
+static DosCmMiss s_cm_miss[48]; static int s_cm_miss_n = 0; static unsigned s_cm_miss_tot = 0;
+static const char *VmImportName(const void *f)
+{
+    if (!f) return "-";
+    for (uint32_t i = 0;; ++i)
+    {
+        const ScriptImport *imp = simp.GetByIndex(i);
+        if (!imp) break;
+        if (imp->Value.Ptr == f && !imp->Name.IsEmpty()) return imp->Name.GetCStr();
+    }
+    return "?";
+}
+void dos_cm_diag_miss()
+{
+    ++s_cm_miss_tot;
+    int i = 0;
+    for (; i < s_cm_miss_n; ++i)
+        if (s_cm_miss[i].site == s_cm_bsite && s_cm_miss[i].fn == s_cm_bfn) break;
+    if (i == s_cm_miss_n && s_cm_miss_n < 48) { s_cm_miss[i].site = s_cm_bsite; s_cm_miss[i].fn = s_cm_bfn; s_cm_miss[i].n = 0; ++s_cm_miss_n; }
+    if (i < 48) ++s_cm_miss[i].n;
+    if (s_cm_miss_tot % 1000 == 0) dos_cm_dump();
+}
+static void dos_cm_dump()
+{
+    {
+        AGS::Common::Debug::Printf(AGS::Common::kDbgMsg_Info, "DOS-PORT cmdump hits=%u misses_stale=%u", s_cm_hits, s_cm_miss_tot);
+        for (int k = 0; k < s_cm_pfn_n; ++k)
+            AGS::Common::Debug::Printf(AGS::Common::kDbgMsg_Info, "DOS-PORT cmpure n=%u needed=%u fn=%s", s_cm_pn[k], s_cm_need[k], VmImportName(s_cm_pfn[k]));
+        AGS::Common::Debug::Printf(AGS::Common::kDbgMsg_Info, "DOS-PORT cmmiss tot=%u", s_cm_miss_tot);
+        for (int k = 0; k < s_cm_miss_n; ++k)
+            AGS::Common::Debug::Printf(AGS::Common::kDbgMsg_Info, "DOS-PORT cmmiss site=%d n=%u fn=%s op=%u",
+                s_cm_miss[k].site, s_cm_miss[k].n, (s_cm_miss[k].site % 100 == 5) ? "-" : VmImportName(s_cm_miss[k].fn),
+                (unsigned)(uintptr_t)s_cm_miss[k].fn);
+    }
+}
+#endif

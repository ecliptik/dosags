+++ b/Engine/ac/draw_software.cpp
@@ -244,10 +244,14 @@ void set_invalidrects_cameraoffs(int view_index, int x, int y)
     }
 }
 
+#ifdef __DJGPP__
+static bool dos_port_break_0193();   // patch 0195: defined below
+#endif
+
 void invalidate_all_rects()
 {
 #ifdef __DJGPP__
-    dos_port_dirty_set_full("invalidate_all_rects");   // patch 0193: the accumulator never heard of this

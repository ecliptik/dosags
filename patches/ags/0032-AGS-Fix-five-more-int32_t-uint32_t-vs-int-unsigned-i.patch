--- a/Common/gfx/image_png.cpp
+++ b/Common/gfx/image_png.cpp
@@ -97,7 +97,14 @@ PixelBuffer LoadPNG(Stream *in, PixelFormat *src_fmt, RGB *pal)
     stbi_uc *pixels;
     int width, height;

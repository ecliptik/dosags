diff --git a/Engine/ac/draw_software.cpp b/Engine/ac/draw_software.cpp
index 972c684f0..ba8a2ccf1 100644
--- a/Engine/ac/draw_software.cpp
+++ b/Engine/ac/draw_software.cpp
@@ -37,10 +37,15 @@
 //=============================================================================
 
 #include <string.h>
+#include <stdlib.h>
 #include <vector>
 #include "ac/draw_software.h"
 #include "gfx/bitmap.h"
 #include "util/scaling.h"
+#ifdef __DJGPP__
+#include "main/dos_port_tick_timing.h"
+#include "debug/out.h"
+#endif
 
 using namespace AGS::Common;
 using namespace AGS::Engine;
@@ -373,6 +378,183 @@ void invalidate_rect_ds(DirtyRects &rects, int x1, int y1, int x2, int y2, bool
     invalidate_rect_on_surf(x1, y1, x2, y2, rects);
 }
 
+#ifdef __DJGPP__
+// DOS-PORT patch 0124: accumulate a SCREEN-SPACE dirty bbox so the present
+// can be narrowed to what actually changed.
+//
+// Measured on AGS Quest: present_update_window is 16.74 ms per frame,
+// 460,800 bytes to VRAM at 27.5 MB/s -- which matches this machine's own
+// LFB near-pointer ceiling, so the copy is already at the hardware limit.
+// It cannot be made faster; it can only be made SMALLER. That is what this
+// is for, and it is the one lever left on that term.
+//
+// Note this sidesteps patch 0102 entirely. That gate disables the
+// unchanged-frame pixel comparison above 100,000 bytes, which is why AGS
+// Quest reports presents_skipped=0 -- but engine-supplied invalidation
+// needs no comparison at all, so the 460,800-byte frame is narrowable even
+// though it is far past 0102's threshold.
+//
+// DEFAULT FULL, narrow only on a positive signal. A contributor nobody
+// accounted for costs performance, not corruption -- the DOSBox-X gate
+// cannot catch corruption on a path it never executes.
+DosPortDirtyState dos_port_dirty;
+int dos_port_dirty_source = kDirtySrc_Other;            // patch 0175
+long long dos_port_dirty_src_px[kDirtySrc_Count] = {0};
+long dos_port_dirty_src_n[kDirtySrc_Count] = {0};
+
+// patch 0132: read once, clamped to the array. 12 is the default because
+// it is what the four-design comparison was run at; the sweep decides
+// whether it stays.
+int dos_port_dirty_max_boxes = []() {
+    const char *h = getenv("DOSAGS_DIRTY_BOXES");
+    int n = h ? atoi(h) : 8;   // patch 0132: measured knee
+    if (n < 1) n = 1;
+    if (n > DOS_PORT_DIRTY_MAX_BOXES) n = DOS_PORT_DIRTY_MAX_BOXES;
+    return n;
+}();
+
+void dos_port_dirty_add_screen(int x1, int y1, int x2, int y2)
+{
+    dos_port_dirty.adds++;
+    {   // patch 0175: attribute this rect's area to whoever asked for it
+        const int _s = (dos_port_dirty_source >= 0 && dos_port_dirty_source < kDirtySrc_Count)
+                       ? dos_port_dirty_source : kDirtySrc_Other;
+        dos_port_dirty_src_px[_s] += (long long)(x2 - x1 + 1) * (y2 - y1 + 1);
+        dos_port_dirty_src_n[_s]++;
+    }
+    // TRAP GUARD: these callers iterate RoomCamRects, which is EMPTY
+    // between rooms. An accumulator placed inside that loop would silently
+    // never fire and read as "narrowing didn't help". Counted, not assumed.
+    if (RoomCamRects.empty())
+        dos_port_dirty.adds_no_camera++;
+    if (dos_port_dirty.is_full)
+        return;
+    // patch 0129: keep the single bbox too. It still gates correctness
+    // (valid/is_full) and it is the control the box set is scored against
+    // -- px_multi_bbox versus px_multi on the same frames is a within-run
+    // A/B that needs no second cell.
+    if (!dos_port_dirty.valid)
+    {
+        dos_port_dirty.x1 = x1; dos_port_dirty.y1 = y1;
+        dos_port_dirty.x2 = x2; dos_port_dirty.y2 = y2;
+        dos_port_dirty.valid = true;
+    }
+    else
+    {
+        if (x1 < dos_port_dirty.x1) dos_port_dirty.x1 = x1;
+        if (y1 < dos_port_dirty.y1) dos_port_dirty.y1 = y1;
+        if (x2 > dos_port_dirty.x2) dos_port_dirty.x2 = x2;
+        if (y2 > dos_port_dirty.y2) dos_port_dirty.y2 = y2;
+    }
+
+    // patch 0130: mark the rows this rect touches. Cheap, and it is the
+    // only extra data a band design needs.
+    {
+        int ry1 = y1 < 0 ? 0 : y1;
+        int ry2 = y2 > 1023 ? 1023 : y2;
+        if (ry2 >= ry1)
+        {
+            if (dos_port_dirty.row_max < dos_port_dirty.row_min)
+            { dos_port_dirty.row_min = ry1; dos_port_dirty.row_max = ry2; }
+            else
+            {
+                if (ry1 < dos_port_dirty.row_min) dos_port_dirty.row_min = ry1;
+                if (ry2 > dos_port_dirty.row_max) dos_port_dirty.row_max = ry2;
+            }
+            for (int r = ry1; r <= ry2; ++r)
+                dos_port_dirty.row_dirty[r] = 1;
+        }
+    }
+
+    // patch 0129: fold into the box set. Merge into any box this rect
+    // touches or overlaps; failing that take a free slot; failing that
+    // merge the pair whose union wastes the fewest pixels. "Touches" uses
+    // a one-pixel slack so adjacent rects coalesce instead of filling
+    // slots -- a sprite invalidated as several abutting pieces is the
+    // common case, not the exception.
+    for (int i = 0; i < dos_port_dirty.nbox; ++i)
+    {
+        DosPortDirtyBox &b = dos_port_dirty.box[i];
+        if (x1 <= b.x2 + 1 && x2 >= b.x1 - 1 && y1 <= b.y2 + 1 && y2 >= b.y1 - 1)
+        {
+            if (x1 < b.x1) b.x1 = x1;
+            if (y1 < b.y1) b.y1 = y1;
+            if (x2 > b.x2) b.x2 = x2;
+            if (y2 > b.y2) b.y2 = y2;
+            return;
+        }
+    }
+    if (dos_port_dirty.nbox < dos_port_dirty_max_boxes)
+    {
+        DosPortDirtyBox &b = dos_port_dirty.box[dos_port_dirty.nbox++];
+        b.x1 = x1; b.y1 = y1; b.x2 = x2; b.y2 = y2;
+        return;
+    }
+    // Full: merge the cheapest pair, counting the new rect as a candidate.
+    {
+        int best_i = 0, best_j = 1;
+        long long best_waste = -1;
+        DosPortDirtyBox cand; cand.x1 = x1; cand.y1 = y1; cand.x2 = x2; cand.y2 = y2;
+        for (int i = 0; i < dos_port_dirty.nbox; ++i)
+        {
+            for (int j = i + 1; j <= dos_port_dirty.nbox; ++j)
+            {
+                const DosPortDirtyBox &a = dos_port_dirty.box[i];
+                const DosPortDirtyBox &b = (j == dos_port_dirty.nbox) ? cand : dos_port_dirty.box[j];
+                const int ux1 = a.x1 < b.x1 ? a.x1 : b.x1;
+                const int uy1 = a.y1 < b.y1 ? a.y1 : b.y1;
+                const int ux2 = a.x2 > b.x2 ? a.x2 : b.x2;
+                const int uy2 = a.y2 > b.y2 ? a.y2 : b.y2;
+                const long long waste =
+                    (long long)(ux2 - ux1 + 1) * (uy2 - uy1 + 1)
+                    - (long long)(a.x2 - a.x1 + 1) * (a.y2 - a.y1 + 1)
+                    - (long long)(b.x2 - b.x1 + 1) * (b.y2 - b.y1 + 1);
+                if (best_waste < 0 || waste < best_waste)
+                { best_waste = waste; best_i = i; best_j = j; }
+            }
+        }
+        DosPortDirtyBox &a = dos_port_dirty.box[best_i];
+        const DosPortDirtyBox &b = (best_j == dos_port_dirty.nbox) ? cand : dos_port_dirty.box[best_j];
+        if (b.x1 < a.x1) a.x1 = b.x1;
+        if (b.y1 < a.y1) a.y1 = b.y1;
+        if (b.x2 > a.x2) a.x2 = b.x2;
+        if (b.y2 > a.y2) a.y2 = b.y2;
+        if (best_j < dos_port_dirty.nbox)
+        {
+            // the merged-away slot is now free for the new rect
+            dos_port_dirty.box[best_j].x1 = x1; dos_port_dirty.box[best_j].y1 = y1;
+            dos_port_dirty.box[best_j].x2 = x2; dos_port_dirty.box[best_j].y2 = y2;
+        }
+    }
+}
+
+void dos_port_dirty_set_full(const char *why)
+{
+    if (!dos_port_dirty.is_full)
+    {
+        dos_port_dirty.is_full = true;
+        dos_port_dirty.full_reason = why;
+        dos_port_dirty.full_latches++;
+    }
+}
+
+void dos_port_dirty_frame_reset()
+{
+    dos_port_dirty.valid = false;
+    dos_port_dirty.is_full = false;
+    dos_port_dirty.full_reason = nullptr;
+    dos_port_dirty.scene_path = false;
+    dos_port_dirty.nbox = 0;   // patch 0129
+    // patch 0130: clear only the range actually touched, not 1KB.
+    if (dos_port_dirty.row_max >= dos_port_dirty.row_min)
+    {
+        for (int r = dos_port_dirty.row_min; r <= dos_port_dirty.row_max; ++r)
+            dos_port_dirty.row_dirty[r] = 0;
+    }
+    dos_port_dirty.row_min = 0; dos_port_dirty.row_max = -1;
+}
+#endif
+
 void invalidate_rect_ds(int x1, int y1, int x2, int y2, bool in_room)
 {
     if (!in_room)
@@ -383,12 +565,35 @@ void invalidate_rect_ds(int x1, int y1, int x2, int y2, bool in_room)
         y2 += GlobalOffs.Y;
     }
 
+#ifdef __DJGPP__
+    if (!in_room)
+    {
+        dos_port_dirty_add_screen(x1, y1, x2, y2);
+    }
+    else if (!RoomCamRects.empty())
+    {
+        // Room coords -> screen, via the same PlaneScaling the per-camera
+        // path uses. Without this every in_room rect forces a full present,
+        // which is what an earlier revision of this measured: 100% of
+        // frames latched full with reason "in_room rect".
+        const DirtyRects &r0 = RoomCamRects[0];
+        dos_port_dirty_add_screen(r0.Room2Screen.X.ScalePt(x1), r0.Room2Screen.Y.ScalePt(y1),
+                                  r0.Room2Screen.X.ScalePt(x2), r0.Room2Screen.Y.ScalePt(y2));
+    }
+    else
+    {
+        dos_port_dirty_set_full("in_room rect with no camera");
+    }
+#endif
     for (auto &rects : RoomCamRects)
         invalidate_rect_ds(rects, x1, y1, x2, y2, in_room);
 }
 
 void invalidate_rect_global(int x1, int y1, int x2, int y2)
 {
+#ifdef __DJGPP__
+    dos_port_dirty_add_screen(x1, y1, x2, y2);
+#endif
     for (auto &rects : RoomCamRects)
         invalidate_rect_ds(rects, x1, y1, x2, y2, false);
 }
diff --git a/Engine/ac/draw_software.h b/Engine/ac/draw_software.h
index add2af80e..1afb3f271 100644
--- a/Engine/ac/draw_software.h
+++ b/Engine/ac/draw_software.h
@@ -39,6 +39,96 @@ void invalidate_all_rects();
 // Mark the whole camera surface dirty
 void invalidate_all_camera_rects(int view_index);
 // Mark certain rectangle dirty; in_room tells if coordinates are room viewport or screen coords
+#ifdef __DJGPP__
+// DOS-PORT patch 0124: screen-space dirty bbox for a narrowed present.
+// DOS-PORT patch 0129: a SET of boxes, not one bounding box.
+// Patch 0124's single bbox was measured dead: it degenerates to the whole
+// screen the moment two dirty rects sit in opposite corners, and on AGS
+// Quest that happened permanently around frame 500 (narrow frozen at 376,
+// full climbing by 500 per report). AGS's own dirty system keeps 25
+// regions with per-row spans for exactly this reason. 12 boxes is a
+// compromise: enough that ordinary scattered sprites stay separate, few
+// enough that the per-rect cost of SDL_UpdateWindowSurfaceRects and the
+// merge scan stay small. The right value is an open question -- it is a
+// tunable, not a constant, until a sweep says otherwise.
+#define DOS_PORT_DIRTY_MAX_BOXES 32
+// patch 0132: the cap is a RUNTIME value (DOSAGS_DIRTY_BOXES), not a
+// constant, because the coordinator's point stands -- maximum fidelity is
+// not obviously best. 25 regions pay 25x the per-rect overhead for the
+// same pixels one bbox covers for none, so the knee gets measured.
+extern int dos_port_dirty_max_boxes;
+struct DosPortDirtyBox { int x1, y1, x2, y2; };
+struct DosPortDirtyState
+{
+    int  x1 = 0, y1 = 0, x2 = 0, y2 = 0;
+    bool valid = false;        // bbox holds a real union
+    // patch 0129
+    DosPortDirtyBox box[DOS_PORT_DIRTY_MAX_BOXES] = {};
+    int  nbox = 0;
+    long frames_multi = 0;      // frames pushed as >1 rect
+    long long px_multi = 0;     // area those pushes actually covered
+    long long px_multi_bbox = 0;// what the single bbox would have cost them
+    long rej_wholescreen = 0;   // patch 0129: box set covers the whole screen
+    long rej_outside = 0;       // ... versus genuinely outside dst
+    long boxes_pushed = 0;      // total rects handed to SDL
+    // patch 0130: full-width ROW BANDS, the coordinator's variant. A band
+    // at 640px is contiguous memory -- no stride penalty, no per-row
+    // address arithmetic, and very few rects by construction, so it
+    // sidesteps the per-rect overhead risk that arbitrary rects carry.
+    // Accounted here alongside the box set so ONE run prices all four
+    // designs (full / bbox / bands / rects) against each other, rather
+    // than a cell per candidate.
+    unsigned char row_dirty[1024] = {};
+    int  row_min = 0, row_max = -1;
+    long long px_bands = 0;     // rows touched x full width
+    long bands_count = 0;       // contiguous runs of dirty rows
+    long frames_rowacct = 0;    // frames the row accounting covered
+    // patch 0134: price a greedy pairwise merge at several thresholds,
+    // ACCOUNTING ONLY -- nothing merged is pushed. Same trick that priced
+    // four present designs off one run. The thresholds bracket the
+    // coordinator's ~5,500 px break-even (0.37 ms/rect at ~15,245 px/ms).
+    long long mg_px[4] = {0,0,0,0};
+    long      mg_rects[4] = {0,0,0,0};
+    bool is_full = false;      // something demands a full present
+    bool scene_path = false;   // this frame went through construct_game_scene()
+    // patch 0128: why a frame fell back to a full present, counted per
+    // cause. One latched string could not survive the per-frame reset.
+    long rej_scaled = 0;        // dst is not 1:1 with the virtual screen
+    long rej_no_scene = 0;      // frame never went through construct_game_scene()
+    long rej_latched_full = 0;  // something called dos_port_dirty_set_full()
+    long rej_no_rects = 0;      // no rect was invalidated at all
+    long rej_palette = 0;       // palette-only present
+    long rej_clip = 0;          // bbox fell outside dst after translation
+    const char *full_reason = nullptr;
+    long adds = 0, adds_no_camera = 0, full_latches = 0;
+    long frames_narrow = 0, frames_full = 0;
+    long long px_narrow = 0, px_full = 0;
+};
+extern DosPortDirtyState dos_port_dirty;
+// DOS-PORT patch 0175: which call site dirtied how many pixels.
+//
+// The dirty region is 80,514 px/frame after stage 1 halved it, and nothing
+// has explained the remainder. It is upstream of all three costly terms --
+// the restore repaints it, the present pushes it, and gCredits intersects
+// it every frame BECAUSE it is large. Arithmetic: clipping gCredits to the
+// 61% intersection leaves tail frames at 37.7 ms, still over the 25 ms
+// budget, so they keep skipping; removing gCredits entirely would give
+// 16.6 ms. The clip cannot reach budget but a smaller dirty region makes
+// the clip approach the removal.
+//
+// Same technique that found gCredits: one field, no cell, one question.
+enum DosPortDirtySource {
+    kDirtySrc_Other = 0, kDirtySrc_RoomSprite, kDirtySrc_UiSprite,
+    kDirtySrc_Cursor, kDirtySrc_Screen, kDirtySrc_Count
+};
+extern int dos_port_dirty_source;
+extern long long dos_port_dirty_src_px[kDirtySrc_Count];
+extern long dos_port_dirty_src_n[kDirtySrc_Count];
+void dos_port_dirty_add_screen(int x1, int y1, int x2, int y2);
+void dos_port_dirty_set_full(const char *why);
+void dos_port_dirty_frame_reset();
+#endif
+
 void invalidate_rect_ds(int x1, int y1, int x2, int y2, bool in_room);
 // Mark rectangle dirty, treat pos as global screen coords (not offset by legacy letterbox mode)
 void invalidate_rect_global(int x1, int y1, int x2, int y2);
diff --git a/Engine/gfx/ali3dsw.cpp b/Engine/gfx/ali3dsw.cpp
index b0c662c8f..c28a50c0e 100644
--- a/Engine/gfx/ali3dsw.cpp
+++ b/Engine/gfx/ali3dsw.cpp
@@ -12,6 +12,7 @@
 //
 //=============================================================================
 #include "gfx/ali3dsw.h"
+#include "ac/draw_software.h"   // patch 0124
 #include <algorithm>
 #include <cstring>
 #include <stack>
@@ -1375,6 +1376,221 @@ void SDLRendererGraphicsDriver::Present(int xoff, int yoff, GraphicFlip flip)
         DosPortAliasTryActivate(win_surface, dst);
 #endif
 
+#ifdef __DJGPP__
+    // patch 0124: narrow the push to the accumulated bbox when this frame
+    // demonstrably went through the scene path and nothing demanded full.
+    // DOSAGS_DIRTY_PRESENT=0 disables -- fastest by default, tunable off.
+    SDL_Rect _dp_push = dst;
+    bool _dp_narrowed = false;
+    SDL_Rect _dp_rects[DOS_PORT_DIRTY_MAX_BOXES];   // patch 0129
+    int _dp_nrects = 0;
+    {
+        static bool hint_read = false, hint_on = true;
+        if (!hint_read) { const char *h = getenv("DOSAGS_DIRTY_PRESENT");
+                          hint_on = !(h && h[0]=='0'); hint_read = true; }
+        // patch 0128: the bbox is accumulated in GAME coordinates
+        // (invalidate_rect_ds/_global, y in 0..gameh-1); dst is in WINDOW
+        // coordinates, and for a letterboxed 640x360 in 640x480 they differ
+        // by dst.y == 60. Comparing the two directly made "b.y >= dst.y"
+        // mean "is the dirty region below game row 60", so any frame
+        // touching the top of the viewport presented full -- permanently,
+        // once anything up there redrew every frame (measured: narrow
+        // froze at 376 while full reached 2124). And the frames that did
+        // pass pushed a rect 60 rows too high, refreshing the wrong strip.
+        // Translate first, and only when the mapping is a pure offset.
+        const bool _dp_one_to_one =
+            blit_src && dst.w == blit_src->w && dst.h == blit_src->h;
+        if (!_dp_one_to_one) dos_port_dirty.rej_scaled++;
+        else if (!hint_on) { /* switched off, not a rejection */ }
+        else if (!dos_port_dirty.scene_path) dos_port_dirty.rej_no_scene++;
+        else if (dos_port_dirty.is_full) dos_port_dirty.rej_latched_full++;
+        else if (!dos_port_dirty.valid) dos_port_dirty.rej_no_rects++;
+        else if (palette_only_present) dos_port_dirty.rej_palette++;

+static void l1b_gram(uint64_t key, int fused)
+{
+    uint32_t h = static_cast<uint32_t>((key * 0x9E3779B97F4A7C15ULL) >> 47) & (kL1bGN - 1);
+    for (uint32_t k = 0; k < 64; ++k, h = (h + 1) & (kL1bGN - 1))
+    {
+        L1bG &e = s_l1b_g[h];
+        if (e.n == 0) { e.key = key; e.n = 1; e.nf = fused ? 1 : 0; ++s_l1b_g_used; return; }
+        if (e.key == key) { ++e.n; if (fused) ++e.nf; return; }
+    }
+    ++s_l1b_g_full;
+}
+
+static int l1b_bucket()
+{
+    int b = dos_l1_cur();
+    return (b >= 0 && b < kL1bNB) ? b : 0;
+}

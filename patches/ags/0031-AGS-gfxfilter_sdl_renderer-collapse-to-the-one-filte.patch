-// SDL software renderer filter. Technically a non-op, as SDL_Renderer
-// does the job.
+// SDL software renderer filter. A true non-op: the DOS window-surface
+// present step (ali3dsw.cpp, patch 0029) always blits at a fixed
+// SDL_SCALEMODE_NEAREST, so this filter has nothing left to configure.
+//
+// DOS-PORT: this used to be two filters -- this one (nearest) and a
+// second SDLRendererAAGfxFilter (linear) -- each picking an SDL_Renderer
+// texture scale mode via GetScaleMode()/an SDL_HINT_RENDER_SCALE_QUALITY
+// hint via InitSDLHint(). Both became meaningless once the present step
+// stopped using SDL_Renderer at all (patch 0029) and started calling
+// SDL_BlitSurfaceScaled() with a hardcoded scale mode directly -- nothing
+// left in this driver ever calls either method. Collapsed to the one
+// filter the v0.1 profile actually offers (see PLAN.md's review-decision
+// section: "no scaling, no filtering"), matching the doc's own patch
+// 0029 row. GetScaleMode()/InitSDLHint() are dropped, not stubbed: SDL3
+// does not even have an SDL_HINT_RENDER_SCALE_QUALITY hint any more
+// (confirmed by reading vendor/SDL/include/SDL3/ directly), so there is
+// nothing correct left for InitSDLHint() to do.
 //
 //=============================================================================
 #ifndef __AGS_EE_GFX__SDLRENDERERFILTER_H
 #define __AGS_EE_GFX__SDLRENDERERFILTER_H
 
-#include <SDL_render.h>
 #include "gfx/gfxfilter_scaling.h"
 
 namespace AGS
@@ -34,9 +48,6 @@ class SDLRendererGfxFilter : public ScalingGfxFilter
 public:
     const GfxFilterInfo &GetInfo() const override;
 
-    virtual SDL_ScaleMode GetScaleMode() const;
-    virtual void InitSDLHint() const;
-
     static const GfxFilterInfo FilterInfo;
 };
 

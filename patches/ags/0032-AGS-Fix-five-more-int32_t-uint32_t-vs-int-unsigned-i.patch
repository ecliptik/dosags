             finfo.YOffset = in->ReadInt32();
-            finfo.LineSpacing = std::max(0, in->ReadInt32());
+            // DOS-PORT: std::max(int, int32_t) is ambiguous under DJGPP's
+            // ILP32 model (int32_t is long int, distinct from int) -- same
+            // divergence as patches 0013/0018/0019/0024/0027; LineSpacing
+            // is a plain int (gamestructdefines.h), so cast to match it
+            // rather than the other way around.
+            finfo.LineSpacing = std::max(0, (int)in->ReadInt32());
             finfo.SetFlags(flags);
             // This corresponds to the "v360_fonts" extension in game data
             // NOTE: we have a 3.6.0 extension right here, because this TRA
diff --git a/Common/gfx/allegrobitmap.h b/Common/gfx/allegrobitmap.h
index a3f11c56b..a712194be 100644
--- a/Common/gfx/allegrobitmap.h
+++ b/Common/gfx/allegrobitmap.h
@@ -255,8 +255,14 @@ public:
     // Draws rotated bitmap, using angle given in degrees.
     // Warning: does not resize destination bitmap; if it's not large enough
     // then the resulting image may end up cropped.
-    void    RotateBlt(const Bitmap *src, int dst_x, int dst_y, int angle);
-    void    RotateBlt(const Bitmap *src, int dst_x, int dst_y, int pivot_x, int pivot_y, int angle);
+    // DOS-PORT: angle is fixed_t (platform/types.h: int32_t) in both real
+    // definitions (allegrobitmap.cpp) -- this declaration said plain int,
+    // a distinct type from int32_t under DJGPP's ILP32 model (unlike a
+    // 64-bit host, where int32_t is int and the mismatch is invisible).
+    // Matching the definitions' own (semantically correct -- this is a
+    // fixed-point angle) type, not the other way around.
+    void    RotateBlt(const Bitmap *src, int dst_x, int dst_y, fixed_t angle);
+    void    RotateBlt(const Bitmap *src, int dst_x, int dst_y, int pivot_x, int pivot_y, fixed_t angle);
 
     //=========================================================================
     // Pixel operations

diff --git a/libsrc/allegro/src/c/cmisc.c b/libsrc/allegro/src/c/cmisc.c
index 88f52c8cb..ab9db3229 100644
--- a/libsrc/allegro/src/c/cmisc.c
+++ b/libsrc/allegro/src/c/cmisc.c
@@ -34,3 +34,37 @@
 #endif
 
 
+
+/* DOS-PORT patch 0127: masked-sprite run-length statistics.
+ *
+ * Measured BEFORE writing a run-based blit, not after, because the whole
+ * case for `rep movsd` over opaque runs depends on the runs being long.
+ * The bandwidth probe (2026-09-19) priced a read at 2.27 cycles/byte and
+ * a write at 1.61, so skipping the write on a transparent pixel saves
+ * only 41% of it -- all the win is in opaque spans, and if the sprites
+ * turn out to be speckled, run detection costs more than it saves.
+ *
+ * Deliberately NOT compiled unless DOSAGS_SPRITE_RUN_STATS is defined:
+ * this is three adds and a branch inside the hottest loop in the engine,
+ * which is exactly the kind of thing the cache-footprint observations
+ * say costs ~1 fps. The stats build is a separate build.
+ */
+#ifdef DOSAGS_SPRITE_RUN_STATS
+unsigned long dosags_spr_px = 0;
+unsigned long dosags_spr_opaque_px = 0;
+unsigned long dosags_spr_runs = 0;
+#endif
+
+/* DOS-PORT patch 0160: run-based masked blit switch.
+ *
+ * -1 = not yet read. DOSAGS_RUNBLIT=0 disables and falls back to the
+ * original per-pixel loop, so both arms live in ONE binary and a
+ * comparison carries no layout or code-size difference -- the same
+ * discipline the virtual-screen alias and the narrowed present used.
+ *
+ * Default ON. The measurement that justifies it: mean opaque run is 57.0
+ * pixels (patch 0127, 1,309,835 runs over 74.6M opaque pixels), against a
+ * decision rule of 16 written before the data existed. The current loop
+ * runs at 19.4 cycles/pixel against a measured copy ceiling of 7.8.
+ */
+int dosags_runblit = -1;
diff --git a/libsrc/allegro/src/c/cspr.h b/libsrc/allegro/src/c/cspr.h
index 6d6b48014..10add589f 100644
--- a/libsrc/allegro/src/c/cspr.h
+++ b/libsrc/allegro/src/c/cspr.h
@@ -18,6 +18,20 @@
 #ifndef __bma_cspr_h
 #define __bma_cspr_h
 
+#ifdef DOSAGS_SPRITE_RUN_STATS
+/* DOS-PORT patch 0127 -- defined in cmisc.c, see the comment there for
+ * why this is a separate build rather than always on. */
+extern unsigned long dosags_spr_px;
+extern unsigned long dosags_spr_opaque_px;
+extern unsigned long dosags_spr_runs;
+#endif
+
+#ifdef __DJGPP__
+#include <stdlib.h>
+#include <string.h>
+extern int dosags_runblit;   /* DOS-PORT patch 0160, defined in cmisc.c */
+#endif
+
 /* _linear_draw_sprite:
  *  Draws a sprite onto a linear bitmap at the specified x, y position,
  *  using a masked drawing mode where zero pixels are not output.
@@ -66,12 +80,90 @@ void FUNC_LINEAR_DRAW_SPRITE(BITMAP *dst, BITMAP *src, int dx, int dy)
 	 PIXEL_PTR s = OFFSET_PIXEL_PTR(src->line[sybeg + y], sxbeg);
 	 PIXEL_PTR d = OFFSET_PIXEL_PTR(dst->line[dybeg + y], dxbeg);
 
+#ifdef DOSAGS_SPRITE_RUN_STATS
+	 /* patch 0127: count opaque RUNS, not just opaque pixels -- a run
+	  * is a transparent-to-opaque transition, so runs and opaque
+	  * pixels together give the mean run length, which is the number
+	  * that decides whether a run-based blit is worth writing. */
+	 {
+	    int dosags_in_run = 0;
+	    dosags_spr_px += (unsigned long)w;
+	    for (x = w - 1; x >= 0; INC_PIXEL_PTR(s), INC_PIXEL_PTR(d), x--) {
+	       uint32_t c = GET_MEMORY_PIXEL(s);
+	       if (!IS_SPRITE_MASK(src, c)) {
+		  PUT_MEMORY_PIXEL(d, c);
+		  dosags_spr_opaque_px++;
+		  if (!dosags_in_run) { dosags_spr_runs++; dosags_in_run = 1; }
+	       }
+	       else {
+		  dosags_in_run = 0;
+	       }
+	    }
+	 }
+#elif defined(__DJGPP__)
+	 /* DOS-PORT patch 0160: copy opaque RUNS in bulk.
+	  *
+	  * The read is unavoidable -- it IS the mask test, and the bandwidth
+	  * probe priced a read at 2.27 cycles/byte against a write's 1.61,
+	  * so skipping a write saves only 41% of a transparent pixel. The
+	  * win is not in skipping work, it is in amortising the loop: the
+	  * original pays pointer increments, a bounds test and a branch for
+	  * every pixel, 19.4 cycles/pixel against a 7.8 copy ceiling. With a
+	  * mean opaque run of 57 pixels (measured, patch 0127), one memcpy
+	  * replaces 57 individual stores and their bookkeeping.
+	  *
+	  * The run's byte length comes from POINTER DIFFERENCE, not from
+	  * sizeof: this header is instantiated at 8/15/16/24/32 bpp, and at
+	  * 24 bpp PIXEL_PTR is unsigned char* while a pixel is three bytes,
+	  * so sizeof would silently copy a third of each run. Pointer
+	  * difference is correct at every depth by construction.
+	  */
+	 if (dosags_runblit < 0) {
+	    const char *_h = getenv("DOSAGS_RUNBLIT");
+	    dosags_runblit = (_h && _h[0] == '0') ? 0 : 1;
+	 }
+	 if (dosags_runblit) {
+	    x = 0;
+	    while (x < w) {
+	       while (x < w && IS_SPRITE_MASK(src, GET_MEMORY_PIXEL(s))) {
+		  INC_PIXEL_PTR(s); INC_PIXEL_PTR(d); x++;
+	       }
+	       if (x >= w)
+		  break;
+	       {
+		  /* Declared separately, NOT "PIXEL_PTR rs = s, rd = d;".
+		   * PIXEL_PTR is a macro expanding to "unsigned short*", so
+		   * that form declares rd as a plain unsigned short and the
+		   * memcpy destination becomes a truncated integer cast back
+		   * to a pointer. The compiler caught it; the C declarator
+		   * rule binds the * to the first declarator only, and a
+		   * pointer spelled as a macro hides that completely. */
+		  PIXEL_PTR rs = s;
+		  PIXEL_PTR rd = d;
+		  while (x < w && !IS_SPRITE_MASK(src, GET_MEMORY_PIXEL(s))) {
+		     INC_PIXEL_PTR(s); INC_PIXEL_PTR(d); x++;
+		  }
+		  memcpy((void *)rd, (const void *)rs,
+			 (size_t)((const char *)s - (const char *)rs));
+	       }
+	    }
+	 }
+	 else {
+	    for (x = w - 1; x >= 0; INC_PIXEL_PTR(s), INC_PIXEL_PTR(d), x--) {
+	       uint32_t c = GET_MEMORY_PIXEL(s);
+	       if (!IS_SPRITE_MASK(src, c)) {
+		  PUT_MEMORY_PIXEL(d, c);
+	       }
+	    }
+	 }
+#else
 	 for (x = w - 1; x >= 0; INC_PIXEL_PTR(s), INC_PIXEL_PTR(d), x--) {
 	    uint32_t c = GET_MEMORY_PIXEL(s);
 	    if (!IS_SPRITE_MASK(src, c)) {
 	       PUT_MEMORY_PIXEL(d, c);
 	    }
 	 }
+#endif
       }
    }
 }

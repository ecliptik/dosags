 static DOSFramebufferState fb_state;
 
+// DOS-PORT patch 0210: SDL_DOS_PACK24 (see SDL_dosmodes.c). The mode's internal data says
+// 24 bpp while the format offered to the application is 4 bytes per pixel.
+static bool dos_mode_is_pack24(const SDL_DisplayMode *mode)
+{
+    const SDL_DisplayModeData *m = mode ? mode->internal : NULL;
+    return m && m->bpp == 24 && SDL_BYTESPERPIXEL(mode->format) == 4;
+}
+
+// XRGB8888 in memory is B,G,R,X; the packed mode wants B,G,R. Drops the X byte, nothing
+// else, so the displayed RGB equals the 32-bit path's. Four pixels -> three dword stores.
+static void dos_pack24_row(Uint8 *dst, const Uint32 *src, int n)
+{
+    while (n >= 4) {
+        const Uint32 a = src[0], b = src[1], c = src[2], d = src[3];
+        const Uint32 o0 = (a & 0x00FFFFFFu) | (b << 24);
+        const Uint32 o1 = ((b >> 8) & 0x0000FFFFu) | (c << 16);
+        const Uint32 o2 = ((c >> 16) & 0x000000FFu) | (d << 8);
+        __builtin_memcpy(dst, &o0, 4);
+        __builtin_memcpy(dst + 4, &o1, 4);
+        __builtin_memcpy(dst + 8, &o2, 4);
+        src += 4;
+        dst += 12;
+        n -= 4;
+    }
+    while (n-- > 0) {
+        const Uint32 p = *src++;
+        dst[0] = (Uint8)p;
+        dst[1] = (Uint8)(p >> 8);
+        dst[2] = (Uint8)(p >> 16);
+        dst += 3;
+    }
+}
+
+static unsigned long dos_pack24_pushed_px = 0;
+static int dos_pack24_mode_id = 0;
+
+static void dos_pack24_report(void)
+{
+    fprintf(stdout, "DOS-PORT pack24 active=1 mode=0x%04X pushed_px=%lu\n",
+            dos_pack24_mode_id, dos_pack24_pushed_px);
+    fflush(stdout);
+}

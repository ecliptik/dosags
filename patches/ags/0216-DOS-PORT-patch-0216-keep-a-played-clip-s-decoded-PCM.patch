+            {
+                const std::shared_ptr<const DosDecodedPcm> fresh = decode_clip(src_bytes->data(), src_bytes->size(), fmt);
+                g_pcm_verified++;
+                if (!fresh || fresh->samples != _pcm->samples || fresh->device != _pcm->device)
+                    g_pcm_verify_mismatches++;

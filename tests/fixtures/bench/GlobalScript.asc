// GlobalScript.asc -- BENCH fixture's own minimal global script.
// License: MIT. Nothing here derives from an AGS template.
//
// The only GUI is gMenu: SAVE / LOAD / CLOSE, slot 1. F5 toggles it.

function game_start()
{
  Game.NormalFont = eFontPressStart2P;
  Game.SpeechFont = eFontPressStart2P;
}

function repeatedly_execute()
{
}

function on_key_press(eKeyCode keycode)
{
  if (keycode == eKeyCtrlQ) QuitGame(0);
  if (keycode == eKeyF5) gMenu.Visible = !gMenu.Visible;
}

function on_mouse_click(MouseButton button)
{
  if (gMenu.Visible) return;
  if (button == eMouseLeft) Room.ProcessClick(mouse.x, mouse.y, mouse.Mode);
  else if (button == eMouseRight) mouse.SelectNextMode();
}

function btnSave_OnClick(GUIControl *control, MouseButton button)
{
  SaveGameSlot(1, "bench");
}

function btnLoad_OnClick(GUIControl *control, MouseButton button)
{
  if (Game.GetSaveSlotDescription(1) != null) RestoreGameSlot(1);
}

function btnClose_OnClick(GUIControl *control, MouseButton button)
{
  gMenu.Visible = false;
}

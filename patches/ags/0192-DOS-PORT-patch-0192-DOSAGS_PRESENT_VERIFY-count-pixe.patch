+namespace AGS { namespace Engine { namespace ALSW {
+extern long dos_port_pv_frames, dos_port_pv_stale_frames, dos_port_pv_stale_max, dos_port_pv_first;
+extern long long dos_port_pv_stale_px;
+extern int dos_port_pv_bbox[4];
+} } }
+#endif
+
 #if defined(__DJGPP__) && defined(DOSAGS_SPRITE_RUN_STATS)
 extern "C" {
 extern unsigned long dosags_spr_px;
@@ -100,6 +109,9 @@ extern unsigned long dosags_spr_runs;
 
 using namespace AGS::Common;
 using namespace AGS::Engine;
+#ifdef __DJGPP__
+using namespace AGS::Engine::ALSW;   // patch 0192: the presentverify counters
+#endif
 
 extern GameSetupStruct game;
 extern SpriteCache spriteset;
@@ -384,6 +396,7 @@ void quit(const char *quitmsg)
             "DOSAGS_FORCE_COLOR_DEPTH",
             "DOSAGS_MAX_SCALE",       // patch 0101: caps the render-frame scale (bake-off candidate c)
             "DOSAGS_PRESENT_NO_SKIP", // patch 0099: forces real presents -- changes every fps figure
+            "DOSAGS_PRESENT_VERIFY",  // patch 0192: reads the surface twice per present -- a diagnostic, never a timed cell
             "DOSAGS_TAS_AUTO_EXIT_TICK",
             "DOS_PORT_ENVIRONMENT",
             // patch 0099: the backend's presentation-path switches. They
@@ -662,6 +675,10 @@ void quit(const char *quitmsg)
                     extern long dos_port_gui_unchanged_tally[64];
                     extern long dos_port_gui_skip_tally[64];    // patch 0191
                     extern long dos_port_gui_flush_n, dos_port_gui_flush_late_n;
+                    if (dos_port_pv_frames)
+                        Debug::Printf("DOS-PORT presentverify frames=%ld stale_frames=%ld stale_px=%lld stale_px_max=%ld first_stale_frame=%ld bbox=%d,%d..%d,%d",
+                            dos_port_pv_frames, dos_port_pv_stale_frames, dos_port_pv_stale_px, dos_port_pv_stale_max,
+                            dos_port_pv_first, dos_port_pv_bbox[0], dos_port_pv_bbox[1], dos_port_pv_bbox[2], dos_port_pv_bbox[3]);
                     extern long dos_port_gui_flush_tally[64];
                     extern long dos_port_gui_flush_hidden_n, dos_port_gui_flush_props_n, dos_port_gui_flush_flag_n;
                     for (int _g = 0; _g < 64; ++_g)

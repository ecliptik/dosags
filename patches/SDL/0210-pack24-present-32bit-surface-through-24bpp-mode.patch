             // dosmemput path (banked window, possibly multi-bank)
             const int src_pitch = fb_state.src_pitch;
             const int dst_pitch = fb_state.vram_pitch;
diff --git a/src/video/dos/SDL_dosmodes.c b/src/video/dos/SDL_dosmodes.c
index 38070ad90..34c7d1327 100644
--- a/src/video/dos/SDL_dosmodes.c
+++ b/src/video/dos/SDL_dosmodes.c
@@ -75,6 +75,17 @@
 #define VBE_MEMMODEL_PACKED_PIXEL 4 // packed pixel (includes 8-bit indexed)
 #define VBE_MEMMODEL_DIRECT_COLOR 6 // direct color (RGB with masks)
 
+// DOS-PORT patch 0210: a 24-bpp mode whose bytes are B,G,R -- XRGB8888 minus the X byte --
+// with a linear framebuffer. Only this exact layout is packed; anything else is left alone.
+static bool DOS_ModeIsPack24Candidate(const SDL_DisplayModeData *m)
+{
+    return m->bpp == 24 && m->num_planes == 1 && m->has_lfb &&
+           m->memory_model == VBE_MEMMODEL_DIRECT_COLOR &&
+           m->red_mask_pos == 16 && m->red_mask_size == 8 &&
+           m->green_mask_pos == 8 && m->green_mask_size == 8 &&
+           m->blue_mask_pos == 0 && m->blue_mask_size == 8;
+}
+
 // VBE set-mode flag
 #define VBE_SETMODE_LFB 0x4000 // request linear framebuffer when setting mode
 
@@ -596,14 +607,16 @@ bool DOSVESA_GetDisplayModes(SDL_VideoDevice *device, SDL_VideoDisplay *sdl_disp
                 DOS_PORT_MODES_LOG("  mode 0x%04X: %4dx%-4d bpp=%-2d planes=%d "
                                    "model=%d attrs=0x%04X lfb=%d sup=%d gfx=%d color=%d "
                                    "pitch=%d pages=%d win_seg=0x%04X win_size=%uKB win_gran=%uKB win_attr=0x%02X "
-                                   "lfb_addr=0x%08lX",

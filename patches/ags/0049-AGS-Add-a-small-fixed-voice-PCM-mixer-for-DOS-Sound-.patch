+++ b/Engine/platform/dos/dos_audio_mixer.cpp
@@ -0,0 +1,289 @@
+//=============================================================================
+//
+// Adventure Game Studio (AGS)
+//
+// Copyright (C) 1999-2011 Chris Jones and 2011-2026 various contributors
+// The full list of copyright holders can be found in the Copyright.txt
+// file, which is part of this source code distribution.
+//
+// The AGS source code is provided under the Artistic License 2.0.
+// A copy of this license can be found in the file License.txt and at
+// https://opensource.org/license/artistic-2-0/
+//
+//=============================================================================
+#include "platform/dos/dos_audio_mixer.h"
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+#include <SDL3/SDL_dosaudio_devicerate.h>
+#include <SDL3/SDL_dosaudio_pump.h>
+#include "debug/out.h"
+
+using namespace AGS::Common;
+
+namespace
+{
+
+// A voice's ring is a plain append/consume byte buffer: writes append to
+// the back, reads advance read_pos and the backing vector is only
+// actually shrunk once fully drained. Every voice's bytes are already in
+// DOS_AUDIO_MIXER_FORMAT/CHANNELS/RATE by the time they arrive here --
+// sdldecoder.cpp's DOS implementation converts once at load -- so no
+// per-chunk resampling happens in this file.
+struct Voice
+{
+    bool used = false;
+    bool active = false;
+    float volume = 1.0f;
+    std::vector<uint8_t> ring;
+    size_t read_pos = 0;
+};
+
+// Cap per-voice buffering so a stalled consumer (mixer not pumped) can't
+// grow a voice's ring without bound; PutData()-equivalent callers get 0
+// back and retry next frame once this is exceeded, same all-or-nothing
+// contract the original mojoAL-backed PutData() had.
+const size_t MAX_VOICE_RING_BYTES = 32 * 1024; // ~1.48s at 11025 Hz S16 mono
+
+// Mixdown granularity and target queued depth (a top-up, not a
+// run-to-cap fill -- hub docs/audio.md's own pump convention).
+const int MIX_CHUNK_SAMPLES = 512; // ~46 ms at 11025 Hz mono
+const int MIX_CHUNK_BYTES = MIX_CHUNK_SAMPLES * static_cast<int>(sizeof(int16_t));
+const int TARGET_QUEUED_BYTES = MIX_CHUNK_BYTES * 4; // ~186 ms ahead
+const int MAX_PUMP_ITERS = 8; // defense-in-depth against a runaway top-up loop
+
+Voice g_voices[DOS_AUDIO_MIXER_MAX_VOICES];
+SDL_AudioStream *g_stream = nullptr;
+int g_underruns = 0;
+
+// A snapshot of the status string taken at dos_audio_mixer_shutdown(),
+// so RUNMANIFEST's audio_vital_status (built by quit.cpp's own manifest
+// block, well after shutdown_sound() -> sys_audio_shutdown() has already
+// torn down the device -- see Engine/media/audio/audio.cpp's own
+// shutdown_sound()) still reports the real final state instead of the
+// "never opened" NA sentinel. Left at "NA" if the device was never
+// opened at all, so that genuine case is still distinguishable.
+char g_last_status[160] = "NA";
+
+void format_status_string(char *buf, size_t bufsize)
+{
+    const int bits = static_cast<int>(SDL_AUDIO_BITSIZE(DOS_AUDIO_MIXER_FORMAT));
+    const char chan_letter = (DOS_AUDIO_MIXER_CHANNELS == 1) ? 'm' : 's';
+    std::snprintf(buf, bufsize, "pcm=sb@%d%c%d,voices=%d,underruns=%d;midi=none",
+        DOS_AUDIO_MIXER_RATE, chan_letter, bits, DOS_AUDIO_MIXER_MAX_VOICES, g_underruns);
+}
+
+} // namespace
+
+bool dos_audio_mixer_init()
+{
+    if (g_stream)
+        return true;
+
+    // Request the SB PCM device open at our exact content rate so SDL
+    // core's own 44100 quality floor doesn't insert a logical->physical
+    // resampler between us and the hardware (see
+    // SDL_dosaudio_devicerate.h's own rationale). Must be called before
+    // the device opens.
+    SDL_DOSAudioSetDeviceFrameRate(DOS_AUDIO_MIXER_RATE);
+
+    SDL_AudioSpec spec;
+    SDL_zero(spec);
+    spec.format = DOS_AUDIO_MIXER_FORMAT;
+    spec.channels = DOS_AUDIO_MIXER_CHANNELS;
+    spec.freq = DOS_AUDIO_MIXER_RATE;
+
+    g_stream = SDL_OpenAudioDeviceStream(SDL_AUDIO_DEVICE_DEFAULT_PLAYBACK, &spec, nullptr, nullptr);
+    if (!g_stream)
+    {
+        Debug::Printf(kDbgMsg_Error, "DOSAudioMixer: SDL_OpenAudioDeviceStream failed: %s", SDL_GetError());
+        return false;
+    }
+    if (!SDL_ResumeAudioStreamDevice(g_stream))
+    {
+        Debug::Printf(kDbgMsg_Error, "DOSAudioMixer: SDL_ResumeAudioStreamDevice failed: %s", SDL_GetError());
+        SDL_DestroyAudioStream(g_stream);
+        g_stream = nullptr;
+        return false;
+    }
+
+    for (auto &v : g_voices)
+        v = Voice();
+    g_underruns = 0;
+
+    Debug::Printf(kDbgMsg_Info, "DOSAudioMixer: opened %d Hz mono S16, %d voices",
+        DOS_AUDIO_MIXER_RATE, DOS_AUDIO_MIXER_MAX_VOICES);
+    return true;
+}
+
+void dos_audio_mixer_shutdown()
+{
+    if (!g_stream)
+        return;
+    format_status_string(g_last_status, sizeof(g_last_status));
+    SDL_DestroyAudioStream(g_stream);
+    g_stream = nullptr;
+    for (auto &v : g_voices)
+        v = Voice();
+}
+
+bool dos_audio_mixer_is_open()
+{
+    return g_stream != nullptr;
+}
+
+int dos_audio_mixer_voice_acquire()
+{
+    for (int i = 0; i < DOS_AUDIO_MIXER_MAX_VOICES; i++)
+    {
+        if (!g_voices[i].used)
+        {
+            g_voices[i] = Voice();
+            g_voices[i].used = true;
+            return i;
+        }
+    }
+    return -1;
+}
+
+void dos_audio_mixer_voice_release(int voice)
+{
+    if (voice < 0 || voice >= DOS_AUDIO_MIXER_MAX_VOICES)
+        return;
+    g_voices[voice] = Voice();
+}
+
+size_t dos_audio_mixer_voice_write(int voice, const void *data, size_t bytes)
+{
+    if (voice < 0 || voice >= DOS_AUDIO_MIXER_MAX_VOICES || !g_voices[voice].used)
+        return 0u;
+    if (!data || bytes == 0)
+        return 0u;
+    Voice &v = g_voices[voice];
+    const size_t buffered = v.ring.size() - v.read_pos;
+    if (buffered + bytes > MAX_VOICE_RING_BYTES)
+        return 0u; // reject the whole chunk; caller retries next frame
+    const uint8_t *bytes_in = static_cast<const uint8_t *>(data);
+    v.ring.insert(v.ring.end(), bytes_in, bytes_in + bytes);
+    return bytes;
+}
+
+size_t dos_audio_mixer_voice_queued(int voice)
+{
+    if (voice < 0 || voice >= DOS_AUDIO_MIXER_MAX_VOICES || !g_voices[voice].used)
+        return 0u;
+    const Voice &v = g_voices[voice];
+    return v.ring.size() - v.read_pos;
+}
+
+void dos_audio_mixer_voice_set_active(int voice, bool active)
+{
+    if (voice < 0 || voice >= DOS_AUDIO_MIXER_MAX_VOICES || !g_voices[voice].used)
+        return;
+    g_voices[voice].active = active;
+}
+
+void dos_audio_mixer_voice_stop(int voice)
+{
+    if (voice < 0 || voice >= DOS_AUDIO_MIXER_MAX_VOICES || !g_voices[voice].used)
+        return;
+    Voice &v = g_voices[voice];
+    v.ring.clear();
+    v.read_pos = 0;
+    v.active = false;
+}
+
+void dos_audio_mixer_voice_set_volume(int voice, float volume)
+{
+    if (voice < 0 || voice >= DOS_AUDIO_MIXER_MAX_VOICES || !g_voices[voice].used)
+        return;
+    if (volume < 0.0f) volume = 0.0f;
+    if (volume > 1.0f) volume = 1.0f;
+    g_voices[voice].volume = volume;
+}
+
+static void mix_one_chunk(bool &out_any_active)
+{
+    int32_t accum[MIX_CHUNK_SAMPLES];
+    std::memset(accum, 0, sizeof(accum));
+    bool any_active = false;
+    bool any_underrun = false;
+
+    for (auto &v : g_voices)
+    {
+        if (!v.used || !v.active)
+            continue;
+        any_active = true;
+
+        const size_t avail_bytes = v.ring.size() - v.read_pos;
+        const size_t avail_samples = avail_bytes / sizeof(int16_t);
+        const size_t take_samples = std::min<size_t>(avail_samples, static_cast<size_t>(MIX_CHUNK_SAMPLES));
+        if (take_samples == 0)
+        {
+            any_underrun = true;
+            continue;
+        }
+
+        const int16_t *src = reinterpret_cast<const int16_t *>(v.ring.data() + v.read_pos);
+        for (size_t s = 0; s < take_samples; s++)
+            accum[s] += static_cast<int32_t>(static_cast<float>(src[s]) * v.volume);
+
+        v.read_pos += take_samples * sizeof(int16_t);
+        if (v.read_pos >= v.ring.size())
+        {
+            v.ring.clear();
+            v.read_pos = 0;
+        }
+    }
+
+    out_any_active = any_active;
+    if (!any_active)
+        return;
+    if (any_underrun)
+        g_underruns++;
+
+    int16_t outbuf[MIX_CHUNK_SAMPLES];
+    for (int s = 0; s < MIX_CHUNK_SAMPLES; s++)
+    {
+        int32_t sample = accum[s];
+        if (sample > 32767) sample = 32767;
+        if (sample < -32768) sample = -32768;
+        outbuf[s] = static_cast<int16_t>(sample);
+    }
+    SDL_PutAudioStreamData(g_stream, outbuf, MIX_CHUNK_BYTES);
+}
+
+void dos_audio_mixer_pump()
+{
+    if (g_stream)
+    {
+        for (int iter = 0; iter < MAX_PUMP_ITERS; iter++)
+        {
+            if (SDL_GetAudioStreamQueued(g_stream) >= TARGET_QUEUED_BYTES)
+                break;
+            bool any_active = false;
+            mix_one_chunk(any_active);
+            if (!any_active)
+                break; // nothing playing; let the device underflow to silence
+        }
+    }
+    // Service the DOS SB ring/ISR regardless -- mandatory per frame, per
+    // the hub's own docs/audio.md convention (SDL_DOSAudioPump()).
+    SDL_DOSAudioPump();
+}
+
+int dos_audio_mixer_underrun_count()
+{
+    return g_underruns;
+}
+
+const char *dos_audio_mixer_status_string()
+{
+    if (!g_stream)
+        return g_last_status; // "NA" if never opened, else the shutdown-time snapshot
+    static char buf[160];
+    format_status_string(buf, sizeof(buf));
+    return buf;
+}

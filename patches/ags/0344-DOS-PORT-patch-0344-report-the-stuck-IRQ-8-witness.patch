From 51278a714dbe856aab2eb8d662d7556db154ff7e Mon Sep 17 00:00:00 2001
From: Micheal Waltz <micheal@ecliptik.com>
Date: Thu, 24 Sep 2026 09:43:51 -0700
Subject: [PATCH] DOS-PORT: patch 0344 -- report the stuck-IRQ-8 witness on the
 status line

SDL 0264 records the hardware state at each "stuck" repair of the RTC
pump: register C's IRQF/PF, the slave PIC's IRQ 8 in-service and
request bits, and whether a BIOS wait was active, plus the first
event's snapshot. These name the agent that silences IRQ 8 on the
486. They belong on the status line every hardware cell collects, not
only in the fsync-per-line SDL trace, which a timing cell cannot
carry. The rtc fields gain stuckw=irqf/pf/isr8/irr8/wait and
stucksnap=<C, slave IRR, slave ISR, master IRR, master ISR, reg A,
reg B, BDA wait byte> as 16 hex digits. The MIDI fragment buffer grows
to fit (512 -> 576; the status buffer is already 768).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Nz9XeKeVG8Ab7dm8esJsMu
---
 Engine/platform/dos/dos_midi_backend.cpp | 15 ++++++++++++---
 1 file changed, 12 insertions(+), 3 deletions(-)

diff --git a/Engine/platform/dos/dos_midi_backend.cpp b/Engine/platform/dos/dos_midi_backend.cpp
index 7c807e5ce..5bfaadefe 100644
--- a/Engine/platform/dos/dos_midi_backend.cpp
+++ b/Engine/platform/dos/dos_midi_backend.cpp
@@ -488,7 +488,7 @@ void dos_midi_backend_status_fragment(char *buf, size_t bufsize)
         // DOS-PORT (patch 0341): the RTC pump's own fields (rate, byte gap,
         // ticks, BIOS INT 15h/86h waits it serviced, longest release-to-write
         // in us) and clk_uc= (song ms / uclock ms since the first plan).
-        char rtc[192] = ""; // DOS-PORT (patch 0343): was 144 (0342), 112 (0341)
+        char rtc[256] = ""; // DOS-PORT (patch 0344): was 192 (0343), 144 (0342), 112 (0341)
         if (g_defer_kind == 3)
         {
             Uint32 hz = 0, gap = 0, ticks = 0, waits = 0, lat = 0;
@@ -501,10 +501,19 @@ void dos_midi_backend_status_fragment(char *buf, size_t bufsize)
             // PIE found off / rate bits changed / IRQ 8 or cascade masked / no tick.
             Uint32 rp = 0, rr = 0, rm = 0, rst = 0;
             SDL_DOSMidiDeferRtcRearms(&rp, &rr, &rm, &rst);
+            // DOS-PORT (patch 0344): what the hardware looked like at the "stuck" repairs (SDL
+            // 0264): per-event counts irqf/pf/isr8/irr8/wait and the first event's snapshot
+            // (C, slave IRR, slave ISR, master IRR, master ISR, reg A, reg B, BDA 0040:00A0).
+            Uint32 sw[5] = {0, 0, 0, 0, 0};
+            Uint8 ss[8] = {0, 0, 0, 0, 0, 0, 0, 0};
+            SDL_DOSMidiDeferRtcStuckWitness(sw, ss);
             std::snprintf(rtc, sizeof(rtc), ",rtc_hz=%u,gap_us=%u,rtc_ticks=%u,bios_waits=%u,lat_max_us=%u,rs=%s,rs_skipped=%u,"
-                "rearm=%u/%u/%u/%u",
+                "rearm=%u/%u/%u/%u,stuckw=%u/%u/%u/%u/%u,stucksnap=%02x%02x%02x%02x%02x%02x%02x%02x",
                 (unsigned)hz, (unsigned)gap, (unsigned)ticks, (unsigned)waits, (unsigned)lat, rs_on ? "on" : "off",
-                (unsigned)rs_skipped, (unsigned)rp, (unsigned)rr, (unsigned)rm, (unsigned)rst);
+                (unsigned)rs_skipped, (unsigned)rp, (unsigned)rr, (unsigned)rm, (unsigned)rst,
+                (unsigned)sw[0], (unsigned)sw[1], (unsigned)sw[2], (unsigned)sw[3], (unsigned)sw[4],
+                (unsigned)ss[0], (unsigned)ss[1], (unsigned)ss[2], (unsigned)ss[3], (unsigned)ss[4],
+                (unsigned)ss[5], (unsigned)ss[6], (unsigned)ss[7]);
         }
         // DOS-PORT patch 0330: SDL 0250's per-IRQ budget, the IRQs it bound,
         // and the drain's own time (us, the SB ISR's timer); per-write in ns

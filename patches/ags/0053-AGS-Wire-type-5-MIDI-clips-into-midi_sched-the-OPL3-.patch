+                 // section); upstream itself never implemented MIDI seek
+                 // either (soundclip.cpp's own pos_to_posms() TODO).
+
     switch (_playState)
     {
     case PlayStateInitial:
@@ -141,5 +326,41 @@ void AudioPlayer::Seek(float pos_ms)
     }
 }
 

+#ifdef __DJGPP__
+// DOS-PORT patch 0093 (40/40 plan, P0 items 2+3): "fix the yardstick".
+//
+// tick_rate (quit.cpp) is LoopCounter / get_runtime_ms(), and
+// get_runtime_ms()'s anchor is set_runtime_start() in start_game()
+// (main/game_start.cpp) -- AFTER engine init, BEFORE the game_start
+// script and load_new_room(). So a whole-run tick_rate silently folds in
+// (a) the first room's load, which happens before any tick, and (b) any
+// one-time stall inside a tick -- on Trilby's Notes, tick 1's blocking
+// room fade-in (~2.6 s) alone drags a ~38.8 ticks/s run down to 33.78.
+// This reports a steady-state figure with those identified and listed
+// SEPARATELY rather than hidden: nothing is dropped from the log, every
+// component of the arithmetic is printed so it can be re-derived.
+//
+// A "tick" here is one UpdateGameOnce() call. Durations are EXCLUSIVE
+// (self) time: a blocking script call (Wait(), a blocking Walk, Display)
+// re-enters UpdateGameOnce() from inside the tick that started it, and an
+// inclusive measure would report that whole blocking span as one giant
+// "stall" on top of the nested ticks it already counted. Classic
+// exclusive-time accounting: each scope hands its own total up to its
+// parent, and subtracts what its children handed it.
+#define DOS_TICK_STALL_THRESHOLD_US 250000LL
+#define DOS_TICK_STALL_CAP 32
+struct DosTickStall { uint32_t tick_index; long ms; };
+static DosTickStall dos_tick_stalls[DOS_TICK_STALL_CAP];
+static long dos_tick_stall_total = 0;      // every stall, including any beyond the cap
+static long long dos_tick_stall_us = 0;    // summed self-time of stall ticks
+static long dos_tick_count = 0;
+static long long dos_tick_children_us = 0; // exclusive-time accounting (see above)
+static uclock_t dos_tick_first_entry = 0;
+static uclock_t dos_tick_last_exit = 0;
+static bool dos_tick_have_first = false;
+static uint32_t dos_tick_preloop_ms = 0;   // get_runtime_ms() at the first tick's entry
+
+class DosTickStallScope
+{
+public:
+    DosTickStallScope()
+        : _t0(uclock()), _saved_children(dos_tick_children_us), _index(GameTimer.LoopCounter + 1)
+    {
+        if (!dos_tick_have_first)
+        {
+            dos_tick_have_first = true;
+            dos_tick_first_entry = _t0;
+            dos_tick_preloop_ms = GameTimer.RuntimeStarted ? get_runtime_ms() : 0;
+        }
+        dos_tick_children_us = 0;
+    }
+    ~DosTickStallScope()
+    {
+        const uclock_t t1 = uclock();
+        long long total_us = (long long)(t1 - _t0) * 1000000LL / UCLOCKS_PER_SEC;
+        if (total_us < 0) total_us = 0; // uclock() non-monotonicity, see dos_port_tick_record()
+        long long self_us = total_us - dos_tick_children_us;
+        if (self_us < 0) self_us = 0;
+        dos_tick_children_us = _saved_children + total_us;
+        dos_tick_last_exit = t1;
+        dos_tick_count++;
+        if (self_us > DOS_TICK_STALL_THRESHOLD_US)
+        {
+            if (dos_tick_stall_total < DOS_TICK_STALL_CAP)
+            {
+                dos_tick_stalls[dos_tick_stall_total].tick_index = _index;
+                dos_tick_stalls[dos_tick_stall_total].ms = (long)(self_us / 1000);
+            }
+            dos_tick_stall_total++;
+            dos_tick_stall_us += self_us;
+        }
+    }
+private:
+    uclock_t _t0;
+    long long _saved_children;
+    uint32_t _index;
+};
+
+// Per-real-second cumulative series, so real-vs-skipped presents can be
+// attributed to a PHASE of a run (the AGS Quest AutoPilot logs its own
+// phases against the same tick counter) rather than only to the run as a
+// whole. Cumulative, not per-interval: a consumer diffs adjacent rows.
+#define DOS_PERSEC_CAP 1024
+struct DosPerSec { uint32_t tick; uint32_t renders; long real; long skipped; };
+static DosPerSec dos_persec[DOS_PERSEC_CAP];
+static int dos_persec_count = 0;
+
+static void dos_persec_sample()
+{
+    if (dos_persec_count >= DOS_PERSEC_CAP)
+        return;
+    DosPerSec &r = dos_persec[dos_persec_count++];
+    r.tick = GameTimer.LoopCounter;
+    r.renders = GameTimer.RenderCounter;
+    r.real = dos_port_tick_timing.presents_real;
+    r.skipped = dos_port_tick_timing.presents_skipped;
+}
+
+void dos_port_yardstick_emit(FILE *log)
+{
+    // What fps_p50/fps_p95 actually counted, stated next to them.
+    fprintf(log, "DOS-PORT fps_basis counts=render_passes render_passes=%lu presents_real=%ld presents_skipped=%ld\n",
+        (unsigned long)GameTimer.RenderCounter,
+        dos_port_tick_timing.presents_real, dos_port_tick_timing.presents_skipped);
+    fprintf(log, "DOS-PORT blit_path fast=%ld generic=%ld src_bytes_per_pixel=%d\n",
+        dos_port_tick_timing.blits_fast, dos_port_tick_timing.blits_generic,
+        dos_port_tick_timing.blit_src_bytes_per_pixel);
+
+    const long long loop_us = dos_tick_have_first
+        ? (long long)(dos_tick_last_exit - dos_tick_first_entry) * 1000000LL / UCLOCKS_PER_SEC : 0;
+    const long long steady_us = loop_us - dos_tick_stall_us;
+    const long steady_ticks = dos_tick_count - dos_tick_stall_total;
+    const double steady_rate = steady_us > 0 ? 1000000.0 * (double)steady_ticks / (double)steady_us : 0.0;
+    fprintf(log, "DOS-PORT tick_rate_steady=%.2f ticks=%ld stall_ticks=%ld loop_ms=%ld stall_ms=%ld preloop_ms=%lu threshold_ms=%ld\n",
+        steady_rate, dos_tick_count, dos_tick_stall_total,
+        (long)(loop_us / 1000), (long)(dos_tick_stall_us / 1000),
+        (unsigned long)dos_tick_preloop_ms, (long)(DOS_TICK_STALL_THRESHOLD_US / 1000));
+    const long listed = dos_tick_stall_total < DOS_TICK_STALL_CAP ? dos_tick_stall_total : DOS_TICK_STALL_CAP;
+    for (long i = 0; i < listed; i++)
+        fprintf(log, "DOS-PORT tick_stall index=%lu ms=%ld\n",
+            (unsigned long)dos_tick_stalls[i].tick_index, dos_tick_stalls[i].ms);
+    if (dos_tick_stall_total > DOS_TICK_STALL_CAP)
+        fprintf(log, "DOS-PORT tick_stall_overflow unlisted=%ld\n", dos_tick_stall_total - DOS_TICK_STALL_CAP);
+
+    for (int i = 0; i < dos_persec_count; i++)
+        fprintf(log, "DOS-PORT persec t=%d tick=%lu renders=%lu real=%ld skipped=%ld\n",
+            i + 1, (unsigned long)dos_persec[i].tick, (unsigned long)dos_persec[i].renders,
+            dos_persec[i].real, dos_persec[i].skipped);
+}
+#endif // __DJGPP__
+

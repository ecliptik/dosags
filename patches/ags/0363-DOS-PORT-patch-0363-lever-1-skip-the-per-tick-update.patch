+#ifdef __DJGPP__
+// DOS-PORT patch 0363 lever 1. For a character in another room that is not turning and not following,
+// UpdateCharacterMoveAndAnim (characterinfo_engine.cpp) does nothing but FixupCharacterLoopAndFrame and
+// `process_idle_this_time = 0`: Moving, Animating and Idle all require the displayed room, Follower requires
+// following >= 0, Turning requires walking >= TURNING_AROUND. Fixup changes nothing (and cannot quit) when the
+// (view, loop, frame) it last saw were in range with a non-empty loop and are unchanged -- views are static data.
+// So such a character is skipped with only the store left. dos_char_valid caches the last full update's
+// (view, loop, frame) when in range, -1 otherwise.
+static std::vector<int> dos_char_valid; // 3 ints per character: view, loop, frame
+static inline void dos_char_record(int aa, const CharacterInfo *chi)
+{
+    int *v = &dos_char_valid[aa * 3];
+    const int view = chi->view, loop = chi->loop, frame = chi->frame;
+    if (view >= 0 && static_cast<size_t>(view) < views.size() && loop >= 0 && loop < views[view].numLoops &&
+        views[view].loops[loop].numFrames > 0 && frame >= 0 && frame < views[view].loops[loop].numFrames)
+    { v[0] = view; v[1] = loop; v[2] = frame; }
+    else
+        v[0] = -1;
+}
+static inline bool dos_char_skippable(int aa, const CharacterInfo *chi, const CharacterExtras *chex)
+{
+    const int *v = &dos_char_valid[aa * 3];
+    return chi->room != displayed_room && chi->walking < TURNING_AROUND && chex->following < 0 &&
+        v[0] >= 0 && v[0] == chi->view && v[1] == chi->loop && v[2] == chi->frame;
+}
+#endif
+
 void update_character_move_and_anim(std::vector<int> &followingAsSheep)
 {
+#ifdef __DJGPP__
+  if (dos_englev_on && dos_char_valid.size() != static_cast<size_t>(game.numcharacters) * 3)
+    dos_char_valid.assign(static_cast<size_t>(game.numcharacters) * 3, -1);
+#endif
 	// move & animate characters
   for (int aa=0;aa<game.numcharacters;aa++) {
     if (game.chars[aa].on != 1) continue;
@@ -314,6 +348,44 @@ void update_character_move_and_anim(std::vector<int> &followingAsSheep)
     CharacterInfo*chi    = &game.chars[aa];
 	CharacterExtras*chex = &charextra[aa];
 
+#ifdef __DJGPP__
+    if (dos_englev_on)
+    {
+      if (dos_char_skippable(aa, chi, chex))
+      {
+#ifdef DOSAGS_VMTRACE
+        ++dos_el_skip;
+        if (dos_englev_shadow())
+        {
+          // the full update must leave everything as the skip does: the structs unchanged but for the store,
+          // no RNG draw, no follower queued
+          ++dos_el_check;
+          static uint8_t ci0[sizeof(CharacterInfo)], ce0[sizeof(CharacterExtras)];
+          memcpy(ci0, chi, sizeof(CharacterInfo));
+          memcpy(ce0, chex, sizeof(CharacterExtras));
+          reinterpret_cast<CharacterExtras*>(ce0)->process_idle_this_time = 0;
+          const unsigned long rand0 = dos_rand_calls;
+          const size_t sheep0 = followingAsSheep.size();
+          UpdateCharacterMoveAndAnim(chi, chex, followingAsSheep);
+          if (memcmp(ci0, chi, sizeof(CharacterInfo)) || memcmp(ce0, chex, sizeof(CharacterExtras)) ||
+              rand0 != dos_rand_calls || sheep0 != followingAsSheep.size())
+          {
+            if (dos_el_bad < 10)
+              AGS::Common::Debug::Printf("DOS-PORT charskip MISMATCH char=%d room=%d", aa, chi->room);
+            ++dos_el_bad;
+          }
+          dos_char_record(aa, chi);
+          continue;
+        }
+#endif
+        chex->process_idle_this_time = 0;
+        continue;
+      }
+      UpdateCharacterMoveAndAnim(chi, chex, followingAsSheep);
+      dos_char_record(aa, chi);
+      continue;
+    }
+#endif
 	UpdateCharacterMoveAndAnim(chi, chex, followingAsSheep);
   }
 }

+    {
+        const int want = FindGUIIDScan(dp_q[i]);
+        if (FindGUIID(dp_q[i]) != want) mismatches++;
+        if (FindGUIID(dp_q[i]) != want) mismatches++; // immediately again: a cache hit
+        queries += 2;
+    }
+    Debug::Printf("DOS-PORT fgiselftest phase=%s tick=%lu numgui=%d distinct_queries=%d cache_entries=%ld hits=%ld queries=%ld mismatches=%ld",
+        phase, tick, game.numgui, dp_nq, entries, dp_fgi_hit_count - h0, queries, mismatches);
+}

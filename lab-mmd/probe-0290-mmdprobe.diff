+#ifdef __DJGPP__
+// ---------------------------------------------------------------------------
+// DOS-PORT probe 0290 (LAB ONLY): dispatch / event / room-segment side.
+// See main/dos_port_mmdprobe.h and LAB-MMD.md 2.2.
+// ---------------------------------------------------------------------------
+#include <string.h>
+#include "debug/out.h"
+#include "main/dos_port_mmdprobe.h"
+int dp_mmd_in_dispatch = 0;
+DpMmdSeg dp_mmd_seg;
+static bool dp_mmd_seg_valid = false;
+static unsigned dp_mmd_cur_evmask = 0;
+static int dp_mmd_cur_events = 0;
+extern long dp_mmd_uclock_ns;
+void dp_mmd_reset_tables();
+
+static void dp_mmd_seg_start()
+{
+    memset(&dp_mmd_seg, 0, sizeof(dp_mmd_seg));
+    DpMmdSeg &g = dp_mmd_seg;
+    const DosPortTickTiming &t = dos_port_tick_timing;
+    g.room = displayed_room;
+    g.tick0 = get_loop_counter();
+    g.t0 = dp_mmd_clock();
+    g.s_ugo = t.update_game_once_total.total_us; g.s_ugo_n = t.update_game_once_total.calls;
+    g.s_ped = t.process_events_dispatch.total_us;
+    g.s_svm = t.script_vm.total_us;
+    g.s_guip = t.gui_poll.total_us;
+    g.s_guic = t.gui_context_cursor.total_us;
+    g.s_rts = t.render_to_screen.total_us; g.s_rts_n = t.render_to_screen.calls;
+    g.s_rtspt_n = t.render_to_screen_pertick.calls;
+    g.s_rb = t.render_backbuffer.total_us;
+    g.s_rew = t.rep_exec_wrapper.total_us;
+    g.s_scene = t.scene_construct.total_us;
+    g.s_pres = t.present_update_window.total_us;
+    dp_mmd_reset_tables();
+    dp_mmd_seg_valid = true;
+}
+
+static const char *DP_EVN[6] = { "none", "script", "object", "fadein", "gui", "newroom" };
+static const char *DP_OBN[8] = { "none", "room", "hotspot", "region", "sub4", "sub5", "sub6", "sub7" };
+
+void dp_mmd_dump(const char *why)
+{
+    if (!dp_mmd_seg_valid) return;
+    const DpMmdSeg &g = dp_mmd_seg;
+    const DosPortTickTiming &t = dos_port_tick_timing;
+    const int room = g.room;
+    const uint32_t ticks = get_loop_counter() - g.tick0;
+    Debug::Printf("DOS-PORT mmdprobe seg room=%d why=%s ticks=%lu wall_ms=%ld ugo_n=%ld ugo_us=%lld dispatch_us=%lld script_vm_us=%lld gui_poll_us=%lld gui_ctx_us=%lld rts_n=%ld rts_pertick_n=%ld rts_us=%lld rb_us=%lld repexec_wrapper_us=%lld scene_us=%lld present_us=%lld",
+        room, why, (unsigned long)ticks, (long)(dp_mmd_us(g.t0, uclock()) / 1000),
+        t.update_game_once_total.calls - g.s_ugo_n,
+        t.update_game_once_total.total_us - g.s_ugo,
+        t.process_events_dispatch.total_us - g.s_ped,
+        t.script_vm.total_us - g.s_svm,
+        t.gui_poll.total_us - g.s_guip,
+        t.gui_context_cursor.total_us - g.s_guic,
+        t.render_to_screen.calls - g.s_rts_n,
+        t.render_to_screen_pertick.calls - g.s_rtspt_n,
+        t.render_to_screen.total_us - g.s_rts,
+        t.render_backbuffer.total_us - g.s_rb,
+        t.rep_exec_wrapper.total_us - g.s_rew,
+        t.scene_construct.total_us - g.s_scene,
+        t.present_update_window.total_us - g.s_pres);
+    Debug::Printf("DOS-PORT mmdprobe dispatch room=%d n=%ld us=%lld max_us=%lld nested_n=%ld nested_us=%lld maxdepth=%d rts_n=%ld rts_us=%lld insns=%lld api_n=%ld api_us=%lld",
+        room, g.d_n, g.d_us, g.d_max, g.d_nested_n, g.d_nested_us, g.d_maxdepth,
+        g.d_rts_n, g.d_rts_us, g.d_insns, g.d_api_n, g.d_api_us);
+    for (int i = 0; i < 3; ++i)
+    {
+        const DpMmdTop &x = g.top[i];
+        if (x.us <= 0) continue;
+        Debug::Printf("DOS-PORT mmdprobe dtop room=%d rank=%d tick=%lu us=%lld nested_n=%ld nested_us=%lld rts_n=%ld rts_us=%lld insns=%lu evmask=0x%x events=%d",
+            room, i + 1, (unsigned long)x.tick, x.us, x.nested_n, x.nested_us, x.rts_n, x.rts_us,
+            (unsigned long)x.insns, x.evmask, x.events);
+    }
+    for (int i = 0; i < 6; ++i)
+        if (g.e_n[i])
+            Debug::Printf("DOS-PORT mmdprobe evtype room=%d type=%s n=%ld us=%lld insns=%lld api_us=%lld nested_us=%lld",
+                room, DP_EVN[i], g.e_n[i], g.e_us[i], g.e_insns[i], g.e_api_us[i], g.e_nested_us[i]);
+    for (int i = 0; i < 8; ++i)
+        if (g.o_n[i])
+            Debug::Printf("DOS-PORT mmdprobe evobj room=%d sub=%s n=%ld us=%lld insns=%lld api_us=%lld",
+                room, DP_OBN[i], g.o_n[i], g.o_us[i], g.o_insns[i], g.o_api_us[i]);
+    // entries, by inclusive us
+    {
+        bool used[DP_MMD_FN_CAP]; memset(used, 0, sizeof(used));
+        for (;;)
+        {
+            int best = -1;
+            for (int i = 0; i < dp_mmd_nfns; ++i)
+                if (!used[i] && dp_mmd_fns[i].entry_calls > 0 &&
+                    (best < 0 || dp_mmd_fns[i].entry_us > dp_mmd_fns[best].entry_us)) best = i;
+            if (best < 0) break;
+            used[best] = true;
+            const DpMmdFn &f = dp_mmd_fns[best];
+            long long self = f.entry_us - f.entry_api_us - f.entry_nested_us;
+            Debug::Printf("DOS-PORT mmdprobe entry room=%d name=%s calls=%ld us=%lld self_us=%lld insns=%lld api_n=%ld api_us=%lld nested_n=%ld nested_us=%lld max_us=%lld",
+                room, f.name, f.entry_calls, f.entry_us, self, f.entry_insns, f.entry_api_n,
+                f.entry_api_us, f.entry_nested_n, f.entry_nested_us, f.entry_max_us);
+        }
+    }
+    // functions, by exclusive instructions (top 40)
+    {
+        bool used[DP_MMD_FN_CAP]; memset(used, 0, sizeof(used));
+        for (int k = 0; k < 40; ++k)
+        {
+            int best = -1;
+            for (int i = 0; i < dp_mmd_nfns; ++i)
+                if (!used[i] && (dp_mmd_fns[i].insns > 0 || dp_mmd_fns[i].api_n > 0) &&
+                    (best < 0 || dp_mmd_fns[i].insns + dp_mmd_fns[i].api_us > dp_mmd_fns[best].insns + dp_mmd_fns[best].api_us)) best = i;
+            if (best < 0) break;
+            used[best] = true;
+            const DpMmdFn &f = dp_mmd_fns[best];
+            Debug::Printf("DOS-PORT mmdprobe fn room=%d name=%s line=%d calls=%ld insns=%lld api_n=%ld api_us=%lld",
+                room, f.name, f.first_line, f.calls, f.insns, f.api_n, f.api_us);
+        }
+    }
+    // engine APIs, by us (top 40) and the total
+    {
+        long long tot_us = 0; long tot_n = 0;
+        for (int i = 0; i < dp_mmd_napis; ++i) { tot_us += dp_mmd_apis[i].us; tot_n += dp_mmd_apis[i].n; }
+        Debug::Printf("DOS-PORT mmdprobe apitotal room=%d distinct=%d n=%ld us=%lld", room, dp_mmd_napis - 1, tot_n, tot_us);
+        bool used[DP_MMD_API_CAP]; memset(used, 0, sizeof(used));
+        for (int k = 0; k < 40; ++k)
+        {
+            int best = -1;
+            for (int i = 0; i < dp_mmd_napis; ++i)
+                if (!used[i] && dp_mmd_apis[i].n > 0 &&
+                    (best < 0 || dp_mmd_apis[i].us > dp_mmd_apis[best].us ||
+                     (dp_mmd_apis[i].us == dp_mmd_apis[best].us && dp_mmd_apis[i].n > dp_mmd_apis[best].n))) best = i;
+            if (best < 0) break;
+            used[best] = true;
+            const DpMmdApi &a = dp_mmd_apis[best];
+            Debug::Printf("DOS-PORT mmdprobe api room=%d name=%s n=%ld us=%lld max_us=%lld nested_calls=%ld",
+                room, a.name, a.n, a.us, a.max_us, a.nested_n);
+        }
+    }
+    extern long dp_mmd_pair_ns;
+    Debug::Printf("DOS-PORT mmdprobe cost room=%d uclock_reads=%ld uclock_ns=%ld pair_ns=%ld apitime=%d insns_total=%lu",
+        room, dp_mmd_uclock_reads, dp_mmd_uclock_ns, dp_mmd_pair_ns, dp_mmd_api_time, (unsigned long)dp_mmd_insns);
+}
+
+void dp_mmd_seg_check()
+{
+    if (dp_mmd_seg_valid && displayed_room == dp_mmd_seg.room) return;
+    // only reset when no script frame is live (table indices are on the stacks)
+    if (dp_mmd_fn_sp != 0 || dp_mmd_entry_sp != 0) return;
+    if (!dp_mmd_seg_valid) { dp_mmd_seg_start(); return; }
+    dp_mmd_dump("roomchange");
+    dp_mmd_seg_start();
+}
+
+struct DpMmdDispatchScope
+{
+    bool active; uclock_t t0; long long n0; long nn0; long rn0; long long ru0;
+    uint32_t i0; long long a0; long an0;
+    DpMmdDispatchScope() : active(false), t0(0), n0(0), nn0(0), rn0(0), ru0(0), i0(0), a0(0), an0(0)
+    {
+        if (dp_mmd_in_dispatch == 0)
+        {
+            dp_mmd_seg_check();
+            active = true;
+            dp_mmd_cur_evmask = 0; dp_mmd_cur_events = 0;
+            dp_mmd_dispatch_maxdepth = 0;
+            n0 = dos_tick_nested_us; nn0 = dos_tick_nested_n;
+            rn0 = dos_port_tick_timing.render_to_screen.calls;
+            ru0 = dos_port_tick_timing.render_to_screen.total_us;
+            i0 = dp_mmd_insns; a0 = dp_mmd_api_us_total; an0 = dp_mmd_api_n_total;
+            t0 = dp_mmd_clock();
+        }
+        dp_mmd_in_dispatch++;
+    }
+    ~DpMmdDispatchScope()
+    {
+        dp_mmd_in_dispatch--;
+        if (!active) return;
+        const long long us = dp_mmd_us(t0, dp_mmd_clock());
+        DpMmdSeg &g = dp_mmd_seg;
+        g.d_n++; g.d_us += us; if (us > g.d_max) g.d_max = us;
+        const long long nus = dos_tick_nested_us - n0; const long nn = dos_tick_nested_n - nn0;
+        const long rn = dos_port_tick_timing.render_to_screen.calls - rn0;
+        const long long ru = dos_port_tick_timing.render_to_screen.total_us - ru0;
+        const uint32_t ins = dp_mmd_insns - i0;
+        g.d_nested_us += nus; g.d_nested_n += nn;
+        if (dp_mmd_dispatch_maxdepth > g.d_maxdepth) g.d_maxdepth = dp_mmd_dispatch_maxdepth;
+        g.d_rts_n += rn; g.d_rts_us += ru; g.d_insns += ins;
+        g.d_api_us += dp_mmd_api_us_total - a0; g.d_api_n += dp_mmd_api_n_total - an0;
+        // keep the three longest dispatches of the segment
+        for (int i = 0; i < 3; ++i)
+        {
+            if (us > g.top[i].us)
+            {
+                for (int j = 2; j > i; --j) g.top[j] = g.top[j - 1];
+                DpMmdTop &x = g.top[i];
+                x.us = us; x.tick = get_loop_counter(); x.nested_us = nus; x.nested_n = nn;
+                x.rts_n = rn; x.rts_us = ru; x.insns = ins;
+                x.evmask = dp_mmd_cur_evmask; x.events = dp_mmd_cur_events;
+                break;
+            }
+        }
+    }
+};
+
+struct DpMmdEventScope
+{
+    int type, sub; uclock_t t0; uint32_t i0; long long a0, n0;
+    DpMmdEventScope(int ty, int sb) : type(ty), sub(sb)
+    {
+        if (ty >= 0 && ty < 6) dp_mmd_cur_evmask |= (1u << ty);
+        if (sb >= 0 && sb < 8) dp_mmd_cur_evmask |= (1u << (8 + sb));
+        dp_mmd_cur_events++;
+        i0 = dp_mmd_insns; a0 = dp_mmd_api_us_total; n0 = dos_tick_nested_us;
+        t0 = dp_mmd_clock();
+    }
+    ~DpMmdEventScope()
+    {
+        const long long us = dp_mmd_us(t0, dp_mmd_clock());
+        const long long ins = (uint32_t)(dp_mmd_insns - i0);
+        const long long au = dp_mmd_api_us_total - a0;
+        DpMmdSeg &g = dp_mmd_seg;
+        if (type >= 0 && type < 6)
+        { g.e_n[type]++; g.e_us[type] += us; g.e_insns[type] += ins; g.e_api_us[type] += au;
+          g.e_nested_us[type] += dos_tick_nested_us - n0; }
+        if (sub >= 0 && sub < 8)
+        { g.o_n[sub]++; g.o_us[sub] += us; g.o_insns[sub] += ins; g.o_api_us[sub] += au; }
+    }
+};
+#endif

 #include <cstdio>
 #include <cstdlib> // std::getenv -- DOS-PORT (S7) DOSAGS_MIDI_SILENT_CHIP
 #include <time.h> // uclock(), UCLOCKS_PER_SEC -- DOS-PORT (S4) MIDI wall clock
@@ -194,6 +195,46 @@ void AudioPlayer::Poll()
     }
 }
 
+// TEMPORARY DIAGNOSTIC (S7-GUS, continuation): brackets the midi_sched_
+// tick() call below, not the function itself (shared/audio/midi_sched.c,
+// consumed by every port via the hub subtree/submodule -- a temporary,
+// dosags-specific investigation has no business touching every port's
+// shared code when the exact same measurement is available by timing this
+// one call site instead, which is entirely this port's own file). Real
+// hardware (tags GUST1/GUSD1) found the MIDI slot Poll() loop's own
+// slots_us at a ~6.89s max, ONE single call, nearly identical across two
+// independent runs -- this is that call (AudioPlayer::Poll() ->
+// AudioPlayer::MidiPoll(), called once per real tick from audio_core_
+// entry_poll()'s slot loop, which is exactly what slots_us times). Every
+// individual SDL_DOSGus* voice call gus_sink.c's sink_note_on/note_off/
+// reap_finished_voices/sink_on_tick makes is separately bracketed too
+// (SDL patch SDL/0146) -- this outer bracket lets the real-hardware run
+// confirm whether their sum accounts for the whole outlier, or whether a
+// residual remains (pointing at something else inside midi_sched_tick()
+// itself: the delta_ms>10000 catch-up clamp, the dispatch for(;;) loop,
+// or SDL_DOSGusAllocVoice(), none of which are separately instrumented).
+// Same in-memory accumulate-and-snapshot idiom as every other diagnostic
+// in this investigation. patches/ags/0071 (audio_core.cpp) is the
+// consumer. Temporary -- revert once this sub-investigation concludes.
+static uint32_t s_miditick_calls = 0;
+static uint64_t s_miditick_sum_us = 0;
+static uint64_t s_miditick_min_us = UINT64_MAX;
+static uint64_t s_miditick_max_us = 0;
+
+extern "C" void DOSAGS_MidiTickDiagSnapshot(
+    uint32_t *out_calls, uint32_t *out_min_us, uint32_t *out_mean_us, uint32_t *out_max_us)
+{
+    if (out_calls)  *out_calls  = s_miditick_calls;
+    if (out_min_us) *out_min_us = (uint32_t)((s_miditick_calls > 0) ? s_miditick_min_us : 0);
+    if (out_mean_us) *out_mean_us = (uint32_t)((s_miditick_calls > 0) ? (s_miditick_sum_us / s_miditick_calls) : 0);
+    if (out_max_us) *out_max_us = (uint32_t)s_miditick_max_us;
+
+    s_miditick_calls = 0;
+    s_miditick_sum_us = 0;
+    s_miditick_min_us = UINT64_MAX;
+    s_miditick_max_us = 0;
+}
+
 void AudioPlayer::MidiPoll()
 {
     if (_playState == PlaybackState::PlayStateInitial)
@@ -203,7 +244,15 @@ void AudioPlayer::MidiPoll()
     if (!_midiSched || !_midiSink)
         return;
 
-    midi_sched_tick(_midiSched, MidiNowMs());
+    {
+        const uclock_t t0 = uclock(); /* TEMPORARY DIAGNOSTIC, see above */
+        midi_sched_tick(_midiSched, MidiNowMs());
+        const uint64_t call_us = (uint64_t)((uclock() - t0) * 1000000ULL / UCLOCKS_PER_SEC);
+        s_miditick_calls++;
+        s_miditick_sum_us += call_us;
+        if (call_us < s_miditick_min_us) s_miditick_min_us = call_us;
+        if (call_us > s_miditick_max_us) s_miditick_max_us = call_us;
+    }
 
     const uint64_t total = midi_sched_dispatched(_midiSched);
     if (total > _midiLastDispatched)

+// mode 0: a dispatch at pc; 1: an instruction run by the stepper; >= 16: a constituent of superinstruction group mode-16
+void ccInstance::DosVmTraceFold(const ccInstance *ci, int32_t pc, int32_t mode) const
+{
+    if (!dos_l1_inwin()) return;
+    l1b_alloc();
+    const int b = l1b_bucket();
+    uint32_t g = 0;
+    const int ix = l1b_pctab(ci);
+    L1bPc &t = s_l1b_pct[ix];
+    if (pc < 0 || static_cast<uint32_t>(pc) >= t.codesize) return;
+    if (mode == 0)
+    {
+        const int h = l1b_hidx(reinterpret_cast<const void *>(ci->_scriptData->dcode[pc]));
+        s_l1b_unit[b * (kVmH_Count + 2) + h]++;
+        if (h >= kVmH_SFarCall && h < kVmH_Count) s_l1b_attempt[h]++;
+    }
+    else if (mode == 1)
+        s_l1b_unit[b * (kVmH_Count + 2) + kVmH_Count]++;
+    else
+        g = static_cast<uint32_t>(mode - 16);
+    const intptr_t *code = ci->_code;
+    const int op = static_cast<int>(code[pc] & INSTANCE_ID_REMOVEMASK);
+    if (op < 0 || op >= CC_NUM_SCCMDS) return;
+    const int argc = s_argc[op];
+    const int m = s_regmask[op];
+    uint32_t form = static_cast<uint32_t>(op);
+    if (argc >= 1 && (m & 1)) form |= static_cast<uint32_t>((code[pc + 1] & 7) + 1) << 7;
+    if (argc >= 2 && (m & 2)) form |= static_cast<uint32_t>((code[pc + 2] & 7) + 1) << 11;
+    s_l1b_op[b * CC_NUM_SCCMDS + op]++;
+    if (s_l1b_actn > 0) s_l1b_act[s_l1b_actn - 1].ops++;
+    if (t.n[pc]++ == 0)
+    {
+        char buf[256];
+        int k = snprintf(buf, sizeof(buf), "%d %d", op, argc);
+        for (int j = 0; j < argc && k < 200; ++j)
+        {
+            const intptr_t w = code[pc + 1 + j];
+            const int fx = ci->_code_fixups ? ci->_code_fixups[pc + 1 + j] : 0;
+            if (fx == FIXUP_GLOBALDATA)
+                k += snprintf(buf + k, sizeof(buf) - k, " g:%d", static_cast<int>(reinterpret_cast<const ScriptVariable *>(w)->ScAddress));
+            else if (fx == FIXUP_IMPORT)
+            {
+                const ScriptImport *imp = simp.GetByIndex(static_cast<uint32_t>(w));
+                k += snprintf(buf + k, sizeof(buf) - k, " i:%s", imp ? imp->Name.GetCStr() : "?");
+            }
+            else if (fx == FIXUP_STRING)
+            {
+                char sb[28]; int q = 0;
+                const char *str = ci->_strings + w;
+                for (; q < 24 && str[q]; ++q) sb[q] = (str[q] > 32 && str[q] < 127) ? str[q] : '_';
+                sb[q] = 0;
+                k += snprintf(buf + k, sizeof(buf) - k, " s:\"%s\"", sb);
+            }
+            else if (fx == FIXUP_FUNCTION) k += snprintf(buf + k, sizeof(buf) - k, " f:%d", static_cast<int>(w));
+            else if (fx == FIXUP_STACK) k += snprintf(buf + k, sizeof(buf) - k, " k:%d", static_cast<int>(w));
+            else if (fx == FIXUP_DATADATA) k += snprintf(buf + k, sizeof(buf) - k, " d:%d", static_cast<int>(w));
+            else if (fx != 0) k += snprintf(buf + k, sizeof(buf) - k, " x%d:%d", fx, static_cast<int>(w));
+            else k += snprintf(buf + k, sizeof(buf) - k, " %d", static_cast<int>(w));
+        }
+        t.desc[pc] = buf;
+    }
+    const L1bRing cur = { form, g, b };
+    if (s_l1b_rn >= 1)
+    {
+        const L1bRing &p1 = s_l1b_r[s_l1b_rn - 1];
+        l1b_gram((static_cast<uint64_t>(b) << 46) | (static_cast<uint64_t>(p1.form) << 30) | (static_cast<uint64_t>(form) << 15),
+            g && p1.g == g);
+        if (s_l1b_rn >= 2)
+        {
+            const L1bRing &p2 = s_l1b_r[s_l1b_rn - 2];
+            l1b_gram((static_cast<uint64_t>(b) << 46) | (1ULL << 45) | (static_cast<uint64_t>(p2.form) << 30) |
+                (static_cast<uint64_t>(p1.form) << 15) | form, g && p1.g == g && p2.g == g);
+        }
+    }
+    if (s_l1b_rn == 2) { s_l1b_r[0] = s_l1b_r[1]; s_l1b_r[1] = cur; }
+    else s_l1b_r[s_l1b_rn++] = cur;
+    s_l1b_r_pc = pc;
+    s_l1b_r_sc = s_l1b_last_sc;
+}
+
+// a superinstruction H committed at pc: count its constituents after the first (counted at its dispatch)
+void ccInstance::DosVmSyncFold(const ccInstance *ci, int32_t pc, int32_t h) const
+{
+    if (!dos_l1_inwin()) return;
+    if (h >= 0 && h < kVmH_Count) s_l1b_commit[h]++;
+    const uint32_t g = ++s_l1b_serial;
+    if (s_l1b_rn > 0 && s_l1b_r_pc == pc && s_l1b_r_sc == ci->GetScript().get()) s_l1b_r[s_l1b_rn - 1].g = g;
+    const int K = (h == kVmH_SFarCall) ? 5 : 3;
+    int32_t p = pc;
+    for (int i = 1; i < K; ++i)
+    {
+        const int op = static_cast<int>(ci->_code[p] & INSTANCE_ID_REMOVEMASK);
+        p += 1 + s_argc[op];
+        DosVmTraceFold(ci, p, static_cast<int32_t>(16 + g));
+    }
+}

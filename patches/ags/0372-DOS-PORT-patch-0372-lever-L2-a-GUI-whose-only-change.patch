diff --git a/Engine/gui/gui_engine.cpp b/Engine/gui/gui_engine.cpp
index f86b6f9de..ebe916a55 100644
--- a/Engine/gui/gui_engine.cpp
+++ b/Engine/gui/gui_engine.cpp
@@ -1,3 +1,8 @@
+#ifdef __DJGPP__

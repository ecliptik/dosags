+            AGS::Common::Debug::Printf("DOS-PORT opcount room=%d mar_type=%d reads=%lld writes=%lld",
+                room, t, dp_mar_rd[t] - dp_s_rd[t], dp_mar_wr[t] - dp_s_wr[t]);
+    for (int i = 0; i < CC_NUM_SCCMDS; ++i)
+        if (dp_op_n[i] - dp_s_op[i])
+            AGS::Common::Debug::Printf("DOS-PORT opcount room=%d op=%s code=%d n=%lld",
+                room, sccmd_info[i].CmdName, i, dp_op_n[i] - dp_s_op[i]);
+}
+extern int displayed_room;
+void dp_opcount_seg_check()
+{
+    if (displayed_room == dp_oc_room) return;
+    if (dp_oc_room != -1000) dp_opcount_dump(dp_oc_room, "roomchange");
+    dp_oc_room = displayed_room;
+    dp_oc_snap();
+}
+void dp_opcount_quit() { dp_opcount_dump(dp_oc_room, "quit"); }

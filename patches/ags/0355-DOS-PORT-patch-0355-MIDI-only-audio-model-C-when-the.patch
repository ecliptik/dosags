+// DOS-PORT patch 0355 (model C, MIDI-only): see dos_audio_mixer.h. Reached only
+// from sys_audio_init() after the SB path failed, never with GUS selected.
+bool dos_audio_mixer_init_midi_only()
+{
+    if (g_stream || g_gus_open || g_null_open)
+        return true;
+    g_gus_backend = false; // S16, as on the SB path
+    for (auto &v : g_voices)
+        v = Voice();
+    g_underruns = 0;
+    g_drains = 0;
+    g_mixed_chunks = g_mixed_zero = g_mixed_quiet = 0;
+    g_null_last_uc = uclock();
+    g_null_due = 0;
+    g_null_frac = 0;
+    g_null_capped = 0;
+    for (int i = 0; i < DOS_AUDIO_MIXER_MAX_VOICES; i++)
+    {
+        g_null_vsamples[i] = 0;
+        g_null_vstart[i] = 0;
+    }
+    g_null_open = true;
+    Debug::Printf(kDbgMsg_Info, "DOSAudioMixer: no PCM device (model C): %d voices drained silently at %d Hz mono, "
+        "pump gaps credited up to %d ms", DOS_AUDIO_MIXER_MAX_VOICES, DOS_AUDIO_MIXER_RATE,
+        NULL_MAX_GAP_CHUNKS * MIX_CHUNK_SAMPLES * 1000 / DOS_AUDIO_MIXER_RATE);
+    return true;
+}

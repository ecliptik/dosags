+        // DOS-PORT: SDL_Keysym::sym was renamed .key on the flattened
+        // SDL_KeyboardEvent that ags_getkeysdown() now stores/returns
+        // (SDL_Keysym itself is gone in SDL3).
         for (size_t i = 0; i < keys.size(); ++i)
             *(static_cast<uint32_t*>(arr.Obj()) + i) = AGSKeyToScriptKey(

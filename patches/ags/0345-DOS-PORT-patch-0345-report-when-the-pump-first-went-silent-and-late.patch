 // DOS-PORT (patch 0275): the first event's song ms, main-loop tick, planner-call
 // gap in SB IRQs and first-plan-after-start flag go to plan_behind_at=.
 void dos_midi_backend_note_plan_behind(uint32_t song_ms, uint32_t loop_tick, uint32_t gap_irqs, bool first_plan);
+// DOS-PORT (patch 0345): the first stuck repair and first late write (SDL 0266), with the song ms at
+// their slots, stamped once each for stuck_at= and late_at=. 0xFFFFFFFF = no event yet.
+void dos_midi_backend_note_first_events(uint32_t stuck_irq, uint32_t stuck_prev, uint32_t stuck_song_ms,
+    uint32_t late_irq, uint32_t late_song_ms, uint32_t loop_tick);
 // DOS-PORT (patch 0208): the measured IRQ period the planner is using.
 void dos_midi_backend_note_isr_period(uint32_t period_us);
 

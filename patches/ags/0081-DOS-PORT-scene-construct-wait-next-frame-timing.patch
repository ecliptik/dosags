                     "DOS-PORT tickstats_audio_sync calls=%ld total_ms=%ld min_ms=%ld max_ms=%ld mean_ms=%.2f\n",
                     au.calls, au.total_ms, au.min_ms, au.max_ms,
                     au.calls > 0 ? (double)au.total_ms / (double)au.calls : 0.0);
+                // DOS-PORT patch 0081: three more candidates from the
+                // 8-bit optimization pass (draw-list construction, and
+                // the frame-pacing wait -- both measured cost AND, for
+                // the wait, what it itself requested to sleep for).
+                const DosPortTickPhaseStats &sc = dos_port_tick_timing.scene_construct;

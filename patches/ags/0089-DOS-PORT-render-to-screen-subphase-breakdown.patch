         if (src_lock) SDL_UnlockSurface(src);
         return false;
     }
+    uclock_t _t1 = uclock();
+    dos_port_tick_record(dos_port_tick_timing.fastblit_lock, (_t1 - _t0) * 1000000LL / UCLOCKS_PER_SEC);
 
     const Uint8 *src_pixels = (const Uint8 *)src->pixels;
     Uint8 *dst_pixels = (Uint8 *)dst->pixels;
@@ -806,10 +815,12 @@ static bool TryFastIntegerNearestBlit(SDL_Surface *src, SDL_Surface *dst, const
     // performance-blocked for unrelated reasons, per STATUS.md), and a
     // multi-byte memcpy's per-call overhead is proportionally smaller
     // relative to its payload than a 1-byte one is.
+    long long hrep_us = 0, vmemcpy_us = 0;
     if (bpp == 1)
     {
         for (int sy = 0; sy < src->h; sy++)
         {
+            _t0 = uclock();
             const Uint8 *src_row = src_pixels + (size_t)sy * (size_t)src->pitch;
             Uint8 *out = row_buf.data();
             for (int sx = 0; sx < src->w; sx++)
@@ -818,17 +829,22 @@ static bool TryFastIntegerNearestBlit(SDL_Surface *src, SDL_Surface *dst, const
                 for (int r = 0; r < scale_x; r++)
                     *out++ = v;
             }
+            _t1 = uclock();
+            hrep_us += (_t1 - _t0) * 1000000LL / UCLOCKS_PER_SEC;
             Uint8 *dst_row_base = dst_pixels + (size_t)(sy * scale_y) * (size_t)dst->pitch;
             for (int r = 0; r < scale_y; r++)
             {
                 std::memcpy(dst_row_base + (size_t)r * (size_t)dst->pitch, row_buf.data(), dst_row_bytes);
             }
+            _t0 = uclock();
+            vmemcpy_us += (_t0 - _t1) * 1000000LL / UCLOCKS_PER_SEC;
         }
     }
     else
     {

+++ b/Engine/script/cc_instance.cpp
@@ -380,6 +380,34 @@ bool ccInstance::FindExportedFunction(const String &fn_name, int32_t &start_at,
     return true;
 }
 
+
+#ifdef __DJGPP__
+// DOS-PORT probe 0304 v2 (LAB ONLY, never in patches/; LAB-MMD.md 16.6-16.8): time the outermost
+// ccInstance::Run of each kAGSEvent_Script dispatch FROM ITS CALLER, so Run's own code is untouched
+// (v1 put code inside Run and moved `this` out of its register). R_out = script event - Run.
+// Raw uclock_t sums, converted at dump. DOSAGS_SPLIT=0 keeps the counts, takes no clock reads.
+#include <time.h>
+extern int dp_split_in_evt;
+static int dp_split_on = -1, dp_split_depth = 0;
+static long long dp_split_run_t = 0, dp_split_reads = 0, dp_split_pair_t = -1;
+static long dp_split_runs = 0;
+static void dp_split_init()
+{
+    if (dp_split_on >= 0) return;
+    const char *e = getenv("DOSAGS_SPLIT"); dp_split_on = (e && atoi(e) == 0) ? 0 : 1;
+    long long pair = 0;
+    for (int i = 0; i < 1000; ++i) { const uclock_t a = uclock(); const uclock_t b = uclock(); pair += (long long)(b - a); }
+    dp_split_pair_t = pair;
+}
+static uclock_t dp_split_now() { if (!dp_split_on) return 0; dp_split_reads++; return uclock(); }
+void dp_split_dump()
+{
+    Debug::Printf("DOS-PORT split v2 on=%d runs=%ld reads=%ld run_t=%ld pair1000_t=%ld ucps=%ld",
+        dp_split_on, dp_split_runs, (long)dp_split_reads, (long)dp_split_run_t, (long)dp_split_pair_t,
+        (long)UCLOCKS_PER_SEC);
+}
+#endif

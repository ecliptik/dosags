@@ -1329,9 +1329,29 @@
 }
 #endif
 
+#ifdef DOSAGS_LEVERCOUNT
+#include "main/dos_levercount.h"
+unsigned long dos_lc[kLC_Count];
+unsigned long dos_lc_tick = 0;
+static void dp_levercount()
+{
+    dos_lc_tick = GameTimer.LoopCounter;
+    if (dos_lc_tick % 250 != 0) return;
+    Debug::Printf("DOS-PORT levercount tick=%lu fmt=%lu dbgscript=%lu dbgprint=%lu scriptsprintf=%lu charidat=%lu charidat_repeat=%lu"
+        " charidat_chars=%lu charscale=%lu charscale_same=%lu fixuploop=%lu moveandanim=%lu follower=%lu idle=%lu animating=%lu"
+        " moving=%lu guiat=%lu", dos_lc_tick, dos_lc[kLC_Fmt], dos_lc[kLC_DbgScriptPrint], dos_lc[kLC_DbgPrint],
+        dos_lc[kLC_ScriptSprintf], dos_lc[kLC_CharIdAt], dos_lc[kLC_CharIdAtRepeat], dos_lc[kLC_CharIdAtChars],
+        dos_lc[kLC_CharScale], dos_lc[kLC_CharScaleSame], dos_lc[kLC_FixupLoop], dos_lc[kLC_MoveAndAnim], dos_lc[kLC_Follower],
+        dos_lc[kLC_Idle], dos_lc[kLC_Animating], dos_lc[kLC_Moving], dos_lc[kLC_GuiAt]);
+}
+#endif
+
 static void game_loop_update_loop_counter()
 {
     GameTimer.LoopCounter++;
+#ifdef DOSAGS_LEVERCOUNT
+    dp_levercount(); // patch 0360 probe, LAB ONLY
+#endif
 #ifdef DOSAGS_VMTRACE
     dp_statewit(); // patch 0360, LAB ONLY
 #endif

+        dos_s2.vfy_bad++;
+        dos_s2.vfy_bad_px += bad;
+        if (dos_s2.vfy_first < 0) dos_s2.vfy_first = dos_s2.vfy;
+        if (dos_s2.vfy_logged < 12)
+        {
+            dos_s2.vfy_logged++;
+            Debug::Printf("DOS-PORT scale2verify BAD check=%ld bad_px=%ld src_bbox=%d,%d..%d,%d",
+                dos_s2.vfy, bad, bx1, by1, bx2, by2);
+        }
+    }

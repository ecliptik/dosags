+      wallscreen == walkable_areas_temp && dos_walktemp_serial != 0 && dos_walktemp_serial == rp_cache_serial &&
+      rp_cache_src->GetWidth() == wallscreen->GetWidth() && rp_cache_src->GetHeight() == wallscreen->GetHeight();
+  bool hit = (rp_req_mask == wallscreen && rp_cache_src != nullptr && rp_cache_maxgran == pfc.MaxGranularity);
+  if (!hit && serial_hit)
+  {
+    hit = true;
+    rp_n_serial_hits++;
+    if (rp_verify == 1)
+    {
+      rp_n_verified++;
+      if (!rp_cache_matches(wallscreen, pfc.MaxGranularity))
+        rp_n_serial_mismatch++;
+    }
+  }
+  if (!hit)
+  {
+    rp_n_compares++;
+    hit = rp_cache_matches(wallscreen, pfc.MaxGranularity);
+    if (hit)
+      rp_cache_serial = (wallscreen == walkable_areas_temp) ? dos_walktemp_serial : 0; // 0319 (A)
+  }
+  if (hit)
   {
     rp_req_mask = wallscreen; // DOS-PORT patch 0317
+    memcpy(walk_area_granularity, rp_cache_gran, sizeof(walk_area_granularity));
+    if (fast && rp_labels_ok) // DOS-PORT patch 0319 (B): no copy, no flood
+    {
+      rp_n_label_answers++;
+      const int r = rp_route_possible_labels(fromx, fromy, tox, toy, pfc);
+      if (rp_verify == 1)
+      {
+        const int sx = suggestx, sy = suggesty;
+        suggestx = -1;
+        Bitmap *vw = BitmapHelper::CreateBitmapCopy(rp_cache_norm, 8);
+        const int rv = is_route_possible_flood(vw, fromx, fromy, tox, toy, pfc);
+        rp_n_verified++;
+        if (rv != r || suggestx != sx || suggesty != sy)
+          rp_n_label_mismatch++;
+        suggestx = sx; suggesty = sy;
+      }
+      return r;
+    }
     Bitmap *tempw = BitmapHelper::CreateBitmapCopy(rp_cache_norm, 8);
     if (tempw == nullptr)
       quit("no memory for route calculation");
-    memcpy(walk_area_granularity, rp_cache_gran, sizeof(walk_area_granularity));
     return is_route_possible_flood(tempw, fromx, fromy, tox, toy, pfc);
   }
 
@@ -314,6 +521,36 @@ static int is_route_possible(const Bitmap *wallscreen, int fromx, int fromy, int
   memcpy(rp_cache_gran, walk_area_granularity, sizeof(rp_cache_gran));
   rp_cache_maxgran = pfc.MaxGranularity;
   rp_req_mask = rp_cache_src ? wallscreen : nullptr; // DOS-PORT patch 0317: the cache now holds this mask
+  // DOS-PORT patch 0319: the serial the cache now holds, and the labels of its normalised mask (tempw is still the
+  // unflooded normalised copy here)
+  rp_cache_serial = (rp_cache_src && wallscreen == walkable_areas_temp) ? dos_walktemp_serial : 0;
+  {
+#ifdef __DJGPP__
+    const uclock_t l0 = uclock();
+#endif
+    rp_labels_ok = rp_fast_on() && rp_cache_norm && rp_build_labels(tempw);
+#ifdef __DJGPP__
+    rp_label_us = (unsigned long)((uclock() - l0) * 1000000.0 / UCLOCKS_PER_SEC);
+#endif
+  }
+  if (rp_labels_ok) // DOS-PORT patch 0319 re-cut: the first request of a serial is answered from the labels too
+  {
+    rp_n_label_answers++;
+    const int r = rp_route_possible_labels(fromx, fromy, tox, toy, pfc);
+    if (rp_verify == 1)
+    {
+      const int sx = suggestx, sy = suggesty;
+      suggestx = -1;
+      const int rv = is_route_possible_flood(tempw, fromx, fromy, tox, toy, pfc); // deletes tempw
+      rp_n_verified++;
+      if (rv != r || suggestx != sx || suggesty != sy)
+        rp_n_label_mismatch++;
+      suggestx = sx; suggesty = sy;
+    }
+    else
+      delete tempw;
+    return r;
+  }
 
   return is_route_possible_flood(tempw, fromx, fromy, tox, toy, pfc);
 }
diff --git a/Engine/ac/walkablearea.cpp b/Engine/ac/walkablearea.cpp

     Uint16 reg;
+    const uclock_t t0 = uclock(); /* TEMPORARY DIAGNOSTIC, see above */
     if (!g_gus_active || voice < 0 || voice >= g_gus_voices) {
         return;
     }
@@ -1657,10 +1798,44 @@ void SDL_DOSGusSetVoiceVol(int voice, int linear_vol)
         gus_diag_put(GUS_DR_VOL, (Uint8)voice, (Uint32)linear_vol, reg); /* IRQ-safe */
     }
     DOS_EnableInterrupts();
+

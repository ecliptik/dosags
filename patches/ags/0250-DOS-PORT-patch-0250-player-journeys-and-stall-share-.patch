+void dos_journey_load_request(int slot);      // RestoreGameSlot() entry
+void dos_journey_load_exec(int slot);         // try_restore_save() entry
+void dos_journey_load_done(int slot, bool ok);// load_game(): restored (before GameRestored) or failed
+void dos_journey_input_dequeued(const SDL_Event &evt, bool dropped);
+void dos_journey_input_cleared(const SDL_Event &evt);
+void dos_journey_emit(FILE *log);

+            k.ta, k.tl, k.ll, k.zoom, k.mir, c.w, c.h, c.spw, c.sph, atx, aty, basel, k.transp, dos_r2_crop, (int)wbc,
+            (int)ks, (int)ps, is, hs, dos_r2_us(t0, t1), dos_r2_us(t1, t2));

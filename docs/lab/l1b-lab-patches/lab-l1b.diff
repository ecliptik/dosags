+static void l1b_enter()
+{
+    if (s_l1b_markn < 64) s_l1b_mark[s_l1b_markn++] = s_l1b_actn;
+    s_l1b_rn = 0;
+    if (!dos_l1_inwin() || s_l1b_actn >= 1024) return;
+    L1bAct &a = s_l1b_act[s_l1b_actn++];
+    a.b = l1b_bucket(); a.ops = 0; a.calls = 0; a.apis = 0; a.entry = 1;
+}
+static void l1b_exit()
+{
+    if (s_l1b_markn <= 0) return;
+    const int m = s_l1b_mark[--s_l1b_markn];
+    while (s_l1b_actn > m) l1b_pop(0);
+    s_l1b_rn = 0;
+}
+static void l1b_walk(int n)
+{
+    if (!dos_l1_inwin()) return;
+    const int b = l1b_bucket();
+    s_l1b_walkn[b]++; s_l1b_walks[b] += static_cast<uint64_t>(n < 0 ? 0 : n);
+}
+static inline uint64_t l1b_tsc()
+{
+    uint32_t lo, hi;
+    __asm__ __volatile__("rdtsc" : "=a"(lo), "=d"(hi));
+    return (static_cast<uint64_t>(hi) << 32) | lo;
+}
+__attribute__((noinline)) static RuntimeScriptValue l1b_empty_api(const RuntimeScriptValue *params, int32_t n)
+{
+    (void)params; (void)n;
+    __asm__ __volatile__("" ::: "memory");
+    return RuntimeScriptValue().SetInt32(0);
+}
+static volatile int32_t s_l1b_sink = 0;
+typedef RuntimeScriptValue (*L1bApiFn)(const RuntimeScriptValue *, int32_t);
+__attribute__((noinline)) static uint64_t l1b_time(L1bApiFn fn, const RuntimeScriptValue *p, int32_t n, int reps)
+{
+    // the loop around the calls: measured with no call at all, subtracted by the caller
+    const uint64_t t0 = l1b_tsc();
+    int32_t acc = 0;
+    for (int i = 0; i < reps; ++i)
+    {
+        if (fn) acc += fn(p, n).IValue;
+        __asm__ __volatile__("" ::: "memory");
+    }
+    const uint64_t t1 = l1b_tsc();
+    s_l1b_sink = acc;
+    return t1 - t0;
+}
+static void l1b_api(const void *fn, const RuntimeScriptValue *params, int32_t n)
+{
+    if (!dos_l1_inwin()) return;
+    if (s_l1b_actn > 0) s_l1b_act[s_l1b_actn - 1].apis++;
+    if (!s_l1b_bready)
+    {
+        s_l1b_bready = true;
+        for (int i = 0; i < kL1bBN; ++i)
+        {
+            const uint32_t idx = simp.GetIndexOfAny(AGS::Common::String(s_l1b_bench_names[i]));
+            const ScriptImport *imp = (idx == UINT32_MAX) ? nullptr : simp.GetByIndex(idx);
+            s_l1b_bfn[i] = (imp && imp->Value.Type == kScValStaticFunction) ? reinterpret_cast<const void *>(imp->Value.SPfn) : nullptr;
+        }
+    }
+    for (int i = 0; i < kL1bBN; ++i)
+    {
+        if (!fn || s_l1b_bfn[i] != fn) continue;
+        const unsigned long c = ++s_l1b_bcalls[i];
+        if ((c == 200 || c == 2000 || c == 20000 || c == 100000) && s_l1b_bsamples[i] < 4 && n <= 2)
+        {
+            RuntimeScriptValue p[2];
+            for (int k = 0; k < n; ++k) p[k] = params[k];
+            const int reps = 256;
+            const uint64_t tl = l1b_time(nullptr, p, n, reps);
+            const uint64_t te = l1b_time(l1b_empty_api, p, n, reps);
+            const uint64_t tf = l1b_time(reinterpret_cast<L1bApiFn>(const_cast<void *>(fn)), p, n, reps);
+            const int s = s_l1b_bsamples[i]++;
+            s_l1b_bres[i][s] = ((tf > tl ? tf - tl : 0) * 1000ULL) / reps;
+            s_l1b_bempty[i][s] = ((te > tl ? te - tl : 0) * 1000ULL) / reps;
+            s_l1b_bnargs[i] = n;
+            for (int k = 0; k < 2; ++k) s_l1b_barg[i][k] = (k < n) ? params[k].IValue : 0;
+        }
+        break;
+    }
+}
+
+static int l1b_pctab(const ccInstance *ci)
+{
+    const ccScript *sc = ci->GetScript().get();
+    if (sc == s_l1b_last_sc) return s_l1b_last_ix;
+    auto it = s_l1b_pcix.find(sc);
+    int ix;
+    if (it == s_l1b_pcix.end() || s_l1b_pct[it->second].codesize != ci->GetScript()->code.size())
+    {
+        L1bPc t;
+        // the label is the L1 bucket prefix of the running function (game / roomN / ...)
+        char buf[32];
+        snprintf(buf, sizeof(buf), "b%d", l1b_bucket());
+        t.label = buf;
+        t.codesize = static_cast<uint32_t>(sc->code.size());
+        t.n.assign(t.codesize, 0u);
+        t.desc.resize(t.codesize);
+        for (size_t i = 0; i < sc->exports.size() && i < sc->export_addr.size(); ++i)
+            if (((sc->export_addr[i] >> 24) & 0xFF) == EXPORT_FUNCTION)
+                t.fns.push_back(std::make_pair(sc->exports[i], sc->export_addr[i] & 0x00FFFFFF));
+        s_l1b_pct.push_back(std::move(t));
+        ix = static_cast<int>(s_l1b_pct.size()) - 1;
+        s_l1b_pcix[sc] = ix;
+    }
+    else
+        ix = it->second;
+    s_l1b_last_sc = sc;
+    s_l1b_last_ix = ix;
+    return ix;
+}

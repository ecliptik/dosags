+    }
+    if (!dos_r3l_mode) return 0;
+    const long lc = (long)get_loop_counter();
+    return lc >= dos_r3l_lo && lc <= dos_r3l_hi;
+}
+int dos_lab_sprdump_now()
+{
+    if (dos_lab_r3log_now()) return 1;
+    if (dos_sd_mode < 0)
+    {
+        dos_sd_mode = 0;
+        const char *e = getenv("DOSAGS_LAB_SPRDUMP");
+        while (e && *e && dos_sd_n < 32)
+        {
+            long t; int used = 0;
+            if (sscanf(e, "%ld%n", &t, &used) != 1) break;
+            dos_sd_t[dos_sd_n++] = t; e += used; if (*e == ',') e++;
+        }
+        dos_sd_mode = dos_sd_n > 0;
+    }
+    if (!dos_sd_mode) return 0;
+    const long lc = (long)get_loop_counter();

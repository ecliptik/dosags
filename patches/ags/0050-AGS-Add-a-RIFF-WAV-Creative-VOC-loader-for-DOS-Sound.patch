+// https://opensource.org/license/artistic-2-0/
+//
+//=============================================================================
+//
+// DOS-PORT (Sound milestone, S1): a small RIFF WAV + Creative Voice File
+// (VOC) loader. Sniffs the actual file header rather than trusting the
+// clip's own extension/fileType hint (PLAN.md's own requirement, since
+// AGS's ScriptAudioClip fileType is not always reliable), and converts
+// whatever PCM it finds ONCE into the mixer's fixed Tier-2 device format
+// -- never per chunk (dossage's own 0039 lesson: per-chunk resampling
+// cost 43% of every frame until it moved to load time).
+//
+// Only uncompressed PCM is supported: WAV PCM (format tag 1) 8/16-bit,
+// and VOC codec 0 (unsigned 8-bit) / new-format (type 9) signed 16-bit.
+// OGG/MP3/ADPCM/etc. are never decoded on DOS (host-side pre-conversion,
+// PLAN.md decision 2) -- any of those, or a genuinely corrupt file, fails
+// this call cleanly, matching how a missing decoder already fails today
+// ("AudioClip.Play: unable to load sound file").
+//
+//=============================================================================
+#ifndef __AGS_EE_PLATFORM_DOS__DOS_AUDIO_DECODE_H
+#define __AGS_EE_PLATFORM_DOS__DOS_AUDIO_DECODE_H
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+// Sniffs and decodes `data` (the complete raw file bytes) as WAV or VOC,
+// resampling/downmixing to mono S16 @ DOS_AUDIO_MIXER_RATE (see
+// dos_audio_mixer.h). Returns true and fills out_pcm on success; returns
+// false (out_pcm left empty) on any unrecognized header, unsupported
+// sub-format, or truncated/corrupt data.
+bool dos_audio_decode_pcm(const uint8_t *data, size_t size, std::vector<int16_t> &out_pcm);
+
+#endif // __AGS_EE_PLATFORM_DOS__DOS_AUDIO_DECODE_H

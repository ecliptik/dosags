+    s_l1b_unit = static_cast<uint32_t *>(calloc(static_cast<size_t>(kL1bNB) * (kVmH_Count + 2), sizeof(uint32_t)));
+    s_l1b_g = static_cast<L1bG *>(calloc(kL1bGN, sizeof(L1bG)));
+    s_l1b_as = static_cast<L1bAS *>(calloc(kL1bNB, sizeof(L1bAS)));

-    AudioPlayer(int handle, const AGS::Common::String &midi_path, bool repeat);
+    AudioPlayer(int handle, const std::vector<uint8_t> &midi_data, const AGS::Common::String &midi_path, bool repeat);
     ~AudioPlayer();
 
     // Gets current playback state
@@ -149,7 +151,6 @@ private:
     // <AudioPlayer>>) and SoundClip's slot-handle contract need no change.
     bool _isMidi = false;
     bool _midiRepeat = false;
-    AGS::Common::String _midiPath;
     midi_sched *_midiSched = nullptr;
     // DOS-PORT (S5): opaque -- dos_midi_backend.h's own handle, whose real
     // type (opl3_sink* or waveblaster_sink*) and lifecycle both depend on

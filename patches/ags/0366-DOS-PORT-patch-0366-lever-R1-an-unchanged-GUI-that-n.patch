+#ifdef __DJGPP__
+// DOS-PORT patch 0366 -- lever R1 (dosags LAB-PLAY.md sections 3 and 7; round GC on the 486). An unchanged GUI
+// (0169/0191/0234's skip-invalidate set) whose rect misses everything this frame repaints is not composited at all.
+// 0170 clips such an entry to the frame's dirty bbox plus 0236's carry boxes, and drew it IN FULL when that
+// intersection was empty; a clip to an empty rect draws nothing, so the skip is 0170+0236 taken to its limit.
+// DOSAGS_GUI_CLIP: unset (or any other value) = 2, the skip (default); 0 = off, every GUI composited in full (the 0365
+// head); 1 = 0170+0236's clip without the skip (the opt-in it was).
+// Latch: any change of the back buffer (the virtualScreen object, its pixel base or its size), any alias activate or
+// deactivate, a whole-surface restore the dirty set was not told about (dos_guiclip_note_fullrestore, below), and any
+// tint or plugin entry force full composition -- no clip, no skip, exactly what mode 0 draws -- for
+// that frame and the next, so nothing relies on pixels a different buffer holds.
+static int dos_gc_mode = -1;
+static long dos_gc_flagged = 0, dos_gc_skipped = 0, dos_gc_clipped = 0, dos_gc_full = 0, dos_gc_latched_full = 0;
+static long dos_gc_latch_events = 0, dos_gc_latch_alias = 0, dos_gc_latch_buffer = 0, dos_gc_latch_tint = 0;
+static long dos_gc_latch_fullrestore = 0;
+static long long dos_gc_skipped_px = 0;
+static int dos_gc_latch = 0;
+static const void *dos_gc_last_vs = nullptr, *dos_gc_last_base = nullptr;
+static int dos_gc_last_w = -1, dos_gc_last_h = -1;
+int dos_guiclip_mode()
+{
+    if (dos_gc_mode < 0)
+    {
+        const char *e = getenv("DOSAGS_GUI_CLIP");
+        dos_gc_mode = (e && e[0] == '0' && e[1] == 0) ? 0 : (e && e[0] == '1' && e[1] == 0) ? 1 : 2;
+        AGS::Common::Debug::Printf("DOS-PORT guiclip DOSAGS_GUI_CLIP=%s mode=%d", (e && *e) ? e : "(default)", dos_gc_mode);
+    }
+    return dos_gc_mode;
+}
+static void dos_gc_set_latch(long &why)
+{
+    if (dos_gc_latch < 2) { dos_gc_latch_events++; why++; }
+    dos_gc_latch = 2;
+}
+// Called by the restore (draw_software.cpp) when it repaints a whole surface that the dirty set does not report as
+// full: AGS turns a 26th rect in one interval into WHOLESCREENDIRTY without telling dos_port_dirty (found by the R3
+// lab, dosags LAB-R3.md), so the bbox the clip reads is smaller than what was just repainted. The frame being
+// constructed then composites every flagged GUI in full (the latch, armed here, is consumed by this frame's render).
+void dos_guiclip_note_fullrestore()
+{
+    dos_gc_set_latch(dos_gc_latch_fullrestore);
+}
+void dos_guiclip_summary(FILE *log)
+{
+    if (!log) return;
+    fprintf(log, "DOS-PORT guiclip_final mode=%d flagged=%ld skipped=%ld skipped_px=%lld clipped=%ld full=%ld latched_full=%ld"
+        " latch_events=%ld latch_alias=%ld latch_buffer=%ld latch_tint=%ld latch_fullrestore=%ld\n",
+        dos_gc_mode, dos_gc_flagged, dos_gc_skipped, dos_gc_skipped_px, dos_gc_clipped, dos_gc_full, dos_gc_latched_full,
+        dos_gc_latch_events, dos_gc_latch_alias, dos_gc_latch_buffer, dos_gc_latch_tint, dos_gc_latch_fullrestore);
+}
 #endif
 
 

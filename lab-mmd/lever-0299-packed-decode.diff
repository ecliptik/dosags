+// DOS-PORT patch 0299: validate every instruction once, then pack its argument count into bits 7-8 of
+// its code word (bits 7-21 are otherwise always zero: the opcode takes 7 bits, the instance id sits at
+// 22-31). A walk that meets an opcode the VM would reject, a set bit in 7-21, or arguments running past
+// the code's end leaves the code unpacked: that instance then runs the unchanged decode path, so a
+// malformed script behaves exactly as it does today. Idempotent.
+void ccInstance::PackCode()
+{
+    ResolvedScriptData &sd = *_scriptData;
+    if (sd.packed || sd.codesize == 0)
+        return;
+    const size_t n = sd.codesize;
+    intptr_t *code = sd.code.data();
+    for (size_t pc = 0; pc < n; )
+    {
+        const int32_t op = static_cast<int32_t>(code[pc]) & INSTANCE_ID_REMOVEMASK;
+        if (op < 0 || op >= CC_NUM_SCCMDS)
+            return;
+        const size_t argc = static_cast<size_t>(sccmd_info[op].ArgCount);
+        if (pc + argc >= n)
+            return;
+        pc += 1 + argc;
+    }
+    for (size_t pc = 0; pc < n; )
+    {
+        const int32_t op = static_cast<int32_t>(code[pc]) & INSTANCE_ID_REMOVEMASK;
+        const int argc = sccmd_info[op].ArgCount;
+        code[pc] |= static_cast<intptr_t>(argc) << 7;
+        pc += 1 + argc;
+    }
+    sd.packed = true;
+}

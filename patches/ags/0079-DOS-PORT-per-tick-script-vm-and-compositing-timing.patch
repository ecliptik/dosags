 namespace AGS
@@ -468,6 +472,16 @@ void SDLRendererGraphicsDriver::SetStageScreen(const Size & /*sz*/, int /*x*/, i
 
 void SDLRendererGraphicsDriver::RenderToBackBuffer()
 {
+    // DOS-PORT patch 0079: this function is the CPU-side sprite-
+    // compositing step, confirmed (by reading Render() just below) to
+    // be a clean, sequential, non-overlapping phase from Present()/the
+    // flip step -- Render(int,int,GraphicFlip) calls this then Present()
+    // back to back, never interleaved. RAII-bracketed (not a plain
+    // begin/end pair) because this function has more than one return
+    // path (the "nothing to render" early exit just below).
+#ifdef __DJGPP__
+    DosPortTickScope _dos_port_render_scope(dos_port_tick_timing.render_backbuffer);
+#endif
     // Close unended batches, and issue a warning
     assert(_actSpriteBatch == UINT32_MAX);
     while (_actSpriteBatch != UINT32_MAX)
diff --git a/Engine/main/dos_port_tick_timing.h b/Engine/main/dos_port_tick_timing.h
new file mode 100644
index 000000000..ffc34c9fe
--- /dev/null
+++ b/Engine/main/dos_port_tick_timing.h
@@ -0,0 +1,115 @@
+//=============================================================================
+//
+// Adventure Game Studio (AGS)
+//
+// Copyright (C) 1999-2011 Chris Jones and 2011-2026 various contributors
+// The full list of copyright holders can be found in the Copyright.txt
+// file, which is part of this source code distribution.
+//
+// The AGS source code is provided under the Artistic License 2.0.
+// A copy of this license can be found in the file License.txt and at
+// https://opensource.org/license/artistic-2-0/
+//
+//=============================================================================
+//
+// DOS-PORT patch 0079: full-run per-tick timing for the two candidate
+// steady-state bottlenecks identified from patch 0078's real-hardware
+// phase-breakdown data (PLAN.md's "40fps push step 3" comparison,
+// 2026-09-16, S16FI1/S32FI1) -- load time and per-flip Present() cost
+// were both measured and ruled out as the dominant cost; the remaining
+// candidates were script VM execution and RenderToBackBuffer()'s
+// CPU-side sprite compositing.
+//
+// Bracket points, found by reading source (not assumed):
+//  - script_vm: script/script.cpp's RunScriptFunction() -- the single
+//    funnel every per-tick script callback actually runs through
+//    (repExecAlways/lateRepExecAlways via main/game_run.cpp's
+//    GameUpdateEarlyRepExec()/GameUpdateLateRepExec(), and every queued
+//    event handler via processallevents()/GameUpdateProcessEvents() --
+//    confirmed live by reading game_run.cpp's UpdateGameOnce() and
+//    following each call site into script.cpp, rather than guessing a
+//    single "the script phase" span). Also fires for non-per-tick
+//    script calls (game_start, room-load scripts) -- a real, small,
+//    documented overlap with patch 0078's own first_room_load_ms, not
+//    hidden.
+//  - render_backbuffer: gfx/ali3dsw.cpp's
+//    SDLRendererGraphicsDriver::RenderToBackBuffer() -- confirmed to be
+//    a clean, sequential, non-overlapping phase distinct from the flip/
+//    present step: Render(int,int,GraphicFlip) calls RenderToBackBuffer()
+//    then Present() as two back-to-back, non-interleaved calls (the
+//    latter already covered by patch 0035's own DOSAGS_FLIP_INSTR
+//    instrumentation in vendor/SDL/src/video/dos/SDL_dosframebuffer.c).
+//    Only invoked on ticks that actually render (main/game_run.cpp's
+//    UpdateGameOnce(): render_graphics() is skipped whenever
+//    play.fast_forward or skip_render_and_wait, i.e. every
+//    DOSAGS_FIXED_TIMESTEP catch-up tick) -- so this phase's own call
+//    count will legitimately be far smaller than script_vm's.
+//
+// Full-run RUNNING aggregates (count/total/min/max), not per-call
+// logging (would perturb timing and flood the log, same reasoning as
+// the existing flip instrumentation) and not the flip instrumentation's
+// own per-100-sample block-and-reset (that shape exists there because
+// SDLDBG.LOG wants periodic snapshots of a long-running, possibly-never-
+// exiting game loop; this header's consumer is a single number set
+// dumped once at process exit, main/quit.cpp, alongside the existing
+// tick_rate/frames_skipped/memory_min_free_kb lines). O(1) memory and
+// O(1) work per call -- just two long compares and an add.
+//
+//=============================================================================
+#ifndef __AGS_EE_MAIN__DOS_PORT_TICK_TIMING_H
+#define __AGS_EE_MAIN__DOS_PORT_TICK_TIMING_H
+
+#ifdef __DJGPP__
+
+// Caller must already have <time.h> included for uclock_t/uclock()/
+// UCLOCKS_PER_SEC -- not included here, same convention as
+// dos_port_startup_timing.h.
+
+struct DosPortTickPhaseStats
+{
+    long calls = 0;
+    long total_ms = 0;
+    long min_ms = -1; // -1 == no sample yet
+    long max_ms = -1;
+};
+
+struct DosPortTickTiming
+{
+    DosPortTickPhaseStats script_vm;         // script/script.cpp: RunScriptFunction()
+    DosPortTickPhaseStats render_backbuffer; // gfx/ali3dsw.cpp: RenderToBackBuffer()
+};
+
+// Defined in main.cpp, alongside dos_port_startup_timing.
+extern DosPortTickTiming dos_port_tick_timing;
+
+static inline void dos_port_tick_record(DosPortTickPhaseStats &stats, long sample_ms)
+{
+    stats.calls++;
+    stats.total_ms += sample_ms;
+    if (stats.min_ms < 0 || sample_ms < stats.min_ms)
+        stats.min_ms = sample_ms;
+    if (sample_ms > stats.max_ms)
+        stats.max_ms = sample_ms;
+}
+
+// RAII bracket for a function with more than one return path (e.g.
+// RenderToBackBuffer()'s early "nothing to render" exit) -- one line at
+// the top of the function instead of touching every return statement.
+class DosPortTickScope
+{
+public:
+    explicit DosPortTickScope(DosPortTickPhaseStats &stats)
+        : _stats(stats), _t0(uclock()) {}
+    ~DosPortTickScope()
+    {
+        dos_port_tick_record(_stats,
+            (long)((uclock() - _t0) * 1000 / UCLOCKS_PER_SEC));
+    }
+private:
+    DosPortTickPhaseStats &_stats;
+    uclock_t _t0;
+};
+
+#endif // __DJGPP__
+
+#endif // __AGS_EE_MAIN__DOS_PORT_TICK_TIMING_H

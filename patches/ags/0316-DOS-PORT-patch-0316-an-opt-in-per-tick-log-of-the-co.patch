diff --git a/Engine/main/dos_port_tick_timing.h b/Engine/main/dos_port_tick_timing.h
index 6eec16186..6ae23f96e 100644
--- a/Engine/main/dos_port_tick_timing.h
+++ b/Engine/main/dos_port_tick_timing.h
@@ -509,6 +509,23 @@ static inline long long dos_port_fine_elapsed_us(uclock_t t0)
     return dos_port_tick_fine_on() ? dos_port_tick_elapsed_us(t0) : 0;
 }
 
+// DOS-PORT patch 0316: an opt-in per-tick log of the coarse scopes. The run totals above cannot say which tick
+// a cost fell in, so a figure that must leave out a room-entry tick or a click's hitch could not be computed
+// (LAB-MMD 47.2, 50.2). DOSAGS_TICKLOG=<ticks> (read once at startup) allocates a record buffer; every close
+// of the three coarse scopes then appends (loop counter, kind, us) -- the SAME clamped us the totals add, so
+// the log sums to the totals -- and room entries and dequeued inputs append an event record. Unset, the
+// buffer pointer stays null: one test per coarse-scope close, no allocation, no extra clock read. The buffer
+// is written to TICKS.BIN at exit. Records are in time order; a tick's render/scene/room/input records come
+// before its update_game_once close (the loop counter itself advances between render and that close).
+enum
+{
+    kDosTickLogUgo = 1, kDosTickLogRender = 2, kDosTickLogScene = 3,   // coarse scope closes, value = us
+    kDosTickLogRoom = 4,                                                 // "Now in room", value = room
+    kDosTickLogClick = 5, kDosTickLogKey = 6                             // input dequeued, value = 1 if dropped
+};
+extern unsigned long *dos_port_ticklog_buf;   // null unless DOSAGS_TICKLOG is set
+void dos_port_ticklog_add(unsigned kind, unsigned long value);
+
 static inline void dos_port_tick_record_us(DosPortTickPhaseStats &stats, long long sample_us)
 {
     stats.calls++;
@@ -539,8 +556,10 @@ class DosPortTickScope
 {
 public:
     // patch 0315: coarse scopes time whatever DOSAGS_TICKSTATS_FINE says; the rest only when it is on
-    explicit DosPortTickScope(DosPortTickPhaseStats &stats, bool coarse = false)
-        : _stats(stats), _on(coarse || dos_port_tick_fine_on()), _t0(_on ? uclock() : 0) {}
+    // patch 0316: `coarse` is the scope's per-tick log kind (kDosTickLog*), 0 for a fine scope
+    explicit DosPortTickScope(DosPortTickPhaseStats &stats, int coarse = 0)
+        : _stats(stats), _on(coarse != 0 || dos_port_tick_fine_on()), _log((unsigned char)coarse),
+          _t0(_on ? uclock() : 0) {}
     ~DosPortTickScope()
     {
         if (!_on)
@@ -550,11 +569,15 @@ public:
         // was silently discarding real aggregate time. uclock_t is
         // already `long long` (time.h), so this multiply cannot
         // overflow within any real per-call duration this engine sees.
-        dos_port_tick_record_us(_stats, dos_port_tick_elapsed_us(_t0));
+        long long us = dos_port_tick_elapsed_us(_t0);
+        dos_port_tick_record_us(_stats, us);
+        if (_log && dos_port_ticklog_buf)   // patch 0316
+            dos_port_ticklog_add(_log, us < 0 ? 0UL : (unsigned long)(us > 0x0FFFFFFFLL ? 0x0FFFFFFFLL : us));
     }
 private:
     DosPortTickPhaseStats &_stats;
     bool _on;
+    unsigned char _log;   // patch 0316
     uclock_t _t0;
 };
 
diff --git a/Engine/main/game_run.cpp b/Engine/main/game_run.cpp
index 2eed8a9bf..313a8a97b 100644
--- a/Engine/main/game_run.cpp
+++ b/Engine/main/game_run.cpp
@@ -28,6 +28,60 @@
 #include "main/dos_port_tick_timing.h" // DOS-PORT patch 0080
 #ifdef __DJGPP__
 int dos_port_tick_fine_flag = 0; // DOS-PORT patch 0315: set once in ags_entry_point; 0 (off) until then
+
+// DOS-PORT patch 0316: the per-tick coarse log (see dos_port_tick_timing.h). Two 32-bit words a record:
+// the loop counter, then kind << 28 | value (value capped at 28 bits: 268 s of us, or a room number).
+unsigned long *dos_port_ticklog_buf = nullptr;
+static unsigned long dos_port_ticklog_cap = 0, dos_port_ticklog_n = 0, dos_port_ticklog_dropped = 0;
+uint32_t get_loop_counter();   // game_run.h, included further down
+
+void dos_port_ticklog_init(const char *env)
+{
+    const long ticks = (env && env[0]) ? atol(env) : 0;
+    if (ticks <= 0 || ticks > 1000000L)
+        return;
+    // ~1.6 coarse closes a tick in play; 4 records a tick plus room for events leaves margin, and an
+    // overflow is counted, never silent
+    dos_port_ticklog_cap = (unsigned long)ticks * 4UL + 256UL;
+    dos_port_ticklog_buf = (unsigned long *)malloc(dos_port_ticklog_cap * 2UL * sizeof(unsigned long));
+    if (!dos_port_ticklog_buf)
+        dos_port_ticklog_cap = 0;
+}
+
+void dos_port_ticklog_add(unsigned kind, unsigned long value)
+{
+    if (!dos_port_ticklog_buf)
+        return;
+    if (dos_port_ticklog_n >= dos_port_ticklog_cap)
+    {
+        dos_port_ticklog_dropped++;
+        return;
+    }
+    if (value > 0x0FFFFFFFUL)
+        value = 0x0FFFFFFFUL;
+    unsigned long *r = dos_port_ticklog_buf + 2UL * dos_port_ticklog_n++;
+    r[0] = (unsigned long)get_loop_counter();
+    r[1] = ((unsigned long)kind << 28) | value;
+}
+
+void dos_port_ticklog_dump(FILE *log)
+{
+    if (!dos_port_ticklog_buf)
+        return;
+    FILE *f = fopen("TICKS.BIN", "wb");
+    bool ok = false;
+    if (f)
+    {
+        const unsigned long hdr[5] = { 0x474F4C54UL /* 'TLOG' */, 1UL, dos_port_ticklog_n, dos_port_ticklog_dropped,
+                                       dos_port_ticklog_cap };
+        ok = fwrite(hdr, sizeof(hdr), 1, f) == 1 &&
+             fwrite(dos_port_ticklog_buf, 2UL * sizeof(unsigned long), dos_port_ticklog_n, f) == dos_port_ticklog_n;
+        ok = (fclose(f) == 0) && ok;
+    }
+    if (log)
+        fprintf(log, "DOS-PORT ticklog records=%lu dropped=%lu cap=%lu file=TICKS.BIN written=%d\n",
+                dos_port_ticklog_n, dos_port_ticklog_dropped, dos_port_ticklog_cap, ok ? 1 : 0);
+}
 #endif
 #include "main/dos_port_work.h"        // DOS-PORT patch 0230
 #endif
@@ -1870,7 +1924,7 @@ void UpdateGameOnce(bool do_controls, IDriverDependantBitmap *extra_ddb, int ext
     // named sub-phases actually accounts for the whole tick.
 #ifdef __DJGPP__
     DosTickStallScope _dos_tick_stall_scope; // patch 0093
-    DosPortTickScope _dos_port_update_once_scope(dos_port_tick_timing.update_game_once_total, true); // patch 0315: coarse
+    DosPortTickScope _dos_port_update_once_scope(dos_port_tick_timing.update_game_once_total, kDosTickLogUgo); // patch 0315: coarse; 0316: logged
 #endif
     set_our_eip(1000);
 

     const size_t last_batch_to_rend = _spriteBatchDesc.size() - 1;
     for (size_t cur_bat = 0u, last_bat = 0u, cur_spr = 0u; last_bat <= last_batch_to_rend;)
     {
@@ -612,7 +629,22 @@ void SDLRendererGraphicsDriver::RenderToBackBuffer()
             const auto &batch = _spriteBatches[cur_bat];
             // Prepare the transparent surface
             if (batch.Surface && !batch.Opaque)
+            {
+#ifdef __DJGPP__
+                // patch 0125: a full-surface clear per non-opaque batch,
+                // every frame. render_backbuffer is 5.04 ms/tick and 20.2%
+                // of a 16-bit frame -- the largest term nobody has
+                // examined. Looking for STRUCTURE first (how many batches,
+                // how many clears, over how many bytes) rather than
+                // efficiency, because this campaign's biggest win came
+                // from redundancy in an unexamined path and its best
+                // micro-optimisation was 8x smaller.
+                dos_port_tick_timing.rb_clears++;
+                dos_port_tick_timing.rb_clear_px +=
+                    (long long)batch.Surface->GetWidth() * batch.Surface->GetHeight();
+#endif
                 batch.Surface->ClearTransparent();
+            }
         }
 
         // Render immediate batch sprites, if any, update cur_spr iterator
@@ -680,9 +712,18 @@ void SDLRendererGraphicsDriver::RenderToBackBuffer()
 
 size_t SDLRendererGraphicsDriver::RenderSpriteBatch(const ALSpriteBatch &batch, size_t from, Bitmap *surface, int surf_offx, int surf_offy)
 {
+#ifdef __DJGPP__
+  // patch 0125: 1.09 sprites per batch means any per-batch setup is paid
+  // once per sprite rather than amortised. Bracketing the blitting half
+  // separates it from the outer batch loop's own cost.
+  DosPortTickScope _dp_rb_spr(dos_port_tick_timing.rb_sprite_time);
+#endif
   for (; (from < _spriteList.size()) && (_spriteList[from].node == batch.ID); ++from)
   {
     const auto &sprite = _spriteList[from];
+#ifdef __DJGPP__
+    dos_port_tick_timing.rb_sprites++;   // patch 0125
+#endif
     if (sprite.ddb == nullptr)
     {
       if (_spriteEvtCallback)
@@ -702,6 +743,34 @@ size_t SDLRendererGraphicsDriver::RenderSpriteBatch(const ALSpriteBatch &batch,
     }
 
     ALSoftwareBitmap* bitmap = sprite.ddb;
+#ifdef __DJGPP__
+    // patch 0125: MEASURE the composited area instead of assuming a sprite
+    // size. An earlier reading inferred ~2.3 cycles/pixel from an assumed
+    // 100x200 sprite -- but 0.70 ms at this machine's measured 17 MB/s is
+    // only ~12 KB, so the assumed size and the measured time cannot both be
+    // right. Counting pixels settles whether this blit sits at the memory
+    // ceiling (irreducible) or beats it (cache-resident, different ceiling).
+    if (bitmap && bitmap->GetBitmap())
+    {
+        const long _w = bitmap->GetBitmap()->GetWidth();
+        const long _h = bitmap->GetBitmap()->GetHeight();
+        dos_port_tick_timing.rb_sprite_px += (long long)_w * _h;
+        // patch 0166: remember the frame's LARGEST sprite's dimensions.
+        //
+        // A count separates one enormous sprite from many; it does not
+        // separate redundant work from necessary work, which is what
+        // decides whether there is a win. If the same dimensions appear on
+        // every tail frame, an unchanged overlay is being recomposited --
+        // the class that produced every win that landed today. If they
+        // vary, it is real content and the answer is different.
+        if (_w * _h > dos_port_tick_timing.rb_max_spr_px)
+        {
+            dos_port_tick_timing.rb_max_spr_px = _w * _h;
+            dos_port_tick_timing.rb_max_spr_w = _w;
+            dos_port_tick_timing.rb_max_spr_h = _h;
+        }
+    }
+#endif
     int drawAtX = sprite.x + surf_offx;
     int drawAtY = sprite.y + surf_offy;
     const int alpha = bitmap->GetAlpha();
diff --git a/Engine/main/dos_port_tick_timing.h b/Engine/main/dos_port_tick_timing.h

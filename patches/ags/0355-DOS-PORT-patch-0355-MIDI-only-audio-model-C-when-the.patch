     else
@@ -254,7 +274,7 @@ SDL_AudioFormat dos_audio_mixer_format()
 
 bool dos_audio_mixer_init()
 {
-    if (g_stream || g_gus_open)
+    if (g_stream || g_gus_open || g_null_open) // DOS-PORT patch 0355: g_null_open
         return true;
 

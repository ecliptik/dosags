-size_t OpenAlSource::PutData(const SoundBufferPtr & /*data*/)
+OpenAlSource::~OpenAlSource()
 {
-    return 0u;
+    if (_voice >= 0)
+        dos_audio_mixer_voice_release(_voice);
+}
+
+bool OpenAlSource::IsEmpty() const
+{
+    return _voice < 0 || dos_audio_mixer_voice_queued(_voice) == 0u;

     if (g_voices[voice].gus_stream)
         gus_pcm_stream_set_active(g_voices[voice].gus_stream, active);
 }
@@ -653,9 +718,79 @@ static bool dos_topup_would_hole()
     return false;
 }
 
+// DOS-PORT patch 0355 (model C, MIDI-only): what mix_one_chunk() does to the
+// voices, without a device: per MIX_CHUNK_SAMPLES of uclock() time since the last
+// pump (gap capped at NULL_MAX_GAP_CHUNKS chunks), take up to one chunk from each
+// active voice and discard it, counting underruns/drains/mixed as mix_one_chunk()
+// does. With no voice active the time owed is dropped, as an idle SB device plays
+// silence and the next sound starts fresh.
+static void dos_null_drain()
+{
+    const uclock_t now = uclock();
+    uclock_t d = now - g_null_last_uc;
+    g_null_last_uc = now;
+    if (d < 0)
+        d = 0;
+    const uint64_t cap = (uint64_t)NULL_MAX_GAP_CHUNKS * MIX_CHUNK_SAMPLES;
+    const uint64_t num = (uint64_t)d * DOS_AUDIO_MIXER_RATE + g_null_frac;
+    g_null_due += num / UCLOCKS_PER_SEC;
+    g_null_frac = num % UCLOCKS_PER_SEC;
+    if (g_null_due > cap)
+    {
+        g_null_due = cap;
+        g_null_frac = 0;
+        g_null_capped++;
+    }
+    while (g_null_due >= (uint64_t)MIX_CHUNK_SAMPLES)
+    {
+        g_null_due -= MIX_CHUNK_SAMPLES;
+        bool any_active = false, any_underrun = false, any_drain = false;
+        for (int i = 0; i < DOS_AUDIO_MIXER_MAX_VOICES; i++)
+        {
+            Voice &v = g_voices[i];
+            if (!v.used || !v.active)
+                continue;
+            any_active = true;
+            const size_t avail_samples = (v.ring.size() - v.read_pos) / sizeof(int16_t);
+            const size_t take = std::min<size_t>(avail_samples, static_cast<size_t>(MIX_CHUNK_SAMPLES));
+            if (take == 0)
+            {
+                if (v.source_done)
+                    any_drain = true;
+                else
+                    any_underrun = true;
+                continue;
+            }
+            v.read_pos += take * sizeof(int16_t);
+            g_null_vsamples[i] += (uint32_t)take;
+            if (v.read_pos >= v.ring.size())
+            {
+                v.ring.clear();
+                v.read_pos = 0;
+            }
+        }
+        if (!any_active)
+        {
+            g_null_due = 0;
+            g_null_frac = 0;
+            break;
+        }
+        if (any_underrun)
+            g_underruns++;
+        else if (any_drain)
+            g_drains++;
+        g_mixed_chunks++;
+    }
+}

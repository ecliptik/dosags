From d5a923aa9f82fedc82720fa2e628415f6488f261 Mon Sep 17 00:00:00 2001
From: Micheal Waltz <micheal@ecliptik.com>
Date: Wed, 16 Sep 2026 23:13:01 -0700
Subject: [PATCH] DOS-PORT: patch 0084 -- bracket the catch-up path's
 audio_core_entry_poll()

Operator-directed inline-code audit: does UpdateGameOnce() have
substantial work in its own body never delegated to a named sub-call?
Reading the complete literal source top to bottom, statement by
statement, found the function is essentially just a dispatcher --
every substantial call already funnels into an existing bracket, and
everything left directly in the body (set_our_eip() calls, mouse-
position caching, the event-count snapshot, GameTimer.RenderCounter++,
GameUpdateCheckProblems()/check_debug_keys()/
ccNotifyScriptStillAlive()/update_gui_disabled_status(), all read fresh
this round) is confirmed trivial: no loops, no allocation, only rare
state-transition branches that do not fire in a normal run.

One real exception: audio_core_entry_poll() on the catch-up/fast-
forward early-return path (the skip_render_and_wait branch,
patches 0047/0048) is a genuinely substantial function (an audio-slot
poll loop + dos_audio_mixer_pump() + SDL_DOSAudioPump()) and was
completely unbracketed there, despite running on every catch-up tick
-- most ticks, when the game is behind the 40Hz target.
WaitForNextFrame() is this function's only other call site and that
one is already inside the wait_next_frame bracket, so the catch-up
path's own cost was invisible. Bracketed as catchup_audio_poll.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_014hnodGZ6cg8CWuFXEDTsUq
---
 Engine/main/dos_port_tick_timing.h | 11 +++++++++++
 Engine/main/game_run.cpp           | 16 +++++++++++++++-
 Engine/main/quit.cpp               |  1 +
 3 files changed, 27 insertions(+), 1 deletion(-)

diff --git a/Engine/main/dos_port_tick_timing.h b/Engine/main/dos_port_tick_timing.h
index 602561b27..d669e3900 100644
--- a/Engine/main/dos_port_tick_timing.h
+++ b/Engine/main/dos_port_tick_timing.h
@@ -291,6 +291,17 @@ struct DosPortTickTiming
     // rep_exec_wrapper/drawable_object_states do (report this phase's
     // own total alongside, not summed with, script_vm).
     DosPortTickPhaseStats process_events_dispatch; // ac/event.cpp: processallevents()
+
+    // patch 0084 (operator-directed inline-code audit, checking whether
+    // UpdateGameOnce() has substantial work in its own body never
+    // delegated to a named sub-call): reading the complete literal
+    // source top to bottom found exactly one real exception --
+    // audio_core_entry_poll() on the catch-up/fast-forward early-return
+    // path, called on EVERY skip_render_and_wait tick (most ticks, when
+    // the game is running behind the 40Hz target), never bracketed.
+    // WaitForNextFrame() (ac/timer.cpp) is this function's only other
+    // call site and that one is already inside wait_next_frame.
+    DosPortTickPhaseStats catchup_audio_poll; // main/game_run.cpp: UpdateGameOnce()'s catch-up-path audio_core_entry_poll()
 };
 
 // Defined in main.cpp, alongside dos_port_startup_timing.
diff --git a/Engine/main/game_run.cpp b/Engine/main/game_run.cpp
index e1ccc7e0d..7296cc670 100644
--- a/Engine/main/game_run.cpp
+++ b/Engine/main/game_run.cpp
@@ -1658,7 +1658,21 @@ void UpdateGameOnce(bool do_controls, IDriverDependantBitmap *extra_ddb, int ext
         // path, and a full mixdown on every one of those calls measured
         // as a real fps regression (~35%) on this same harness.
 #if defined(AGS_DISABLE_THREADS)
-        audio_core_entry_poll();
+        // DOS-PORT patch 0084 (operator-directed inline-code audit): the
+        // one real, non-trivial call left directly in UpdateGameOnce()'s
+        // own body, never delegated to any named sub-phase -- found by
+        // reading this function's complete literal source top to bottom.
+        // Runs on EVERY catch-up tick (DOSAGS_FIXED_TIMESTEP's
+        // skip_render_and_wait path, patches 0047/0048), not just the
+        // ~1-in-5.56 ticks that actually render; WaitForNextFrame()
+        // (ac/timer.cpp) is this function's only other call site, and
+        // that one IS already inside the wait_next_frame bracket.
+        {
+#ifdef __DJGPP__
+            DosPortTickScope _dos_port_catchup_audio_scope(dos_port_tick_timing.catchup_audio_poll);
+#endif
+            audio_core_entry_poll();
+        }
 #endif
         return;
     }
diff --git a/Engine/main/quit.cpp b/Engine/main/quit.cpp
index fe068437c..2a409a02f 100644
--- a/Engine/main/quit.cpp
+++ b/Engine/main/quit.cpp
@@ -503,6 +503,7 @@ void quit(const char *quitmsg)
                 dos_port_tick_emit(run_manifest_log, "rep_exec_wrapper", t.rep_exec_wrapper);
                 dos_port_tick_emit(run_manifest_log, "drawable_object_states", t.drawable_object_states);
                 dos_port_tick_emit(run_manifest_log, "process_events_dispatch", t.process_events_dispatch);
+                dos_port_tick_emit(run_manifest_log, "catchup_audio_poll", t.catchup_audio_poll);
             }
 
             // TEMPORARY DIAGNOSTIC (S7): dump the AUDIOPRB window data

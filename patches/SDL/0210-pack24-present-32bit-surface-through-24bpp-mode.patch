+            fprintf(stdout, "DOS-PORT pack24 engaged mode=0x%04X %dx%d vram_pitch=%d src_pitch=%d path=%s\n",
+                    mdata->mode_id, mdata->w, mdata->h, vram_pitch, surface->pitch,
+                    use_lfb_path ? "lfb" : "banked");
+            fflush(stdout);
+            atexit(dos_pack24_report);
+        }
+    }
 
     if (use_lfb_path) {
         // LFB nearptr -- DPMI-mapped VRAM linear address.
@@ -1643,6 +1703,20 @@ static void BankedFramebufferCopyRect(const SDL_DisplayModeData *mdata,
     const int bytes_per_pixel = SDL_BYTESPERPIXEL(src->format);
     const int row_bytes = src_rect->w * bytes_per_pixel;
 
+    // patch 0210: packed-24 mode, 4-byte source: pack each row, then the banked copy.
+    if (mdata->bpp == 24 && bytes_per_pixel == 4) {
+        static Uint8 row24[4096 * 3];
+        const int w = src_rect->w > 4096 ? 4096 : src_rect->w;
+        for (int y = 0; y < src_rect->h; y++) {
+            const Uint32 *src_row = (const Uint32 *)((const Uint8 *)src->pixels + (src_rect->y + y) * src->pitch) + src_rect->x;
+            Uint32 dst_offset = (Uint32)(dst_y + src_rect->y + y) * dst_pitch + (Uint32)(dst_x + src_rect->x) * 3;
+            dos_pack24_row(row24, src_row, w);
+            BankedDosmemput(row24, (Uint32)(w * 3), dst_offset,
+                            win_gran_bytes, win_size_bytes, win_base, win_func_ptr, current_bank);
+        }
+        return;
+    }
+
     // Fast path: if the source row width matches src pitch AND the destination
     // row width matches dst pitch, the data is contiguous in both source and
     // destination — we can copy it as one flat block, minimizing dosmemput calls.
@@ -1744,10 +1818,64 @@ static void _dos_port_dbg_dump_first16(const char *tag, const Uint8 *src, int n)
     dos_port_dbg_log("%s", buf);
 }
 
+// DOS-PORT patch 0210: the direct-FB push for a packed-24 mode. Same rect clipping as the
+// other branches; each row is packed 4->3 bytes straight into the LFB (three dword stores per
+// four pixels, at the card's 24-bpp write rate), or into a row buffer for the banked window.
+static void dos_pack24_push(const SDL_Rect *rects, int numrects)
+{
+    static Uint8 row24[4096 * 3];
+    const int src_pitch = fb_state.src_pitch;
+    const int dst_pitch = fb_state.vram_pitch;
+    int current_bank = -1;
+    for (int i = 0; i < numrects; i++) {
+        int rx = rects[i].x, ry = rects[i].y;
+        int rw = rects[i].w, rh = rects[i].h;
+        if (rx < 0) {
+            rw += rx;
+            rx = 0;
+        }
+        if (ry < 0) {
+            rh += ry;
+            ry = 0;
+        }
+        if (rx + rw > fb_state.vram_w) {
+            rw = fb_state.vram_w - rx;
+        }
+        if (ry + rh > fb_state.vram_h) {
+            rh = fb_state.vram_h - ry;
+        }
+        if (rw <= 0 || rh <= 0) {
+            continue;
+        }
+        if (rw > 4096) {
+            rw = 4096;
+        }
+        for (int row = 0; row < rh; row++) {
+            const Uint32 *sp = (const Uint32 *)(fb_state.pixels + (ry + row) * src_pitch) + rx;
+            const Uint32 dst_off = (Uint32)(ry + row) * (Uint32)dst_pitch + (Uint32)rx * 3;
+            if (!fb_state.use_dosmemput) {
+                Uint8 *dp = fb_state.vram_ptr + dst_off;
+                dos_pack24_row(dp, sp, rw);
+            } else {
+                dos_pack24_row(row24, sp, rw);
+                if (!fb_state.banked_multibank) {
+                    dosmemput(row24, rw * 3, fb_state.vram_phys + dst_off);
+                } else {
+                    BankedDosmemput(row24, (Uint32)(rw * 3), dst_off, fb_state.win_gran_bytes,
+                                    fb_state.win_size_bytes, fb_state.win_base, fb_state.win_func_ptr,
+                                    &current_bank);
+                }
+            }
+        }
+        dos_pack24_pushed_px += (unsigned long)rw * (unsigned long)rh;
+    }
+}

         if (self_us > DOS_TICK_STALL_THRESHOLD_US)
         {
             if (dos_tick_stall_total < DOS_TICK_STALL_CAP)
@@ -1672,6 +1730,8 @@ private:
     uclock_t _t0;
     long long _saved_children;
     uint32_t _index;
+    long long _w0[kDW_Count];             // patch 0230
+    long long _saved_child_w[kDW_Count];  // patch 0230
 };
 
 // Per-real-second cumulative series, so real-vs-skipped presents can be
@@ -1685,7 +1745,9 @@ private:
 // taken at the end of a tick, so NO row is sampled during a multi-second
 // blocking stall (a room transition, a Display(), a save) and adjacent
 // rows can be 20 s apart. Per-phase rates need the real elapsed time.
-struct DosPerSec { uint32_t tick; uint32_t renders; long real; long skipped; long ms; };
+struct DosPerSec { uint32_t tick; uint32_t renders; long real; long skipped; long ms;
+                   // patch 0230: cumulative work, sampled at the same point
+                   long long ins, push, blit, spr_px, bg_px, file; };
 static DosPerSec dos_persec[DOS_PERSEC_CAP];
 static int dos_persec_count = 0;
 
@@ -1698,6 +1760,16 @@ static void dos_persec_sample()
     r.renders = GameTimer.RenderCounter;
     r.real = dos_port_tick_timing.presents_real;
     r.skipped = dos_port_tick_timing.presents_skipped;
+    {   // patch 0230
+        long long w[kDW_Count];
+        dos_port_work_snapshot(w);
+        r.ins = w[kDW_ScriptIns];
+        r.push = w[kDW_PushBytes];
+        r.blit = w[kDW_Blit1xBytes] + w[kDW_BlitScBytes];
+        r.spr_px = w[kDW_SprOpqPx] + w[kDW_SprMskPx] + w[kDW_SprBldPx];
+        r.bg_px = w[kDW_BgPx];
+        r.file = w[kDW_FileBytes];
+    }
     {
         extern uclock_t dos_port_engine_start_uclock;
         r.ms = (long)((uclock() - dos_port_engine_start_uclock) * 1000 / UCLOCKS_PER_SEC);
@@ -1741,6 +1813,45 @@ void dos_port_yardstick_emit(FILE *log)
         fprintf(log, "DOS-PORT persec t=%d tick=%lu renders=%lu real=%ld skipped=%ld ms=%ld\n",
             i + 1, (unsigned long)dos_persec[i].tick, (unsigned long)dos_persec[i].renders,
             dos_persec[i].real, dos_persec[i].skipped, dos_persec[i].ms);
+
+    // patch 0230: the work vector. "steady" covers exactly the ticks
+    // tick_rate_steady covers (first tick entry to last tick exit, stall ticks'
+    // self work removed); "excluded" is everything else in the run (before the
+    // loop, stall ticks, after the loop). steady + excluded = the whole run.
+    {
+        static const char *const DWN[kDW_Count] = {
+            "ticks", "renders", "presents", "script_ins", "script_ext",
+            "push_bytes", "push_rects", "blit1x_bytes", "blitsc_bytes",
+            "cmp_bytes", "cache_bytes", "bg_px", "fill_px", "spr_n",
+            "spr_opq_px", "spr_msk_px", "spr_bld_px", "file_bytes", "file_calls" };
+        long long now[kDW_Count], steady[kDW_Count], excl[kDW_Count];
+        dos_port_work_snapshot(now);
+        for (int i = 0; i < kDW_Count; i++)
+        {
+            steady[i] = dos_work_last[i] - dos_work_first[i] - dos_work_excluded[i];
+            excl[i] = now[i] - steady[i];
+        }
+        for (int pass = 0; pass < 2; pass++)
+        {
+            const long long *v = pass == 0 ? steady : excl;
+            fprintf(log, "DOS-PORT work scope=%s", pass == 0 ? "steady" : "excluded");
+            for (int i = 0; i < kDW_Count; i++)
+                fprintf(log, " %s=%lld", DWN[i], v[i]);
+            // script_ins is counted only in a lab build (cc_instance.cpp); say which,
+            // so a 0 from a timed build is never read as "no script ran"
+#ifdef DOSAGS_WORK_SCRIPT_INS
+            const int ins_counted = 1;
+#else
+            const int ins_counted = 0;
+#endif
+            fprintf(log, " vs_bpp=%d win_bpp=%d win=%dx%d script_ins_counted=%d\n", dos_port_work_vs_bpp,
+                dos_port_work_win_bpp, dos_port_work_win_w, dos_port_work_win_h, ins_counted);
+        }
+        for (int i = 0; i < dos_persec_count; i++)
+            fprintf(log, "DOS-PORT workpersec t=%d ins=%lld push=%lld blit=%lld spr_px=%lld bg_px=%lld file=%lld\n",
+                i + 1, dos_persec[i].ins, dos_persec[i].push, dos_persec[i].blit,
+                dos_persec[i].spr_px, dos_persec[i].bg_px, dos_persec[i].file);
+    }
 }
 #endif // __DJGPP__
 

+    if (dos_lab_pair("DOSAGS_LAB_CR_BASEL", dos_lab_bas_k, dos_lab_bas_ch, 0) <= 0 || charid != dos_lab_bas_ch) return 0;
+    if (((dos_cr_scene / dos_lab_bas_k) & 1) == 0) return 0;

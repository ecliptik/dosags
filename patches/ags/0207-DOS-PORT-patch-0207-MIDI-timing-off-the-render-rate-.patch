+// DOS-PORT (patch 0207): the one MIDI player that owns the ISR replay (the
+// queue is global); any other plays on the main-loop poll.
+static AudioPlayer *s_midiIsrOwner = nullptr;
+
+void AudioPlayer::MidiIsrBegin()
+{
+    _midiIsr = false;
+    uint32_t lookahead = 0;
+    const int kind = dos_midi_backend_defer_kind(_midiBackendKind);
+    const char *force = std::getenv("DOSAGS_MIDI_TICK");
+    const bool force_poll = force && std::strcmp(force, "poll") == 0;
+    int period = 0;
+    if (!force_poll && kind != 0 && s_midiIsrOwner == nullptr && SDL_DOSMidiDeferIrqNow() > 0
+        && (period = SDL_DOSMidiDeferIrqPeriodUs()) > 0 && SDL_DOSMidiDeferEnable(kind))
+    {
+        const char *la = std::getenv("DOSAGS_MIDI_LOOKAHEAD_MS");
+        const long la_ms = (la && la[0]) ? std::strtol(la, nullptr, 10) : 2000;
+        lookahead = (uint32_t)((la_ms > 0 ? la_ms : 2000) * 1000 / period);
+        if (lookahead < 4)
+            lookahead = 4;
+        _midiIsr = true;
+        s_midiIsrOwner = this;
+        _midiPeriodUs = (uint32_t)period;
+        _midiLookIrqs = lookahead;
+        _midiLastIrq = SDL_DOSMidiDeferIrqNow();
+        _midiPlanUs = (uint64_t)(_midiLastIrq + 2) * _midiPeriodUs;
+        _midiShiftUs = _midiPlanUs;
+        _midiResumed = false;
+    }
+    dos_midi_backend_set_tick_mode(_midiIsr, _midiIsr ? _midiPeriodUs : 0, lookahead);
+}
+
+void AudioPlayer::MidiIsrEnd(bool flush)
+{
+    if (!_midiIsr)
+        return;
+    if (flush)
+        SDL_DOSMidiDeferFlush(); // drop the writes planned ahead of now
+    SDL_DOSMidiDeferSetStamp(SDL_DOSMidiDeferIrqNow()); // what follows goes out at once
+}
+
+// Plan the song ahead to now + lookahead, one IRQ slot at a time; every
+// port write the sink makes in a slot is stamped for that slot's IRQ.
+void AudioPlayer::MidiIsrPlan()
+{
+    const uint32_t now = SDL_DOSMidiDeferIrqNow();
+    // The first plannable slot is two IRQs out: an entry stamped now + 1 can
+    // miss its IRQ if that IRQ fires while the plan is still being written.
+    const uint64_t floor_us = (uint64_t)(now + 2) * _midiPeriodUs;
+    if (_midiPlanUs < floor_us)
+    {
+        // Fell behind the device (a stall longer than the lookahead) or
+        // resumed from a pause: skip the gap in SONG time instead of
+        // replaying it late, all at once.
+        if (!_midiResumed)
+            dos_midi_backend_note_plan_behind();
+        _midiShiftUs += floor_us - _midiPlanUs;
+        _midiPlanUs = floor_us;
+    }
+    _midiResumed = false;
+    const uint64_t horizon = (uint64_t)(now + _midiLookIrqs) * _midiPeriodUs;
+    while (_midiPlanUs + _midiPeriodUs <= horizon && SDL_DOSMidiDeferFree() > 512)
+    {
+        _midiPlanUs += _midiPeriodUs;
+        SDL_DOSMidiDeferSetStamp((uint32_t)(_midiPlanUs / _midiPeriodUs));
+        midi_sched_tick(_midiSched, MidiSongMs());
+    }
+    SDL_DOSMidiDeferSetStamp(now); // anything written outside the plan goes out at once
+    dos_midi_backend_note_tick(0, (uint32_t)((uint64_t)(now - _midiLastIrq) * _midiPeriodUs / 1000u),
+        get_loop_counter());
+    _midiLastIrq = now;
+}
+
 AudioPlayer::~AudioPlayer()
 {
     if (!_isMidi)
         return;
+    MidiIsrEnd(true); // DOS-PORT (patch 0207)
     if (_midiSched) midi_sched_close(_midiSched);
     // DOS-PORT (S5): dos_midi_backend_end_song(), not a direct close --
     // for opl3 this closes and nulls the handle exactly as the old direct
@@ -99,6 +176,14 @@ AudioPlayer::~AudioPlayer()
     // once at engine shutdown, not per AudioPlayer instance). See
     // dos_midi_backend.h's own doc comment.
     dos_midi_backend_end_song(_midiSink, _midiBackendKind);
+    // DOS-PORT (patch 0207): write out the note-offs just queued, then
+    // release the replay for the next song.
+    if (_midiIsr)
+    {
+        SDL_DOSMidiDeferEnable(0);
+        s_midiIsrOwner = nullptr;
+        _midiIsr = false;
+    }
 }
 
 uint64_t AudioPlayer::MidiNowMsRaw()
@@ -161,7 +246,8 @@ void AudioPlayer::MidiInit()
             const char *silent = std::getenv("DOSAGS_MIDI_SILENT_CHIP");
             if (!(silent && silent[0] == '1' && silent[1] == '\0'))
             {
-                midi_sched_start(_midiSched, MidiNowMs());
+                MidiIsrBegin(); // DOS-PORT (patch 0207)
+                midi_sched_start(_midiSched, _midiIsr ? MidiSongMs() : MidiNowMs());
             }
         }
     }
@@ -248,6 +334,17 @@ void AudioPlayer::MidiPoll()
     if (!_midiSched || !_midiSink)
         return;
 
+    if (_midiIsr) // DOS-PORT (patch 0207): planned ahead, replayed by the SB IRQ
+    {
+        MidiIsrPlan();
+        const uint64_t total_isr = midi_sched_dispatched(_midiSched);
+        if (total_isr > _midiLastDispatched)
+        {
+            dos_midi_backend_add_dispatched(total_isr - _midiLastDispatched);
+            _midiLastDispatched = total_isr;
+        }
+        return;
+    }
     {
         const uclock_t t0 = uclock(); /* TEMPORARY DIAGNOSTIC, see above */
         midi_sched_tick(_midiSched, MidiNowMs());
@@ -326,7 +423,9 @@ void AudioPlayer::MidiPlay()
             // DOS-PORT (S5 GUS architecture): same ordering requirement as
             // MidiInit() above -- see that call site's own comment.
             dos_midi_backend_prepare_song(_midiSink, _midiBackendKind, _midiSched);
-            midi_sched_start(_midiSched, MidiNowMs());
+            MidiIsrBegin(); // DOS-PORT (patch 0207)
+            _midiLastDispatched = 0;
+            midi_sched_start(_midiSched, _midiIsr ? MidiSongMs() : MidiNowMs());
         }
         _playState = (_midiSched && _midiSink) ? PlayStatePlaying : PlayStateError;
         break;
@@ -343,6 +442,7 @@ void AudioPlayer::MidiPlay()
             _midiPauseStartedMs = 0;
         }
         _playState = PlayStatePlaying;
+        _midiResumed = true; // DOS-PORT (patch 0207): the next plan rebases, not "behind"
         break;
     default:
         break;
@@ -421,7 +521,14 @@ void AudioPlayer::MidiStop()
         // opl3_sink_close() call (MidiPlay() reopens and rebinds on the
         // next Stopped -> Playing transition, unchanged). For wb this is
         // silence-only and the handle survives -- see dos_midi_backend.h.
+        MidiIsrEnd(true); // DOS-PORT (patch 0207): drop the planned-ahead writes first
         dos_midi_backend_end_song(_midiSink, _midiBackendKind);
+        if (_midiIsr) // then write the note-offs out now and release the replay
+        {
+            SDL_DOSMidiDeferEnable(0);
+            s_midiIsrOwner = nullptr;
+            _midiIsr = false;
+        }
         _midiPauseOffsetMs = 0;
         _midiPauseStartedMs = 0;
         break;

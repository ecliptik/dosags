+++ b/Engine/media/audio/audio_core.cpp
@@ -209,6 +209,12 @@ extern uclock_t dos_port_engine_start_uclock;
 // audio_core_entry_poll() invocation below so each call's own register-
 // write cost is attributed to the right AudioPollWindow, not smeared
 // across window boundaries.
+// DOS-PORT patch 0218: SDL patch 0199's switch. Everything below that reads the clock (the three per-poll
+// reads here, and every SDL/ags bracket the snapshots below collect) runs only when
+// SDL_HINT_DOS_AUDIO_DIAG_TIMING is set. Default off: those were ~6 unguarded PIT reads a tick on the 486
+// (LAB-MMD 44) that no current gate reads. With it off, the poll is only counted.
+extern "C" bool SDL_DOSAudioDiagTiming(void);
+
 extern "C" void SDL_DOSOpl3RegWriteDiagSnapshot(
     uint32_t *out_calls, uint32_t *out_min_us, uint32_t *out_mean_us, uint32_t *out_max_us);
 
@@ -425,6 +431,11 @@ struct AudioPollDiag
     uint32_t prepsong_calls_sum = 0;
     uint64_t prepsong_us_sum = 0, prepsong_min_us = UINT64_MAX, prepsong_max_us = 0;
 
+    // DOS-PORT patch 0218: whole-run pump totals and a per-call histogram (< 1, 1-5, 5-9, >= 9 ms), which,
+    // unlike the windows, never drop anything.
+    uint64_t pump_total_us = 0, slots_total_us = 0;
+    uint32_t pump_hist[4] = { 0, 0, 0, 0 };
+
     AudioPollWindow windows[AUDIO_POLL_DIAG_MAX_WINDOWS];
     uint32_t windows_recorded = 0;
     uint32_t windows_dropped = 0;   // AUDIO_POLL_DIAG_MAX_WINDOWS exceeded
@@ -542,6 +553,9 @@ void dos_diag_record_audio_poll(uint64_t slots_us, uint64_t pump_us)
     if (slots_us < d.slots_min_us) d.slots_min_us = slots_us;
     if (slots_us > d.slots_max_us) d.slots_max_us = slots_us;
     d.pump_sum_us += pump_us;
+    d.pump_total_us += pump_us;
+    d.slots_total_us += slots_us;
+    d.pump_hist[pump_us < 1000 ? 0 : pump_us < 5000 ? 1 : pump_us < 9000 ? 2 : 3]++;
     if (pump_us < d.pump_min_us) d.pump_min_us = pump_us;
     if (pump_us > d.pump_max_us) d.pump_max_us = pump_us;
     if (d.window_calls >= AUDIO_POLL_DIAG_WINDOW)
@@ -696,9 +710,21 @@ void dos_diag_dump_audio_poll(FILE *fp)
     if (!fp)
         return;
     AudioPollDiag &d = g_audio_poll_diag;
+    if (!SDL_DOSAudioDiagTiming())
+    {
+        // DOS-PORT patch 0218: nothing was timed; say so rather than print zero-cost windows.
+        fprintf(fp, "DOS-PORT audioprb timing=off total_calls=%lu (SDL_HINT_DOS_AUDIO_DIAG_TIMING=1 to time)\n",
+            (unsigned long)d.total_calls);
+        return;
+    }
     // Fold the still-in-progress partial window in too, so a run that
     // exits mid-window doesn't silently lose its tail.
     dos_diag_close_window();
+    fprintf(fp, "DOS-PORT audioprb pump_hist calls=%lu pump_total_us=%llu slots_total_us=%llu "
+        "lt1ms=%lu 1to5ms=%lu 5to9ms=%lu ge9ms=%lu\n",
+        (unsigned long)d.total_calls, (unsigned long long)d.pump_total_us,
+        (unsigned long long)d.slots_total_us, (unsigned long)d.pump_hist[0],
+        (unsigned long)d.pump_hist[1], (unsigned long)d.pump_hist[2], (unsigned long)d.pump_hist[3]);
     fprintf(fp, "DOS-PORT audioprb total_calls=%lu windows_recorded=%lu windows_dropped=%lu\n",
         (unsigned long)d.total_calls, (unsigned long)d.windows_recorded,
         (unsigned long)d.windows_dropped);
@@ -754,48 +780,52 @@ void dos_diag_dump_audio_poll(FILE *fp)
 void audio_core_entry_poll()
 {
 #ifdef __DJGPP__
-    const uint64_t t_entry_us = dos_diag_now_us();
-    // Discard-snapshot: SDL_DOSOpl3WriteRegister() can also be called from
-    // OUTSIDE this function entirely -- e.g. opl3_sink_open() ->
-    // SDL_DOSOpl3InitChip() at MIDI-slot-creation time

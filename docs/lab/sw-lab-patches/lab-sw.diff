+// LAB-SW (lab only, never a patch): counters and a call trace for the restart-point save write.
+// DOSAGS_SW unset/0 = off (one test per hook). =1 counters + trace (SWTRACE.TXT). =2 also a dry
+// serialisation into memory after the real write, compared byte for byte with the file.
+#ifndef __AGS_CN_UTIL__DOS_SW_LAB_H
+#define __AGS_CN_UTIL__DOS_SW_LAB_H
+#ifdef __DJGPP__
+#include <stddef.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+extern volatile int dos_sw_active;   // 1 only inside the slot-999 SaveGame()
+int  dos_sw_mode_get(void);
+void dos_sw_begin(void);
+void dos_sw_end(void);
+void dos_sw_bs_write(long long pos, size_t size);                    // BufferedStream::Write (logical)
+void dos_sw_bs_flush(long long bufpos, size_t size, long long topos); // BufferedStream::FlushBuffer
+void dos_sw_fs_event(char kind, long a, long b, unsigned long long dt); // FileStream: O/W/S/C/F
+void dos_sw_dump(const char *path, long savegame_ms, const char *extra);
+#ifdef __cplusplus
+}
+#endif
+#endif

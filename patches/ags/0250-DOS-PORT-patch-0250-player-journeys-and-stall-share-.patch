diff --git a/Engine/platform/dos/dos_journeys.cpp b/Engine/platform/dos/dos_journeys.cpp
new file mode 100644
index 000000000..3d9039a55
--- /dev/null
+++ b/Engine/platform/dos/dos_journeys.cpp
@@ -0,0 +1,665 @@
+//=============================================================================
+//
+// Adventure Game Studio (AGS)
+//
+// Copyright (C) 1999-2011 Chris Jones and 2011-2026 various contributors
+// The full list of copyright holders can be found in the Copyright.txt
+// file, which is part of this source code distribution.
+//
+// The AGS source code is provided under the Artistic License 2.0.
+// A copy of this license can be found in the file License.txt and at
+// https://opensource.org/license/artistic-2-0/
+//
+//=============================================================================
+//
+// DOS-PORT patch 0250: player journeys and stall share. See dos_journeys.h
+// for the definitions; this file is the bookkeeping and the report.
+//
+//=============================================================================
+#include "platform/dos/dos_journeys.h"
+
+#ifdef __DJGPP__
+#include <stdint.h>
+#include <stdlib.h>
+#include <time.h>          // uclock, uclock_t, UCLOCKS_PER_SEC
+#include <algorithm>
+#include <SDL3/SDL.h>
+#include <SDL3/SDL_dosinput_stats.h>   // SDL patch 0220
+#include "ac/gamestate.h"              // play.screen_is_faded_out
+#include "ac/runtime_defines.h"        // RESTART_POINT_SAVE_GAME_NUMBER
+
+extern uclock_t dos_port_engine_start_uclock;   // main.cpp, patch 0042
+extern int displayed_room;
+extern "C" {
+extern volatile uint32_t dos_port_kbd_irq_count;    // SDL_dosevents.c: bytes from IRQ 1
+extern volatile uint32_t dos_port_kbd_drain_count;  // SDL_dosevents.c: bytes the pump drained
+}
+
+namespace
+{
+
+enum JourneyKind
+{
+    kJ_Boot, kJ_Room, kJ_Save, kJ_SaveRestartPoint, kJ_Load,
+    kJ_Click, kJ_ClickSim, kJ_Key, kJ_Count
+};
+const char *const kJourneyName[kJ_Count] =
+    { "boot", "room", "save", "save_restartpoint", "load", "click", "click_sim", "key" };
+
+// flags on a finished record
+const unsigned kJF_Dropped      = 1u << 0; // input: dequeued by the drop path, not handled
+const unsigned kJF_TsFallback   = 1u << 1; // input: event carried no usable timestamp; poll time = dequeue time
+const unsigned kJF_RoomChanged  = 1u << 2; // load: first unfaded present showed a room other than the restored one
+const unsigned kJF_Failed       = 1u << 3; // load: restore failed (ms = request -> failure)
+const unsigned kJF_Retargeted   = 1u << 4; // room: the target changed before the fade-in (leaves-screen redirect)
+const unsigned kJF_EndedInFade  = 1u << 5; // room/boot: left before any present after the fade-in; end = the fade's last present
+
+struct JRec
+{
+    unsigned char kind;
+    unsigned char flags;
+    short a, b;       // room: from/to; save/load: slot/room; boot: -/room
+    long t_ms;        // start, engine-start-relative
+    long ms;          // start -> end present
+    long sub1_ms;     // room: start -> fade-in end; save: write; load: restore; input: poll -> dequeue
+    long sub2_ms;     // input: dequeue -> present; boot/room: fade-in end -> present
+    long bound_ms;    // input: upper bound on the unseen wait before the poll (SDL 0220); else 0
+};
+
+// 256 records x 28 bytes: DJGPP stores .bss in the image, so the cap is file
+// size; a run with more journeys than this counts them in overflow=.
+const int kRecCap = 256;
+JRec g_rec[kRecCap];
+int g_nrec = 0;
+long g_rec_overflow[kJ_Count];
+long g_superseded[kJ_Count];
+long g_retargeted[kJ_Count];
+long g_cleared[kJ_Count];
+long g_rerequested[kJ_Count];   // save/load: a request while an earlier one had not yet run
+
+struct Pend
+{
+    bool active;
+    bool armed;       // waiting for its end present
+    uclock_t start;
+    uclock_t mid;     // fade-in end / save done / restore done
+    int a, b;
+    long sub1_us;
+    unsigned flags;
+    uclock_t exec;    // save_game() / try_restore_save() entry
+};
+Pend p_boot = { true, false, 0, 0, -1, -1, 0, 0, 0 };
+Pend p_room, p_save, p_load;
+int g_armed = 0;      // number of armed Pend entries (fast test in the present hook)
+bool g_boot_done = false;
+bool g_in_fadein = false;
+uclock_t g_fadein_begin_u = 0;
+uclock_t g_last_present_u = -1;   // last present attempt, any
+bool g_fade_presented = false;    // the last fade-in presented at least one frame
+int g_title_room = -2; // -2: env not read yet; -1: first room
+
+struct PendIn
+{
+    unsigned char kind;
+    unsigned char flags;
+    uclock_t recv, deq;
+    long bound_ms;
+};
+const int kPendInCap = 16;
+PendIn p_in[kPendInCap];
+int p_in_n = 0;
+long g_in_pend_overflow = 0;
+
+// ---- stall share / stalls > 100 ms (present-attempt basis) ----
+bool s_have = false;
+uclock_t s_first = 0, s_last = 0;
+int s_floor = -1;                 // DOSAGS_JOURNEY_FPS_FLOOR, default 39
+long s_win_idx = 0, s_win_count = 0;
+bool s_win_busy = false;
+long s_windows = 0, s_below = 0, s_windows_nj = 0, s_below_nj = 0;
+long s_win_min_nj = -1;
+long s_presents = 0;
+long s_stalls = 0, s_stalls_busy = 0;
+uclock_t s_stall_sum = 0, s_stall_sum_busy = 0, s_stall_max = 0;
+const int kStallListCap = 48;
+struct StallRec { long t_ms; long ms; bool busy; };
+StallRec s_list[kStallListCap];
+int s_list_n = 0;
+
+inline uclock_t now_u() { return uclock() - dos_port_engine_start_uclock; }
+inline long u2ms(uclock_t u) { return (long)(u * 1000 / UCLOCKS_PER_SEC); }
+inline long us2ms(long us) { return us / 1000; }
+
+bool journey_busy()
+{
+    return p_boot.active || p_room.active || p_save.active || p_load.active;
+}
+
+JRec *add_rec(int kind, unsigned flags, int a, int b, uclock_t start, uclock_t end,
+              long sub1_ms, long sub2_ms)
+{
+    if (g_nrec >= kRecCap)
+    {
+        g_rec_overflow[kind]++;
+        return nullptr;
+    }
+    JRec &r = g_rec[g_nrec++];
+    r.kind = (unsigned char)kind;
+    r.flags = (unsigned char)flags;
+    r.a = (short)a;
+    r.b = (short)b;
+    r.t_ms = u2ms(start);
+    r.ms = u2ms(end - start);
+    r.sub1_ms = sub1_ms;
+    r.sub2_ms = sub2_ms;
+    r.bound_ms = 0;
+    return &r;
+}
+
+void arm(Pend &p, uclock_t t)
+{
+    if (!p.armed)
+    {
+        p.armed = true;
+        g_armed++;
+    }
+    p.mid = t;
+}
+
+void disarm(Pend &p)
+{
+    if (p.armed)
+        g_armed--;
+    p.armed = false;
+    p.active = false;
+}
+
+void close_window(long count, bool busy)
+{
+    s_windows++;
+    if (count < s_floor)
+        s_below++;
+    if (!busy)
+    {
+        s_windows_nj++;
+        if (count < s_floor)
+            s_below_nj++;
+        if (s_win_min_nj < 0 || count < s_win_min_nj)
+            s_win_min_nj = count;
+    }
+}
+
+void stall_account(uclock_t t)
+{
+    const bool busy = journey_busy();
+    s_presents++;
+    if (!s_have)
+    {
+        if (s_floor < 0)
+        {
+            const char *e = getenv("DOSAGS_JOURNEY_FPS_FLOOR");
+            s_floor = (e && atoi(e) > 0) ? atoi(e) : 39;
+        }
+        s_have = true;
+        s_first = s_last = t;
+        s_win_idx = 0;
+        s_win_count = 1;
+        s_win_busy = busy;
+        return;
+    }
+    const uclock_t gap = t - s_last;
+    if (gap > UCLOCKS_PER_SEC / 10)
+    {
+        s_stalls++;
+        s_stall_sum += gap;
+        if (gap > s_stall_max)
+            s_stall_max = gap;
+        if (busy)
+        {
+            s_stalls_busy++;
+            s_stall_sum_busy += gap;
+        }
+        if (s_list_n < kStallListCap)
+        {
+            StallRec &sr = s_list[s_list_n++];
+            sr.t_ms = u2ms(t);
+            sr.ms = u2ms(gap);
+            sr.busy = busy;
+        }
+    }
+    const long idx = (long)((t - s_first) / UCLOCKS_PER_SEC);
+    if (idx != s_win_idx)
+    {
+        close_window(s_win_count, s_win_busy || busy);
+        const long empty = idx - s_win_idx - 1;   // whole seconds with no present at all
+        if (empty > 0)
+        {
+            s_windows += empty;
+            s_below += empty;                     // 0 presents < any floor
+            if (!busy)
+            {
+                s_windows_nj += empty;
+                s_below_nj += empty;
+                s_win_min_nj = 0;
+            }
+        }
+        s_win_idx = idx;
+        s_win_count = 0;
+        s_win_busy = false;
+    }
+    s_win_count++;
+    if (busy)
+        s_win_busy = true;
+    s_last = t;
+}
+
+int input_kind(const SDL_Event &evt)
+{
+    if (evt.type == SDL_EVENT_MOUSE_BUTTON_DOWN)
+        return (evt.button.which == SDL_TOUCH_MOUSEID) ? kJ_ClickSim : kJ_Click;
+    if (evt.type == SDL_EVENT_KEY_DOWN && !evt.key.repeat)
+        return kJ_Key;
+    return -1;
+}
+
+// upper = true: ms + the input wait bound (a record with an unknown bound
+// counts its bare ms, and is counted in the summary's bound_unknown=)
+void percentiles(int kind, bool upper, long &n, long &p50, long &p95, long &mx)
+{
+    long v[kRecCap];   // 1 KB of stack, once, at exit
+    n = 0;
+    for (int i = 0; i < g_nrec; ++i)
+        if (g_rec[i].kind == kind && !(g_rec[i].flags & kJF_Failed))
+            v[n++] = g_rec[i].ms + ((upper && g_rec[i].bound_ms > 0) ? g_rec[i].bound_ms : 0);
+    p50 = p95 = mx = -1;
+    if (n == 0)
+        return;
+    std::sort(v, v + n);
+    // nearest rank: the smallest value with at least p of the sample at or below it
+    p50 = v[(n * 50 + 99) / 100 - 1];
+    p95 = v[(n * 95 + 99) / 100 - 1];
+    mx = v[n - 1];
+}
+
+// A room (or the title) faded in, and the game left it before any present
+// followed. If the fade itself presented frames, the room WAS on screen:
+// end at the fade's last present, flagged. If not (instant transition), it
+// never showed: superseded.
+void end_armed_without_present(Pend &p, int kind)
+{
+    if (g_fade_presented && g_last_present_u >= g_fadein_begin_u)
+    {
+        if (kind == kJ_Boot)
+        {
+            add_rec(kJ_Boot, kJF_EndedInFade, -1, p.b, 0, g_last_present_u, u2ms(p.mid), 0);
+            g_boot_done = true;
+        }
+        else
+            add_rec(kind, p.flags | kJF_EndedInFade, p.a, p.b, p.start, g_last_present_u,
+                    u2ms(p.mid - p.start), 0);
+    }
+    else
+        g_superseded[kind]++;
+    disarm(p);
+}
+
+} // namespace
+
+void dos_journey_present()
+{
+    const uclock_t t = now_u();
+    stall_account(t);
+    g_last_present_u = t;
+    if (g_armed == 0 && p_in_n == 0)
+        return;
+
+    if (p_boot.armed)
+    {
+        add_rec(kJ_Boot, 0, -1, p_boot.b, 0, t, u2ms(p_boot.mid), u2ms(t - p_boot.mid));
+        disarm(p_boot);
+        g_boot_done = true;
+    }
+    if (p_room.armed)
+    {
+        add_rec(kJ_Room, p_room.flags, p_room.a, p_room.b, p_room.start, t,
+                u2ms(p_room.mid - p_room.start), u2ms(t - p_room.mid));
+        disarm(p_room);
+    }
+    if (p_save.armed)
+    {
+        add_rec(p_save.a == RESTART_POINT_SAVE_GAME_NUMBER ? kJ_SaveRestartPoint : kJ_Save, 0,
+                p_save.a, displayed_room, p_save.start, t, us2ms(p_save.sub1_us), u2ms(t - p_save.mid));
+        disarm(p_save);
+    }
+    // a restored game is on screen only once it is not faded out and no fade-in is running
+    if (p_load.armed && !play.screen_is_faded_out && !g_in_fadein)
+    {
+        const unsigned f = p_load.flags | (displayed_room != p_load.b ? kJF_RoomChanged : 0);
+        add_rec(kJ_Load, f, p_load.a, displayed_room, p_load.start, t,
+                us2ms(p_load.sub1_us), u2ms(t - p_load.mid));
+        disarm(p_load);
+    }
+    for (int i = 0; i < p_in_n; ++i)
+    {
+        const PendIn &pi = p_in[i];
+        JRec *r = add_rec(pi.kind, pi.flags, -1, displayed_room, pi.recv, t,
+                          u2ms(pi.deq - pi.recv), u2ms(t - pi.deq));
+        if (r)
+            r->bound_ms = pi.bound_ms;
+    }
+    p_in_n = 0;
+}
+
+void dos_journey_room_request(int to_room)
+{
+    const uclock_t t = now_u();
+    if (p_room.active && !p_room.armed)
+    {
+        // NewRoom() then new_room() for one change, or a leaves-screen
+        // redirect: one journey, from the FIRST request
+        if (to_room != p_room.b)
+        {
+            p_room.b = to_room;
+            p_room.flags |= kJF_Retargeted;
+            g_retargeted[kJ_Room]++;
+        }
+        return;
+    }
+    if (p_boot.armed)
+        end_armed_without_present(p_boot, kJ_Boot);
+    if (p_room.active && p_room.armed)
+        end_armed_without_present(p_room, kJ_Room);
+    else if (p_room.active)
+        disarm(p_room);
+    p_room.active = true;
+    p_room.armed = false;
+    p_room.start = t;
+    p_room.a = displayed_room;
+    p_room.b = to_room;
+    p_room.flags = 0;
+}
+
+void dos_journey_fadein_begin()
+{
+    g_in_fadein = true;
+    g_fadein_begin_u = now_u();
+}
+
+void dos_journey_fadein_end(int room)
+{
+    const uclock_t t = now_u();
+    g_in_fadein = false;
+    g_fade_presented = (g_last_present_u >= g_fadein_begin_u);
+    if (g_title_room == -2)
+    {
+        const char *e = getenv("DOSAGS_JOURNEY_TITLE_ROOM");
+        g_title_room = (e && *e) ? atoi(e) : -1;
+    }
+    if (p_boot.active && (g_title_room < 0 || room == g_title_room))
+    {
+        p_boot.b = room;
+        arm(p_boot, t);
+    }
+    if (p_room.active)
+    {
+        p_room.b = room;   // the room actually faded in
+        arm(p_room, t);
+    }
+}
+
+void dos_journey_save_request(int slot)
+{
+    const uclock_t t = now_u();
+    if (p_save.active && !p_save.armed)
+    {
+        g_rerequested[kJ_Save]++;   // the journey keeps the FIRST request's start
+        return;   // already requested, not yet written
+    }
+    if (p_save.active)
+    {
+        g_superseded[kJ_Save]++;
+        disarm(p_save);
+    }
+    p_save.active = true;
+    p_save.armed = false;
+    p_save.start = t;
+    p_save.exec = 0;
+    p_save.a = slot;
+    p_save.flags = 0;
+}
+
+void dos_journey_save_exec(int slot)
+{
+    const uclock_t t = now_u();
+    if (!p_save.active || p_save.armed)   // no script request (a save dialog)
+    {
+        dos_journey_save_request(slot);
+        p_save.start = t;
+    }
+    p_save.a = slot;
+    p_save.exec = t;
+}
+
+void dos_journey_save_done(int slot, bool ok)
+{
+    if (!p_save.active || p_save.armed)
+        return;
+    const uclock_t t = now_u();
+    p_save.a = slot;
+    // exec == 0: refused before save_game() ran (SaveGameSlot's disk-space check)
+    p_save.sub1_us = p_save.exec ? (long)((t - p_save.exec) * 1000000LL / UCLOCKS_PER_SEC) : 0;
+    if (!ok)
+    {
+        add_rec(slot == RESTART_POINT_SAVE_GAME_NUMBER ? kJ_SaveRestartPoint : kJ_Save, kJF_Failed,
+                slot, displayed_room, p_save.start, t, us2ms(p_save.sub1_us), 0);
+        disarm(p_save);
+        return;
+    }
+    arm(p_save, t);
+}
+
+void dos_journey_load_request(int slot)
+{
+    const uclock_t t = now_u();
+    if (p_load.active && !p_load.armed)
+    {
+        g_rerequested[kJ_Load]++;   // the journey keeps the FIRST request's start
+        return;
+    }
+    if (p_load.active)
+    {
+        g_superseded[kJ_Load]++;
+        disarm(p_load);
+    }
+    p_load.active = true;
+    p_load.armed = false;
+    p_load.start = t;
+    p_load.exec = 0;
+    p_load.a = slot;
+    p_load.flags = 0;
+}
+
+void dos_journey_load_exec(int slot)
+{
+    const uclock_t t = now_u();
+    if (!p_load.active || p_load.armed)   // no script request (dialog, startup, restart)
+    {
+        dos_journey_load_request(slot);
+        p_load.start = t;
+    }
+    p_load.a = slot;
+    p_load.exec = t;
+    // the restore replaces the game state: a room change requested before it
+    // can no longer finish (one requested DURING the restore, by the restored
+    // game's own scripts, is a new journey and is kept)
+    if (p_room.active)
+    {
+        g_superseded[kJ_Room]++;
+        disarm(p_room);
+    }
+}
+
+void dos_journey_load_done(int slot, bool ok)
+{
+    if (!p_load.active || p_load.armed)
+        return;   // already marked (the GameRestored point runs before the caller's check)
+    const uclock_t t = now_u();
+    p_load.a = slot;
+    p_load.b = displayed_room;
+    p_load.sub1_us = (long)((t - p_load.exec) * 1000000LL / UCLOCKS_PER_SEC);
+    if (!ok)
+    {
+        add_rec(kJ_Load, kJF_Failed, slot, displayed_room, p_load.start, t, us2ms(p_load.sub1_us), 0);
+        disarm(p_load);
+        return;
+    }
+    arm(p_load, t);
+}
+
+void dos_journey_input_dequeued(const SDL_Event &evt, bool dropped)
+{
+    const int kind = input_kind(evt);
+    if (kind < 0)
+        return;
+    if (p_in_n >= kPendInCap)
+    {
+        g_in_pend_overflow++;
+        return;
+    }
+    const uclock_t t = now_u();
+    PendIn &pi = p_in[p_in_n++];
+    pi.kind = (unsigned char)kind;
+    pi.flags = dropped ? kJF_Dropped : 0;
+    pi.deq = t;
+    // SDL stamps every event with SDL_GetTicksNS() when the backend's pump
+    // produces it (the poll); the DOS performance counter is uclock(), so the
+    // event's age converts straight back onto this clock
+    const Uint64 ts = evt.common.timestamp;
+    const Uint64 now_ns = SDL_GetTicksNS();
+    pi.bound_ms = -1;
+    if (ts != 0 && ts <= now_ns && now_ns - ts < 60000000000ULL)
+    {
+        pi.recv = t - (uclock_t)((now_ns - ts) * (Uint64)UCLOCKS_PER_SEC / 1000000000ULL);
+        // SDL 0220: the press may have waited up to this long for the poll
+        // that stamped it; 0 from SDL means unknown, reported as -1
+        const Uint64 b = SDL_DOSInputWaitBoundNS(ts);
+        if (b > 0)
+            pi.bound_ms = (long)(b / 1000000ULL);
+    }
+    else
+    {
+        pi.recv = t;
+        pi.flags |= kJF_TsFallback;
+    }
+}
+
+void dos_journey_input_cleared(const SDL_Event &evt)
+{
+    const int kind = input_kind(evt);
+    if (kind >= 0)
+        g_cleared[kind]++;
+}
+
+void dos_journey_emit(FILE *log)
+{
+    if (!log)
+        return;
+    fprintf(log, "DOS-PORT journey_basis clock=uclock end=present_attempt t_ms=start_since_engine_start"
+        " percentile=nearest_rank\n");
+    for (int i = 0; i < g_nrec; ++i)
+    {
+        const JRec &r = g_rec[i];
+        switch (r.kind)
+        {
+        case kJ_Boot:
+            fprintf(log, "DOS-PORT journey kind=boot room=%d t_ms=0 ms=%ld to_fadein_end_ms=%ld fadein_end_to_present_ms=%ld ended_in_fade=%d\n",
+                r.b, r.ms, r.sub1_ms, r.sub2_ms, (r.flags & kJF_EndedInFade) ? 1 : 0);
+            break;
+        case kJ_Room:
+            fprintf(log, "DOS-PORT journey kind=room from=%d to=%d t_ms=%ld ms=%ld to_fadein_end_ms=%ld fadein_end_to_present_ms=%ld retargeted=%d ended_in_fade=%d\n",
+                r.a, r.b, r.t_ms, r.ms, r.sub1_ms, r.sub2_ms, (r.flags & kJF_Retargeted) ? 1 : 0,
+                (r.flags & kJF_EndedInFade) ? 1 : 0);
+            break;
+        case kJ_Save:
+        case kJ_SaveRestartPoint:
+            fprintf(log, "DOS-PORT journey kind=%s slot=%d room=%d t_ms=%ld ms=%ld write_ms=%ld done_to_present_ms=%ld failed=%d\n",
+                kJourneyName[r.kind], r.a, r.b, r.t_ms, r.ms, r.sub1_ms, r.sub2_ms, (r.flags & kJF_Failed) ? 1 : 0);
+            break;
+        case kJ_Load:
+            fprintf(log, "DOS-PORT journey kind=load slot=%d room=%d t_ms=%ld ms=%ld restore_ms=%ld done_to_present_ms=%ld room_changed=%d failed=%d\n",
+                r.a, r.b, r.t_ms, r.ms, r.sub1_ms, r.sub2_ms,
+                (r.flags & kJF_RoomChanged) ? 1 : 0, (r.flags & kJF_Failed) ? 1 : 0);
+            break;
+        default:
+            fprintf(log, "DOS-PORT journey kind=%s room=%d t_ms=%ld ms=%ld poll_to_dequeue_ms=%ld dequeue_to_present_ms=%ld wait_bound_ms=%ld dropped=%d ts_fallback=%d\n",
+                kJourneyName[r.kind], r.b, r.t_ms, r.ms, r.sub1_ms, r.sub2_ms, r.bound_ms,
+                (r.flags & kJF_Dropped) ? 1 : 0, (r.flags & kJF_TsFallback) ? 1 : 0);
+            break;
+        }
+    }
+    // unfinished = started, never reached its end present before exit
+    long unfinished[kJ_Count] = {};
+    if (p_boot.active) unfinished[kJ_Boot]++;
+    if (p_room.active) unfinished[kJ_Room]++;
+    if (p_save.active)
+        unfinished[p_save.a == RESTART_POINT_SAVE_GAME_NUMBER ? kJ_SaveRestartPoint : kJ_Save]++;
+    if (p_load.active) unfinished[kJ_Load]++;
+    for (int i = 0; i < p_in_n; ++i)
+        unfinished[p_in[i].kind]++;
+    for (int k = 0; k < kJ_Count; ++k)
+    {
+        long n, p50, p95, mx, un, u50, u95, umx;
+        percentiles(k, false, n, p50, p95, mx);
+        percentiles(k, true, un, u50, u95, umx);
+        long failed = 0, bound_unknown = 0;
+        for (int i = 0; i < g_nrec; ++i)
+        {
+            if (g_rec[i].kind != k)
+                continue;
+            if (g_rec[i].flags & kJF_Failed)
+                failed++;
+            if (k >= kJ_Click && g_rec[i].bound_ms < 0)
+                bound_unknown++;
+        }
+        fprintf(log, "DOS-PORT journey_summary kind=%s n=%ld p50_ms=%ld p95_ms=%ld max_ms=%ld p95_upper_ms=%ld max_upper_ms=%ld"
+            " failed=%ld unfinished=%ld superseded=%ld retargeted=%ld rerequested=%ld cleared=%ld overflow=%ld bound_unknown=%ld\n",
+            kJourneyName[k], n, p50, p95, mx, u95, umx, failed, unfinished[k], g_superseded[k], g_retargeted[k],
+            g_rerequested[k], g_cleared[k], g_rec_overflow[k], bound_unknown);
+    }
+    // lost input: presses the mouse driver counted that the level poll never
+    // saw (SDL 0220), and keyboard bytes IRQ 1 delivered that the pump never
+    // drained (still in the ring at exit, or overwritten by a full ring)
+    Uint32 hw = 0, seen = 0, checks = 0;
+    SDL_DOSMouseClickStats(&hw, &seen, &checks);
+    const long lost_clicks = (long)hw - (long)seen;
+    const long kbd_undrained = (long)(dos_port_kbd_irq_count - dos_port_kbd_drain_count);
+    fprintf(log, "DOS-PORT journey_input mouse_presses_hw=%lu mouse_presses_seen=%lu lost_clicks=%ld hw_checks=%lu"
+        " kbd_bytes_irq=%lu kbd_bytes_drained=%lu kbd_bytes_undrained=%ld pending_overflow=%ld\n",
+        (unsigned long)hw, (unsigned long)seen, lost_clicks, (unsigned long)checks,
+        (unsigned long)dos_port_kbd_irq_count, (unsigned long)dos_port_kbd_drain_count,
+        kbd_undrained, g_in_pend_overflow);
+    // stall share: whole 1 s windows (from the first present; the last partial
+    // window is not counted) with fewer present attempts than the floor.
+    // "nojourney" drops every window in which a boot/room/save/load journey
+    // was pending at any present, or at the present that closed the window.
+    const long span_ms = s_have ? u2ms(s_last - s_first) : 0;
+    fprintf(log, "DOS-PORT stallshare basis=present_attempts floor=%d windows=%ld below=%ld share=%.4f"
+        " windows_nojourney=%ld below_nojourney=%ld share_nojourney=%.4f min_nojourney=%ld presents=%ld span_ms=%ld\n",
+        s_floor, s_windows, s_below, s_windows ? (double)s_below / (double)s_windows : 0.0,
+        s_windows_nj, s_below_nj, s_windows_nj ? (double)s_below_nj / (double)s_windows_nj : 0.0,
+        s_win_min_nj, s_presents, span_ms);
+    const double minutes = span_ms / 60000.0;
+    const long nj = s_stalls - s_stalls_busy;
+    // tail_ms: last present -> this report (quit). Not folded into the
+    // figures above, because quit() itself takes time before it gets here;
+    // a freeze that ends in the auto-exit shows up here and nowhere else.
+    const long tail_ms = s_have ? u2ms(now_u() - s_last) : -1;
+    fprintf(log, "DOS-PORT stalls100 basis=present_gap n=%ld per_min=%.2f total_ms=%ld max_ms=%ld"
+        " n_nojourney=%ld per_min_nojourney=%.2f total_ms_nojourney=%ld listed=%d tail_ms=%ld\n",
+        s_stalls, minutes > 0 ? s_stalls / minutes : 0.0, u2ms(s_stall_sum), u2ms(s_stall_max),
+        nj, minutes > 0 ? nj / minutes : 0.0, u2ms(s_stall_sum - s_stall_sum_busy), s_list_n, tail_ms);
+    for (int i = 0; i < s_list_n; ++i)
+        fprintf(log, "DOS-PORT stall100 t_ms=%ld ms=%ld journey=%d\n",
+            s_list[i].t_ms, s_list[i].ms, s_list[i].busy ? 1 : 0);
+}
+#endif // __DJGPP__

+// DOS-PORT patch 0320: see dos_audio_decode.h. The WAV chunk walk below is decode_wav()'s own, stopping at the
+// same first data chunk with the same fmt checks; the per-frame downmix is decode_pcm_block()'s, branch for
+// branch; the resampling is append_resampled_mono()'s, with i0 / rem started from i * rate exactly rather than
+// stepped from 0 (the stepped values are that quotient and remainder).
+bool dos_audio_wav_range_source(const uint8_t *data, size_t size, DosPcmRangeSource &src)
+{
+    if (!data || size < 12 || std::memcmp(data, "RIFF", 4) != 0 || std::memcmp(data + 8, "WAVE", 4) != 0)
+        return false;
+    int fmt_channels = 0, fmt_bits = 0;
+    uint32_t fmt_rate = 0;
+    bool have_fmt = false;
+    size_t pos = 12;
+    while (pos + 8 <= size)
+    {
+        const uint8_t *id = data + pos;
+        uint32_t chunk_size = rd_u32le(data + pos + 4);
+        const size_t body = pos + 8;
+        if (body > size)
+            break;
+        if (chunk_size > size - body)
+            chunk_size = static_cast<uint32_t>(size - body);
+        if (std::memcmp(id, "fmt ", 4) == 0 && chunk_size >= 16)
+        {
+            const uint16_t audio_format = rd_u16le(data + body);
+            fmt_channels = rd_u16le(data + body + 2);
+            fmt_rate = rd_u32le(data + body + 4);
+            fmt_bits = rd_u16le(data + body + 14);
+            have_fmt = (audio_format == 1 /* PCM */) && (fmt_bits == 8 || fmt_bits == 16) && fmt_channels > 0;
+        }
+        else if (std::memcmp(id, "data", 4) == 0)
+        {
+            if (!have_fmt || static_cast<int>(fmt_rate) <= 0)
+                return false;
+            const size_t bpf = static_cast<size_t>(fmt_channels) * static_cast<size_t>(fmt_bits / 8);
+            const size_t frames = bpf ? chunk_size / bpf : 0;
+            size_t out_total = 0;
+            if (static_cast<int>(fmt_rate) == DOS_AUDIO_MIXER_RATE)
+                out_total = frames;
+            else if (frames > 0)
+                out_total = static_cast<size_t>((static_cast<uint64_t>(frames) * DOS_AUDIO_MIXER_RATE) / fmt_rate);
+            if (out_total == 0)
+                return false;
+            src.data = data + body;
+            src.frames = frames;
+            src.rate = static_cast<int>(fmt_rate);
+            src.channels = fmt_channels;
+            src.bits = fmt_bits;
+            src.out_total = out_total;
+            return true;
+        }
+        pos = body + chunk_size + (chunk_size & 1u);
+    }
+    return false;
+}
+
+static inline int16_t range_mono_frame(const DosPcmRangeSource &s, size_t f)
+{
+    const uint8_t *d = s.data;
+    if (s.channels == 1 && s.bits == 16)
+        return static_cast<int16_t>(rd_u16le(d + f * 2));
+    if (s.channels == 1)
+        return static_cast<int16_t>((static_cast<int32_t>(d[f]) - 128) * 256);
+    if (s.channels == 2 && s.bits == 16)
+    {
+        const int32_t sum = static_cast<int16_t>(rd_u16le(d + f * 4)) + static_cast<int16_t>(rd_u16le(d + f * 4 + 2));
+        return static_cast<int16_t>(sum / 2);
+    }
+    if (s.channels == 2)
+    {
+        const int32_t sum = ((static_cast<int32_t>(d[f * 2]) - 128) * 256) + ((static_cast<int32_t>(d[f * 2 + 1]) - 128) * 256);
+        return static_cast<int16_t>(sum / 2);
+    }
+    const size_t bpf = static_cast<size_t>(s.channels) * static_cast<size_t>(s.bits / 8);
+    int32_t sum = 0;
+    const uint8_t *frame = d + f * bpf;
+    for (int c = 0; c < s.channels; c++)
+    {
+        int32_t sample;
+        if (s.bits == 8)
+            sample = (static_cast<int32_t>(frame[c]) - 128) * 256;
+        else
+            sample = static_cast<int16_t>(rd_u16le(frame + c * 2));
+        sum += sample;
+    }
+    return static_cast<int16_t>(sum / s.channels);
+}
+
+// interp_double() over the range source (the same double formula; the frame after the last is clamped to the
+// last, where the whole-clip vector would have read past its end)
+static int16_t range_interp_double(const DosPcmRangeSource &s, size_t i)
+{
+    const double src_pos = (static_cast<double>(i) * s.rate) / DOS_AUDIO_MIXER_RATE;
+    const size_t i0 = static_cast<size_t>(src_pos);
+    const double frac = src_pos - static_cast<double>(i0);
+    const int32_t s0 = range_mono_frame(s, i0 < s.frames ? i0 : s.frames - 1);
+    const int32_t s1 = range_mono_frame(s, i0 + 1 < s.frames ? i0 + 1 : s.frames - 1);
+    return static_cast<int16_t>(s0 + static_cast<double>(s1 - s0) * frac);
+}
+
+void dos_audio_decode_range(const DosPcmRangeSource &s, size_t a, size_t n, int16_t *out)
+{
+    if (s.rate == DOS_AUDIO_MIXER_RATE)
+    {
+        for (size_t k = 0; k < n; k++)
+            out[k] = range_mono_frame(s, a + k);
+        return;
+    }
+    const size_t src_n = s.frames;
+    for (size_t k = 0; k < n; k++)
+    {
+        const size_t i = a + k;
+        const uint64_t p = static_cast<uint64_t>(i) * static_cast<uint32_t>(s.rate);
+        const size_t i0 = static_cast<size_t>(p / DOS_AUDIO_MIXER_RATE);
+        const int32_t rem = static_cast<int32_t>(p % DOS_AUDIO_MIXER_RATE);
+        if (i0 + 1 >= src_n)
+        {
+            out[k] = range_mono_frame(s, src_n - 1);
+            continue;
+        }
+        const int32_t s0 = range_mono_frame(s, i0);
+        const int32_t d = static_cast<int32_t>(range_mono_frame(s, i0 + 1)) - s0;
+        if (rem == 0 || d == 0)
+            out[k] = static_cast<int16_t>(s0);
+        else
+        {
+            const int32_t t = s0 * DOS_AUDIO_MIXER_RATE + d * rem;
+            const int32_t q = t / DOS_AUDIO_MIXER_RATE;
+            out[k] = (q * DOS_AUDIO_MIXER_RATE != t) ? static_cast<int16_t>(q) : range_interp_double(s, i);
+        }
+    }
+}
+

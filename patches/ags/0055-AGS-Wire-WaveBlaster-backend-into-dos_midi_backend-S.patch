diff --git a/Engine/platform/dos/dos_midi_backend.cpp b/Engine/platform/dos/dos_midi_backend.cpp
index 31495921d..bbff3d573 100644
--- a/Engine/platform/dos/dos_midi_backend.cpp
+++ b/Engine/platform/dos/dos_midi_backend.cpp
@@ -24,36 +24,105 @@ namespace
 DosMidiBackendKind g_last_kind = DOS_MIDI_BACKEND_NONE;
 uint64_t g_events_dispatched = 0;
 
+// DOS-PORT (S5): the wb backend is a session-lifetime singleton, unlike
+// opl3's per-AudioPlayer-instance handles -- see dos_midi_backend_cold_init()
+// and dos_midi_backend_end_song()'s own doc comments in the header for why.
+waveblaster_sink *g_wb_sink = nullptr;
+bool g_wb_cold_init_attempted = false;
+
 const char *kind_name(DosMidiBackendKind k)
 {
     switch (k)
     {
     case DOS_MIDI_BACKEND_OPL3: return "opl3";
+    case DOS_MIDI_BACKEND_WB:   return "wb";
     default:                    return "none";
     }
 }
 
-} // namespace
-
-opl3_sink *dos_midi_backend_open(DosMidiBackendKind *out_kind)
+const char *resolve_backend_hint()
 {
     const char *hint = SDL_GetHint("SDL_HINT_DOS_AUDIO_BACKEND");
     if (!hint || !hint[0])
         hint = "auto";
+    return hint;
+}
+
+} // namespace
+
+void dos_midi_backend_cold_init()
+{
+    if (g_wb_cold_init_attempted)
+        return; // idempotent -- meaningful once per session only
+    g_wb_cold_init_attempted = true;
+
+    const char *hint = resolve_backend_hint();
+    if (SDL_strcasecmp(hint, "wb") != 0)
+        return; // every other backend: zero WaveBlaster-related SDL calls
+
+    g_wb_sink = waveblaster_sink_open();
+    if (g_wb_sink)
+    {
+        Debug::Printf(kDbgMsg_Info,
+            "DosMidiBackend: WaveBlaster/MPU-401 cold-init succeeded "
+            "(ran before the PCM device opened, as required)");
+    }
+    else
+    {
+        Debug::Printf(kDbgMsg_Info,
+            "DosMidiBackend: WaveBlaster/MPU-401 cold-init declined -- no "
+            "MPU-401 responded (or this ran too late; see "
+            "waveblaster_sink.h). wb backend unavailable this session.");
+    }
+}
+
+void *dos_midi_backend_open(DosMidiBackendKind *out_kind, midi_sched_sink *out_sink)
+{
+    const char *hint = resolve_backend_hint();
 
     DosMidiBackendKind kind = DOS_MIDI_BACKEND_NONE;
-    opl3_sink *sink = nullptr;
+    void *handle = nullptr;
 
     if (SDL_strcasecmp(hint, "none") == 0)
     {
         // Explicit opt-out -- do not even probe for a chip.
     }
+    else if (SDL_strcasecmp(hint, "wb") == 0)
+    {
+        // Never opened lazily here -- dos_midi_backend_cold_init() is the
+        // only place SDL_DOSMpu401Init() may run (see its own header
+        // comment for why: it must happen before the PCM device is hot).
+        handle = g_wb_sink;
+        if (handle)
+        {
+            kind = DOS_MIDI_BACKEND_WB;
+            if (out_sink)
+                waveblaster_sink_bind(g_wb_sink, out_sink);
+            Debug::Printf(kDbgMsg_Info, "DosMidiBackend: WaveBlaster/MPU-401 backend active");
+        }
+        else
+        {
+            Debug::Printf(kDbgMsg_Info,
+                "DosMidiBackend: SDL_HINT_DOS_AUDIO_BACKEND=wb requested, but "
+                "cold-init did not succeed (see the earlier log line from "
+                "engine startup) -- MIDI disabled this session");
+        }
+    }
     else if (SDL_strcasecmp(hint, "opl3") == 0 || SDL_strcasecmp(hint, "auto") == 0)
     {
-        sink = opl3_sink_open();
+        opl3_sink *sink = opl3_sink_open();
         if (sink)
         {
             kind = DOS_MIDI_BACKEND_OPL3;
+            handle = sink;
+            // Best-effort GM bank, staged alongside the exe -- same
+            // convention shared/tests/probes/opl3midi.c already
+            // established. Missing file or a bad header just keeps the
+            // sink's built-in 8-patch fallback (opl3_sink_load_bank()'s
+            // own documented contract); not fatal.
+            opl3_sink_load_bank(sink, "OPL3BANK.DAT", nullptr);
+            if (out_sink)
+                opl3_sink_bind(sink, out_sink);
             Debug::Printf(kDbgMsg_Info, "DosMidiBackend: OPL3/OPL2 chip detected and initialized");
         }
         else
@@ -64,18 +133,48 @@ opl3_sink *dos_midi_backend_open(DosMidiBackendKind *out_kind)
     }
     else
     {
-        // "wb" / "gus" / "adlib": real semantics, but no such sink is
-        // hoisted into shared/ yet (S5). Fail closed rather than silently
-        // falling back to OPL3, which the hint did not ask for.
+        // "adlib" / "gus": real semantics, but no such sink is hoisted
+        // into shared/ yet. Fail closed rather than silently falling back
+        // to a different backend the hint did not ask for.
         Debug::Printf(kDbgMsg_Info,
-            "DosMidiBackend: SDL_HINT_DOS_AUDIO_BACKEND=%s requested, no such backend hoisted yet (S5) -- MIDI disabled this session",
+            "DosMidiBackend: SDL_HINT_DOS_AUDIO_BACKEND=%s requested, no such backend hoisted yet -- MIDI disabled this session",
             hint);
     }
 
     g_last_kind = kind;
     if (out_kind)
         *out_kind = kind;
-    return sink;
+    return handle;
+}
+
+void dos_midi_backend_end_song(void *&handle, DosMidiBackendKind kind)
+{
+    if (!handle)
+        return;
+
+    switch (kind)
+    {
+    case DOS_MIDI_BACKEND_OPL3:
+        opl3_sink_close((opl3_sink *)handle);
+        handle = nullptr;
+        break;
+    case DOS_MIDI_BACKEND_WB:
+        // Silence only -- handle stays alive and bound; see this
+        // function's own doc comment in the header for why.
+        waveblaster_sink_silence((waveblaster_sink *)handle);
+        break;
+    default:
+        break;
+    }
+}
+
+void dos_midi_backend_shutdown()
+{
+    if (g_wb_sink)
+    {
+        waveblaster_sink_close(g_wb_sink);
+        g_wb_sink = nullptr;
+    }
 }
 

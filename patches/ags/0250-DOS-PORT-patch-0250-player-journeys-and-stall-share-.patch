+//
+//=============================================================================
+//
+// DOS-PORT patch 0250: player journeys and stall share, next to fps.
+//
+// A journey runs from a start event (the player's input, or the game's own
+// request) to the first present that can show its result. Every end is a
+// present ATTEMPT (SDLRendererGraphicsDriver::Present, any exit: pixels
+// pushed, palette only, or skipped because the frame was unchanged -- in the
+// last case the right picture was already on screen). One clock throughout:
+// uclock(), the engine-start anchor every DOS-PORT t_ms uses, EXCEPT the
+// DOSAGS_XT lines, which are get_runtime_ms() and run ~0.8 s behind it.
+//
+//   boot   engine start (main_init) -> first present after the first fade-in
+//          ends (or after the fade-in of room DOSAGS_JOURNEY_TITLE_ROOM).
+//          Does NOT include the DOS loader, the DPMI host or static init.
+//   room   NewRoom()/new_room() request -> first present after the new
+//          room's fade-in ends.
+//   save   SaveGameSlot() request -> file written -> next present.
+//   load   RestoreGameSlot() request -> state restored -> first present with
+//          the screen not faded out and no fade-in running.
+//   "written" / "restored" are marked BEFORE the GameSaved / GameRestored
+//   script events: run_on_event() runs on_event at once when no script is
+//   running, so anything the game does in response (AGS Quest restores
+//   inside its save, and changes room inside its restore) is nested in the
+//   same call and must not be counted as write or restore time.
+//   click / key   the SDL event's own timestamp (the poll that produced it)
+//          -> dequeued by the engine -> first present after the dequeue.
+//          The press itself is not timestamped anywhere on DOS: it may have
+//          waited up to one pump gap for that poll. wait_bound_ms (SDL 0220)
+//          is the upper bound on that wait, and p95_upper_ms in the summary
+//          is the percentile of ms + wait_bound_ms. A press the poll never
+//          saw has no journey at all: it is counted in journey_input
+//          lost_clicks (driver presses - seen presses), never in a p95.
+//
+// What a FAILED journey prints (read this before trusting a figure):
+//   never ends before exit     -> unfinished=1 in its summary, no record
+//   save/load failed or refused-> a record with failed=1, counted in the
+//                                 summary's failed=, excluded from n and p95
+//   room left before a present-> superseded= (not in n), or ended_in_fade=1
+//   a second save/load request while one is pending -> rerequested=; the
+//                                 journey keeps the first request's start
+//   input discarded by a queue clear -> cleared= (not in n)
+//   a click the poll never saw -> nothing here; journey_input lost_clicks
+// n=0 with p95_ms=-1 is "no journey", never "fast". Check n (and, for
+// inputs, the host's own count of what it injected) before any p95.
+//
+// Nothing is printed while the game runs; the record goes to RUNMANI.LOG at
+// exit (dos_journey_emit). Cost while running: one uclock() per present, a
+// flag test per present, and O(1) work at each start/end event.
+//
+//=============================================================================
+#ifndef __AGS_EE_PLATFORM_DOS__DOS_JOURNEYS_H

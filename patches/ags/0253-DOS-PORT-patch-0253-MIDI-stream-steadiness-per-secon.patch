+// DOS-PORT patch 0253: is the music a steady stream across the run? Per 1 s
+// window of uclock (sampled once per mixer pump, i.e. per game tick), the
+// MIDI work that reached the chip: in isr mode the register writes the SB IRQ
+// replayed (SDL_DOSMidiDeferStats), in poll mode the events dispatched. At
+// quit: the windows from the first one with any MIDI to the last window, how
+// many of those had none (gaps: a song that ended, a pause, a stall that
+// outran the plan), the longest gap, and per-window p5/p50/min. A gate that
+// judges MIDI (late_writes=0) is only as good as the stream it ran on: a run
+// whose song ended after 20 s passes it vacuously for the rest.
+namespace
+{
+const int kMsCap = 1800;              // 30 min of 1 s windows, 3.6 KB
+uint16_t ms_win[kMsCap];
+int ms_nwin = 0;                      // windows closed
+long ms_idx = -1;                     // current window index
+uint64_t ms_last_total = 0;
+uclock_t ms_t0 = 0;
+bool ms_have = false;
+bool ms_isr_basis = false;
+uint64_t ms_total()
+{
+    if (g_tick_isr)
+    {
+        Uint32 wr = 0;
+        SDL_DOSMidiDeferStats(&wr, nullptr, nullptr, nullptr, nullptr);
+        return wr;
+    }
+    return g_events_dispatched;
+}
+} // namespace
+
+void dos_midi_stream_sample()
+{
+    const uclock_t now = uclock();
+    if (!ms_have)
+    {
+        ms_have = true;
+        ms_t0 = now;
+        ms_idx = 0;
+        ms_last_total = ms_total();
+        return;
+    }
+    const long idx = (long)((now - ms_t0) / UCLOCKS_PER_SEC);
+    if (idx == ms_idx)
+        return;
+    const uint64_t tot = ms_total();
+    const uint64_t d = tot - ms_last_total;
+    ms_isr_basis = g_tick_isr;
+    // the whole delta goes to the window just closed; whole seconds with no
+    // sample at all (a stall) are empty windows
+    for (long w = ms_idx; w < idx && ms_nwin < kMsCap; ++w)
+        ms_win[ms_nwin++] = (uint16_t)((w == ms_idx) ? (d > 65535 ? 65535 : d) : 0);
+    ms_last_total = tot;
+    ms_idx = idx;
+}
+
+void dos_midi_stream_emit(FILE *log)
+{
+    if (!log)
+        return;
+    int first = -1, last = ms_nwin - 1;
+    for (int i = 0; i < ms_nwin; ++i)
+        if (ms_win[i]) { first = i; break; }
+    if (first < 0)
+    {
+        fprintf(log, "DOS-PORT midistream basis=%s windows=%d active_windows=0 first_s=-1\n",
+            ms_isr_basis ? "isr_writes" : "events", ms_nwin);
+        return;
+    }
+    int zero = 0, run = 0, longest = 0, n = 0;
+    uint16_t v[kMsCap];
+    for (int i = first; i <= last; ++i)
+    {
+        v[n++] = ms_win[i];
+        if (ms_win[i] == 0) { zero++; run++; if (run > longest) longest = run; }
+        else run = 0;
+    }
+    std::sort(v, v + n);
+    fprintf(log, "DOS-PORT midistream basis=%s windows=%d first_s=%d span_windows=%d zero_windows=%d"
+        " longest_gap_s=%d trailing_gap_s=%d min=%u p5=%u p50=%u max=%u\n",
+        ms_isr_basis ? "isr_writes" : "events", ms_nwin, first, n, zero, longest, run,
+        (unsigned)v[0], (unsigned)v[(n * 5 + 99) / 100 - 1], (unsigned)v[(n * 50 + 99) / 100 - 1], (unsigned)v[n - 1]);
+}

-    }
-    {
-        uint32_t c, mn, me, mx;
-        SDL_DOSGusSetVoiceFreqDiagSnapshot(&c, &mn, &me, &mx);
-        dos_diag_record_voicefreq(c, mn, me, mx);
-        SDL_DOSGusSetVoiceVolDiagSnapshot(&c, &mn, &me, &mx);
-        dos_diag_record_voicevol(c, mn, me, mx);
-        SDL_DOSGusSetVoicePanDiagSnapshot(&c, &mn, &me, &mx);
-        dos_diag_record_voicepan(c, mn, me, mx);
-        SDL_DOSGusStartVoiceDiagSnapshot(&c, &mn, &me, &mx);

+/* DOS-PORT patch 0254: per-backend OPL write pacing. Every OPL write here is
+   followed by dummy status reads: 6 after the address and 6 after the data.
+   That is 12 of the 14 port operations of a write, and on a 486 each costs
+   ~2 us (lab CAPH-1I: 28.8 us per write), so a dense MIDI burst holds the SB
+   ISR for >10 ms. The PicoGUS (firmware v4.1.1, sw/picogus.cpp) needs no
+   spacing: an address write is a fast write, a data write holds IOCHRDY
+   until the handler has queued it, and each dummy read is itself a
+   stretched cycle. But it queues writes in a 256-entry buffer with no full
+   check (sw/include/cmd_buffers.h), drained every 128 samples at 49716 Hz,
+   ~2.57 ms, so writes must not arrive faster than ~128 per window: 4 + 4
+   reads (~20.6 us per write, ~125 per window) keep half the buffer free.
+   Chosen only on a POSITIVE detection (the card's own control port, as its
+   pgusinit reads it: magic 0xDD, protocol 4, SB mode, OPL base 0x388);
+   every other card keeps 6 + 6. SDL_HINT_DOS_OPL_DELAY_READS=N (1..6)
+   overrides it. */
+volatile Uint8 g_dos_opl_delay_reads = 6;
+Uint8 g_dos_opl_pgdetect = 0;
+
+static void DOS_OplPacingProbe(void)
+{
+    static bool probed = false;
+    Uint8 magic, proto = 0, mode = 0;
+    Uint16 oplport = 0;
+    if (probed) {
+        return;
+    }
+    probed = true;
+    {   /* SDL_HINT_DOS_OPL_PICOGUS_PROBE=0: never touch 0x1D0-0x1D2 (a field escape if
+           another device decodes those ports); the pacing stays 6 + 6. */
+        const char *p = SDL_getenv("SDL_HINT_DOS_OPL_PICOGUS_PROBE");
+        if (p && p[0] == '0' && p[1] == 0) {
+            magic = 0;
+            goto probe_done;
+        }
+    }
+    /* The same sequence as the PicoGUS's own pgusinit initPicoGUS()
+       (pgusinit/pgusinit.c:1307-1328 at v4.1.1): knock 0xCC, select the
+       magic register, read 0xDD from 0x1D2. With no PicoGUS the ISA bus
+       floats (reads 0xFF) and nothing more is written after these two
+       bytes; only on a 0xDD answer are more registers selected. */
+    outportb(0x1D0, 0xCC); /* PicoGUS control port: knock */
+    outportb(0x1D0, 0x00); /* select the magic register */
+    magic = inportb(0x1D2);
+    if (magic == 0xDD) {
+        outportb(0x1D0, 0x01); /* protocol version */
+        proto = inportb(0x1D2);
+        outportb(0x1D0, 0x03); /* boot mode (5 = SB) */
+        mode = inportb(0x1D2);
+        outportb(0x1D0, 0x05); /* OPL base port, 16-bit */
+        oplport = inportw(0x1D1);
+        /* An unknown register ends control mode: select_picogus()'s default
+           branch clears control_active (sw/picogus.cpp:282-283; 0x80 is not a
+           CMD_ value in common/picogus.h). pgusinit leaves it set. */
+        outportb(0x1D0, 0x80);
+        if (proto == 4 && mode == 5 && oplport == 0x388) {
+            g_dos_opl_pgdetect = 1;
+            g_dos_opl_delay_reads = 4;
+        }
+    }
+probe_done:
+    {
+        const char *e = SDL_getenv("SDL_HINT_DOS_OPL_DELAY_READS");
+        if (e && *e) {
+            const long v = SDL_strtol(e, NULL, 10);
+            if (v >= 1 && v <= 6) {
+                g_dos_opl_delay_reads = (Uint8)v;
+            }
+        }
+    }
+    dos_port_dbg_log("audio: patch 0254 OPL pacing: PicoGUS magic 0x%02x proto %u mode %u oplport 0x%x -> pgdetect %u, %u + %u reads",
+                     (unsigned)magic, (unsigned)proto, (unsigned)mode, (unsigned)oplport,
+                     (unsigned)g_dos_opl_pgdetect, (unsigned)g_dos_opl_delay_reads, (unsigned)g_dos_opl_delay_reads);
+}
+
+void SDL_DOSOplPacing(Uint32 *pgdetect, Uint32 *reads)
+{
+    if (pgdetect) *pgdetect = g_dos_opl_pgdetect;
+    if (reads) *reads = g_dos_opl_delay_reads;
+}
+
 static bool Opl3Detect_Impl(void)
 {
     /* Standard Adlib detection: timer-1 rollover sequence.
@@ -1073,17 +1153,18 @@ void SDL_DOSOpl3WriteRegister(uint16_t reg, uint8_t value)
     const bool diag = SDL_DOSAudioDiagTiming(); /* patch 0199: off by default */
     const uclock_t t0 = diag ? uclock() : 0; /* TEMPORARY DIAGNOSTIC, see above */
 
+    const int opl_reads = g_dos_opl_delay_reads; /* DOS-PORT patch 0254 (was 6) */
     outportb(addr_port, (Uint8)(reg & 0xFF));
     /* Inter-write delay: canonical Adlib 6 dummy status reads.
        Per YMF262 datasheet ~24 master clock cycles ~ 1.7 us at
        14.318 MHz; six ISA-bus reads at ~1 us each = ~6 us -- well
        past the requirement, bullet-proof on PODP83 + Cirrus 5434. */
-    for (int i = 0; i < 6; i++) {
+    for (int i = 0; i < opl_reads; i++) {
         (void)inportb(0x388);
     }
     outportb(data_port, value);
     /* Post-data delay before next register access: another 6 reads. */
-    for (int i = 0; i < 6; i++) {
+    for (int i = 0; i < opl_reads; i++) {
         (void)inportb(0x388);
     }
 
@@ -2234,6 +2315,7 @@ void SDL_DOSAudioInitTimer(void)
 bool SDL_DOSOpl3Detect(void)
 {
     const bool held = SDL_DOSMidiDeferHold(true);
+    DOS_OplPacingProbe(); /* DOS-PORT patch 0254 */
     const bool r = Opl3Detect_Impl();
     if (held) SDL_DOSMidiDeferHold(false);
     return r;

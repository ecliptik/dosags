 namespace AGS { namespace Engine { void dos_rp_report(FILE *log); } } // DOS-PORT patch 0319 (route_finder_impl_legacy.cpp)
 void dos_gc2_report(FILE *log);   // DOS-PORT patch 0372 (ac/draw.cpp)
-void dos_heap_policy_report(FILE *log); // DOS-PORT patch 0380 (main/game_start.cpp)
 #include "main/dos_port_tick_timing.h" // DosPortTickTiming, patch 0079
 #include <SDL3/SDL_dosident.h> // SDL_DOSVideoIsBankedMode()/SDL_DOSVideoGetBankSwitchCount(), patch 0085
 #endif
@@ -419,8 +418,6 @@ void quit(const char *quitmsg)
             "DOSAGS_FREEZE_TICKS",
             "DOSAGS_GUI_CLIP",        // patch 0366/0368: GUI composite (4 = R3 by default; 2 = R1; 0 = off; 1 = 0170's clip)
             "DOSAGS_GUI_CTRL_MARK",   // DOS-PORT patch 0372: a GUI whose only change is controls marks their rects (on by default since 0373; 0 = off)
-            "DOSAGS_HEAP_PREGROW_KB", // patch 0380: grow the heap once before play (off by default; TEMPORARY switch)
-            "DOSAGS_HEAP_UNLOCK",     // patch 0380: clear crt0 LOCK_MEMORY before play (off by default; TEMPORARY switch)
             "DOSAGS_MAX_SCALE",       // patch 0101: caps the render-frame scale (bake-off candidate c)
             "DOSAGS_PRESENT_NO_SKIP", // patch 0099: forces real presents -- changes every fps figure
             "DOSAGS_PRESENT_VERIFY",  // patch 0192: reads the surface twice per present -- a diagnostic, never a timed cell
@@ -958,7 +955,6 @@ void quit(const char *quitmsg)
             AGS::Engine::dos_rp_report(run_manifest_log); // DOS-PORT patch 0319
             dos_gc2_report(run_manifest_log);              // DOS-PORT patch 0372
             dos_audio_mixer_ring_report(run_manifest_log); // DOS-PORT patch 0377
-            dos_heap_policy_report(run_manifest_log);      // DOS-PORT patch 0380
             // patch 0217: SDL 0198's IRQ-safe uclock() -- first = calls made with the caller's interrupt
             // flag (the one that sets up the PIT), wrapped = calls made with interrupts off. 0/0 means the
             // program was linked without -Wl,--wrap=uclock.

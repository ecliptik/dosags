From 220c54c6b70d20edfffacb399344d961b2215106 Mon Sep 17 00:00:00 2001
From: Micheal Waltz <micheal@ecliptik.com>
Date: Wed, 23 Sep 2026 20:06:57 -0700
Subject: [PATCH] DOS-PORT: patch 0343 -- report the RTC pump's hardware
 repairs

SDL 0262 has the SB IRQ repair the WaveBlaster RTC pump's interrupt
whenever something outside the pump turned it off. On the round-A 486
that happened, unseen, and the pump stalled. On the next hardware
round the counts are the evidence of which agent it was, and whether
0263 removed it. They should be on the status line every cell already
collects, not only in the SDL trace (which fsyncs every line, so a
timing cell does not carry it). The rtc fields gain
rearm=pie/rate/mask/stuck.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Nz9XeKeVG8Ab7dm8esJsMu
---
 Engine/platform/dos/dos_midi_backend.cpp | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/Engine/platform/dos/dos_midi_backend.cpp b/Engine/platform/dos/dos_midi_backend.cpp
index 7aa4e905b..7c807e5ce 100644
--- a/Engine/platform/dos/dos_midi_backend.cpp
+++ b/Engine/platform/dos/dos_midi_backend.cpp
@@ -488,7 +488,7 @@ void dos_midi_backend_status_fragment(char *buf, size_t bufsize)
         // DOS-PORT (patch 0341): the RTC pump's own fields (rate, byte gap,
         // ticks, BIOS INT 15h/86h waits it serviced, longest release-to-write
         // in us) and clk_uc= (song ms / uclock ms since the first plan).
-        char rtc[144] = ""; // DOS-PORT (patch 0342): was 112
+        char rtc[192] = ""; // DOS-PORT (patch 0343): was 144 (0342), 112 (0341)
         if (g_defer_kind == 3)
         {
             Uint32 hz = 0, gap = 0, ticks = 0, waits = 0, lat = 0;
@@ -497,9 +497,14 @@ void dos_midi_backend_status_fragment(char *buf, size_t bufsize)
             // the status bytes it did not send.
             bool rs_on = false;
             const Uint32 rs_skipped = SDL_DOSMidiDeferRtcRunningStatus(&rs_on);
-            std::snprintf(rtc, sizeof(rtc), ",rtc_hz=%u,gap_us=%u,rtc_ticks=%u,bios_waits=%u,lat_max_us=%u,rs=%s,rs_skipped=%u",
+            // DOS-PORT (patch 0343): the pump's hardware repairs by kind (SDL 0262):
+            // PIE found off / rate bits changed / IRQ 8 or cascade masked / no tick.
+            Uint32 rp = 0, rr = 0, rm = 0, rst = 0;
+            SDL_DOSMidiDeferRtcRearms(&rp, &rr, &rm, &rst);
+            std::snprintf(rtc, sizeof(rtc), ",rtc_hz=%u,gap_us=%u,rtc_ticks=%u,bios_waits=%u,lat_max_us=%u,rs=%s,rs_skipped=%u,"
+                "rearm=%u/%u/%u/%u",
                 (unsigned)hz, (unsigned)gap, (unsigned)ticks, (unsigned)waits, (unsigned)lat, rs_on ? "on" : "off",
-                (unsigned)rs_skipped);
+                (unsigned)rs_skipped, (unsigned)rp, (unsigned)rr, (unsigned)rm, (unsigned)rst);
         }
         // DOS-PORT patch 0330: SDL 0250's per-IRQ budget, the IRQs it bound,
         // and the drain's own time (us, the SB ISR's timer); per-write in ns
-- 

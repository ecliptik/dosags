+// Lever 2's whitelist: the engine API calls MMD makes between its repeated hit tests (measured in the lab: the
+// calls made between a memo store and a memo hit on MMD character select and intro), each audited to change
+// nothing GetCharIDAtRoom reads (characters and their extras, views/frames and images, the room) and to run no
+// game tick or script. Every other function, every plugin and object function, invalidates.
+static const char *const s_pure_names[] = {
+    "GetLocationType", "GetLocationName",                         // the callers: GUI/room/hotspot/object hit tests
+                                                                  // (Name also writes its buffer and the last-name state)
+    "StrGetCharAt", "StrLen", "StrSetCharAt", "StrCat", "StrCopy", // script string buffers only
+    "GetPlayerCharacter", "GetCursorMode",                        // plain reads
+    "GetInvAt",                                                   // GUI + inventory window read
+};
+static const void *s_pure_tab[64];
+static const void *s_pure_over[32];
+static int s_pure_over_n = 0;
+static bool s_pure_ready = false;
+static void VmPureInit()
+{
+    s_pure_ready = true;
+    for (const char *nm : s_pure_names)
+    {
+        const uint32_t idx = simp.GetIndexOfAny(AGS::Common::String(nm));
+        const ScriptImport *imp = (idx == UINT32_MAX) ? nullptr : simp.GetByIndex(idx);
+        if (!imp || imp->Value.Type != kScValStaticFunction) continue;
+        const void *f = reinterpret_cast<const void*>(imp->Value.SPfn);
+        const unsigned slot = (reinterpret_cast<uintptr_t>(f) >> 4) & 63;
+        if (!s_pure_tab[slot]) s_pure_tab[slot] = f;
+        else if (s_pure_tab[slot] != f && s_pure_over_n < 32) s_pure_over[s_pure_over_n++] = f;
+    }
+}
+static inline bool VmIsPure(const void *f)
+{
+    if (s_pure_tab[(reinterpret_cast<uintptr_t>(f) >> 4) & 63] == f) return true;
+    for (int i = 0; i < s_pure_over_n; ++i) if (s_pure_over[i] == f) return true;
+    return false;
+}
+// Lever 2's hooks, lazy: the memo holds entries only between a hit test and the next thing that may change
+// what it reads, and only then (dos_cmemo_live) do the hooks do any work.
+//  - every engine call from the fast loop names its function in dos_vm_curcall (nullptr for object, plugin
+//    and other calls) and clears it on return; a hit test may use the memo only when the innermost engine
+//    call from the VM is on the whitelist (dos_cmemo_curpure), so nothing is memoised inside any other call
+//    or outside the VM;
+//  - a non-whitelisted engine call, a generic step that may write engine state, the line hook, the pending
+//    events check and every VM entry and exit invalidate (bump the generation) -- when the memo is live.
+// No bump is needed after a call returns: the bump came before it, nothing is memoised inside a non-whitelisted
+// call, and a nested VM run bumps on its own exit. Out of line so the fast loop keeps no value live across the
+// call (a first version with locals here cost the loop its register allocation: +0.32 ms/tick at fixed cycles).
+__attribute__((noinline)) static void dos_memo_bump()
+{
+    ++dos_cmemo_gen;
+    dos_cmemo_live = 0;
+}
+__attribute__((noinline)) static void dos_memo_check(const void *fn)
+{
+    if (!(fn && VmIsPure(fn)))
+        dos_memo_bump();
+}
+bool dos_cmemo_curpure() { return dos_vm_curcall && s_pure_ready && VmIsPure(dos_vm_curcall); }
+#define VM_MEMO_CALL_BEGIN(FN) do { dos_vm_curcall = (const void *)(FN); if (dos_cmemo_live) dos_memo_check(dos_vm_curcall); } while (0)
+#define VM_MEMO_CALL_END() (dos_vm_curcall = nullptr)
+#define VM_MEMO_BUMP() do { if (dos_cmemo_live) dos_memo_bump(); } while (0)
 

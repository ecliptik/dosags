@@ -209,13 +238,47 @@ QuitReason quit_check_for_error_state(const char *qmsg, String &errmsg, String &
 // total_us is also printed directly (new trailing field, parser-
 // optional) so the full-precision aggregate is visible without relying
 // on mean_ms's rounding.
+// DOS-PORT patch 0146: the SECOND defence, for the failure class the
+// sum-check assertion cannot see.
+//
+// The sum check (game_run.cpp, patch 0144) asks whether a decomposition
+// adds up. It cannot ask whether the interval measured is the intended
+// one -- a bracket that spans nothing decomposes perfectly into nothing.
+// Today the per-skip instrument printed a well-formed row of zeros for
+// exactly that reason, and patch 0083's truncation bug had the same shape:
+// thousands of calls summing to a total of zero, which is arithmetically
+// consistent and physically impossible.
+//
+// So: a phase that was ENTERED cannot have taken no time. Flagged in the
+// output rather than asserted, because a legitimately tiny phase on a fast
+// host can round to zero microseconds and a crash here would be worse than
+// a wrong number. The flag is for whoever reads the file.
+static long dos_port_tick_emit_suspect = 0;
+
 static void dos_port_tick_emit(FILE *log, const char *name, const DosPortTickPhaseStats &s)
 {
     const long total_ms = (long)(s.total_us / 1000);
+    const char *suspect = "";
+    if (s.calls > 0 && s.total_us == 0)
+    {
+        suspect = " SUSPECT=entered-but-zero-time";
+        dos_port_tick_emit_suspect++;
+    }
+    else if (s.calls == 0)
+    {
+        // Distinct from the above and a different bug: an instrument that
+        // never fired at all. That is the RBB1 failure -- a bracket added,
+        // a cell spent, and nothing emitted -- and it is worth naming in
+        // the file so it cannot be missed twice.
+        suspect = " SUSPECT=never-entered";
+        dos_port_tick_emit_suspect++;
+    }
     fprintf(log, "DOS-PORT tickstats_%s calls=%ld total_ms=%ld min_ms=%ld max_ms=%ld mean_ms=%.2f clamped_neg=%ld total_us=%lld\n",
         name, s.calls, total_ms, s.min_ms, s.max_ms,
         s.calls > 0 ? (double)s.total_us / 1000.0 / (double)s.calls : 0.0,
         s.clamped_negative_count, s.total_us);
+    if (suspect[0])
+        fprintf(log, "DOS-PORT tickstats_%s%s\n", name, suspect);
 }
 #endif
 

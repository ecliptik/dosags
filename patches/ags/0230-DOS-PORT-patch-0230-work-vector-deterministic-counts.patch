diff --git a/Engine/main/dos_port_work.h b/Engine/main/dos_port_work.h
new file mode 100644
index 000000000..437212e2f
--- /dev/null
+++ b/Engine/main/dos_port_work.h
@@ -0,0 +1,62 @@
+//=============================================================================
+//
+// DOS-PORT patch 0230: a deterministic per-run WORK vector.
+//
+// Every rate claim on this port costs a real-hardware round (about an hour),
+// and DOSBox-X time is not evidence of 486 time. Counts of work are: the same
+// fixture does the same work under the emulator and on the 486, so a vector
+// of counts priced with the measured bus/blit constants can screen an idea
+// before the hardware round. This header is the vector; LAB-METRIC.md is the
+// cost model and its validation against hardware cells already on disk.
+//
+// Rules the counters follow, because PLAN.md records hot-path probes costing
+// about 1 fps through cache footprint: integer increments or adds of a size
+// already in hand only, never a clock read; per-instruction and per-pixel
+// work stays in a local and is added once per call.
+//
+//=============================================================================
+#ifndef __AGS_EE_MAIN__DOS_PORT_WORK_H
+#define __AGS_EE_MAIN__DOS_PORT_WORK_H
+
+#ifdef __DJGPP__
+
+enum DosPortWorkIndex
+{
+    kDW_Ticks = 0,      // loop ticks (derived: the tick-scope count)
+    kDW_Renders,        // render passes (derived: GameTimer.RenderCounter)
+    kDW_Presents,       // real presents (derived: presents_real)
+    kDW_ScriptIns,      // script VM instructions dispatched
+    kDW_ScriptExt,      // script -> engine API calls (SCMD_CALLEXT)
+    kDW_PushBytes,      // bytes handed to SDL_UpdateWindowSurface(Rects)
+    kDW_PushRects,      // rects handed to it
+    kDW_Blit1xBytes,    // present-time 1:1 RAM->RAM copy, dst bytes
+    kDW_BlitScBytes,    // present-time scaled copy, dst bytes
+    kDW_CmpBytes,       // bytes compared by the unchanged-frame check
+    kDW_CacheBytes,     // bytes copied into the last-presented cache
+    kDW_BgPx,           // background-restore px (derived: bg_px, patch 0126)
+    kDW_FillPx,         // black fill + batch clear px (derived)
+    kDW_SprN,           // sprite composites (derived: rb_sprites, patch 0125)
+    kDW_SprOpqPx,       // composited px, opaque Blit
+    kDW_SprMskPx,       // composited px, masked (transparent colour) blit
+    kDW_SprBldPx,       // composited px, alpha blend or global translucency
+    kDW_FileBytes,      // bytes returned by FileStream::Read/ReadByte (derived)
+    kDW_FileCalls,      // FileStream::Read/ReadByte calls (derived)
+    kDW_Count
+};
+
+// Live counters. Slots marked "derived" above are filled by
+// dos_port_work_snapshot() from where the engine already counts them.
+extern long long dos_port_work[kDW_Count];
+// Common/util/filestream.cpp (the Common library cannot see the engine).
+extern long long dos_port_file_rd_bytes;
+extern long long dos_port_file_rd_calls;
+// Context for pricing bytes: the last real present's formats and window.
+extern int dos_port_work_vs_bpp, dos_port_work_win_bpp;
+extern int dos_port_work_win_w, dos_port_work_win_h;
+
+// Live + derived slots, in DosPortWorkIndex order.
+void dos_port_work_snapshot(long long out[kDW_Count]);
+
+#endif // __DJGPP__
+
+#endif // __AGS_EE_MAIN__DOS_PORT_WORK_H

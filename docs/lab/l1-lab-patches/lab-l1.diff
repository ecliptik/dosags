+// LAB-L1 (lab worktree ~/git/dosags-lab-l1 only, never a port patch): attribution of the script
+// interpreter's time on MMD in play. DOSAGS_L1PROF (read once):
+//   unset/0  off: every hook is one test of dos_l1_level
+//   1        entries: every script_vm entry (RunScriptFunction's CallScriptFunction) and every rep_exec_vm entry
+//            (DoRunScriptFuncCantBlock) is logged with its loop counter, instance, function name, event context
+//            (process_event's type/sub/room event), its us, and the us of game loops nested inside it (blocking)
+//   2        1 + buckets: exclusive time per script function, per engine API function called from scripts, and
+//            per (caller function, API) pair; needs an exe built with DOSAGS_L1VM=1 in cc_instance_vm.cpp
+// DOSAGS_L1WIN=lo:hi limits the level-2 buckets to loop ticks lo <= lc < hi (entries are always logged).
+// Output: L1PROF.TXT in the working directory at exit (quit.cpp, beside TICKS.BIN).
+#ifndef DOS_L1PROF_H
+#define DOS_L1PROF_H
+#ifdef __DJGPP__
+#include <stdint.h>
+class ccInstance;
+extern int dos_l1_level;
+extern int dos_l1_vmon;   // level >= 2: the VM hooks record
+void dos_l1_init();
+void dos_l1_tick(uint32_t lc);                 // once per UpdateGameOnce, at its top
+// entries
+int  dos_l1_entry_begin(int kind, const ccInstance *inst, const char *name);   // kind 0 = script_vm, 1 = rep_exec_vm
+void dos_l1_entry_end(int tok);
+// event context, set by process_event
+void dos_l1_evt_push(int type, int sub, int roomev, int *save);
+void dos_l1_evt_pop(const int *save);
+// nested game loop (UpdateGameOnce while an entry is open)
+int  dos_l1_nest_begin();
+void dos_l1_nest_end(int tok);
+// level 2, from the VM
+void dos_l1_vm_enter(const ccInstance *codeInst, int32_t pc, int legacy);
+void dos_l1_vm_exit();
+void dos_l1_at_pc(const ccInstance *codeInst, int32_t pc);
+void dos_l1_ext_begin(const void *fn);
+void dos_l1_ext_end();
+void dos_l1_dump();
+struct DosL1EvtScope
+{
+    int save[3];
+    DosL1EvtScope(int t, int s, int r) { if (dos_l1_level) dos_l1_evt_push(t, s, r, save); }
+    ~DosL1EvtScope() { if (dos_l1_level) dos_l1_evt_pop(save); }
+};
+struct DosL1NestScope
+{
+    int tok;
+    DosL1NestScope() : tok(dos_l1_level ? dos_l1_nest_begin() : -1) {}
+    ~DosL1NestScope() { if (tok >= 0) dos_l1_nest_end(tok); }
+};
+#endif
+#endif

diff --git a/libsrc/allegro/src/c/cdefs15.h b/libsrc/allegro/src/c/cdefs15.h
index c55facd02..56554b8b3 100644
--- a/libsrc/allegro/src/c/cdefs15.h
+++ b/libsrc/allegro/src/c/cdefs15.h
@@ -20,7 +20,22 @@
 
 #define PP_DEPTH               15
 
-#define PIXEL_PTR              unsigned short*
+/* DOS-PORT patch 0161: a typedef, not a macro.
+ *
+ * As "#define PIXEL_PTR unsigned short*", the declaration
+ *     PIXEL_PTR a = x, b = y;
+ * declares b as a plain unsigned short holding a truncated address,
+ * because C binds the * to the first declarator only. That happened while
+ * writing patch 0160 and the compiler caught it -- but only because the
+ * types were incompatible; the same shape with a compatible type compiles
+ * clean and corrupts memory rather than producing a wrong number.
+ *
+ * A typedef distributes across declarators and removes the class. Safe
+ * here because each translation unit includes exactly one cdefs header
+ * (checked across every .c in this directory), so there is no depth where
+ * two definitions of the name could collide.
+ */
+typedef unsigned short *PIXEL_PTR;
 #define OFFSET_PIXEL_PTR(p,x)  ((PIXEL_PTR) (p) + (x))
 #define INC_PIXEL_PTR(p)       ((p)++)
 #define INC_PIXEL_PTR_N(p,d)   ((p) += d)

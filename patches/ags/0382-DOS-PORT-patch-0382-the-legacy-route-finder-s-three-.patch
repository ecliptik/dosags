@@ -70,6 +70,51 @@ static short **beenhere = nullptr;
 static Bitmap *rp_cache_src = nullptr;   // the mask the cached analysis was made from
 static Bitmap *rp_cache_norm = nullptr;  // that mask with every walkable pixel set to 1
 
+// DOS-PORT patch 0382 (TEMPORARY switch, default off): DOSAGS_ROUTE_FAST=1 runs find_route_dijkstra_fast and the
+// inline line-of-sight walk below; unset, the functions as they were run. The switch is tested once per call, never
+// inside a search loop. To be removed, with the body that loses, after the 486 A/B and the operator's ruling on the default.
+static int dos_rf_fast = -1;
+static inline bool dos_rf_fast_on()
+{
+    if (dos_rf_fast < 0)
+    {
+        const char *e = getenv("DOSAGS_ROUTE_FAST");
+        dos_rf_fast = (e && e[0] == '1' && e[1] == 0) ? 1 : 0;
+    }
+    return dos_rf_fast != 0;
+}
+// R1: one uint8 generation stamp per mask cell. A cell is "not yet visited in this search" when its stamp is not the
+// current generation, which is what the 0xFF fill of beenhere said; beenhere itself stays the per-call buffer it is.
+// When the generation would pass 255 the grid is cleared and it restarts at 1.
+static unsigned char *dos_rf_stamp = nullptr;
+static int dos_rf_stamp_w = 0, dos_rf_stamp_h = 0, dos_rf_gen = 0;
+static long dos_rf_stamp_allocs = 0, dos_rf_stamp_peak = 0;
+static void dos_rf_stamp_free()
+{
+    free(dos_rf_stamp);
+    dos_rf_stamp = nullptr;
+    dos_rf_stamp_w = dos_rf_stamp_h = 0;
+}
+static void dos_rf_stamp_begin(int w, int h)
+{
+    if (!dos_rf_stamp || dos_rf_stamp_w != w || dos_rf_stamp_h != h)
+    {
+        dos_rf_stamp_free();
+        dos_rf_stamp = (unsigned char *)calloc((size_t)w * h, 1);
+        if (!dos_rf_stamp)
+            quit("insufficient memory to allocate pathfinder stamp buffer");
+        dos_rf_stamp_w = w; dos_rf_stamp_h = h; dos_rf_gen = 0;
+        dos_rf_stamp_allocs++;
+        if ((long)w * h > dos_rf_stamp_peak) dos_rf_stamp_peak = (long)w * h;
+    }
+    if (dos_rf_gen >= 255)
+    {
+        memset(dos_rf_stamp, 0, (size_t)w * h);
+        dos_rf_gen = 0;
+    }
+    dos_rf_gen++;
+}
+
 LegacyRouteFinder::LegacyRouteFinder()
 {
     pathbackx = (int *)malloc(sizeof(int) * MAXPATHBACK);
@@ -98,6 +143,7 @@ LegacyRouteFinder::~LegacyRouteFinder()
         }
         free(beenhere);
     }

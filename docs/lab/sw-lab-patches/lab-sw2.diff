+#if defined(__DJGPP__) && !defined(DOSAGS_RELEASE)
+// LAB-SW (lab only). DOSAGS_LABCLICKS=lc:x:y[:b][,...]: LAB-PLAY's clicks, copied from lab-r3-full.diff (b=0 moves only).
+// DOSAGS_LAB_SAVEAT=lc:slot: a scripted normal save, SaveGameSlot(slot, "LABSAVE"), when the loop counter first reaches lc.
+static int dos_lc_mode = -1, dos_lc_n = 0, dos_lc_next = 0;
+static long dos_lc_t[64]; static int dos_lc_x[64], dos_lc_y[64], dos_lc_b[64];
+static void dos_lab_clicks()
+{
+    if (dos_lc_mode < 0)
+    {
+        dos_lc_mode = 0;
+        const char *e = getenv("DOSAGS_LABCLICKS");
+        while (e && *e && dos_lc_n < 64)
+        {
+            long t; int x, y, used = 0, b = 1, used2 = 0;
+            if (sscanf(e, "%ld:%d:%d%n", &t, &x, &y, &used) != 3) break;
+            e += used;
+            if (*e == ':' && sscanf(e, ":%d%n", &b, &used2) == 1) e += used2;
+            dos_lc_t[dos_lc_n] = t; dos_lc_x[dos_lc_n] = x; dos_lc_y[dos_lc_n] = y; dos_lc_b[dos_lc_n] = b; dos_lc_n++;
+            if (*e == ',') e++;
+        }
+        if (dos_lc_n > 0) { dos_lc_mode = 1; Debug::Printf("DOS-PORT labclicks n=%d", dos_lc_n); }
+    }
+    if (dos_lc_mode != 1 || dos_lc_next >= dos_lc_n)
+        return;
+    const long lc = (long)get_loop_counter();
+    if (lc < dos_lc_t[dos_lc_next])
+        return;
+    const int k = dos_lc_next++;
+    SetMousePosition(dos_lc_x[k], dos_lc_y[k]);
+    if (dos_lc_b[k]) SimulateMouseClick(kMouseLeft);
+    Debug::Printf("DOS-PORT labclick lc=%ld n=%d x=%d y=%d click=%d", lc, k + 1, dos_lc_x[k], dos_lc_y[k], dos_lc_b[k]);
+}
+static int dos_sa_mode = -1, dos_sa_slot = 0; static long dos_sa_lc = 0;
+static void dos_lab_saveat()
+{
+    if (dos_sa_mode < 0)
+    {
+        dos_sa_mode = 0;
+        const char *e = getenv("DOSAGS_LAB_SAVEAT");
+        if (e && sscanf(e, "%ld:%d", &dos_sa_lc, &dos_sa_slot) == 2) dos_sa_mode = 1;
+    }
+    if (dos_sa_mode != 1 || (long)get_loop_counter() < dos_sa_lc)
+        return;
+    dos_sa_mode = 2;
+    Debug::Printf("DOS-PORT labsave lc=%ld slot=%d", (long)get_loop_counter(), dos_sa_slot);
+    SaveGameSlot(dos_sa_slot, "LABSAVE", -1);
+}
+#endif

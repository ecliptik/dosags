     return n;
 }();
 
+// patch 0193: the same merge policy as the main accumulator below (touching or overlapping boxes
+// coalesce, else a free slot, else the pair whose union wastes the fewest pixels), on a bare set.
+static void dos_port_boxset_add(DosPortDirtyBox *box, int &n, int cap, int x1, int y1, int x2, int y2)
+{
+    for (int i = 0; i < n; ++i)
+    {
+        DosPortDirtyBox &b = box[i];
+        if (x1 <= b.x2 + 1 && x2 >= b.x1 - 1 && y1 <= b.y2 + 1 && y2 >= b.y1 - 1)
+        {
+            if (x1 < b.x1) b.x1 = x1;
+            if (y1 < b.y1) b.y1 = y1;
+            if (x2 > b.x2) b.x2 = x2;
+            if (y2 > b.y2) b.y2 = y2;
+            return;
+        }
+    }
+    if (n < cap)
+    {
+        box[n].x1 = x1; box[n].y1 = y1; box[n].x2 = x2; box[n].y2 = y2;
+        ++n;
+        return;
+    }
+    int best_i = 0, best_j = 1;
+    long long best_waste = -1;
+    DosPortDirtyBox cand; cand.x1 = x1; cand.y1 = y1; cand.x2 = x2; cand.y2 = y2;
+    for (int i = 0; i < n; ++i)
+    {
+        for (int j = i + 1; j <= n; ++j)
+        {
+            const DosPortDirtyBox &a = box[i];
+            const DosPortDirtyBox &b = (j == n) ? cand : box[j];
+            const int ux1 = a.x1 < b.x1 ? a.x1 : b.x1, uy1 = a.y1 < b.y1 ? a.y1 : b.y1;
+            const int ux2 = a.x2 > b.x2 ? a.x2 : b.x2, uy2 = a.y2 > b.y2 ? a.y2 : b.y2;
+            const long long waste = (long long)(ux2 - ux1 + 1) * (uy2 - uy1 + 1)
+                - (long long)(a.x2 - a.x1 + 1) * (a.y2 - a.y1 + 1)
+                - (long long)(b.x2 - b.x1 + 1) * (b.y2 - b.y1 + 1);
+            if (best_waste < 0 || waste < best_waste) { best_waste = waste; best_i = i; best_j = j; }
+        }
+    }
+    DosPortDirtyBox &a = box[best_i];
+    const DosPortDirtyBox &b = (best_j == n) ? cand : box[best_j];
+    if (b.x1 < a.x1) a.x1 = b.x1;
+    if (b.y1 < a.y1) a.y1 = b.y1;
+    if (b.x2 > a.x2) a.x2 = b.x2;
+    if (b.y2 > a.y2) a.y2 = b.y2;
+    if (best_j < n) { box[best_j].x1 = x1; box[best_j].y1 = y1; box[best_j].x2 = x2; box[best_j].y2 = y2; }
+}
+
 void dos_port_dirty_add_screen(int x1, int y1, int x2, int y2)
 {
     dos_port_dirty.adds++;
+    // patch 0193: after this interval's background restore, a mark is repainted by the NEXT
+    // frame's restore, so it is kept for the next present too. Before the full-latch return
+    // below, because a full push now says nothing about what the next restore repaints.
+    if (dos_port_dirty.restore_seen)
+        dos_port_boxset_add(dos_port_dirty.post_box, dos_port_dirty.post_nbox, dos_port_dirty_max_boxes,
+                            x1, y1, x2, y2);
     {   // patch 0175: attribute this rect's area to whoever asked for it
         const int _s = (dos_port_dirty_source >= 0 && dos_port_dirty_source < kDirtySrc_Count)
                        ? dos_port_dirty_source : kDirtySrc_Other;
@@ -530,6 +590,8 @@ void dos_port_dirty_add_screen(int x1, int y1, int x2, int y2)
 
 void dos_port_dirty_set_full(const char *why)
 {
+    if (dos_port_dirty.restore_seen)
+        dos_port_dirty.post_full = true;   // patch 0193: the next restore repaints all of it
     if (!dos_port_dirty.is_full)
     {
         dos_port_dirty.is_full = true;
@@ -538,8 +600,49 @@ void dos_port_dirty_set_full(const char *why)
     }
 }
 
+void dos_port_dirty_note_restore()
+{
+    dos_port_dirty.restore_seen = true;   // patch 0193
+}
+
+// patch 0193: called at the top of the present's narrowing decision. Adds the previous interval's
+// post-restore marks (what THIS frame's restore repainted) to this interval's set, without letting
+// them be re-recorded as post-restore marks (that would carry them forever).
+void dos_port_dirty_merge_carry()
+{
+    DosPortDirtyState &d = dos_port_dirty;
+    const bool rs = d.restore_seen;
+    d.restore_seen = false;
+    if (d.carry_full)
+    {
+        dos_port_dirty_set_full("previous interval invalidated the whole surface after its restore");
+        d.carried_full++;
+    }
+    if (d.carry_nbox > 0)
+    {
+        const int saved_src = dos_port_dirty_source;
+        dos_port_dirty_source = kDirtySrc_Carry;
+        for (int i = 0; i < d.carry_nbox; ++i)
+            dos_port_dirty_add_screen(d.carry_box[i].x1, d.carry_box[i].y1, d.carry_box[i].x2, d.carry_box[i].y2);
+        dos_port_dirty_source = saved_src;
+        d.carried_presents++;
+        d.carried_boxes += d.carry_nbox;
+    }
+    d.carry_nbox = 0;
+    d.carry_full = false;
+    d.restore_seen = rs;
+}
+
 void dos_port_dirty_frame_reset()
 {
+    // patch 0193: what was marked after this interval's restore is what the next restore repaints.
+    dos_port_dirty.carry_nbox = dos_port_dirty.post_nbox;
+    for (int i = 0; i < dos_port_dirty.post_nbox; ++i)
+        dos_port_dirty.carry_box[i] = dos_port_dirty.post_box[i];
+    dos_port_dirty.carry_full = dos_port_dirty.post_full;
+    dos_port_dirty.post_nbox = 0;
+    dos_port_dirty.post_full = false;
+    dos_port_dirty.restore_seen = false;
     dos_port_dirty.valid = false;
     dos_port_dirty.is_full = false;
     dos_port_dirty.full_reason = nullptr;
@@ -825,6 +928,7 @@ void update_room_invreg_and_reset(int view_index, Bitmap *ds, Bitmap *src, bool
     update_invalid_region(ds, src, RoomCamRects[view_index], no_transform);
 #ifdef __DJGPP__
     }
+    dos_port_dirty_note_restore();   // patch 0193: marks made from here on are repainted next frame
     if ((dos_port_tick_timing.bg_calls % 500) == 0)
         AGS::Common::Debug::Printf("DOS-PORT bgstruct calls=%ld whole=%ld px=%ld slow_px=%ld",
             dos_port_tick_timing.bg_calls, dos_port_tick_timing.bg_whole,

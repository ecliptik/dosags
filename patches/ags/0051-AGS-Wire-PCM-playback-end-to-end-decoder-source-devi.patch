 #include "media/audio/sdldecoder.h"
+#include "platform/dos/dos_audio_decode.h"
+#include "platform/dos/dos_audio_mixer.h"
 #include "util/sdl2_util.h"
+#include <algorithm>
 
 namespace AGS
 {
 namespace Engine
 {
 
+namespace
+{
+// Chunk granularity GetData() hands out -- the decode itself already
+// happened whole, at Open(); this is just a hand-off size to the
+// existing AudioPlayer::Poll()/OpenAlSource::PutData() chunked pump,
+// unchanged by this file, small enough to keep a voice's mixer-side ring
+// (dos_audio_mixer.h, capped at 32 KB) comfortably topped up without
+// ever holding more than a fraction of a second buffered ahead.
+const size_t DECODED_CHUNK_SAMPLES = 2048u; // ~186 ms at 11025 Hz mono
+} // namespace
+
 //-----------------------------------------------------------------------------
 // SDLDecoder
 //-----------------------------------------------------------------------------
@@ -45,6 +59,13 @@ SDLDecoder::SDLDecoder(SDLDecoder &&dec)
     dec._rwops = nullptr;
     _sampleExt = std::move(dec._sampleExt);
     _repeat = dec._repeat;
+    _pcm = std::move(dec._pcm);
+    _readSamples = dec._readSamples;
+    _opened = dec._opened;
+    _eos = dec._eos;
+    dec._opened = false;
+    dec._eos = true;
+    dec._readSamples = 0u;
 }
 
 SDLDecoder::~SDLDecoder()
@@ -52,17 +73,74 @@ SDLDecoder::~SDLDecoder()
     Close();
 }
 
-bool SDLDecoder::Open(float /*pos_ms*/)
+SDL_AudioFormat SDLDecoder::GetFormat() const
 {
-    // STUB: no decoder backend is available on DOS (SDL2_sound is gated
-    // out of the link entirely, patch 0006). Always fail -- every real
-    // call site already handles a failed-to-open decoder (see
-    // audio_core.cpp's audio_core_slot_init). Still close/release
-    // whatever was handed to us, matching the original code's own
-    // "rwops closed regardless of Open()'s outcome" contract, so a
-    // caller that never calls Close() explicitly can't leak the stream.
-    Close();
-    return false;
+    return _opened ? DOS_AUDIO_MIXER_FORMAT : SDL_AUDIO_UNKNOWN;
+}
+
+int SDLDecoder::GetChannels() const
+{
+    return _opened ? DOS_AUDIO_MIXER_CHANNELS : 0;
+}
+
+int SDLDecoder::GetFreq() const
+{
+    return _opened ? DOS_AUDIO_MIXER_RATE : 0;
+}
+
+float SDLDecoder::GetPositionMs() const
+{
+    if (!_opened)
+        return 0.f;
+    return 1000.f * static_cast<float>(_readSamples) / static_cast<float>(DOS_AUDIO_MIXER_RATE);
+}
+
+float SDLDecoder::GetDurationMs() const
+{
+    if (!_opened)
+        return 0.f;
+    return 1000.f * static_cast<float>(_pcm.size()) / static_cast<float>(DOS_AUDIO_MIXER_RATE);
+}
+
+bool SDLDecoder::Open(float pos_ms)
+{
+    // Prevent from "reopening" twice, matching the original real
+    // decoder's own assert/early-seek shape.
+    if (_opened)
+    {
+        if (pos_ms > 0.f)
+            Seek(pos_ms);
+        return true;
+    }
+
+    std::vector<uint8_t> raw;
+    if (_sampleData && !_sampleData->empty())
+    {
+        raw = *_sampleData; // already fully in memory
+    }
+    else if (_rwops)
+    {
+        size_t sz = 0;
+        void *buf = SDL_LoadFile_IO(_rwops, &sz, true /* close it for us */);
+        _rwops = nullptr; // SDL_LoadFile_IO closed it regardless of outcome
+        if (buf)
+        {
+            raw.assign(static_cast<uint8_t *>(buf), static_cast<uint8_t *>(buf) + sz);
+            SDL_free(buf);
+        }
+    }
+
+    const bool decoded = dos_audio_decode_pcm(raw.data(), raw.size(), _pcm);
+    Close(); // release whatever we were handed, decoded or not
+    if (!decoded)
+        return false;
+
+    _opened = true;
+    _readSamples = 0u;
+    _eos = false;
+    if (pos_ms > 0.f)
+        Seek(pos_ms);
+    return true;
 }
 

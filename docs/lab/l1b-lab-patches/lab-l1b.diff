+        const L1bPc &t = s_l1b_pct[i];
+        fprintf(f, "S %u %s %u\n", static_cast<unsigned>(i), t.label.c_str(), t.codesize);
+        for (const auto &fn : t.fns)
+            fprintf(f, "F %u %d %s\n", static_cast<unsigned>(i), static_cast<int>(fn.second), fn.first.c_str());
+        for (uint32_t pc = 0; pc < t.codesize; ++pc)
+            if (t.n[pc]) fprintf(f, "X %u %u %lu %s\n", static_cast<unsigned>(i), pc, static_cast<unsigned long>(t.n[pc]), t.desc[pc].c_str());
+    }
+    for (int i = 0; i < kL1bBN; ++i)
+    {
+        fprintf(f, "K %s calls=%lu nargs=%d args=%d,%d samples=%d", s_l1b_bench_names[i], s_l1b_bcalls[i], s_l1b_bnargs[i],
+            s_l1b_barg[i][0], s_l1b_barg[i][1], s_l1b_bsamples[i]);
+        for (int k = 0; k < s_l1b_bsamples[i]; ++k)
+            fprintf(f, " c%d=%llu e%d=%llu", k, static_cast<unsigned long long>(s_l1b_bres[i][k]), k,
+                static_cast<unsigned long long>(s_l1b_bempty[i][k]));
+        fprintf(f, "\n");
+    }

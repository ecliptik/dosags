     // per-tick path (ac/draw.cpp:~3179), which IS a clean subset,
     // comparable directly against update_game_once_total.
     DosPortTickPhaseStats render_to_screen_pertick; // ac/draw.cpp: render_graphics()'s own render_to_screen() call site only
+
+    // patch 0089 (operator-directed follow-up: patch 0087 cut
+    // render_to_screen_pertick from ~121ms to ~74ms/call, but did not
+    // explain where the remaining ~74ms goes -- instrument before
+    // guessing again, same discipline that found patch 0087 itself).
+    // Sub-phases of render_to_screen()/Present(), in call order:
+    DosPortTickPhaseStats screen_overlay_vsync;    // ac/draw.cpp: render_to_screen()'s own plugin-hook+construct_engine_overlay()+vsync-set logic, BEFORE gfxDriver->Render()
+    DosPortTickPhaseStats present_get_win_surface; // gfx/ali3dsw.cpp: Present()'s SDL_GetWindowSurface() call
+    DosPortTickPhaseStats present_sync_palette;    // gfx/ali3dsw.cpp: Present()'s SyncPaletteIfNeeded() call
+    DosPortTickPhaseStats present_flip_handling;   // gfx/ali3dsw.cpp: Present()'s `if (flip != kFlip_None)` block -- expected near-zero for this game (screen_flipped is normally off), verified not assumed
+    DosPortTickPhaseStats present_blit;            // gfx/ali3dsw.cpp: Present()'s TryFastIntegerNearestBlit()/SDL_BlitSurfaceScaled() call
+    DosPortTickPhaseStats present_update_window;   // gfx/ali3dsw.cpp: Present()'s SDL_UpdateWindowSurface() call -- the actual push to the display
+    // Internal breakdown of present_blit itself, when the fast path is
+    // taken (TryFastIntegerNearestBlit) -- accumulated manually (one
+    // dos_port_tick_record() call per Present(), not per source row)
+    // to avoid per-row RAII overhead across up to 240 rows/call.
+    DosPortTickPhaseStats fastblit_lock;       // SDL_LockSurface() calls (src+dst)
+    DosPortTickPhaseStats fastblit_hreplicate; // the horizontal pixel-replication loop, summed across all source rows
+    DosPortTickPhaseStats fastblit_vmemcpy;    // the vertical memcpy() replication, summed across all source rows
 };
 

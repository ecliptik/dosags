+    DosPortTickPhaseStats rep_exec_wrapper;       // main/game_run.cpp: GameUpdateEarlyRepExec()+GameUpdateLateRepExec()
+
+    // patch 0082: objects_scale only wraps update_objects_scale() --
+    // UpdateDrawableObjectStates() (its caller) ALSO calls
+    // play.UpdateRoomCameras(), update_cursor_over_location(), and
+    // update_cursor_view() directly, none of which were ever bracketed.
+    // Whole-function check, inclusive of objects_scale's own nested cost.
+    DosPortTickPhaseStats drawable_object_states; // main/game_run.cpp: UpdateDrawableObjectStates()
+
+    // patch 0082 (final lead, after four consecutive null results):
+    // script_vm's own ~3669ms single-tick outlier does NOT appear in
+    // rep_exec_vm/rep_exec_wrapper's own max_ms (both capped at 3ms) --
+    // meaning it is NOT reached via the routine repeatedly_execute
+    // path. Traced the real path by reading the actual call chain
+    // (not assumed): ac/event.cpp's process_event() (called from
+    // processallevents()'s dispatch loop) routes hotspot/region/room
+    // interactions through run_interaction_script() (script/script.cpp),
+    // which calls QueueScriptFunction() -- NOT RunScriptFunction()
+    // directly. QueueScriptFunction() itself either defers to
+    // curscript->RunAnother() (if already inside a script) or calls
+    // RunScriptFunctionAuto() immediately, and RunScriptFunctionAuto()'s
+    // own helpers (RunEventInModule/RunClaimableEvent/RunUnclaimableEvent)
+    // all funnel into RunScriptFunction() -- confirmed by reading each
+    // of those four functions directly, not assumed from the name.
+    // So the ACTUAL VM EXECUTION time for event-driven interactions
+    // (hotspot/region/room scripts, on_event handlers) IS already
+    // counted by script_vm -- what is NOT counted is
+    // processallevents()'s own wrapper overhead around that dispatch:
+    // the `std::vector<AGSEvent> evtcopy = events` copy, the dispatch
+    // loop itself, and process_event()'s own routing logic (building

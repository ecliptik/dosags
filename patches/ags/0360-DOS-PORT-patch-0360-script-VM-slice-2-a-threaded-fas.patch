+    DosVmCallStack *fcs;         // Run()'s func_callstack
+    int             curnest;
+    int             num_args_to_func;
+    int             next_call_needs_object;
+    int             was_just_callas;
+    int             loopIterationCheckDisabled;
+    unsigned        loopIterations;
+    unsigned        loopCheckIterations;
+    std::chrono::milliseconds timeout;
+    int32_t         thisbase[MAXNEST];
+    int32_t         funcstart[MAXNEST];
+};

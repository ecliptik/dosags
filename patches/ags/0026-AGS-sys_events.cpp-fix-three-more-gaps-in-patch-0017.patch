     // systems where single keypress can produce that symbol.
 
     // Old mode: Ctrl and Alt combinations realign the letter code to certain offset
-    if (old_keyhandle && (sym >= SDLK_a && sym <= SDLK_z))
+    if (old_keyhandle && (sym >= SDLK_A && sym <= SDLK_Z))
     {
         if ((mod & SDL_KMOD_CTRL) != 0) // align letters to code 1
-            return static_cast<eAGSKeyCode>( 0 + (sym - SDLK_a) + 1 );
+            return static_cast<eAGSKeyCode>( 0 + (sym - SDLK_A) + 1 );
         else if ((mod & SDL_KMOD_ALT) != 0) // align letters to code 301
-            return static_cast<eAGSKeyCode>( AGS_EXT_KEY_SHIFT + (sym - SDLK_a) + 1 );
+            return static_cast<eAGSKeyCode>( AGS_EXT_KEY_SHIFT + (sym - SDLK_A) + 1 );
     }
     // New mode: also handle common key range
-    else if (!old_keyhandle && (sym >= SDLK_SPACE && sym <= SDLK_z))
+    else if (!old_keyhandle && (sym >= SDLK_SPACE && sym <= SDLK_Z))
     {
         return static_cast<eAGSKeyCode>(sym);
     }
@@ -177,7 +177,7 @@ bool ags_key_to_sdl_scan(eAGSKeyCode key, SDL_Scancode(&scan)[3])
     // SDL sym codes happen to match small ASCII letters, so lowercase ours if necessary
     if (key >= eAGSKeyCodeA && key <= eAGSKeyCodeZ)
     {
-        sym = static_cast<SDL_Keycode>(key - eAGSKeyCodeA + SDLK_a);
+        sym = static_cast<SDL_Keycode>(key - eAGSKeyCodeA + SDLK_A);
     }
     // Rest of the printable characters seem to match (and match ascii codes)
     else if (key >= eAGSKeyCodeSpace && key <= eAGSKeyCodeBackquote)
@@ -308,7 +308,7 @@ KeyInput sdl_keyevt_to_ags_key(const SDL_Event &event, bool old_keyhandle)
             }
         }
         ags_strncpy_s(ki.Text, KeyInput::UTF8_ARR_SIZE, event.text.text, KeyInput::UTF8_ARR_SIZE - 1);
-        Utf8::GetChar(event.text.text, SDL_strlen(event.text.text), &ki.UChar);
+        Utf8::GetChar(event.text.text, SDL_strlen(event.text.text), reinterpret_cast<Utf8::Rune*>(&ki.UChar));
         return ki;
     }
     case SDL_EVENT_KEY_DOWN:
@@ -424,7 +424,7 @@ void ags_simulate_keypress(eAGSKeyCode ags_key, eAGSKeyMod mod, bool old_keyhand
     SDL_PushEvent(&sdlevent);
     // Push a text input event for ascii printable characters;
     // in case of "old key handling mode" this instead will trigger on_key_press for them.
-    if (old_keyhandle && (key_sym >= SDLK_SPACE && key_sym <= SDLK_z))
+    if (old_keyhandle && (key_sym >= SDLK_SPACE && key_sym <= SDLK_Z))
     {
         // DOS-PORT: SDL_TextInputEvent::text is a "const char *" in SDL3, not
         // a writable fixed array -- SDL_PushEvent() deep-copies the pointed-to

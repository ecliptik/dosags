                                    (int)info.has_lfb, (int)sup, (int)gfx, (int)color,
                                    info.pitch, info.num_image_pages,
                                    info.win_a_segment, (unsigned)info.win_size,
                                    (unsigned)info.win_granularity, info.win_a_attributes,
-                                   (unsigned long)info.physical_base_addr);
+                                   (unsigned long)info.physical_base_addr,
+                                   info.red_mask_pos, info.red_mask_size, info.green_mask_pos,
+                                   info.green_mask_size, info.blue_mask_pos, info.blue_mask_size);
             }
             DOS_PORT_MODES_LOG("DOSVESA-MODELIST: end of BIOS-reported mode dump");
         }
@@ -668,6 +681,27 @@ bool DOSVESA_GetDisplayModes(SDL_VideoDevice *device, SDL_VideoDisplay *sdl_disp
     // the VGA mode 13h fallback below.
     int num_vesa_modes = (vinfo && vinfo->version >= 0x102) ? vinfo->num_modes : 0;
 
+    // DOS-PORT patch 0210 (dosags lab-metric, Gate S32): SDL_DOS_PACK24=1 presents a
+    // 32-bit application surface through a 24-bpp mode. Measured on an ATI Mach64 under
+    // UniVBE (dosags BW32, 2026-09-24): CPU writes to its 640x480x32 LFB run at 7.7 MB/s,
+    // to 640x480x24 at 27.2 MB/s, the same 8:8:8 colour. A 24-bpp direct-colour LFB mode
+    // whose masks are R16/G8/B0 (memory B,G,R -- XRGB8888 without its X byte) is offered
+    // as SDL_PIXELFORMAT_XRGB8888; the framebuffer code packs 4->3 bytes per pushed pixel
+    // (SDL_dosframebuffer.c). The native 32-bpp mode of the same size is hidden so an
+    // application asking for 32 bpp lands on the packed one. Off by default: the mode
+    // list is byte-unchanged unless the hint is set.
+    const bool pack24_hint = SDL_GetHintBoolean("SDL_DOS_PACK24", false);
+    Uint32 pack24_wh[16];
+    int pack24_n = 0;
+    if (pack24_hint) {
+        for (int mi = 0; mi < num_vesa_modes && pack24_n < 16; mi++) {
+            SDL_DisplayModeData pi;
+            if (GetVESAModeInfo(vinfo->mode_list[mi], &pi) && DOS_ModeIsPack24Candidate(&pi)) {
+                pack24_wh[pack24_n++] = ((Uint32)pi.w << 16) | pi.h;
+            }
+        }
+    }
+
     for (int mi = 0; mi < num_vesa_modes; mi++) {
         const Uint16 modeid = vinfo->mode_list[mi];
 
@@ -718,8 +752,27 @@ bool DOSVESA_GetDisplayModes(SDL_VideoDevice *device, SDL_VideoDisplay *sdl_disp
             // Note: 8-bit indexed modes are packed pixel.
         }
 
+        // patch 0210: hide a 32-bpp mode that has a packable 24-bpp twin.
+        if (pack24_hint && info.bpp == 32) {
+            bool twin = false;
+            for (int k = 0; k < pack24_n; k++) {
+                if (pack24_wh[k] == (((Uint32)info.w << 16) | info.h)) {
+                    twin = true;
+                }
+            }
+            if (twin) {
+                DOS_PORT_MODES_LOG("DOSVESA-PACK24: hiding 32-bpp mode 0x%04X %dx%d (24-bpp twin offered)",
+                                   info.mode_id, info.w, info.h);
+                continue;
+            }
+        }
+
         SDL_PixelFormat format = SDL_PIXELFORMAT_UNKNOWN;
-        if (info.memory_model == VBE_MEMMODEL_PACKED_PIXEL) {

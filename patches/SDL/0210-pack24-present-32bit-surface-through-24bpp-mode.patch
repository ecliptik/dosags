+                               info.mode_id, info.w, info.h, info.pitch);
+        } else if (info.memory_model == VBE_MEMMODEL_PACKED_PIXEL) {
             switch (info.bpp) {
             case 8:
                 format = SDL_PIXELFORMAT_INDEX8;

@@ -887,6 +934,19 @@ static bool populate_fb_state_for_direct_fb(SDL_VideoDevice *device,
     fb_state.src_pitch = surface->pitch;
     fb_state.fb_size = (Uint32)vram_pitch * mdata->h;
     fb_state.pitches_match = (surface->pitch == vram_pitch);
+    fb_state.pack24 = dos_mode_is_pack24(mode); // patch 0210
+    if (fb_state.pack24) {

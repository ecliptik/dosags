-    dump_al_errors();
-    alSourceQueueBuffers(_source, 1, &buf_id);
-    dump_al_errors();
-    _queued++;
-    _predictTs = data.Timestamp() >= 0.f ? (data.Timestamp() + dur_ms) : (_predictTs + dur_ms);
-    // Push buffer record
-    _bufferRecords.push_back(BufferRecord(use_ts, dur_ms, _speed));
-    return data.Size();
-}

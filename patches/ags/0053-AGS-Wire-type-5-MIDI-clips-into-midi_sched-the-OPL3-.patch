+// DOS-PORT (Sound milestone, S4): scratch DOS path a MIDI clip's raw SMF
+// bytes are written to before AudioPlayer's MIDI constructor calls
+// midi_sched_open() on it -- shared/audio's midi_sched_open() reads a file
+// path, not an in-memory buffer (see audioplayer.h's own header note), and
+// the music channel is AGS's single reserved SCHAN_MUSIC slot, so only one
+// MIDI clip is ever live at a time -- a single fixed 8.3 filename is
+// sufficient, no per-clip uniqueness needed. Binary write per this hub's
+// own hard DJGPP constraint (fopen mode, CRLF translation would corrupt
+// the SMF bytes).
+static const char *DOS_MIDI_SCRATCH_PATH = "DOSMIDI.TMP";
+
+int audio_core_slot_init_midi(std::shared_ptr<std::vector<uint8_t>> &data, bool repeat)
+{
+    FILE *fp = fopen(DOS_MIDI_SCRATCH_PATH, "wb");
+    if (!fp)
+    {
+        Debug::Printf(kDbgMsg_Error, "audio_core_slot_init_midi: could not open %s for write", DOS_MIDI_SCRATCH_PATH);
+        return -1;
+    }
+    const size_t written = data ? fwrite(data->data(), 1, data->size(), fp) : 0u;
+    fclose(fp);
+    if (!data || written != data->size())
+    {
+        Debug::Printf(kDbgMsg_Error, "audio_core_slot_init_midi: short write to %s", DOS_MIDI_SCRATCH_PATH);
+        return -1;
+    }
+
+    auto handle = avail_slot_id();
+    std::lock_guard<std::mutex> lk(g_acore.mixer_mutex_m);
+    g_acore.slots_[handle] = std::make_unique<AudioPlayer>(handle, String(DOS_MIDI_SCRATCH_PATH), repeat);
+    g_acore.mixer_cv.notify_all();
+    return handle;
+}
+
 AudioPlayerLock audio_core_get_player(int slot_handle)
 {
     std::unique_lock<std::mutex> ulk(g_acore.mixer_mutex_m);

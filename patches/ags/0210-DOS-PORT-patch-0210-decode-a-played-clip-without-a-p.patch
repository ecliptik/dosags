From 49411e52efe1356b7806a6dcf024009b79960724 Mon Sep 17 00:00:00 2001
From: Micheal Waltz <micheal@ecliptik.com>
Date: Wed, 23 Sep 2026 16:57:23 -0700
Subject: [PATCH] DOS-PORT: patch 0210 -- decode a played clip without a
 per-sample divide, push_back or extra copies

A sound play decodes the whole clip on the main thread inside the script's
play call, and on the 486 that was ~2.5 us per sample for a 16-bit mono clip
already at the mixer rate (5 Days' sound 10: ~270 ms of a 656 ms stall;
dosags STW). decode_pcm_block divided every frame's sum by the runtime
`channels` and push_back'd each sample, append_resampled_mono then copied
the whole buffer into the output, and SDLDecoder::Open copied the cached
clip bytes before decoding them.

Mono and stereo now get their own loops (mono stores the sample as the old
sum / 1 did; stereo divides by the constant 2 with the same truncation);
other channel counts keep the generic loop. A clip already at the mixer rate
is moved into the empty output instead of copied. Open decodes the cache's
bytes in place. The resampling path is unchanged. Every decoded sample is
identical to before: host fuzz of old vs new over 1/2/3 channels, 8/16 bits,
7 rates, odd tails, extremes and VOC multi-block -- 1730 cases, 0 mismatches.
---
 Engine/media/audio/sdldecoder.cpp        | 11 +++-
 Engine/platform/dos/dos_audio_decode.cpp | 68 +++++++++++++++++++-----
 2 files changed, 65 insertions(+), 14 deletions(-)

diff --git a/Engine/media/audio/sdldecoder.cpp b/Engine/media/audio/sdldecoder.cpp
index 9fb31e7ff..a7a9f6f17 100644
--- a/Engine/media/audio/sdldecoder.cpp
+++ b/Engine/media/audio/sdldecoder.cpp
@@ -148,9 +148,14 @@ bool SDLDecoder::Open(float pos_ms)
     }
 
     std::vector<uint8_t> raw;
+    // DOS-PORT patch 0210: a clip already fully in memory (the sound cache's bytes) is decoded where
+    // it is, not copied first -- the copy was a whole-clip memcpy on every play.
+    const uint8_t *src = nullptr;
+    size_t src_size = 0;
     if (_sampleData && !_sampleData->empty())
     {
-        raw = *_sampleData; // already fully in memory
+        src = _sampleData->data(); // already fully in memory; _sampleData keeps it alive until Close()
+        src_size = _sampleData->size();
     }
     else if (_rwops)
     {
@@ -162,9 +167,11 @@ bool SDLDecoder::Open(float pos_ms)
             raw.assign(static_cast<uint8_t *>(buf), static_cast<uint8_t *>(buf) + sz);
             SDL_free(buf);
         }
+        src = raw.data();
+        src_size = raw.size();
     }
 
-    const bool decoded = dos_audio_decode_pcm(raw.data(), raw.size(), _pcm);
+    const bool decoded = dos_audio_decode_pcm(src, src_size, _pcm);
     Close(); // release whatever we were handed, decoded or not
     if (!decoded)
         return false;
diff --git a/Engine/platform/dos/dos_audio_decode.cpp b/Engine/platform/dos/dos_audio_decode.cpp
index b64986181..371713414 100644
--- a/Engine/platform/dos/dos_audio_decode.cpp
+++ b/Engine/platform/dos/dos_audio_decode.cpp
@@ -75,21 +75,65 @@ void decode_pcm_block(const uint8_t *data, size_t bytes, int rate, int channels,
         return;
     const size_t frames = bytes / bytes_per_frame;
     std::vector<int16_t> mono;
-    mono.reserve(frames);
-    for (size_t f = 0; f < frames; f++)
+    // DOS-PORT patch 0210: the play of a clip decodes it whole on the main thread, and this loop was
+    // most of that cost on the 486 (~2.5 us per sample for a 16-bit mono clip already at the mixer
+    // rate: a runtime divide by `channels` and a push_back per sample, then a second full copy).
+    // Mono and stereo get their own loops; every output sample is the same value as the generic
+    // loop's (mono: the sample itself, as sum / 1; stereo: sum / 2 with the same truncation toward
+    // zero, now a divide by a constant). A clip already at the mixer rate is moved into an empty
+    // output instead of copied.
+    mono.resize(frames);
+    int16_t *const m = mono.data();
+    if (channels == 1 && bits == 16)
     {
-        int32_t sum = 0;
-        const uint8_t *frame = data + f * bytes_per_frame;
-        for (int c = 0; c < channels; c++)
+        for (size_t f = 0; f < frames; f++)
+            m[f] = static_cast<int16_t>(rd_u16le(data + f * 2));
+    }
+    else if (channels == 1)
+    {
+        for (size_t f = 0; f < frames; f++)
+            m[f] = static_cast<int16_t>((static_cast<int32_t>(data[f]) - 128) * 256); // unsigned 8-bit -> signed 16
+    }
+    else if (channels == 2 && bits == 16)
+    {
+        for (size_t f = 0; f < frames; f++)
         {
-            int32_t sample;
-            if (bits == 8)
-                sample = (static_cast<int32_t>(frame[c]) - 128) * 256; // unsigned 8-bit -> signed 16
-            else
-                sample = static_cast<int16_t>(rd_u16le(frame + c * 2));
-            sum += sample;
+            const int32_t sum = static_cast<int16_t>(rd_u16le(data + f * 4)) +
+                static_cast<int16_t>(rd_u16le(data + f * 4 + 2));
+            m[f] = static_cast<int16_t>(sum / 2);
         }
-        mono.push_back(static_cast<int16_t>(sum / channels));
+    }
+    else if (channels == 2)
+    {
+        for (size_t f = 0; f < frames; f++)
+        {
+            const int32_t sum = ((static_cast<int32_t>(data[f * 2]) - 128) * 256) +
+                ((static_cast<int32_t>(data[f * 2 + 1]) - 128) * 256);
+            m[f] = static_cast<int16_t>(sum / 2);
+        }
+    }
+    else
+    {
+        for (size_t f = 0; f < frames; f++)
+        {
+            int32_t sum = 0;
+            const uint8_t *frame = data + f * bytes_per_frame;
+            for (int c = 0; c < channels; c++)
+            {
+                int32_t sample;
+                if (bits == 8)
+                    sample = (static_cast<int32_t>(frame[c]) - 128) * 256; // unsigned 8-bit -> signed 16
+                else
+                    sample = static_cast<int16_t>(rd_u16le(frame + c * 2));
+                sum += sample;
+            }
+            m[f] = static_cast<int16_t>(sum / channels);
+        }
+    }
+    if (rate == DOS_AUDIO_MIXER_RATE && out_pcm.empty())
+    {
+        out_pcm = std::move(mono);
+        return;
     }
     append_resampled_mono(mono, rate, out_pcm);
 }

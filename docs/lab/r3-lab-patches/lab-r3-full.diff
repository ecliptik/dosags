+#ifdef __DJGPP__
+// LAB-PLAY (lab worktree only, not a port patch): DOSAGS_LABCLICKS=lc:x:y[,lc:x:y...] clicks the left button at
+// game point (x, y) when the loop counter first reaches lc, through the same calls as patch 0247. Lets an in-play
+// fixture walk MMD's kids by pointing into the room view instead of 0247's fixed sweep (which lands in the verb bar).
+static int dos_lc_mode = -1, dos_lc_n = 0, dos_lc_next = 0;
+static long dos_lc_t[64]; static int dos_lc_x[64], dos_lc_y[64], dos_lc_b[64];
+long dos_lab_camchg = 0, dos_lab_vpchg = 0, dos_lab_invall = 0, dos_lab_invcam = 0, dos_lab_camx_moves = 0;
+static int dos_sd_mode = -1, dos_sd_n = 0; static long dos_sd_t[32];
+// LAB-R3: DOSAGS_LAB_R3LOG=lo:hi -- per-frame GUI / dirty-set / composite log for every render pass with lo <= lc <= hi
+static int dos_r3l_mode = -1; static long dos_r3l_lo = 0, dos_r3l_hi = -1;
+int dos_lab_r3log_now()
+{
+    if (dos_r3l_mode < 0)
+    {
+        dos_r3l_mode = 0;
+        const char *e = getenv("DOSAGS_LAB_R3LOG");
+        if (e && sscanf(e, "%ld:%ld", &dos_r3l_lo, &dos_r3l_hi) == 2) dos_r3l_mode = 1;
+    }
+    if (!dos_r3l_mode) return 0;
+    const long lc = (long)get_loop_counter();
+    return lc >= dos_r3l_lo && lc <= dos_r3l_hi;
+}
+int dos_lab_sprdump_now()
+{
+    if (dos_lab_r3log_now()) return 1;
+    if (dos_sd_mode < 0)
+    {
+        dos_sd_mode = 0;
+        const char *e = getenv("DOSAGS_LAB_SPRDUMP");
+        while (e && *e && dos_sd_n < 32)
+        {
+            long t; int used = 0;
+            if (sscanf(e, "%ld%n", &t, &used) != 1) break;
+            dos_sd_t[dos_sd_n++] = t; e += used; if (*e == ',') e++;
+        }
+        dos_sd_mode = dos_sd_n > 0;
+    }
+    if (!dos_sd_mode) return 0;
+    const long lc = (long)get_loop_counter();
+    for (int i = 0; i < dos_sd_n; ++i) if (dos_sd_t[i] == lc) return 1;
+    return 0;
+}
+static int dos_ck_mode = -1, dos_ck_n = 0, dos_ck_next = 0; static long dos_ck_t[64];
+#ifndef DOSAGS_RELEASE

+#ifdef __DJGPP__
+// DOS-PORT patch 0181: bracket the SCRIPT's file I/O directly.
+//
+// BENCH8's AfterFadein dispatch is 583 ms, of which the three object calls
+// are 6.5% and ~508 ms is our script's other work. The candidate is
+// AutoPilot.asc's WriteLog doing File.Open(eFileAppend) -> WriteRawLine ->
+// Close per line -- on a CF card through DOS FAT that is a directory scan
+// per open and a FAT flush per close.
+//
+// 169 ms per line is currently a RESIDUAL divided by a line count, which is
+// the same move that produced a phantom 4.4 ms term earlier today. This
+// measures the writes instead of subtracting around them.
+//
+// And it has a twin that was already wrong: "AfterFadein is our own
+// logging" reached the operator this morning and was false -- a scope
+// opened before an #ifdef swallowed the call after it. That was the PORT's
+// debug_script_log at 1.9 ms; this is the FIXTURE's script doing real file
+// writes, a different mechanism with an identical-looking sentence. So the
+// count matters as much as the time: 169 ms x N must reconcile against the
+// fixed component, or the candidate is wrong however slow one write is.
+#include <time.h>
+long long dos_port_scfile_open_us = 0;   long dos_port_scfile_open_n = 0;
+long long dos_port_scfile_write_us = 0;  long dos_port_scfile_write_n = 0;
+long long dos_port_scfile_close_us = 0;  long dos_port_scfile_close_n = 0;
+struct DosPortFileScope {
+    uclock_t t0; long long *us; long *n;
+    DosPortFileScope(long long &u, long &c) : t0(uclock()), us(&u), n(&c) {}
+    ~DosPortFileScope() {
+        long long d = (long long)(uclock() - t0) * 1000000LL / UCLOCKS_PER_SEC;
+        if (d < 0) d = 0;
+        *us += d; (*n)++;
+    }
+};
+#endif
+
 void *sc_OpenFile(const char *fnmm, int mode) {
+#ifdef __DJGPP__
+    DosPortFileScope _dp(dos_port_scfile_open_us, dos_port_scfile_open_n);
+#endif
   if ((mode < scFileRead) || (mode > scFileAppend))
     quit("!OpenFile: invalid file mode");
 
@@ -237,6 +276,9 @@ const char *File_ResolvePath(const char *fnmm)
 }
 
 void File_Close(sc_File *fil) {
+#ifdef __DJGPP__
+    DosPortFileScope _dp(dos_port_scfile_close_us, dos_port_scfile_close_n);
+#endif
   fil->Close();
 }
 
@@ -269,6 +311,9 @@ void File_WriteRawInt(sc_File *fil, int towrite) {
 }
 
 void File_WriteRawLine(sc_File *fil, const char *towrite) {
+#ifdef __DJGPP__
+    DosPortFileScope _dp(dos_port_scfile_write_us, dos_port_scfile_write_n);
+#endif
   FileWriteRawLine(fil->handle, towrite);
 }
 

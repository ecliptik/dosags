     long adds = 0, adds_no_camera = 0, full_latches = 0;
     long frames_narrow = 0, frames_full = 0;
     long long px_narrow = 0, px_full = 0;
+    // patch 0193: a frame's marks are made AFTER that frame's background restore, so they are
+    // repainted by the NEXT frame's restore. The present must push them then, or the region a
+    // sprite stood in last frame is restored in RAM and never reaches the screen.
+    bool restore_seen = false;                        // this interval's room restore has run
+    DosPortDirtyBox post_box[DOS_PORT_DIRTY_MAX_BOXES] = {};   // marks made after it
+    int  post_nbox = 0;
+    bool post_full = false;                           // a whole-surface invalidation after it
+    DosPortDirtyBox carry_box[DOS_PORT_DIRTY_MAX_BOXES] = {};  // the previous interval's post-restore marks
+    int  carry_nbox = 0;
+    bool carry_full = false;
+    long carried_presents = 0, carried_boxes = 0, carried_full = 0;
 };
 extern DosPortDirtyState dos_port_dirty;
 // DOS-PORT patch 0175: which call site dirtied how many pixels.
@@ -119,7 +130,7 @@ extern DosPortDirtyState dos_port_dirty;
 // Same technique that found gCredits: one field, no cell, one question.
 enum DosPortDirtySource {
     kDirtySrc_Other = 0, kDirtySrc_RoomSprite, kDirtySrc_UiSprite,
-    kDirtySrc_Cursor, kDirtySrc_Screen, kDirtySrc_Count
+    kDirtySrc_Cursor, kDirtySrc_Screen, kDirtySrc_Carry, kDirtySrc_Count
 };
 extern int dos_port_dirty_source;
 extern long long dos_port_dirty_src_px[kDirtySrc_Count];
@@ -127,6 +138,9 @@ extern long dos_port_dirty_src_n[kDirtySrc_Count];
 void dos_port_dirty_add_screen(int x1, int y1, int x2, int y2);
 void dos_port_dirty_set_full(const char *why);
 void dos_port_dirty_frame_reset();
+// patch 0193: push last interval's post-restore marks with this one's; note the restore happened
+void dos_port_dirty_merge_carry();
+void dos_port_dirty_note_restore();
 #endif
 
 void invalidate_rect_ds(int x1, int y1, int x2, int y2, bool in_room);

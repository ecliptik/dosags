+int dos_midi_backend_defer_kind(DosMidiBackendKind kind)
+{
+    if (kind == DOS_MIDI_BACKEND_OPL3)
+        return 1;
+    if (kind == DOS_MIDI_BACKEND_WB)
+        return 2;
+    return 0;
+}
+
+void dos_midi_backend_set_tick_mode(bool isr, uint32_t period_us, uint32_t lookahead_irqs)
+{
+    g_tick_isr = isr;
+    g_tick_period_us = period_us;
+    g_tick_lookahead = lookahead_irqs;
+    Debug::Printf(kDbgMsg_Info, "DosMidiBackend: MIDI tick %s%s", isr ? "isr" : "poll",
+        isr ? " (writes planned ahead, replayed by the SB IRQ)" : " (main loop)");
+}
+
+void dos_midi_backend_note_plan_behind()
+{
+    g_plan_behind++;
+}

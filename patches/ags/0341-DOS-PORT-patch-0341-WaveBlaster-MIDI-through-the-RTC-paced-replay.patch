diff --git a/Engine/media/audio/audioplayer.cpp b/Engine/media/audio/audioplayer.cpp
index ab1ae387b..43ff65f89 100644
--- a/Engine/media/audio/audioplayer.cpp
+++ b/Engine/media/audio/audioplayer.cpp
@@ -102,8 +102,20 @@ void AudioPlayer::MidiIsrBegin()
     const char *force = std::getenv("DOSAGS_MIDI_TICK");
     const bool force_poll = force && std::strcmp(force, "poll") == 0;
     int period = 0;
+    int enabled = 0; // DOS-PORT (patch 0341): the queue kind actually running
     if (!force_poll && kind != 0 && s_midiIsrOwner == nullptr && SDL_DOSMidiDeferIrqNow() > 0
-        && (period = SDL_DOSMidiDeferIrqPeriodUs()) > 0 && SDL_DOSMidiDeferEnable(kind))
+        && (period = SDL_DOSMidiDeferIrqPeriodUs()) > 0)
+    {
+        // DOS-PORT (patch 0341): the WaveBlaster's default transport paces each
+        // MPU byte (320 us, the DreamBlaster overrun fix) and kind 2 takes only
+        // the blind one; kind 3 replays the same plan through the RTC pump at
+        // that spacing (SDL 0260).
+        if (SDL_DOSMidiDeferEnable(kind))
+            enabled = kind;
+        else if (kind == 2 && SDL_DOSMidiDeferEnable(3))
+            enabled = 3;
+    }
+    if (enabled != 0)
     {
         const char *la = std::getenv("DOSAGS_MIDI_LOOKAHEAD_MS");
         const long la_ms = (la && la[0]) ? std::strtol(la, nullptr, 10) : 2000;
@@ -126,7 +138,7 @@ void AudioPlayer::MidiIsrBegin()
         _midiCalUs0 = (uint64_t)uclock() * 1000000ULL / UCLOCKS_PER_SEC;
         _midiRealPeriodUs = _midiPeriodUs;
     }
-    dos_midi_backend_set_tick_mode(_midiIsr, _midiIsr ? _midiPeriodUs : 0, lookahead);
+    dos_midi_backend_set_tick_mode(_midiIsr, _midiIsr ? _midiPeriodUs : 0, lookahead, enabled);
 }
 
 void AudioPlayer::MidiIsrEnd(bool flush)
@@ -194,6 +206,9 @@ void AudioPlayer::MidiIsrPlan()
         _midiLastSongMs = song_ms;
     }
     dos_midi_backend_note_isr_period(_midiRealPeriodUs);
+    // DOS-PORT (patch 0341): song clock against uclock (clk_uc=).
+    dos_midi_backend_note_song_uclock(_midiSongUs / 1000u,
+        (uint64_t)uclock() * 1000ULL / UCLOCKS_PER_SEC);
     _midiLastIrq = now;
 }
 

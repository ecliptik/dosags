 }
 
 void LegacyRouteFinder::Configure(GameDataVersion game_ver)
@@ -125,6 +171,66 @@ static void line_callback(BITMAP *bmpp, int x, int y, int /*d*/)
   }
 }
 
+// DOS-PORT patch 0382, R3: Allegro 4's do_line (gfx.c) with line_callback inlined for an 8-bit mask: the same pixels in
+// the same order (outside the bitmap reads as a wall, as getpixel's -1 does), stopping at the first wall.
+static void dos_rf_los_line(BITMAP *bmp, int x1, int y1, int x2, int y2)
+{
+   int dx = x2-x1;
+   int dy = y2-y1;
+   int i1, i2;
+   int x, y;
+   int dd;
+   const int bw = bmp->w, bh = bmp->h;
+   #define RF_PX(px, py) { const int _x = (px), _y = (py); \
+      const int _v = (_x < 0 || _y < 0 || _x >= bw || _y >= bh) ? -1 : (int)((unsigned char *)bmp->line[_y])[_x]; \
+      if (_v < 1) { line_failed = 1; return; } \
+      line_lastcx = _x; line_lastcy = _y; }
+   #define RF_DO_LINE(pri_sign, pri_c, pri_cond, sec_sign, sec_c, sec_cond)  \
+   {                                                                         \
+      if (d##pri_c == 0) {                                                   \
+	 RF_PX(x1, y1);                                                      \
+	 return;                                                             \
+      }                                                                      \
+      i1 = 2 * d##sec_c;                                                     \
+      dd = i1 - (sec_sign (pri_sign d##pri_c));                              \
+      i2 = dd - (sec_sign (pri_sign d##pri_c));                              \
+      x = x1;                                                                \
+      y = y1;                                                                \
+      while (pri_c pri_cond pri_c##2) {                                      \
+	 RF_PX(x, y);                                                        \
+	 if (dd sec_cond 0) {                                                \
+	    sec_c = sec_c sec_sign 1;                                        \
+	    dd += i2;                                                        \
+	 }                                                                   \
+	 else                                                                \
+	    dd += i1;                                                        \
+	 pri_c = pri_c pri_sign 1;                                           \
+      }                                                                      \
+   }
+   if (dx >= 0) {
+      if (dy >= 0) {
+	 if (dx >= dy) { RF_DO_LINE(+, x, <=, +, y, >=); }
+	 else { RF_DO_LINE(+, y, <=, +, x, >=); }
+      }
+      else {
+	 if (dx >= -dy) { RF_DO_LINE(+, x, <=, -, y, <=); }
+	 else { RF_DO_LINE(-, y, >=, +, x, >=); }
+      }
+   }
+   else {
+      if (dy >= 0) {
+	 if (-dx >= dy) { RF_DO_LINE(-, x, >=, +, y, >=); }
+	 else { RF_DO_LINE(+, y, <=, -, x, <=); }
+      }
+      else {
+	 if (-dx >= -dy) { RF_DO_LINE(-, x, >=, -, y, <=); }
+	 else { RF_DO_LINE(-, y, >=, -, x, <=); }
+      }
+   }
+   #undef RF_DO_LINE
+   #undef RF_PX
+}
+
 int can_see_from(const Bitmap *wallscreen, int x1, int y1, int x2, int y2)
 {
   assert(wallscreen != nullptr);
@@ -137,7 +243,10 @@ int can_see_from(const Bitmap *wallscreen, int x1, int y1, int x2, int y2)
     return 1;
 
   // TODO: need some way to use Bitmap with callback
-  do_line((BITMAP*)wallscreen->GetAllegroBitmap(), x1, y1, x2, y2, 0, line_callback);
+  if (dos_rf_fast_on() && wallscreen->GetColorDepth() == 8) // DOS-PORT patch 0382
+    dos_rf_los_line((BITMAP*)wallscreen->GetAllegroBitmap(), x1, y1, x2, y2);
+  else
+    do_line((BITMAP*)wallscreen->GetAllegroBitmap(), x1, y1, x2, y2, 0, line_callback);
   if (line_failed == 0)
     return 1;
 
@@ -360,6 +469,9 @@ void dos_rp_report(FILE *log)
       dos_route_prewarm_mode(), rp_pw_n, rp_pw_built, rp_pw_n - rp_pw_built, rp_pw_nowalk, dos_route_prewarm_skipped, rp_pw_us,
       rp_pw_max_us, rp_pw_first_serial, rp_pw_first_compare, rp_pw_first_miss, rp_pw_first_none, rp_pw_pending);
 #endif
+  if (log) // DOS-PORT patch 0382
+    fprintf(log, "DOS-PORT routefast on=%d stamp_allocs=%ld stamp_peak_bytes=%ld\n", dos_rf_fast_on() ? 1 : 0, dos_rf_stamp_allocs,
+      dos_rf_stamp_peak);
 }
 static int is_route_possible_flood(Bitmap *tempw, int fromx, int fromy, int tox, int toy, const LegacyRouteFinder::PathfinderConfig &pfc);
 
@@ -1031,6 +1143,269 @@ static int find_route_dijkstra(const Bitmap *wallscreen, int fromx, int fromy, i
   return 1;
 }
 
+// DOS-PORT patch 0382: find_route_dijkstra_fast is find_route_dijkstra (above, untouched) with two changes that return
+// the same answers: R1 (the stamp grid above instead of the 0xFF fill; CHECK_MIN_FAST's first test) and R2 (each pass
+// walks only the ACTIVE slots -- visited != -1 and vstate != 2 -- kept as a bitset at every write that kills or revives
+// a slot; the same candidates in the same order).
+static uint32_t dos_rf_act[(MAX_TRAIL_LENGTH + 31) / 32];
+#define DOS_RF_ACT_SET(k) dos_rf_act[(k) >> 5] |= (1u << ((k) & 31))
+#define DOS_RF_ACT_CLR(k) dos_rf_act[(k) >> 5] &= ~(1u << ((k) & 31))
+static inline int dos_rf_next(int n, int lim)
+{
+    int k = n + 1;
+    if (k >= lim) return lim;
+    int w = k >> 5;
+    uint32_t bits = dos_rf_act[w] & (0xFFFFFFFFu << (k & 31));
+    const int wl = (lim + 31) >> 5;
+    while (!bits) { if (++w >= wl) return lim; bits = dos_rf_act[w]; }
+    const int r = (w << 5) + __builtin_ctz(bits);
+    return r < lim ? r : lim;
+}
+#define CHECK_MIN_FAST(cellx, celly) { \
+  if (dos_rf_stamp[(celly) * dos_rf_stamp_w + (cellx)] != (unsigned char)dos_rf_gen) {\
+    adjcount = 0; \
+    if (wallscreen->GetScanLine(celly)[cellx] != 0) live = 1; /* DOS-PORT patch 0317 */ \
+    if ((wallscreen->GetScanLine(celly)[cellx] != 0) && (beenhere[j][i]+modifier <= min)) {\
+      if (beenhere[j][i]+modifier < min) { \
+        min = beenhere[j][i]+modifier; \
+        numfound = 0; } \
+      if (numfound < 40) { \
+        newcell[numfound] = (celly) * wallscreen->GetWidth() + (cellx);\
+        cheapest[numfound] = j * wallscreen->GetWidth() + i;\
+        numfound++; \
+      }\
+    } \
+  }}
+
+static int find_route_dijkstra_fast(const Bitmap *wallscreen, int fromx, int fromy, int destx, int desty, const LegacyRouteFinder::PathfinderConfig &pfc)
+{
+  int i, j;
+
+  assert(wallscreen != nullptr);
+  assert(pathbackx != nullptr);
+  assert(pathbacky != nullptr);
+  assert(beenhere != nullptr);
+
+  // This algorithm doesn't behave differently the second time, so ignore
+  if (leftorright == 1)
+    return 0;
+
+  dos_rf_stamp_begin(wallscreen->GetWidth(), wallscreen->GetHeight()); // R1: no 0xFF fill
+
+  round_down_coords(wallscreen, fromx, fromy);
+  beenhere[fromy][fromx] = 0;
+  dos_rf_stamp[fromy * dos_rf_stamp_w + fromx] = (unsigned char)dos_rf_gen; // R1
+
+  int temprd = destx, tempry = desty;
+  round_down_coords(wallscreen, temprd, tempry);
+  if ((temprd == fromx) && (tempry == fromy)) {
+    // already at destination
+    pathbackstage = 0;
+    return 1;
+  }
+
+  int allocsize = int (wallscreen->GetWidth()) * int (wallscreen->GetHeight()) * sizeof(int);
+  int *parent = (int *)malloc(allocsize);
+  int min = 999999, cheapest[40], newcell[40], replace[40];
+  int *visited = (int *)malloc(MAX_TRAIL_LENGTH * sizeof(int));
+  // DOS-PORT patch 0212: each visited cell's x and y, kept beside its index, so the main loop does
+  // not divide by the mask width for every visited cell on every pass (an idiv, ~43 cycles on a 486,
+  // times the ~20000-51000 cell visits of a long request). Same cells, same order, same values.
+  int *visx = (int *)malloc(MAX_TRAIL_LENGTH * sizeof(int));
+  int *visy = (int *)malloc(MAX_TRAIL_LENGTH * sizeof(int));
+  // DOS-PORT patch 0317: per slot, 0 = still has an unvisited walkable neighbour; 1 = every neighbour visited
+  // (its checks can only leave adjcount = 1); 2 = its only unvisited neighbours are unwalkable (its checks can only
+  // leave adjcount = 0, with no candidate). Cells never lose visited status and unwalkable cells are never visited,
+  // so both states are permanent for the cell; a reused slot starts at 0. Skipping the neighbour checks of a
+  // state-1/2 slot leaves every candidate, adjcount outcome, slot kill and slot reuse exactly as before.
+  unsigned char *vstate = (unsigned char *)malloc(MAX_TRAIL_LENGTH);
+  int live = 0;
+  vstate[0] = 0;
+  int iteration = 1;
+  visited[0] = fromy * wallscreen->GetWidth() + fromx;
+  memset(dos_rf_act, 0, sizeof(dos_rf_act)); dos_rf_act[0] = 1u; // R2
+  visx[0] = fromx;
+  visy[0] = fromy;
+  parent[visited[0]] = -1;
+
+  int granularity = 3, newx = -1, newy, foundAnswer = -1, numreplace;
+  int changeiter, numfound, adjcount;
+  int destxlow = destx - pfc.MaxGranularity;
+  int destylow = desty - pfc.MaxGranularity;
+  int destxhi = destxlow + pfc.MaxGranularity * 2;
+  int destyhi = destylow + pfc.MaxGranularity * 2;
+  int modifier = 0;
+  int totalfound = 0;
+  int DIRECTION_BONUS = 0;
+
+  while (foundAnswer < 0) {
+    min = 29999;
+    changeiter = iteration;
+    numfound = 0;
+    numreplace = 0;
+
+    for (int n = dos_rf_next(-1, iteration); n < iteration; n = dos_rf_next(n, iteration)) { // R2
+      if (visited[n] == -1)
+        continue;
+      if (vstate[n] == 2) // DOS-PORT patch 0317: permanently adjcount 0, no candidate
+        continue;
+      if (vstate[n] == 1) { // DOS-PORT patch 0317: permanently adjcount 1
+        if (numreplace < 40) {
+          visited[numreplace] = -1; DOS_RF_ACT_CLR(numreplace); // R2
+          replace[numreplace] = n;
+          numreplace++;
+        }
+        continue;
+      }
+
+      i = visx[n];
+      j = visy[n];
+      granularity = walk_area_granularity[wallscreen->GetScanLine(j)[i]];
+      adjcount = 1;
+      live = 0; // DOS-PORT patch 0317
+
+      if (i >= granularity) {
+        modifier = (destx < i) ? DIRECTION_BONUS : 0;
+        CHECK_MIN_FAST(i - granularity, j)
+      }
+
+      if (j >= granularity) {
+        modifier = (desty < j) ? DIRECTION_BONUS : 0;
+        CHECK_MIN_FAST(i, j - granularity)
+      }
+
+      if (i < wallscreen->GetWidth() - granularity) {
+        modifier = (destx > i) ? DIRECTION_BONUS : 0;
+        CHECK_MIN_FAST(i + granularity, j)
+      }
+
+      if (j < wallscreen->GetHeight() - granularity) {
+        modifier = (desty > j) ? DIRECTION_BONUS : 0;
+        CHECK_MIN_FAST(i, j + granularity)
+      }
+
+      if (!live) // DOS-PORT patch 0317: no unvisited walkable neighbour is left, ever
+      { vstate[n] = adjcount ? 1 : 2; if (!adjcount) DOS_RF_ACT_CLR(n); } // R2
+
+      // If all the adjacent cells have been done, stop checking this one
+      if (adjcount) {
+        if (numreplace < 40) {
+          visited[numreplace] = -1; DOS_RF_ACT_CLR(numreplace); // R2
+          replace[numreplace] = n;
+          numreplace++;
+        }
+      }
+    }
+
+    if (numfound == 0) {
+      free(visited);
+      free(visx);
+      free(visy);
+      free(vstate); // DOS-PORT patch 0317
+      free(parent);
+      return 0;
+    }
+
+    totalfound += numfound;
+    for (int p = 0; p < numfound; p++) {
+      newx = newcell[p] % wallscreen->GetWidth();
+      newy = newcell[p] / wallscreen->GetWidth();
+      const int cellx = newx, celly = newy; // DOS-PORT patch 0212: before the edge adjustment below
+      beenhere[newy][newx] = beenhere[cheapest[p] / wallscreen->GetWidth()][cheapest[p] % wallscreen->GetWidth()] + 1;
+      dos_rf_stamp[newy * dos_rf_stamp_w + newx] = (unsigned char)dos_rf_gen; // R1
+//      int wal = walk_area_granularity[->GetPixel(wallscreen, newx, newy)];
+//      beenhere[newy - newy%wal][newx - newx%wal] = beenhere[newy][newx];
+      parent[newcell[p]] = cheapest[p];
+
+      // edges of screen pose a problem, so if current and dest are within
+      // certain distance of the edge, say we've got it
+      if ((newx >= wallscreen->GetWidth() - pfc.MaxGranularity) && (destx >= wallscreen->GetWidth() - pfc.MaxGranularity))
+        newx = destx;
+
+      if ((newy >= wallscreen->GetHeight() - pfc.MaxGranularity) && (desty >= wallscreen->GetHeight() - pfc.MaxGranularity))
+        newy = desty;
+
+      // Found the desination, abort loop
+      if ((newx >= destxlow) && (newx <= destxhi) && (newy >= destylow)
+          && (newy <= destyhi)) {
+        foundAnswer = newcell[p];
+        break;
+      }
+
+      if (totalfound >= 1000) {
+        //Doesn't work cos it can see the destination from the point that's
+        //not nearest
+        // every so often, check if we can see the destination
+        if (can_see_from(wallscreen, newx, newy, destx, desty)) {
+          DIRECTION_BONUS -= 50;
+          totalfound = 0;
+        }
+
+      }
+
+      if (numreplace > 0) {
+        numreplace--;
+        changeiter = replace[numreplace];
+      } else
+        changeiter = iteration;
+
+      visited[changeiter] = newcell[p];
+      visx[changeiter] = cellx;
+      visy[changeiter] = celly;
+      vstate[changeiter] = 0; // DOS-PORT patch 0317: a new cell in this slot
+      DOS_RF_ACT_SET(changeiter); // R2
+      if (changeiter == iteration)
+        iteration++;
+
+      changeiter = iteration;
+      if (iteration >= MAX_TRAIL_LENGTH) {
+        free(visited);
+        free(visx);
+        free(visy);
+        free(vstate); // DOS-PORT patch 0317
+        free(parent);
+        return 0;
+      }
+    }
+    if (totalfound >= 1000) {
+      totalfound = 0;
+    }
+  }
+  free(visited);
+  free(visx);
+  free(visy);
+  free(vstate); // DOS-PORT patch 0317
+
+  int on;
+  pathbackstage = 0;
+  pathbackx[pathbackstage] = destx;
+  pathbacky[pathbackstage] = desty;
+  pathbackstage++;
+
+  for (on = parent[foundAnswer];; on = parent[on]) {
+    if (on == -1)
+      break;
+
+    newx = on % wallscreen->GetWidth();
+    newy = on / wallscreen->GetWidth();
+    if ((newx >= destxlow) && (newx <= destxhi) && (newy >= destylow)
+        && (newy <= destyhi))
+      break;
+
+    pathbackx[pathbackstage] = on % wallscreen->GetWidth();
+    pathbacky[pathbackstage] = on / wallscreen->GetWidth();
+    pathbackstage++;
+    if (pathbackstage >= MAXPATHBACK) {
+      free(parent);
+      return 0;
+    }
+  }
+  free(parent);
+  return 1;
+}
+#undef DOS_RF_ACT_SET
+#undef DOS_RF_ACT_CLR
+
 static int __find_route(const Bitmap *wallscreen, int srcx, int srcy, int *tox, int *toy, int noredx, const LegacyRouteFinder::PathfinderConfig &pfc)
 {
   assert(wallscreen != nullptr);
@@ -1068,7 +1443,8 @@ findroutebk:
   }
 
   // Try the new pathfinding algorithm
-  if (find_route_dijkstra(wallscreen, srcx, srcy, tox[0], toy[0], pfc)) {
+  if (dos_rf_fast_on() ? find_route_dijkstra_fast(wallscreen, srcx, srcy, tox[0], toy[0], pfc) // DOS-PORT patch 0382
+                       : find_route_dijkstra(wallscreen, srcx, srcy, tox[0], toy[0], pfc)) {
     return 1;
   }
 

+#ifdef DOSAGS_VMTRACE
+// DOS-PORT patch 0360, LAB ONLY (make AGS_RUNSTATS_DEF=-DDOSAGS_VMTRACE): the determinism witness
+// of LAB-MMD probe 0292 (state digests every 25 ticks; DOSAGS_WIT_PERTURB_TICK=N nudges the player
+// one pixel at tick N, the control) carrying the VM trace digest of cc_instance_vm.cpp.
+extern uint32_t dos_vmtrace_h, dos_vmtrace_tick;
+extern unsigned long dos_vmtrace_n;
+static uint32_t dp_fnv(uint32_t h, const void *p, size_t n)
+{
+    const uint8_t *b = static_cast<const uint8_t*>(p);
+    for (size_t i = 0; i < n; ++i) { h ^= b[i]; h *= 16777619u; }
+    return h;
+}
+#define DP_FNV(h, v) h = dp_fnv(h, &(v), sizeof(v))
+static void dp_statewit()
+{
+    static long perturb = -2;
+    if (perturb == -2) { const char *e = getenv("DOSAGS_WIT_PERTURB_TICK"); perturb = e ? atol(e) : -1; }
+    const uint32_t tick = GameTimer.LoopCounter;
+    dos_vmtrace_tick = tick;
+    if (perturb >= 0 && tick == (uint32_t)perturb && game.playercharacter >= 0)
+        game.chars[game.playercharacter].x += 1;
+    if (tick % 25 != 0) return;
+    uint32_t hc = 2166136261u, ho = 2166136261u, hg = 2166136261u, hd = 2166136261u, hr = 2166136261u;
+    for (int i = 0; i < game.numcharacters; ++i)
+    {
+        const CharacterInfo &c = game.chars[i];
+        DP_FNV(hc, c.room); DP_FNV(hc, c.x); DP_FNV(hc, c.y); DP_FNV(hc, c.z); DP_FNV(hc, c.loop);
+        DP_FNV(hc, c.frame); DP_FNV(hc, c.view); DP_FNV(hc, c.walking); DP_FNV(hc, c.animating);
+        DP_FNV(hc, c.flags); DP_FNV(hc, c.wait);
+    }
+    if (croom)
+        for (uint32_t i = 0; i < croom->numobj; ++i)
+        {
+            const RoomObject &o = croom->obj[i];
+            DP_FNV(ho, o.x); DP_FNV(ho, o.y); DP_FNV(ho, o.on); DP_FNV(ho, o.view); DP_FNV(ho, o.loop);
+            DP_FNV(ho, o.frame); DP_FNV(ho, o.cycling); DP_FNV(ho, o.moving); DP_FNV(ho, o.num);
+            DP_FNV(ho, o.transparent); DP_FNV(ho, o.baseline);
+        }
+    hg = dp_fnv(hg, play.globalscriptvars, sizeof(play.globalscriptvars));
+    if (gameinst) { const auto &g = gameinst->GetGlobalData(); if (!g.empty()) hd = dp_fnv(hd, g.data(), g.size()); }
+    if (roominst) { const auto &r = roominst->GetGlobalData(); if (!r.empty()) hr = dp_fnv(hr, r.data(), r.size()); }
+    const int pc = game.playercharacter;
+    Debug::Printf("DOS-PORT statewit tick=%lu room=%d chars=%08lx objs=%08lx gints=%08lx gdata=%08lx rdata=%08lx player=%d,%d vmtrace=%08lx vmops=%lu",
+        (unsigned long)tick, displayed_room, (unsigned long)hc, (unsigned long)ho, (unsigned long)hg,
+        (unsigned long)hd, (unsigned long)hr, pc >= 0 ? game.chars[pc].x : -1, pc >= 0 ? game.chars[pc].y : -1,
+        (unsigned long)dos_vmtrace_h, dos_vmtrace_n);
+}
+#endif
+
 static void game_loop_update_loop_counter()
 {
     GameTimer.LoopCounter++;
+#ifdef DOSAGS_VMTRACE
+    dp_statewit(); // patch 0360, LAB ONLY
+#endif
 
     if (play.wait_counter > 0) play.wait_counter--;
     if (play.shakesc_length > 0) play.shakesc_length--;

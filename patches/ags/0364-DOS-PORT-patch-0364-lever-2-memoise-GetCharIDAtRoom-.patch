+// lever 2: a generic step may write engine state (an object field) or call the engine: it invalidates,
+// unless it is a memory read, or a write into the script's own memory (its stack, a global variable, its
+// global data block). A read through an object or array (CCCharacter/CCStaticArray/... Read*) is a plain read.
+// Out of line, so DosVmStep stays small enough for the fast loop to inline it: with this test inline, GCC
+// stopped inlining DosVmStep and every generic step paid an extra call (+0.094 ms/tick at fixed cycles,
+// levers off -- LEVERS-REPORT.md section 9).
+__attribute__((noinline)) static void dos_memo_step(const intptr_t *code, uint32_t codesize, int32_t pc, ScriptValueType mar)
+{
+    const int op = (pc >= 0 && static_cast<uint32_t>(pc) < codesize) ?
+        static_cast<int>(code[pc] & INSTANCE_ID_REMOVEMASK) : -1;
+    bool keep = (op == SCMD_MEMREAD || op == SCMD_MEMREADB || op == SCMD_MEMREADW);
+    if (op == SCMD_WRITELIT || op == SCMD_MEMWRITE || op == SCMD_MEMWRITEB || op == SCMD_MEMWRITEW)
+        keep = (mar == kScValStackPtr || mar == kScValGlobalVar || mar == kScValData);
+    if (!keep)
+        dos_memo_bump();
+}
+
+int ccInstance::DosVmStep(DosVmFrame &fr, int32_t pc)

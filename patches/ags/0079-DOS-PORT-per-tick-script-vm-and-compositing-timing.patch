--- a/Engine/script/script.cpp
+++ b/Engine/script/script.cpp
@@ -13,6 +13,10 @@
 //=============================================================================
 #include <stdio.h>
 #include <string.h>
+#ifdef __DJGPP__
+#include <time.h> // uclock_t/uclock()/UCLOCKS_PER_SEC -- DOS-PORT patch 0079

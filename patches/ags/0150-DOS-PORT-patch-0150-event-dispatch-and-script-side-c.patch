+                    {   // patch 0156: ONE line, timed on its own. This decides
+                        // how bad the finding is: a one-shot startup report is
+                        // a first-room cost, while 4 seconds on every room
+                        // entry is a per-transition tax on every measurement.
+                        DosPortNamedScope _dp1(dos_port_afterfadein_line_us,
+                                               dos_port_afterfadein_line_n);
+                        debug_script_log("DOS-PORT room_transition t_ms=%ld event=ready room=%d", t_ms, displayed_room);
+                    }
 
                     // DOS-PORT patch 0078: this is also "first interactive
                     // frame" for the startup-timing report -- emit it here,
@@ -301,6 +417,44 @@ void process_event(const AGSEvent *evp)
                         debug_script_log("[DOS-PORT-STARTUP-END]");
                     }
                 }
+#endif
+#ifdef __DJGPP__
+                // patch 0157: CLOSE the logging scope here.
+                //
+                // 0155 opened it before the #ifdef block and let it run to
+                // the end of the else-if, so it covered run_on_event() as
+                // well -- and I reported "AfterFadein is our own logging"

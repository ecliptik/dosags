    the same driver call. */
 static Uint16 dos_mouse_fn5_status[2];
 
+/* dosags patch 0240 (LAB-MMD.md 28.7): the mouse IRQ doorbell. Every SDL pump polled the mouse driver
+   with three real-mode INT 33h calls (function 3, and 0221's function 5 per button) -- 9 a tick in AGS,
+   ~150-170 us each inside the game on a 486DX2-66 under CWSDPMI (cold: dosags LAB-MMD.md 33.5; a warm
+   back-to-back microbench reads ~83 us), even with no input at all. The driver's state (position,
+   buttons, function 5's press counters) changes only in its own IRQ handler or in our INT 33h calls.
+   So a protected-mode handler chained on the mouse IRQ's vector sets a flag and jumps on to the
+   previous handler (DPMI routes the IRQ to it whether it occurs in PM or RM; the previous handler
+   reflects it to the real-mode driver as before), and a pump runs the polling path below -- 0227's,
+   unchanged -- only when that flag was set since the last poll. The flag write and the driver's update
+   happen in the same interrupt, which the main thread cannot split, so a pump that skips would have
+   read exactly what the previous poll read: the engine receives the same events, pump for pump. Our
+   own state-changing INT 33h calls (warp, reset) set the flag too. No 0Ch user routine: CuteMouse
+   drops user-routine calls while one is running (LAB-JOURNEYS.md 11.1), and a routine pointer left in
+   the driver outlives the process; a PM vector does not -- the host drops it with the client. Which
+   IRQ: INT 33h function 24h (CH = type, CL = IRQ; CL 0 = PS/2, IRQ 12). Unknown: polling, as before.
+   SDL_HINT_DOS_MOUSE_POLL=1 forces polling. */
+volatile int dos_mouse_dirty = 1;
+extern void dos_mouse_bell_isr(void);
+extern void dos_mouse_bell_isr_end(void);
+/* dos_mouse_bell_old lives in .text so the handler's ljmp can read it through %cs before it has a data
+   selector. C code writes it through DS (DOS_MouseBellInstall's get-vector call): that is fine on DJGPP,
+   where CS and DS map the same linear range and .text is not write-protected, but it would break under a
+   loader that write-protects code pages. */
+extern __dpmi_paddr dos_mouse_bell_old; /* in .text: read through %cs by the handler's ljmp */
+__asm__(
+    ".text\n"
+    ".globl _dos_mouse_bell_old\n"
+    "_dos_mouse_bell_old:\n"
+    "  .long 0\n"
+    "  .word 0\n"
+    "  .word 0\n"
+    ".globl _dos_mouse_bell_isr\n"
+    "_dos_mouse_bell_isr:\n"
+    "  pushl %ds\n"
+    "  pushl %eax\n"
+    "  movw %cs:___djgpp_ds_alias, %ax\n"
+    "  movw %ax, %ds\n"
+    "  movl $1, _dos_mouse_dirty\n"
+    "  popl %eax\n"
+    "  popl %ds\n"
+    "  ljmp *%cs:_dos_mouse_bell_old\n"
+    ".globl _dos_mouse_bell_isr_end\n"
+    "_dos_mouse_bell_isr_end:\n"
+    "  ret\n");
+static int dos_mouse_bell_vec = -1;       /* the vector we chained, or -1 (polling) */
+static bool dos_mouse_bell_atexit = false;
+static Uint32 dos_mouse_bell_polls = 0, dos_mouse_bell_skips = 0, dos_mouse_bell_safety = 0;
+static Uint64 dos_mouse_bell_last_poll_ns = 0;
+static int dos_mouse_bell_locks = 0; /* lock results, bitmask (see DOS_MouseBellInstall) */
+#define DOS_MOUSE_SAFETY_POLL_NS SDL_NS_PER_SECOND /* poll at least once a second, flag or no flag */
+
+void DOS_MouseBellUninstall(void)
+{
+    if (dos_mouse_bell_vec < 0) {
+        return;
+    }
+    disable();
+    __dpmi_set_protected_mode_interrupt_vector(dos_mouse_bell_vec, &dos_mouse_bell_old);
+    dos_mouse_bell_vec = -1;
+    dos_mouse_dirty = 1; /* back to polling every pump */
+    enable();
+}
+
+static void DOS_MouseBellAtExit(void)
+{
+    DOS_MouseBellUninstall();
+}
+
+bool DOS_MouseBellInstall(void)
+{
+    __dpmi_regs regs;
+    __dpmi_paddr nw;
+    int vec;
+    const char *force_poll = SDL_getenv("SDL_HINT_DOS_MOUSE_POLL");
+    if (force_poll && force_poll[0] == '1' && force_poll[1] == 0) {
+        return false;
+    }
+    SDL_zero(regs);
+    regs.x.ax = 0x24; /* MS mouse v6.26+: software version, mouse type (CH), IRQ (CL) */
+    __dpmi_int(0x33, &regs);
+    if (regs.x.bx == 0 || regs.x.bx == 0xFFFF) {
+        return false; /* function 24h not implemented (BX untouched; regs were zeroed): stay on polling */
+    }
+    /* only the combinations the MS interface defines; anything else stays on polling (0227) */
+    if (regs.h.ch == 4 && regs.h.cl == 0) {
+        vec = 0x74;                         /* PS/2: IRQ 12, slave PIC (CuteMouse: CH 4, CL 0) */
+    } else if ((regs.h.ch == 1 || regs.h.ch == 2 || regs.h.ch == 3 || regs.h.ch == 5) &&
+               regs.h.cl >= 2 && regs.h.cl <= 7) {
+        vec = 0x08 + regs.h.cl;             /* bus/serial/InPort/HP on a master-PIC IRQ */
+    } else {
+        return false;
+    }
+    /* everything the handler touches must be locked: under CWSDPMI with paging, a not-present page
+       inside an IRQ handler is fatal. Bit 1 its code, 2 the flag, 4 the saved vector it jumps
+       through, 8 libc's DS alias it loads. All four, or no doorbell. */
+    dos_mouse_bell_locks = 0;
+    if (_go32_dpmi_lock_code((void *)dos_mouse_bell_isr,
+                             (unsigned long)((char *)dos_mouse_bell_isr_end - (char *)dos_mouse_bell_isr) + 16) == 0) {
+        dos_mouse_bell_locks |= 1;
+    }
+    if (_go32_dpmi_lock_data((void *)&dos_mouse_dirty, sizeof(dos_mouse_dirty)) == 0) {
+        dos_mouse_bell_locks |= 2;
+    }
+    if (_go32_dpmi_lock_data((void *)&dos_mouse_bell_old, sizeof(dos_mouse_bell_old)) == 0) {
+        dos_mouse_bell_locks |= 4;
+    }
+    if (_go32_dpmi_lock_data((void *)&__djgpp_ds_alias, sizeof(__djgpp_ds_alias)) == 0) {
+        dos_mouse_bell_locks |= 8;
+    }
+    if (dos_mouse_bell_locks != 15) {
+        return false; /* could not lock: stay on polling */
+    }
+    if (!dos_mouse_bell_atexit) {
+        atexit(DOS_MouseBellAtExit);
+        dos_mouse_bell_atexit = true;
+    }
+    disable();
+    __dpmi_get_protected_mode_interrupt_vector(vec, &dos_mouse_bell_old);
+    nw.offset32 = (unsigned long)dos_mouse_bell_isr;
+    nw.selector = (unsigned short)_my_cs();
+    __dpmi_set_protected_mode_interrupt_vector(vec, &nw);
+    dos_mouse_bell_vec = vec;
+    dos_mouse_dirty = 1; /* the first pump polls */
+    enable();
+    return true;
+}
+
+void DOS_MouseNoteDriverChanged(void)
+{
+    dos_mouse_dirty = 1;
+}
+
+/* true if this pump must poll the driver: always on the polling path; with the doorbell, only if a
+   mouse IRQ (or one of our own driver calls) came since the last poll -- taken and cleared at once */
+static bool DOS_MouseShouldPoll(Uint64 now_ns)
+{
+    int d;
+    if (dos_mouse_bell_vec < 0) {
+        return true;
+    }
+    disable();
+    d = dos_mouse_dirty;
+    dos_mouse_dirty = 0;
+    enable();
+    if (d) {
+        dos_mouse_bell_polls++;
+    } else if (now_ns - dos_mouse_bell_last_poll_ns >= DOS_MOUSE_SAFETY_POLL_NS) {
+        /* the safety poll: bounds any missed doorbell to <= 1 s of staleness, detectably (it would
+           deliver something); costs 3 INT 33h a second. A poll reads exactly what a pump would. */
+        dos_mouse_bell_safety++;
+        d = 1;
+    } else {
+        dos_mouse_bell_skips++;
+    }
+    if (d) {
+        dos_mouse_bell_last_poll_ns = now_ns;
+    }
+    return d != 0;
+}
+
+int SDL_DOSMouseBellStats(Uint32 *polls, Uint32 *safety_polls, Uint32 *skips, int *locks)
+{
+    if (locks) *locks = dos_mouse_bell_locks;
+    if (polls) *polls = dos_mouse_bell_polls;
+    if (safety_polls) *safety_polls = dos_mouse_bell_safety;
+    if (skips) *skips = dos_mouse_bell_skips;
+    return dos_mouse_bell_vec >= 0 ? dos_mouse_bell_vec : 0;
+}
+
 static void DOS_ReadMousePressCounters(void)
 {
     __dpmi_regs regs;
@@ -497,7 +668,8 @@ void DOSVESA_PumpEvents(SDL_VideoDevice *device)
     }
 
     SDL_Mouse *mouse = SDL_GetMouse();
-    if (mouse->internal) { // if non-NULL, there's a mouse detected on the system.
+    /* dosags patch 0240: with the doorbell, the driver is polled only if its state can have changed */
+    if (mouse->internal && DOS_MouseShouldPoll(dos_pump_ring_ns[(dos_pump_ring_n - 1) % DOS_PUMP_RING])) { // if non-NULL, there's a mouse detected on the system.
         __dpmi_regs regs;
 
         regs.x.ax = 0x3; // read mouse buttons and position.

 Bitmap *walkareabackup=nullptr, *walkable_areas_temp = nullptr;
 
+// DOS-PORT patch 0319: what walkable_areas_temp was built from, so the legacy pathfinder's 0211 cache can tell a
+// byte-identical mask without comparing 64 KB. prepare_walkable_areas() is the only writer of walkable_areas_temp:
+// its pixels are a function of thisroom.WalkAreaMask's pixels (tracked by dos_walkmask_gen, bumped by every path
+// that can write them: room load/unload, redo_walkable_areas, a drawing surface or plugin bitmap on the walkable
+// mask) and of the blocking rectangles it cuts out. The whole input record is compared (no hash); an identical
+// record keeps the same serial, any difference takes a new one. 0 means unknown.
+unsigned long dos_walkmask_gen = 1;
+unsigned long dos_walktemp_serial = 0;
+static unsigned long dos_walktemp_next_serial = 1;
+static unsigned long dos_walktemp_sig_gen = 0;
+static std::vector<Rect> dos_walktemp_sig_rects, dos_walktemp_new_rects;
+static const Bitmap *dos_walktemp_sig_bmp = nullptr;
+static int dos_walktemp_sig_noblock = -1;
+
+static void dos_walktemp_sig_commit(int noblock)
+{
+    if (dos_walktemp_serial != 0 && dos_walktemp_sig_gen == dos_walkmask_gen &&
+        dos_walktemp_sig_bmp == walkable_areas_temp && dos_walktemp_sig_noblock == noblock &&
+        dos_walktemp_sig_rects.size() == dos_walktemp_new_rects.size() &&
+        std::equal(dos_walktemp_new_rects.begin(), dos_walktemp_new_rects.end(), dos_walktemp_sig_rects.begin(),
+            [](const Rect &a, const Rect &b) { return a.Left == b.Left && a.Top == b.Top && a.Right == b.Right && a.Bottom == b.Bottom; }))
+        return; // the same inputs as last time: walkable_areas_temp holds the same pixels, keep the serial
+    dos_walktemp_sig_rects.swap(dos_walktemp_new_rects);
+    dos_walktemp_sig_gen = dos_walkmask_gen;
+    dos_walktemp_sig_bmp = walkable_areas_temp;
+    dos_walktemp_sig_noblock = noblock;
+    dos_walktemp_serial = dos_walktemp_next_serial++;
+}

+        const auto &reg1 = _registers[op_arg1];
+
+        fr.was_just_callas = -1;
+        if (fr.num_args_to_func < 0)
+        {
+            fr.num_args_to_func = fr.fcs->GetSize();
+        }
+
+        // Convert pointer arguments to simple types
+        for (RuntimeScriptValue *prval = fr.fcs->GetHead() + fr.num_args_to_func;
+            --prval >= fr.fcs->GetHead();)
+        {
+            prval->DirectPtr();
+        }
+
+#ifdef __DJGPP__
+        dos_port_work[kDW_ScriptExt]++;   // patch 0230, every build
+#endif
+
+        RuntimeScriptValue return_value;
+
+        if (reg1.Type == kScValPluginFunction)
+        {
+            if (fr.next_call_needs_object)
+            {
+                RuntimeScriptValue obj_rval = _registers[SREG_OP];
+                obj_rval.DirectPtrObj();
+                return_value = CallPluginFunction(reg1.Ptr, &obj_rval, fr.fcs->GetHead(), fr.num_args_to_func);
+            }
+            else
+            {
+                return_value = CallPluginFunction(reg1.Ptr, nullptr, fr.fcs->GetHead(), fr.num_args_to_func);
+            }
+        }
+        else if (fr.next_call_needs_object)
+        {
+            // member function call
+            if (reg1.Type == kScValObjectFunction)
+            {
+                RuntimeScriptValue obj_rval = _registers[SREG_OP];
+                obj_rval.DirectPtrObj();
+                return_value = reg1.ObjPfn(obj_rval.Ptr, fr.fcs->GetHead(), fr.num_args_to_func);
+            }
+            else
+            {
+                cc_error("invalid pointer type for object function call: %d", reg1.Type);
+            }
+        }
+        else if (reg1.Type == kScValStaticFunction)
+        {
+            return_value = reg1.SPfn(fr.fcs->GetHead(), fr.num_args_to_func);
+        }
+        else if (reg1.Type == kScValObjectFunction)
+        {
+            cc_error("unexpected object function pointer on SCMD_CALLEXT");
+        }
+        else
+        {
+            cc_error("invalid pointer type for function call: %d", reg1.Type);
+        }
+
+        if (cc_has_error())
+        {
+            return -1;
+        }
+
+        _registers[SREG_AX] = return_value;
+        fr.next_call_needs_object = 0;
+        fr.num_args_to_func = -1;
+        break;
+    }
+    case SCMD_PUSHREAL:
+    {
+        const auto &reg1 = _registers[op_arg1];
+        fr.fcs->Push(reg1);
+        break;
+    }
+    case SCMD_SUBREALSTACK:
+    {
+        // Drop arg_lit entries from the func_callstack
+        // TODO: cannot we just clear the func_callstack right after using it in call op?
+        // it does not seem like these values are needed for anything else.
+        const auto arg_lit = op_arg1;
+        if (fr.fcs->GetSize() < static_cast<uint32_t>(arg_lit))
+        {
+            cc_error("function callstack underflow");
+            return -1;
+        }
+        fr.fcs->PopCount(arg_lit);
+
+        if (fr.was_just_callas >= 0)
+        {
+            ASSERT_STACK_SIZE(arg_lit);
+            PopValuesFromStack(arg_lit);
+            fr.was_just_callas = -1;
+        }
+        break;
+    }
+    case SCMD_CALLOBJ:
+    {
+        // set the OP register
+        const auto &reg1 = _registers[op_arg1];
+        if (reg1.IsNull())
+        {
+            cc_error("!Null pointer referenced");
+            return -1;
+        }
+        switch (reg1.Type)
+        {
+            // This might be a static object, passed to the user-defined extender function
+        case kScValScriptObject:
+        case kScValPluginObject:
+        case kScValPluginArg:
+        case kScValPluginArgPtr:
+            // This might be an object of USER-DEFINED type, calling its MEMBER-FUNCTION.
+            // Note, that this is the only case known when such object is written into reg[SREG_OP];
+            // in any other case that would count as error.
+        case kScValGlobalVar:
+        case kScValStackPtr:
+            _registers[SREG_OP] = reg1;
+            break;
+        case kScValStaticArray:
+            //FIXME: return manager type from interface?
+            //CC_ERROR_IF_RETCODE(!reg1.ArrMgr->GetDynamicManager(), "internal error: SCMD_CALLOBJ argument is not a dynamic object");
+            _registers[SREG_OP].SetScriptObject(
+                    reg1.ArrMgr->GetElementPtr(reg1.Ptr, reg1.IValue),
+                    reg1.ArrMgr->GetObjectManager());
+            break;
+        default:
+            cc_error("internal error: SCMD_CALLOBJ argument is not an object of built-in or user-defined type");
+            return -1;
+        }
+        fr.next_call_needs_object = 1;
+        break;
+    }
+    case SCMD_SHIFTLEFT:
+    {
+        auto       &reg1 = _registers[op_arg1];
+        const auto &reg2 = _registers[op_arg2];
+        reg1.SetInt32(reg1.IValue << reg2.IValue);
+        break;
+    }
+    case SCMD_SHIFTRIGHT:
+    {
+        auto       &reg1 = _registers[op_arg1];
+        const auto &reg2 = _registers[op_arg2];
+        reg1.SetInt32(reg1.IValue >> reg2.IValue);
+        break;
+    }
+    case SCMD_THISBASE:
+    {
+        const auto arg_lit = op_arg1;
+        fr.thisbase[fr.curnest] = arg_lit;
+        break;
+    }
+    case SCMD_NEWARRAY:
+    {
+        auto &reg1 = _registers[op_arg1];
+        const int arg_elnum = reg1.IValue;
+        const uint32_t arg_elsize = static_cast<uint32_t>(op_arg2);
+        const bool arg_managed = op_arg3 != 0; // patch 0293: == Arg3().GetAsBool() on an int-set value
+        if (arg_elnum < 0)
+        {
+            cc_error("Invalid size for dynamic array; requested: %d, range: 0..%d", arg_elnum, INT32_MAX);
+            return -1;
+        }
+        DynObjectRef ref = CCDynamicArray::Create(static_cast<uint32_t>(arg_elnum), arg_elsize, arg_managed);
+        reg1.SetScriptObject(ref.Obj(), &globalDynamicArray);
+        break;
+    }
+    case SCMD_NEWUSEROBJECT:
+    {
+        auto &reg1 = _registers[op_arg1];
+        const uint32_t arg_size = static_cast<uint32_t>(op_arg2);
+        if (arg_size > INT32_MAX)
+        {
+            cc_error("Invalid size for user object; requested: %u, range: 0..%d", arg_size, INT32_MAX);
+            return -1;
+        }
+        DynObjectRef ref = ScriptUserObject::Create(arg_size);
+        reg1.SetScriptObject(ref.Obj(), ref.Mgr());
+        break;
+    }
+    case SCMD_FADD:
+    {
+        auto &reg1 = _registers[op_arg1];
+        const auto arg_lit = op_arg2;
+        reg1.SetFloat(reg1.FValue + arg_lit); // arg2 was used as int here originally
+        break;
+    }
+    case SCMD_FSUB:
+    {
+        auto &reg1 = _registers[op_arg1];
+        const auto arg_lit = op_arg2;
+        reg1.SetFloat(reg1.FValue - arg_lit); // arg2 was used as int here originally
+        break;
+    }
+    case SCMD_FMULREG:
+    {
+        auto       &reg1 = _registers[op_arg1];
+        const auto &reg2 = _registers[op_arg2];
+        reg1.SetFloat(reg1.FValue * reg2.FValue);
+        break;
+    }
+    case SCMD_FDIVREG:
+    {
+        auto       &reg1 = _registers[op_arg1];
+        const auto &reg2 = _registers[op_arg2];
+        if (reg2.FValue == 0.0)
+        {
+            cc_error("!Floating point divide by zero");
+            return -1;
+        }
+        reg1.SetFloat(reg1.FValue / reg2.FValue);
+        break;
+    }
+    case SCMD_FADDREG:
+    {
+        auto       &reg1 = _registers[op_arg1];
+        const auto &reg2 = _registers[op_arg2];
+        reg1.SetFloat(reg1.FValue + reg2.FValue);
+        break;
+    }
+    case SCMD_FSUBREG:
+    {
+        auto       &reg1 = _registers[op_arg1];
+        const auto &reg2 = _registers[op_arg2];
+        reg1.SetFloat(reg1.FValue - reg2.FValue);
+        break;
+    }
+    case SCMD_FGREATER:
+    {
+        auto       &reg1 = _registers[op_arg1];
+        const auto &reg2 = _registers[op_arg2];
+        reg1.SetFloatAsBool(reg1.FValue > reg2.FValue);
+        break;
+    }
+    case SCMD_FLESSTHAN:
+    {
+        auto       &reg1 = _registers[op_arg1];
+        const auto &reg2 = _registers[op_arg2];
+        reg1.SetFloatAsBool(reg1.FValue < reg2.FValue);
+        break;
+    }
+    case SCMD_FGTE:
+    {
+        auto       &reg1 = _registers[op_arg1];
+        const auto &reg2 = _registers[op_arg2];
+        reg1.SetFloatAsBool(reg1.FValue >= reg2.FValue);
+        break;
+    }
+    case SCMD_FLTE:
+    {
+        auto       &reg1 = _registers[op_arg1];
+        const auto &reg2 = _registers[op_arg2];
+        reg1.SetFloatAsBool(reg1.FValue <= reg2.FValue);
+        break;
+    }
+    case SCMD_ZEROMEMORY:
+    {
+        const auto arg_size = op_arg1;
+        // Check if we are zeroing at stack tail
+        if (_registers[SREG_MAR] == _registers[SREG_SP])
+        {
+            // creating a local variable -- check the stack to ensure no mem overrun
+            ASSERT_STACK_SPACE_BYTES(arg_size);
+            // NOTE: according to compiler's logic, this is always followed
+            // by SCMD_ADD, and that is where the data is "allocated", here we
+            // just clean the place.
+            memset(_stackdataPtr, 0, arg_size);
+        }
+        else
+        {
+            cc_error("internal error: stack tail address expected on SCMD_ZEROMEMORY instruction, reg[MAR] type is %d",
+                _registers[SREG_MAR].Type);
+            return -1;
+        }
+        break;
+    }
+    case SCMD_CREATESTRING:
+    {
+        auto &reg1 = _registers[op_arg1];
+        const char *ptr = reinterpret_cast<const char*>(reg1.GetDirectPtr());
+        DynObjectRef ref = ScriptString::Create(ptr);
+        reg1.SetScriptObject(ref.Obj(), &myScriptStringImpl);
+        break;
+    }
+    case SCMD_STRINGSEQUAL:
+    {
+        auto       &reg1 = _registers[op_arg1];
+        const auto &reg2 = _registers[op_arg2];
+        if ((reg1.IsNull()) || (reg2.IsNull()))
+        {
+            cc_error("!Null pointer referenced");
+            return -1;
+        }
+        else
+        {
+            const char *ptr1 = reinterpret_cast<const char*>(reg1.GetDirectPtr());
+            const char *ptr2 = reinterpret_cast<const char*>(reg2.GetDirectPtr());
+            reg1.SetInt32AsBool(strcmp(ptr1, ptr2) == 0);
+        }
+        break;
+    }
+    case SCMD_STRINGSNOTEQ:
+    {
+        auto       &reg1 = _registers[op_arg1];
+        const auto &reg2 = _registers[op_arg2];
+        if ((reg1.IsNull()) || (reg2.IsNull()))
+        {
+            cc_error("!Null pointer referenced");
+            return -1;
+        }
+        else
+        {
+            const char *ptr1 = reinterpret_cast<const char*>(reg1.GetDirectPtr());
+            const char *ptr2 = reinterpret_cast<const char*>(reg2.GetDirectPtr());
+            reg1.SetInt32AsBool(strcmp(ptr1, ptr2) != 0);
+        }
+        break;
+    }
+    case SCMD_LOOPCHECKOFF:
+        if (fr.loopIterationCheckDisabled == 0)
+            fr.loopIterationCheckDisabled++;
+        break;
+    default:
+        cc_error("instruction %d is not implemented", op_code);
+        return -1;
+    }
+    _pc += op_argc + 1;
+    return 0;
+}
+
+// The fast loop. fr == nullptr: fill s_vm_handlers and return.
+// Register operands are byte offsets into _registers; jump operands are word deltas from the
+// jump's own slot. Every native handler tests its preconditions before writing anything and
+// leaves through h_generic when one fails, so DosVmStep raises the same error with the same state.
+#define VM_REG(off) (*reinterpret_cast<RuntimeScriptValue*>(reinterpret_cast<char*>(_registers) + (off)))
+#define VM_PC() static_cast<int32_t>(ip - fr->dbase)
+#define VM_IS_START(p) ((fr->dstart[static_cast<uint32_t>(p) >> 5] >> (static_cast<uint32_t>(p) & 31)) & 1u)
+#ifdef DOSAGS_VMTRACE
+#define VM_TRACE() DosVmTraceFold(fr->codeInst, VM_PC(), static_cast<int32_t>(fr->codeInst->_code[VM_PC()] & INSTANCE_ID_REMOVEMASK))
+#else
+#define VM_TRACE()
+#endif
+#define VM_DISPATCH() do { VM_TRACE(); goto *reinterpret_cast<const void*>(*ip); } while (0)
+#define VM_NEXT(n) do { ip += (n); VM_DISPATCH(); } while (0)
+#define VM_ABORTED_EXIT() if (_flags & INSTF_ABORTED) { _pc = VM_PC(); return kInstErr_None; }
+#define VM_SP (_registers[SREG_SP])
+
+ccInstError ccInstance::DosVmLoop(DosVmFrame *fr, int32_t startpc)
+{
+    if (!fr)
+    {
+        static const void *const tbl[kVmH_Count] = {
+            &&h_generic, &&h_linenum, &&h_add, &&h_sub, &&h_mov, &&h_ret,
+            &&h_movl_int, &&h_movl_gvar, &&h_movl_str, &&h_movl_imp, &&h_memread, &&h_memwrite,
+            &&h_mulreg, &&h_addreg, &&h_subreg, &&h_bitand, &&h_bitor, &&h_isequal, &&h_notequal,
+            &&h_greater, &&h_lessthan, &&h_gte, &&h_lte, &&h_and, &&h_or, &&h_xorreg, &&h_call,
+            &&h_jz, &&h_jnz, &&h_jmp, &&h_push, &&h_pop, &&h_mul, &&h_callext, &&h_pushreal,
+            &&h_subrealstack, &&h_numfuncargs, &&h_thisbase, &&h_checkbounds, &&h_checknull,
+            &&h_checknullreg };
+        for (int i = 0; i < kVmH_Count; ++i)
+            s_vm_handlers[i] = tbl[i];
+        s_vm_handlers_ready = true;
+        return kInstErr_None;
+    }
+
+    const intptr_t *ip = fr->dbase + startpc;
+    // Run()'s loop condition, before the first instruction
+    if (_flags & INSTF_ABORTED)
+        return kInstErr_None;
+    if (!VM_IS_START(startpc))
+        goto h_generic_untraced;
+    VM_DISPATCH();
+
+h_linenum: // SCMD_LINENUM; the hook is a call-out
+    _lineNumber = static_cast<int>(ip[1]);
+    currentline = _lineNumber;
+    if (new_line_hook)
+    {
+        _pc = VM_PC();
+        new_line_hook(this, currentline);
+        ip += 2;
+        VM_ABORTED_EXIT();
+        VM_DISPATCH();
+    }
+    VM_NEXT(2);
+
+h_add: // SCMD_ADD
+    {
+        RuntimeScriptValue &reg1 = VM_REG(ip[1]);
+        const int32_t arg_lit = static_cast<int32_t>(ip[2]);
+        if (ip[1] == SREG_SP * static_cast<intptr_t>(sizeof(RuntimeScriptValue)))
+        {
+            if ((VM_SP.RValue + 1 - _stackBegin) >= CC_STACK_SIZE ||
+                (_stackdataPtr + arg_lit - _stackdataBegin) >= CC_STACK_DATA_SIZE)
+                goto h_generic;
+            if (reg1.RValue->IsValid())
+            {
+                VM_SP.RValue++;
+                _stackdataPtr += arg_lit;
+            }
+            else
+            {
+                // PushDataToStack (its CC_ERROR_IF is empty in this build)
+                VM_SP.RValue->SetData(_stackdataPtr, arg_lit);
+                _stackdataPtr += arg_lit;
+                VM_SP.RValue++;
+            }
+        }
+        else
+        {
+            reg1.IValue += arg_lit;
+        }
+        VM_NEXT(3);
+    }
+
+h_sub: // SCMD_SUB
+    {
+        RuntimeScriptValue &reg1 = VM_REG(ip[1]);
+        const int32_t arg_lit = static_cast<int32_t>(ip[2]);
+        if (reg1.Type == kScValStackPtr)
+        {
+            if (ip[1] == SREG_SP * static_cast<intptr_t>(sizeof(RuntimeScriptValue)))
+            {
+                PopDataFromStack(arg_lit);
+            }
+            else
+            {
+                // GetStackPtrOffsetRw, inline (its CC_ERROR_IF_RETVALs are empty in this build)
+                int32_t total_off = 0;
+                RuntimeScriptValue *stack_entry = VM_SP.RValue;
+                while (total_off < arg_lit && stack_entry > _stackBegin)
+                {
+                    stack_entry--;
+                    total_off += stack_entry->Size;
+                }
+                reg1.SetStackPtr(stack_entry);
+                reg1.IValue += total_off - arg_lit;
+            }
+        }
+        else
+        {
+            reg1.IValue -= arg_lit;
+        }
+        VM_NEXT(3);
+    }
+
+h_mov: // SCMD_REGTOREG
+    {
+        const RuntimeScriptValue &reg1 = VM_REG(ip[1]);
+        RuntimeScriptValue &reg2 = VM_REG(ip[2]);
+        reg2 = reg1;
+        VM_NEXT(3);
+    }
+
+h_ret: // SCMD_RET
+    {
+        if (VM_SP.RValue - 1 < _stackBegin)
+            goto h_generic;
+        RuntimeScriptValue *slot = VM_SP.RValue - 1;
+        const int32_t newpc = slot->IValue;
+        if (newpc != 0 && _callStackSize < 1)
+            goto h_generic;
+        if (fr->loopIterationCheckDisabled > 0)
+            fr->loopIterationCheckDisabled--;
+        VM_SP.RValue = slot;
+        _stackdataPtr -= sizeof(int32_t);
+        slot->Invalidate();
+        fr->curnest--;
+        _pc = newpc;
+        if (newpc == 0)
+        {
+            _returnValue = _registers[SREG_AX].IValue;
+            return kInstErr_None;
+        }
+        _callStackSize--;
+        _lineNumber = _callStackLineNumber[_callStackSize];
+        currentline = _lineNumber;
+        ip = fr->dbase + newpc;
+        if (newpc < 0 || static_cast<uint32_t>(newpc) >= fr->codesize || !VM_IS_START(newpc))
+            goto h_generic_untraced;
+        VM_DISPATCH();
+    }
+
+h_movl_int: // SCMD_LITTOREG, no fixup / FIXUP_FUNCTION
+    VM_REG(ip[1]).SetInt32(static_cast<int32_t>(ip[2]));
+    VM_NEXT(3);
+h_movl_gvar: // FIXUP_GLOBALDATA: operand is &ScriptVariable::RValue
+    VM_REG(ip[1]).SetGlobalVar(reinterpret_cast<RuntimeScriptValue*>(ip[2]));
+    VM_NEXT(3);
+h_movl_str: // FIXUP_STRING: operand is _strings + offset
+    VM_REG(ip[1]).SetStringLiteral(reinterpret_cast<const char*>(ip[2]));
+    VM_NEXT(3);
+h_movl_imp: // FIXUP_IMPORT: operand is the import index, looked up now as Run() does
+    {
+        const ScriptImport *import = simp.GetByIndex(static_cast<uint32_t>(ip[2]));
+        if (!import)
+            goto h_generic;
+        VM_REG(ip[1]) = import->Value;
+        VM_NEXT(3);
+    }
+
+h_memread: // SCMD_MEMREAD, MAR on the stack or a global variable (no call-outs on those paths)
+    {
+        const RuntimeScriptValue &mar = _registers[SREG_MAR];
+        if (mar.Type != kScValStackPtr && mar.Type != kScValGlobalVar)
+            goto h_generic;
+        VM_REG(ip[1]) = mar.ReadValue();
+        VM_NEXT(2);
+    }
+h_memwrite: // SCMD_MEMWRITE, same two MAR types
+    {
+        RuntimeScriptValue &mar = _registers[SREG_MAR];
+        if (mar.Type != kScValStackPtr && mar.Type != kScValGlobalVar)
+            goto h_generic;
+        mar.WriteValue(VM_REG(ip[1]));
+        VM_NEXT(2);
+    }
+
+#define VM_BINOP(LABEL, EXPR) \
+LABEL: \
+    { \
+        RuntimeScriptValue &reg1 = VM_REG(ip[1]); \
+        const RuntimeScriptValue &reg2 = VM_REG(ip[2]); \
+        EXPR; \
+        VM_NEXT(3); \
+    }
+    VM_BINOP(h_mulreg, reg1.SetInt32(reg1.IValue * reg2.IValue))
+    VM_BINOP(h_addreg, reg1.IValue += reg2.IValue)
+    VM_BINOP(h_subreg, reg1.IValue -= reg2.IValue)
+    VM_BINOP(h_bitand, reg1.SetInt32(reg1.IValue & reg2.IValue))
+    VM_BINOP(h_bitor, reg1.SetInt32(reg1.IValue | reg2.IValue))
+    VM_BINOP(h_isequal, reg1.SetInt32AsBool(reg1 == reg2))
+    VM_BINOP(h_notequal, reg1.SetInt32AsBool(reg1 != reg2))
+    VM_BINOP(h_greater, reg1.SetInt32AsBool(reg1.IValue > reg2.IValue))
+    VM_BINOP(h_lessthan, reg1.SetInt32AsBool(reg1.IValue < reg2.IValue))
+    VM_BINOP(h_gte, reg1.SetInt32AsBool(reg1.IValue >= reg2.IValue))
+    VM_BINOP(h_lte, reg1.SetInt32AsBool(reg1.IValue <= reg2.IValue))
+    VM_BINOP(h_and, reg1.SetInt32AsBool(reg1.IValue && reg2.IValue))
+    VM_BINOP(h_or, reg1.SetInt32AsBool(reg1.IValue || reg2.IValue))
+    VM_BINOP(h_xorreg, reg1.SetInt32(reg1.IValue ^ reg2.IValue))
+#undef VM_BINOP
+
+h_mul: // SCMD_MUL
+    VM_REG(ip[1]).IValue *= static_cast<int32_t>(ip[2]);
+    VM_NEXT(3);
+
+h_call: // SCMD_CALL
+    {
+        if (fr->curnest >= MAXNEST - 1 || _callStackSize >= MAX_CALL_STACK)
+            goto h_generic;
+        RuntimeScriptValue *slot = VM_SP.RValue;
+        if ((slot + 1 - _stackBegin) >= CC_STACK_SIZE ||
+            (_stackdataPtr + sizeof(int32_t) - _stackdataBegin) >= CC_STACK_DATA_SIZE ||
+            VM_SP.Type != kScValStackPtr || slot->Type == kScValData)
+            goto h_generic;
+        const int32_t pc = VM_PC();
+        // PUSH_CALL_STACK
+        _callStackLineNumber[_callStackSize] = _lineNumber;
+        _callStackCodeInst[_callStackSize] = _runningInst;
+        _callStackAddr[_callStackSize] = pc;
+        _callStackSize++;
+        // PushValueToStack(RuntimeScriptValue().SetInt32(_pc + op_argc + 1))
+        slot->SetInt32(pc + 2);
+        slot->Size = 4;
+        _stackdataPtr += sizeof(int32_t);
+        VM_SP.RValue = slot + 1;
+        const RuntimeScriptValue &reg1 = VM_REG(ip[1]);
+        int32_t target;
+        if (fr->thisbase[fr->curnest] == 0)
+            target = reg1.IValue;
+        else
+        {
+            target = fr->funcstart[fr->curnest];
+            target += (reg1.IValue - fr->thisbase[fr->curnest]);
+        }
+        _pc = target;
+        fr->next_call_needs_object = 0;
+        if (fr->loopIterationCheckDisabled)
+            fr->loopIterationCheckDisabled++;
+        fr->curnest++;
+        fr->thisbase[fr->curnest] = 0;
+        fr->funcstart[fr->curnest] = target;
+        ip = fr->dbase + target;
+        if (target < 0 || static_cast<uint32_t>(target) >= fr->codesize || !VM_IS_START(target))
+            goto h_generic_untraced;
+        VM_DISPATCH();
+    }
+
+h_jz: // SCMD_JZ; operand = arg + 2
+    if (_registers[SREG_AX].IsNull())
+        VM_NEXT(ip[1]);
+    VM_NEXT(2);
+h_jnz: // SCMD_JNZ
+    if (!_registers[SREG_AX].IsNull())
+        VM_NEXT(ip[1]);
+    VM_NEXT(2);
+h_jmp: // SCMD_JMP, with Run()'s backward-jump watchdog
+    {
+        const int32_t arg_lit = static_cast<int32_t>(ip[1]) - 2;
+        if (arg_lit < 0)
+        {
+            const int32_t pc_after = VM_PC() + arg_lit; // Run(): _pc += arg_lit, before the checks
+            ++fr->loopIterations;
+            if (_flags & INSTF_RUNNING)
+            {
+                _flags &= ~INSTF_RUNNING;
+                fr->loopIterations = 0u;
+                fr->loopCheckIterations = 0u;
+            }
+            else if ((fr->loopIterationCheckDisabled == 0) && (_maxWhileLoops > 0) &&
+                (++fr->loopCheckIterations > _maxWhileLoops))
+            {
+                _pc = pc_after;
+                cc_error("!Script appears to be hung (a while loop ran %d times). The problem may be in a calling function; check the call stack.", fr->loopCheckIterations);
+                return kInstErr_Generic;
+            }
+            else if ((fr->loopIterations & 0x3FF) == 0 &&
+                (std::chrono::duration_cast<std::chrono::milliseconds>(
+                    FastClock::now() - _lastAliveTs) > fr->timeout))
+            {
+                _pc = pc_after;
+                sys_evt_process_pending();
+                _lastAliveTs = FastClock::now();
+                ip += ip[1];
+                VM_ABORTED_EXIT();
+                VM_DISPATCH();
+            }
+        }
+        VM_NEXT(ip[1]);
+    }
+
+h_push: // SCMD_PUSHREG
+    {
+        RuntimeScriptValue *slot = VM_SP.RValue;
+        if ((slot + 1 - _stackBegin) >= CC_STACK_SIZE ||
+            (_stackdataPtr + sizeof(int32_t) - _stackdataBegin) >= CC_STACK_DATA_SIZE ||
+            VM_SP.Type != kScValStackPtr || slot->Type == kScValData)
+            goto h_generic;
+        *slot = VM_REG(ip[1]);
+        slot->Size = 4;
+        _stackdataPtr += sizeof(int32_t);
+        VM_SP.RValue = slot + 1;
+        VM_NEXT(2);
+    }
+h_pop: // SCMD_POPREG: straight into the register (registers and the stack never alias)
+    {
+        if (VM_SP.RValue - 1 < _stackBegin)
+            goto h_generic;
+        RuntimeScriptValue *slot = VM_SP.RValue - 1;
+        VM_SP.RValue = slot;
+        _stackdataPtr -= sizeof(int32_t);
+        VM_REG(ip[1]) = *slot;
+        slot->Invalidate();
+        VM_NEXT(2);
+    }
+
+h_callext: // SCMD_CALLEXT: Run()'s text, with _pc synced before the call and the abort test after
+    {
+        _pc = VM_PC();
+        const RuntimeScriptValue &reg1 = VM_REG(ip[1]);
+        DosVmCallStack &fcs = *fr->fcs;
+        fr->was_just_callas = -1;
+        if (fr->num_args_to_func < 0)
+            fr->num_args_to_func = fcs.GetSize();
+        for (RuntimeScriptValue *prval = fcs.GetHead() + fr->num_args_to_func;
+            --prval >= fcs.GetHead();)
+        {
+            prval->DirectPtr();
+        }
+        dos_port_work[kDW_ScriptExt]++;   // patch 0230, every build
+        RuntimeScriptValue return_value;
+        if (reg1.Type == kScValPluginFunction)
+        {
+            if (fr->next_call_needs_object)
+            {
+                RuntimeScriptValue obj_rval = _registers[SREG_OP];
+                obj_rval.DirectPtrObj();
+                return_value = CallPluginFunction(reg1.Ptr, &obj_rval, fcs.GetHead(), fr->num_args_to_func);
+            }
+            else
+            {
+                return_value = CallPluginFunction(reg1.Ptr, nullptr, fcs.GetHead(), fr->num_args_to_func);
+            }
+        }
+        else if (fr->next_call_needs_object)
+        {
+            if (reg1.Type == kScValObjectFunction)
+            {
+                RuntimeScriptValue obj_rval = _registers[SREG_OP];
+                obj_rval.DirectPtrObj();
+                return_value = reg1.ObjPfn(obj_rval.Ptr, fcs.GetHead(), fr->num_args_to_func);
+            }
+            else
+            {
+                cc_error("invalid pointer type for object function call: %d", reg1.Type);
+            }
+        }
+        else if (reg1.Type == kScValStaticFunction)
+        {
+            return_value = reg1.SPfn(fcs.GetHead(), fr->num_args_to_func);
+        }
+        else if (reg1.Type == kScValObjectFunction)
+        {
+            cc_error("unexpected object function pointer on SCMD_CALLEXT");
+        }
+        else
+        {
+            cc_error("invalid pointer type for function call: %d", reg1.Type);
+        }
+        if (cc_has_error())
+            return kInstErr_Generic;
+        _registers[SREG_AX] = return_value;
+        fr->next_call_needs_object = 0;
+        fr->num_args_to_func = -1;
+        ip += 2;
+        VM_ABORTED_EXIT();
+        VM_DISPATCH();
+    }
+
+h_pushreal: // SCMD_PUSHREAL
+    fr->fcs->Push(VM_REG(ip[1]));
+    VM_NEXT(2);
+h_subrealstack: // SCMD_SUBREALSTACK; the after-CALLAS case goes through the stepper
+    {
+        const int32_t arg_lit = static_cast<int32_t>(ip[1]);
+        if (fr->fcs->GetSize() < static_cast<uint32_t>(arg_lit) || fr->was_just_callas >= 0)
+            goto h_generic;
+        fr->fcs->PopCount(arg_lit);
+        VM_NEXT(2);
+    }
+h_numfuncargs: // SCMD_NUMFUNCARGS
+    fr->num_args_to_func = static_cast<int32_t>(ip[1]);
+    VM_NEXT(2);
+h_thisbase: // SCMD_THISBASE
+    fr->thisbase[fr->curnest] = static_cast<int32_t>(ip[1]);
+    VM_NEXT(2);
+h_checkbounds: // SCMD_CHECKBOUNDS; the error goes through the stepper
+    {
+        const RuntimeScriptValue &reg1 = VM_REG(ip[1]);
+        const int32_t arg_lit = static_cast<int32_t>(ip[2]);
+        if ((reg1.IValue < 0) || (reg1.IValue >= arg_lit))
+            goto h_generic;
+        VM_NEXT(3);
+    }
+h_checknull: // SCMD_CHECKNULL
+    if (_registers[SREG_MAR].IsNull())
+        goto h_generic;
+    VM_NEXT(1);
+h_checknullreg: // SCMD_CHECKNULLREG
+    if (VM_REG(ip[1]).IsNull())
+        goto h_generic;
+    VM_NEXT(2);
+
+h_generic_untraced: // ip is at an instruction the trace has not seen yet (a non-start target)
+    VM_TRACE();
+h_generic: // the instruction at ip, and any that follow until an instruction start, by the stepper
+    {
+        int32_t pc = VM_PC();
+        for (;;)
+        {
+            const int st = DosVmStep(*fr, pc);
+            if (st < 0)
+                return kInstErr_Generic;
+            if (st > 0)
+                return kInstErr_None;
+            if (_flags & INSTF_ABORTED)
+                return kInstErr_None; // _pc is the next instruction, as Run() leaves it
+            pc = _pc;
+            if (pc >= 0 && static_cast<uint32_t>(pc) < fr->codesize && VM_IS_START(pc))
+            {
+                ip = fr->dbase + pc;
+                VM_DISPATCH();
+            }
+#ifdef DOSAGS_VMTRACE
+            DosVmTraceFold(fr->codeInst, pc, static_cast<int32_t>(fr->codeInst->_code[pc] & INSTANCE_ID_REMOVEMASK));
+#endif
+        }
+    }
+}
+
+#ifdef DOSAGS_VMTRACE
+// LAB ONLY (make AGS_RUNSTATS_DEF=-DDOSAGS_VMTRACE): the instruction-by-instruction trace digest
+// (VM-DESIGN 5, slice 2). Folded before every executed instruction, by Run() and by the fast loop
+// alike: the code instance, pc, opcode, all eight registers' type/value/size and pointer
+// presence (a stack pointer by its stack index), the stack data offset, the three stack entries
+// at the top, the line number and the call depth. Pointers are folded as present/absent only,
+// so heap layout cannot move the digest. game_run.cpp prints it on the statewit line.
+uint32_t dos_vmtrace_h = 2166136261u;
+unsigned long dos_vmtrace_n = 0;
+uint32_t dos_vmtrace_tick = 0;
+
+void ccInstance::DosVmTraceFold(const ccInstance *codeInst, int32_t pc, int32_t op) const
+{
+    uint32_t h = dos_vmtrace_h;
+#define VT(v) h = (h ^ static_cast<uint32_t>(v)) * 16777619u
+    VT(codeInst->_loadedInstanceId); VT(pc); VT(op);
+    for (int i = 0; i < CC_NUM_REGISTERS; ++i)
+    {
+        const RuntimeScriptValue &r = _registers[i];
+        VT(r.Type); VT(r.IValue); VT(r.Size); VT(r.Ptr != nullptr); VT(r.MgrPtr != nullptr);
+        if (r.Type == kScValStackPtr && r.RValue >= _stackBegin && r.RValue < _stackBegin + CC_STACK_SIZE)
+            VT(r.RValue - _stackBegin);
+    }
+    VT(_stackdataPtr - _stackdataBegin);
+    if (_registers[SREG_SP].Type == kScValStackPtr)
+    {
+        const RuntimeScriptValue *sp = _registers[SREG_SP].RValue;
+        for (int k = -2; k <= 0; ++k)
+        {
+            const RuntimeScriptValue *e = sp + k;
+            if (e >= _stackBegin && e < _stackBegin + CC_STACK_SIZE)
+            {
+                VT(e->Type); VT(e->IValue); VT(e->Size);
+            }
+        }
+    }
+    VT(_lineNumber); VT(_callStackSize);
+#undef VT
+    dos_vmtrace_h = h;
+    dos_vmtrace_n++;
+}
+
+// The trace's control: DOSAGS_VMTRACE_CONTROL=N flips bit 0 of AX after the first engine call at
+// or after tick N (Run()'s CALLEXT only; the control arm runs the legacy VM).
+bool dos_vmtrace_control_fire()
+{
+    static long at = -2;
+    static bool done = false;
+    if (at == -2) { const char *e = getenv("DOSAGS_VMTRACE_CONTROL"); at = e ? atol(e) : -1; }
+    if (at < 0 || done || static_cast<long>(dos_vmtrace_tick) < at) return false;
+    done = true;
+    return true;
+}
+#endif
+

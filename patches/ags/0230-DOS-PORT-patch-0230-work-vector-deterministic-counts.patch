+// DOS-PORT patch 0230: the work vector (main/dos_port_work.h), split the same
+// way the time is. tick_rate_steady excludes stall ticks' self time and
+// everything outside [first tick entry, last tick exit]; a vector compared with
+// that time must exclude the same work, or a room load's file reads and fade
+// presents get priced against a denominator that left them out. Snapshots are
+// taken where the tick scope already reads the clock, children are subtracted
+// exactly as dos_tick_children_us is, and a stall tick's self delta goes to
+// dos_work_excluded. About 19 loads and stores per scope edge: per tick, not
+// per pixel.
+long long dos_port_work[kDW_Count] = {};
+int dos_port_work_vs_bpp = 0, dos_port_work_win_bpp = 0;
+int dos_port_work_win_w = 0, dos_port_work_win_h = 0;
+static long long dos_work_first[kDW_Count] = {};     // at the first tick's entry
+static long long dos_work_last[kDW_Count] = {};      // at the last tick exit (any depth)
+static long long dos_work_excluded[kDW_Count] = {};  // stall ticks' self work
+static long long dos_work_children[kDW_Count] = {};  // nested ticks' work, as for time
+
+void dos_port_work_snapshot(long long out[kDW_Count])
+{
+    for (int i = 0; i < kDW_Count; i++)
+        out[i] = dos_port_work[i];
+    const DosPortTickTiming &t = dos_port_tick_timing;
+    out[kDW_Ticks]     = dos_tick_count;
+    out[kDW_Renders]   = (long long)GameTimer.RenderCounter;
+    out[kDW_Presents]  = t.presents_real;
+    out[kDW_BgPx]      = t.bg_px;
+    out[kDW_FillPx]    = t.black_fill_px + t.rb_clear_px;
+    out[kDW_SprN]      = t.rb_sprites;
+    out[kDW_FileBytes] = dos_port_file_rd_bytes;
+    out[kDW_FileCalls] = dos_port_file_rd_calls;
+}
+
 class DosTickStallScope
 {
 public:
@@ -1569,8 +1602,16 @@ public:
         : _t0(uclock()), _saved_children(dos_tick_children_us), _index(GameTimer.LoopCounter + 1)

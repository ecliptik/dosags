+/* DOS-PORT patch 0260: the TIMED-DELAY transport, and nothing else, may be
+   paced by the RTC pump instead of this busy-wait: same direct port, same
+   minimum spacing between two bytes, no status read. */
+bool SDL_DOSMpu401PacedDirectBase(Uint16 *out_base, Uint32 *out_gap_us)
+{
+    if (s_mpu401_port_base < 0 || s_mpu401_use_dsp || s_mpu401_tx_delay_us == 0) {
+        return false;
+    }
+    if (out_base) {
+        *out_base = (Uint16)s_mpu401_port_base;
+    }
+    if (out_gap_us) {
+        *out_gap_us = s_mpu401_tx_delay_us;
+    }
+    return true;
+}
+
+void SDL_DOSMpu401PaceDelay(void)
+{
+    mpu401_tx_pace_delay(s_mpu401_tx_delay_us);
+}

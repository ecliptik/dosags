+    {
+        const char *e = getenv("DOSAGS_SAVEMEM");
+        m = (e != nullptr && e[0] == '0') ? 0 : 1;
+    }
+    return m;
+}
+int dos_savemem_failknob()
+{
+#ifndef DOSAGS_RELEASE
+    static int k = -1;
+    if (k < 0)
+    {   // LAB knob: =1 the reservation fails; =2 the failure comes after the whole image was serialised
+        const char *e = getenv("DOSAGS_LAB_SAVEMEM_FAIL");
+        k = (e != nullptr && (e[0] == '1' || e[0] == '2')) ? (e[0] - '0') : 0;
+    }
+    return k;
+#else
+    return 0;
+#endif
+}

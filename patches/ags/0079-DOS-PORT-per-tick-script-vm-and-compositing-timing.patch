@@ -436,6 +437,27 @@ void quit(const char *quitmsg)
                     tick_rate_hz, dos_get_frames_skipped());
             }
 
+            // DOS-PORT patch 0079: full-run script-VM/render-compositing
+            // aggregates (dos_port_tick_timing.h) -- same "own line after
+            // the RUNMANIFEST block" placement as tick_rate/frames_skipped
+            // and memory_min_free_kb just above, not a RUNMANIFEST schema
+            // field. calls=0 means that phase's bracket was never reached
+            // this run (e.g. a game that quit before its first tick) --
+            // min_ms/max_ms stay at -1 and mean_ms is printed as 0.00
+            // rather than dividing by zero.
+            {
+                const DosPortTickPhaseStats &sv = dos_port_tick_timing.script_vm;
+                const DosPortTickPhaseStats &rb = dos_port_tick_timing.render_backbuffer;
+                fprintf(run_manifest_log,
+                    "DOS-PORT tickstats_script_vm calls=%ld total_ms=%ld min_ms=%ld max_ms=%ld mean_ms=%.2f\n",
+                    sv.calls, sv.total_ms, sv.min_ms, sv.max_ms,
+                    sv.calls > 0 ? (double)sv.total_ms / (double)sv.calls : 0.0);
+                fprintf(run_manifest_log,
+                    "DOS-PORT tickstats_render_backbuffer calls=%ld total_ms=%ld min_ms=%ld max_ms=%ld mean_ms=%.2f\n",
+                    rb.calls, rb.total_ms, rb.min_ms, rb.max_ms,
+                    rb.calls > 0 ? (double)rb.total_ms / (double)rb.calls : 0.0);
+            }
+
             // TEMPORARY DIAGNOSTIC (S7): dump the AUDIOPRB window data
             // (audio_core.cpp) through THIS handle rather than a separate
             // periodically-reopened AUDIOPRB.LOG -- see that file's own

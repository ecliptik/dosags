 Engine/media/audio/audioplayer.cpp       | 19 +++++++++
 Engine/platform/dos/dos_midi_backend.cpp | 49 ++++++++++++++++++++++--
 Engine/platform/dos/dos_midi_backend.h   |  4 ++
 3 files changed, 68 insertions(+), 4 deletions(-)

diff --git a/Engine/media/audio/audioplayer.cpp b/Engine/media/audio/audioplayer.cpp
index 43ff65f89..68be8a3ef 100644
--- a/Engine/media/audio/audioplayer.cpp
+++ b/Engine/media/audio/audioplayer.cpp
@@ -196,6 +196,25 @@ void AudioPlayer::MidiIsrPlan()
         SDL_DOSMidiDeferSetStamp((uint32_t)(_midiPlanUs / _midiPeriodUs));
         midi_sched_tick(_midiSched, _midiSongUs / 1000u + 1000u);
     }
+    // DOS-PORT (patch 0345): stamp the first stuck repair and first late write (SDL 0266) with the
+    // song ms at their slots -- the song time planned for a slot is the planner's song clock minus the
+    // slots planned past it -- and this plan's main-loop tick.
+    {
+        Uint32 st_irq = 0xFFFFFFFFu, st_prev = 0, lt_irq = 0xFFFFFFFFu;
+        SDL_DOSMidiDeferFirstEvents(&st_irq, &st_prev, &lt_irq);
+        if (st_irq != 0xFFFFFFFFu || lt_irq != 0xFFFFFFFFu)
+        {
+            const uint32_t plan_slot = (uint32_t)(_midiPlanUs / _midiPeriodUs);
+            const uint64_t song_us = _midiSongUs;
+            const uint32_t real_us = _midiRealPeriodUs;
+            auto song_ms_at = [plan_slot, song_us, real_us](uint32_t slot) -> uint32_t {
+                const uint64_t back = (uint64_t)(plan_slot > slot ? plan_slot - slot : 0) * real_us;
+                return (uint32_t)((song_us > back ? song_us - back : 0) / 1000u);
+            };
+            dos_midi_backend_note_first_events(st_irq, st_prev, st_irq != 0xFFFFFFFFu ? song_ms_at(st_irq) : 0,
+                lt_irq, lt_irq != 0xFFFFFFFFu ? song_ms_at(lt_irq) : 0, get_loop_counter());
+        }
+    }
     SDL_DOSMidiDeferSetStamp(now); // anything written outside the plan goes out at once
     // DOS-PORT (patch 0208): report the song clock itself (song ms planned
     // since the last poll; the lookahead is a constant offset after the
diff --git a/Engine/platform/dos/dos_midi_backend.cpp b/Engine/platform/dos/dos_midi_backend.cpp
index 5bfaadefe..f156d3f06 100644
--- a/Engine/platform/dos/dos_midi_backend.cpp
+++ b/Engine/platform/dos/dos_midi_backend.cpp
@@ -57,6 +57,12 @@ uint32_t g_plan_behind = 0;
 static bool g_pb_seen = false;
 static uint32_t g_pb_song_ms = 0, g_pb_loop = 0, g_pb_gap_irqs = 0;
 static bool g_pb_first = false;
+// DOS-PORT (patch 0345): the first stuck repair and the first late write (SDL 0266), stamped at the
+// first plan that sees them: song ms at the event's slot, the main-loop tick of that plan, the SB IRQ
+// index, and for the stuck repair the RTC ticks in the kick interval before it. Reporting only.
+static bool g_st_seen = false, g_lt_seen = false;
+static uint32_t g_st_song_ms = 0, g_st_loop = 0, g_st_irq = 0, g_st_prev = 0;
+static uint32_t g_lt_song_ms = 0, g_lt_loop = 0, g_lt_irq = 0;
 uint32_t g_real_period_us = 0; // DOS-PORT (patch 0208)
 // DOS-PORT (patch 0341): the queue kind in use, and the clk_uc= witness.
 int g_defer_kind = 0;
@@ -426,6 +432,26 @@ void dos_midi_backend_note_isr_period(uint32_t period_us)
     g_real_period_us = period_us;
 }
 
+void dos_midi_backend_note_first_events(uint32_t stuck_irq, uint32_t stuck_prev, uint32_t stuck_song_ms,
+    uint32_t late_irq, uint32_t late_song_ms, uint32_t loop_tick)
+{
+    if (!g_st_seen && stuck_irq != 0xFFFFFFFFu) // DOS-PORT (patch 0345)
+    {
+        g_st_seen = true;
+        g_st_song_ms = stuck_song_ms;
+        g_st_loop = loop_tick;
+        g_st_irq = stuck_irq;
+        g_st_prev = stuck_prev;
+    }
+    if (!g_lt_seen && late_irq != 0xFFFFFFFFu)
+    {
+        g_lt_seen = true;
+        g_lt_song_ms = late_song_ms;
+        g_lt_loop = loop_tick;
+        g_lt_irq = late_irq;
+    }
+}
+
 void dos_midi_backend_note_plan_behind(uint32_t song_ms, uint32_t loop_tick, uint32_t gap_irqs, bool first_plan)
 {
     g_plan_behind++;
@@ -507,10 +533,22 @@ void dos_midi_backend_status_fragment(char *buf, size_t bufsize)
             Uint32 sw[5] = {0, 0, 0, 0, 0};
             Uint8 ss[8] = {0, 0, 0, 0, 0, 0, 0, 0};
             SDL_DOSMidiDeferRtcStuckWitness(sw, ss);
+            // DOS-PORT (patch 0345): second register-C reads that found a flag (SDL 0265); 'off' when disabled.
+            bool rd_on = false;
+            const Uint32 rd = SDL_DOSMidiDeferRtcRedrains(&rd_on);
+            char st_at[56] = "";
+            if (g_st_seen)
+                std::snprintf(st_at, sizeof(st_at), "%u@%u/%u/%u", (unsigned)g_st_song_ms, (unsigned)g_st_loop,
+                    (unsigned)g_st_irq, (unsigned)g_st_prev);
+            char rd_s[16];
+            if (rd_on)
+                std::snprintf(rd_s, sizeof(rd_s), "%u", (unsigned)rd);
+            else
+                std::snprintf(rd_s, sizeof(rd_s), "off");
             std::snprintf(rtc, sizeof(rtc), ",rtc_hz=%u,gap_us=%u,rtc_ticks=%u,bios_waits=%u,lat_max_us=%u,rs=%s,rs_skipped=%u,"
-                "rearm=%u/%u/%u/%u,stuckw=%u/%u/%u/%u/%u,stucksnap=%02x%02x%02x%02x%02x%02x%02x%02x",
+                "rearm=%u/%u/%u/%u,c_redrain=%s,stuck_at=%s,stuckw=%u/%u/%u/%u/%u,stucksnap=%02x%02x%02x%02x%02x%02x%02x%02x",
                 (unsigned)hz, (unsigned)gap, (unsigned)ticks, (unsigned)waits, (unsigned)lat, rs_on ? "on" : "off",
-                (unsigned)rs_skipped, (unsigned)rp, (unsigned)rr, (unsigned)rm, (unsigned)rst,
+                (unsigned)rs_skipped, (unsigned)rp, (unsigned)rr, (unsigned)rm, (unsigned)rst, rd_s, st_at,
                 (unsigned)sw[0], (unsigned)sw[1], (unsigned)sw[2], (unsigned)sw[3], (unsigned)sw[4],
                 (unsigned)ss[0], (unsigned)ss[1], (unsigned)ss[2], (unsigned)ss[3], (unsigned)ss[4],
                 (unsigned)ss[5], (unsigned)ss[6], (unsigned)ss[7]);
@@ -532,18 +570,21 @@ void dos_midi_backend_status_fragment(char *buf, size_t bufsize)
         SDL_DOSOplPaceStats(&pk, &pwin, &pw_n, &pw_us, &pw_max, &peak, &povr);
         // DOS-PORT (patch 0275): plan_behind_at=<song_ms>@<loop>/<gap>irq/<first|later>, empty when no event.
         char pb_at[48] = "";
+        char lt_at[48] = ""; // DOS-PORT (patch 0345): late_at=<song_ms>@<loop>/<irq>, empty when none
+        if (g_lt_seen)
+            std::snprintf(lt_at, sizeof(lt_at), "%u@%u/%u", (unsigned)g_lt_song_ms, (unsigned)g_lt_loop, (unsigned)g_lt_irq);
         if (g_pb_seen)
             std::snprintf(pb_at, sizeof(pb_at), "%u@%u/%uirq/%s", (unsigned)g_pb_song_ms, (unsigned)g_pb_loop,
                 (unsigned)g_pb_gap_irqs, g_pb_first ? "first" : "later");
         std::snprintf(buf, bufsize, "midi=%s,events=%llu%s,midi_tick=%s,period_us=%u,lookahead=%u,isr_writes=%u,"
             "late_writes=%u,late_max_ms=%u,isr_burst=%u,qfull=%u,qsync=%u,qdropped=%u,plan_behind=%u,plan_behind_at=%s,"
-            "clk=%llu/%ds,real_period_us=%u,clk_uc=%lld/%lld,"
+            "late_at=%s,clk=%llu/%ds,real_period_us=%u,clk_uc=%lld/%lld,"
             "budget=%u,cap_hits=%u,isr_max_us=%u,isr_mean_us=%u,isr_ns_per_write=%u,"
             "dedupe=%u,skipped=%u,pgdetect=%u,opl_reads=%u,pace=%u/%u,pwait=%u/%u/%u,peak=%u/%u%s",
             kind_name(g_last_kind), (unsigned long long)g_events_dispatched, chip, g_defer_kind == 3 ? "rtc" : "isr",
             g_tick_period_us, g_tick_lookahead,
             (unsigned)wr, (unsigned)late, (unsigned)((uint64_t)late_max * g_tick_period_us / 1000u), (unsigned)burst,
-            (unsigned)full, (unsigned)sync, (unsigned)dropped, g_plan_behind, pb_at, (unsigned long long)g_song_ms, rtc_s,
+            (unsigned)full, (unsigned)sync, (unsigned)dropped, g_plan_behind, pb_at, lt_at, (unsigned long long)g_song_ms, rtc_s,
             (unsigned)g_real_period_us, (long long)(g_uc_last_song_ms - g_uc_first_song_ms),
             (long long)(g_uc_last_ms - g_uc_first_ms),
             (unsigned)budget, (unsigned)cap_hits, isr_max_us, isr_mean_us, isr_ns_per_write,
diff --git a/Engine/platform/dos/dos_midi_backend.h b/Engine/platform/dos/dos_midi_backend.h

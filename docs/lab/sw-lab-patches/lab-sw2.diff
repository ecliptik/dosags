+#if defined(__DJGPP__) && !defined(DOSAGS_RELEASE)
+// ---- LAB-SW (lab only, never a patch): restart-point save write counters and trace ----
+#include <stdio.h>
+#include <string.h>
+#include <time.h>
+#include <dpmi.h>
+#include "util/dos_sw_lab.h"
+extern "C" {
+volatile int dos_sw_active = 0;
+static int dos_sw_mode = -1;
+struct DosSwRec { char k; unsigned char ah, al, cf; long a, b, c, d; unsigned long t, dt; };
+struct DosSwRun { long long pos; long long len; long calls; };
+#define DOS_SW_MAX 4096
+#define DOS_SW_RUNS 4096
+static DosSwRec dos_sw_rec[DOS_SW_MAX];
+static DosSwRun dos_sw_run[DOS_SW_RUNS];
+static int dos_sw_n = 0, dos_sw_nrun = 0;
+static long dos_sw_lost = 0, dos_sw_runlost = 0;
+static uclock_t dos_sw_t0 = 0, dos_sw_t1 = 0;
+static long dos_sw_bs_n = 0; static long long dos_sw_bs_bytes = 0; static long dos_sw_bs_hist[24];
+static long dos_sw_i21_n[256]; static unsigned long long dos_sw_i21_t[256];
+static long dos_sw_fw_n = 0; static unsigned long long dos_sw_fw_t = 0; static long long dos_sw_fw_bytes = 0;
+static long dos_sw_fs_n = 0; static unsigned long long dos_sw_fs_t = 0;
+static unsigned long long dos_sw_open_t = 0, dos_sw_close_t = 0;
+static int dos_sw_in = 0;
+int dos_sw_mode_get(void)
+{
+    if (dos_sw_mode < 0)
+    {
+        const char *e = getenv("DOSAGS_SW");
+        dos_sw_mode = (e && e[0] >= '1' && e[0] <= '9') ? (e[0] - '0') : 0;
+    }
+    return dos_sw_mode;
+}
+static DosSwRec *dos_sw_new(char k)
+{
+    if (dos_sw_n >= DOS_SW_MAX) { dos_sw_lost++; return nullptr; }
+    DosSwRec *r = &dos_sw_rec[dos_sw_n++];
+    memset(r, 0, sizeof(*r)); r->k = k; return r;
+}
+void dos_sw_begin(void)
+{
+    dos_sw_n = dos_sw_nrun = 0; dos_sw_lost = dos_sw_runlost = 0;
+    dos_sw_bs_n = 0; dos_sw_bs_bytes = 0; memset(dos_sw_bs_hist, 0, sizeof(dos_sw_bs_hist));
+    memset(dos_sw_i21_n, 0, sizeof(dos_sw_i21_n)); memset(dos_sw_i21_t, 0, sizeof(dos_sw_i21_t));
+    dos_sw_fw_n = 0; dos_sw_fw_t = 0; dos_sw_fw_bytes = 0; dos_sw_fs_n = 0; dos_sw_fs_t = 0;
+    dos_sw_open_t = dos_sw_close_t = 0;
+    dos_sw_t0 = uclock();
+    dos_sw_active = 1;
+}
+void dos_sw_end(void) { dos_sw_active = 0; dos_sw_t1 = uclock(); }
+void dos_sw_bs_write(long long pos, size_t size)
+{
+    dos_sw_bs_n++; dos_sw_bs_bytes += (long long)size;
+    int b;
+    if (size <= 16) b = (int)size; else if (size <= 64) b = 17; else if (size <= 256) b = 18; else if (size <= 1024) b = 19;
+    else if (size <= 4096) b = 20; else if (size < 8192) b = 21; else b = 22;
+    dos_sw_bs_hist[b]++;
+    if (dos_sw_nrun > 0 && dos_sw_run[dos_sw_nrun - 1].pos + dos_sw_run[dos_sw_nrun - 1].len == pos)
+    { dos_sw_run[dos_sw_nrun - 1].len += (long long)size; dos_sw_run[dos_sw_nrun - 1].calls++; return; }
+    if (dos_sw_nrun >= DOS_SW_RUNS) { dos_sw_runlost++; return; }
+    dos_sw_run[dos_sw_nrun].pos = pos; dos_sw_run[dos_sw_nrun].len = (long long)size; dos_sw_run[dos_sw_nrun].calls = 1; dos_sw_nrun++;
+}
+void dos_sw_bs_flush(long long bufpos, size_t size, long long topos)
+{
+    DosSwRec *r = dos_sw_new('B'); if (!r) return;
+    r->a = (long)bufpos; r->b = (long)size; r->c = (long)topos; r->t = (unsigned long)(uclock() - dos_sw_t0);
+}
+void dos_sw_fs_event(char kind, long a, long b, unsigned long long dt)
+{
+    if (kind == 'W') { dos_sw_fw_n++; dos_sw_fw_t += dt; dos_sw_fw_bytes += a; }
+    else if (kind == 'S') { dos_sw_fs_n++; dos_sw_fs_t += dt; }
+    else if (kind == 'O') dos_sw_open_t += dt;
+    else if (kind == 'C') dos_sw_close_t += dt;
+    DosSwRec *r = dos_sw_new(kind); if (!r) return;
+    r->a = a; r->b = b; r->dt = (unsigned long)dt; r->t = (unsigned long)(uclock() - dos_sw_t0);
+}
+int __real___dpmi_int(int vector, __dpmi_regs *regs);
+int __wrap___dpmi_int(int vector, __dpmi_regs *regs)
+{
+    if (!dos_sw_active || vector != 0x21 || dos_sw_in)
+        return __real___dpmi_int(vector, regs);
+    dos_sw_in = 1;
+    const unsigned char ah = regs->h.ah, al = regs->h.al;
+    const unsigned short bx = regs->x.bx, cx = regs->x.cx, dx = regs->x.dx;
+    const uclock_t t = uclock();
+    const int ret = __real___dpmi_int(vector, regs);
+    const uclock_t dt = uclock() - t;
+    dos_sw_i21_n[ah]++; dos_sw_i21_t[ah] += (unsigned long long)dt;
+    DosSwRec *r = dos_sw_new('D');
+    if (r)
+    {
+        r->ah = ah; r->al = al; r->cf = (unsigned char)(regs->x.flags & 1);
+        r->a = bx; r->b = cx; r->c = dx; r->d = (long)(((unsigned long)regs->x.dx << 16) | regs->x.ax);
+        r->t = (unsigned long)(t - dos_sw_t0); r->dt = (unsigned long)dt;
+    }
+    dos_sw_in = 0;
+    return ret;
+}
+static double dos_sw_ms(unsigned long long u) { return (double)u * 1000.0 / (double)UCLOCKS_PER_SEC; }
+void dos_sw_dump(const char *path, long savegame_ms, const char *extra)
+{
+    FILE *f = fopen(path, "w");
+    if (!f) return;
+    unsigned long long i21t = 0; long i21n = 0;
+    for (int i = 0; i < 256; i++) { i21n += dos_sw_i21_n[i]; i21t += dos_sw_i21_t[i]; }
+    fprintf(f, "swlab v1 savegame_ms=%ld bracket_ms=%.3f recs=%d lost=%ld runs=%d runlost=%ld\n", savegame_ms,
+        dos_sw_ms(dos_sw_t1 - dos_sw_t0), dos_sw_n, dos_sw_lost, dos_sw_nrun, dos_sw_runlost);
+    fprintf(f, "bs_writes=%ld bs_bytes=%lld\n", dos_sw_bs_n, dos_sw_bs_bytes);
+    fprintf(f, "bs_hist");
+    for (int i = 1; i < 23; i++) fprintf(f, " %d:%ld", i, dos_sw_bs_hist[i]);
+    fprintf(f, "  (17=17-64 18=65-256 19=257-1K 20=1K-4K 21=4K-8K 22=>=8K)\n");
+    fprintf(f, "fwrite_n=%ld fwrite_bytes=%lld fwrite_ms=%.3f fseek_n=%ld fseek_ms=%.3f open_ms=%.3f close_ms=%.3f\n",
+        dos_sw_fw_n, dos_sw_fw_bytes, dos_sw_ms(dos_sw_fw_t), dos_sw_fs_n, dos_sw_ms(dos_sw_fs_t),
+        dos_sw_ms(dos_sw_open_t), dos_sw_ms(dos_sw_close_t));
+    fprintf(f, "int21_n=%ld int21_ms=%.3f\n", i21n, dos_sw_ms(i21t));
+    for (int i = 0; i < 256; i++)
+        if (dos_sw_i21_n[i]) fprintf(f, "int21 ah=%02X n=%ld ms=%.3f\n", i, dos_sw_i21_n[i], dos_sw_ms(dos_sw_i21_t[i]));
+    if (extra) fprintf(f, "%s\n", extra);
+    fprintf(f, "# k t_us dt_us ...\n");
+    for (int i = 0; i < dos_sw_n; i++)
+    {
+        const DosSwRec &r = dos_sw_rec[i];
+        const double tu = dos_sw_ms(r.t) * 1000.0, du = dos_sw_ms(r.dt) * 1000.0;
+        if (r.k == 'D')
+            fprintf(f, "D %.0f %.1f ah=%02X al=%02X bx=%ld cx=%ld dx=%ld cf=%d out=%lu\n", tu, du, r.ah, r.al, r.a, r.b, r.c, r.cf,
+                (unsigned long)r.d);
+        else if (r.k == 'B')
+            fprintf(f, "B %.0f 0 bufpos=%ld size=%ld topos=%ld\n", tu, r.a, r.b, r.c);
+        else
+            fprintf(f, "%c %.0f %.1f a=%ld b=%ld\n", r.k, tu, du, r.a, r.b);
+    }
+    fprintf(f, "# runs pos len calls\n");
+    for (int i = 0; i < dos_sw_nrun; i++)
+        fprintf(f, "L %lld %lld %ld\n", dos_sw_run[i].pos, dos_sw_run[i].len, dos_sw_run[i].calls);
+    fclose(f);
+}
+} // extern "C"
+#endif
 

+
+// DOS-PORT patch 0216: the decoded-PCM cache. The sound cache (sound.cpp) keeps a clip's FILE BYTES,
+// so every play of a clip -- a looping ambient, a footstep, a repeating chime -- decoded, resampled and
+// converted it again on the main thread (room 35: one ~14 ms decode every ~0.85 s, 107 of them in
+// ~90 s; LAB-JOURNEYS 9b.2). This keeps the result.
+//
+// Key: the sound cache's byte buffer itself. Every play of a cached clip is handed the SAME
+// shared_ptr, so an entry remembers that buffer by a weak reference: a hit needs the buffer to be
+// alive and to be that buffer (two live buffers cannot share an address), so an entry can never
+// answer for different bytes, and it lapses when the sound cache drops the bytes. No asset names are
+// plumbed through. A clip that is streamed (too big to load at once) has no such buffer and is never
+// cached. Held: the device-format samples, shared and immutable -- the cache and every decoder
+// playing the clip point at one copy. Bounded: least-recently-used entries are evicted to stay under
+// DOSAGS_PCM_CACHE_KB (default 2048, as the sound cache; 0 turns the cache off); a clip bigger than
+// the cap is not cached. DOSAGS_PCM_CACHE_VERIFY=1 decodes every hit afresh as well and counts any
+// difference (a witness setting: it spends what the cache saves). Main thread only, as Open() is.
+struct PcmCacheEntry
+{
+    std::weak_ptr<std::vector<uint8_t>> src;
+    const std::vector<uint8_t> *src_addr = nullptr;
+    std::shared_ptr<const DosDecodedPcm> pcm;
+    uint32_t last_use = 0u;
+};
+std::vector<PcmCacheEntry> g_pcm_cache;
+size_t g_pcm_cache_bytes = 0u, g_pcm_cache_peak = 0u;
+uint32_t g_pcm_cache_clock = 0u;
+unsigned long g_pcm_hits = 0u, g_pcm_misses = 0u, g_pcm_evictions = 0u, g_pcm_uncacheable = 0u,
+    g_pcm_lapsed = 0u, g_pcm_verified = 0u, g_pcm_verify_mismatches = 0u;
+
+size_t pcm_cache_cap()
+{
+    static long cap_kb = -1;
+    if (cap_kb < 0)
+    {
+        const char *e = SDL_getenv("DOSAGS_PCM_CACHE_KB");
+        cap_kb = (e && *e) ? SDL_atoi(e) : 2048;
+        if (cap_kb < 0)
+            cap_kb = 0;
+    }
+    return static_cast<size_t>(cap_kb) * 1024u;
+}
+
+bool pcm_cache_verify()
+{
+    static int verify = -1;
+    if (verify < 0)
+    {
+        const char *e = SDL_getenv("DOSAGS_PCM_CACHE_VERIFY");
+        verify = (e && e[0] == '1' && e[1] == 0) ? 1 : 0;
+    }
+    return verify == 1;
+}
+
+void pcm_cache_drop(size_t k)
+{
+    g_pcm_cache_bytes -= g_pcm_cache[k].pcm->device.size();
+    g_pcm_cache.erase(g_pcm_cache.begin() + k);
+}
+
+std::shared_ptr<const DosDecodedPcm> pcm_cache_find(const std::shared_ptr<std::vector<uint8_t>> &src,
+    SDL_AudioFormat fmt)
+{
+    for (size_t k = 0; k < g_pcm_cache.size();)
+    {
+        PcmCacheEntry &e = g_pcm_cache[k];
+        if (e.src.expired())
+        {
+            pcm_cache_drop(k); // the sound cache let the bytes go; so do we
+            g_pcm_lapsed++;
+            continue;
+        }
+        if (e.src_addr == src.get() && e.pcm->fmt == fmt && e.src.lock() == src)
+        {
+            e.last_use = ++g_pcm_cache_clock;
+            return e.pcm;
+        }
+        k++;
+    }
+    return nullptr;
+}
+
+void pcm_cache_put(const std::shared_ptr<std::vector<uint8_t>> &src, const std::shared_ptr<const DosDecodedPcm> &pcm)
+{
+    const size_t cap = pcm_cache_cap();
+    const size_t sz = pcm->device.size();
+    if (sz == 0u || sz > cap)
+    {
+        g_pcm_uncacheable++;
+        return;
+    }
+    while (g_pcm_cache_bytes + sz > cap && !g_pcm_cache.empty())
+    {
+        size_t lru = 0;
+        for (size_t k = 1; k < g_pcm_cache.size(); k++)
+            if (g_pcm_cache[k].last_use < g_pcm_cache[lru].last_use)
+                lru = k;
+        pcm_cache_drop(lru);
+        g_pcm_evictions++;
+    }
+    PcmCacheEntry e;
+    e.src = src;
+    e.src_addr = src.get();
+    e.pcm = pcm;
+    e.last_use = ++g_pcm_cache_clock;
+    g_pcm_cache.push_back(e);
+    g_pcm_cache_bytes += sz;
+    if (g_pcm_cache_bytes > g_pcm_cache_peak)
+        g_pcm_cache_peak = g_pcm_cache_bytes;
+}
+
+// Decodes a whole clip into a new DosDecodedPcm in the given device format; nullptr if it is not a
+// clip dos_audio_decode_pcm() understands.
+std::shared_ptr<const DosDecodedPcm> decode_clip(const uint8_t *src, size_t src_size, SDL_AudioFormat fmt)
+{
+    std::vector<int16_t> pcm16;
+    if (!dos_audio_decode_pcm(src, src_size, pcm16))
+        return nullptr;
+    std::shared_ptr<DosDecodedPcm> dec = std::make_shared<DosDecodedPcm>();
+    // DOS-PORT (S5 GUS, "Correction #1"): convert to the ACTIVE device
+    // format ONCE here, not per-chunk in GetData() -- see this file's own
+    // convert_to_device_format() comment.
+    convert_to_device_format(pcm16, fmt, dec->device);
+    dec->samples = pcm16.size();
+    dec->fmt = fmt;
+    return dec;
+}
 } // namespace
 
+void dos_pcm_cache_report(FILE *log)
+{
+    std::fprintf(log, "DOS-PORT pcmcache hits=%lu misses=%lu evictions=%lu uncacheable=%lu lapsed=%lu"
+        " entries=%lu bytes=%lu peak_bytes=%lu cap_kb=%lu verify=%lu verify_mismatches=%lu\n",
+        g_pcm_hits, g_pcm_misses, g_pcm_evictions, g_pcm_uncacheable, g_pcm_lapsed,
+        (unsigned long)g_pcm_cache.size(), (unsigned long)g_pcm_cache_bytes, (unsigned long)g_pcm_cache_peak,
+        (unsigned long)(pcm_cache_cap() / 1024u), g_pcm_verified, g_pcm_verify_mismatches);
+}
+

+// S7-GUS continuation: same rollup-of-rollups shape as dos_diag_record_
+// gusscan, one per SDL_DOSGus* voice-setup/-teardown function.
+void dos_diag_record_voicefreq(uint32_t calls, uint32_t min_us, uint32_t mean_us, uint32_t max_us)
+{
+    if (calls == 0)
+        return;
+    AudioPollDiag &d = g_audio_poll_diag;
+    d.voicefreq_calls_sum += calls;
+    d.voicefreq_us_sum += (uint64_t)mean_us * calls;
+    if ((uint64_t)min_us < d.voicefreq_min_us) d.voicefreq_min_us = min_us;
+    if ((uint64_t)max_us > d.voicefreq_max_us) d.voicefreq_max_us = max_us;
+}
+
+void dos_diag_record_voicevol(uint32_t calls, uint32_t min_us, uint32_t mean_us, uint32_t max_us)
+{

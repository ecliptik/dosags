+    // exactly 4 bytes here, so the byte-level reinterpret_cast<uint8_t*>
+    // read below (r/g/b/a per entry) is unaffected.
+    unsigned int palette_colors[PAL_SIZE] = { 0 };
     if (use_palette)
     {
         pixels = stbi_load_from_callbacks_with_palette(

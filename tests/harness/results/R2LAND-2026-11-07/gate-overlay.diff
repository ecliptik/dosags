+static int dos_lab_pair(const char *n, int &k, int &a, int defa)
+{
+    if (k < 0) { k = 0; a = defa; const char *e = getenv(n); if (e) { k = atoi(e); const char *c = strchr(e, ':'); if (c) a = atoi(c + 1); } }
+    return k;
+}

@@ -15,6 +15,14 @@
 #include <stdexcept>
 #include "util/stdio_compat.h"
 
+#ifdef __DJGPP__
+// DOS-PORT patch 0230: file bytes read, for the work vector
+// (Engine/main/dos_port_work.h). Defined here, at global scope, because the
+// Common library cannot see the engine; the engine reads them at snapshot time.
+long long dos_port_file_rd_bytes = 0;
+long long dos_port_file_rd_calls = 0;
+#endif
+
 namespace AGS
 {
 namespace Common
@@ -102,12 +110,27 @@ soff_t FileStream::GetPosition() const
 
 size_t FileStream::Read(void *buffer, size_t size)
 {
+#ifdef __DJGPP__
+    const size_t n = fread(buffer, sizeof(uint8_t), size, _file);
+    dos_port_file_rd_bytes += (long long)n;
+    dos_port_file_rd_calls++;
+    return n;
+#else
     return fread(buffer, sizeof(uint8_t), size, _file);
+#endif
 }
 
 int32_t FileStream::ReadByte()
 {
+#ifdef __DJGPP__
+    const int c = fgetc(_file);
+    if (c != EOF)
+        dos_port_file_rd_bytes++;
+    dos_port_file_rd_calls++;
+    return c;
+#else
     return fgetc(_file);
+#endif
 }
 
 size_t FileStream::Write(const void *buffer, size_t size)

     const float ts = 1000.f * static_cast<float>(_readSamples) / static_cast<float>(DOS_AUDIO_MIXER_RATE);
     const float dur = 1000.f * static_cast<float>(take) / static_cast<float>(DOS_AUDIO_MIXER_RATE);
-    // DOS-PORT (S5 GUS, "Correction #1"): slice _pcmDevice (the ACTIVE

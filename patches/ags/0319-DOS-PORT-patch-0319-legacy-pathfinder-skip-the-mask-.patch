 using namespace AGS::Common;
 
+// DOS-PORT patch 0319: walkablearea.cpp's temp mask and its input serial (global scope)
+extern Bitmap *walkable_areas_temp;
+extern unsigned long dos_walktemp_serial;
+
 // #define DEBUG_PATHFINDER
 
 namespace AGS
@@ -179,6 +187,165 @@ static int rp_cache_maxgran = -1;
 // The mask is not written during a request, so the second and later is_route_possible calls of the same request
 // (the nearest-walkable retry) skip the 64 KB compare; FindRouteImpl clears it at the start of every request.
 static const Bitmap *rp_req_mask = nullptr;
+
+// DOS-PORT patch 0319 (DOSAGS_RP_FAST=0 turns both parts off; DOSAGS_RP_VERIFY=1 also runs the old path and counts
+// any disagreement):
+// (A) the cache records walkable_areas_temp's input serial (walkablearea.cpp) when it is built or verified from
+//     that bitmap; a later request whose serial is the same holds the same pixels, so the 64 KB compare is skipped.
+// (B) the flood fill from the source (a 64 KB copy of the normalised mask, then an Allegro scanline fill) only
+//     answers "which pixels are 4-connected to the source"; that is computed once per cache build as component
+//     labels over the normalised mask, and the reachability test and the nearest-walkable sweep read the labels.
+static unsigned long rp_cache_serial = 0;
+// re-cut 2 (2026-09-29): the labels are kept as runs, not a pixel map -- per row, runs (x0, x1, label) in x order;
+// row y's runs are [rp_rowstart[y], rp_rowstart[y + 1]). No 128 KB map to write or zero-fill.
+static std::vector<int16_t> rp_rx0, rp_rx1;
+static std::vector<uint16_t> rp_rlab;
+static std::vector<int> rp_rowstart;
+static int rp_lab_w = 0, rp_lab_h = 0;
+
+// the label of pixel (x, y), 0 if not walkable or outside: a binary search over row y's runs
+static inline uint16_t rp_label_at(int x, int y)
+{
+  if (x < 0 || y < 0 || x >= rp_lab_w || y >= rp_lab_h)
+    return 0;
+  int lo = rp_rowstart[y], hi = rp_rowstart[y + 1] - 1;
+  while (lo <= hi)
+  {
+    const int mid = (lo + hi) >> 1;
+    if (x < rp_rx0[mid]) hi = mid - 1;
+    else if (x > rp_rx1[mid]) lo = mid + 1;
+    else return rp_rlab[mid];
+  }
+  return 0;
+}
+static bool rp_labels_ok = false;
+static unsigned long rp_label_us = 0; // DOS-PORT patch 0319 re-cut: the last label build, us
+static int rp_fast = -1, rp_verify = -1;
+static unsigned long rp_n_serial_hits = 0, rp_n_compares = 0, rp_n_label_answers = 0, rp_n_verified = 0,
+    rp_n_serial_mismatch = 0, rp_n_label_mismatch = 0;
+
+static bool rp_fast_on()
+{
+  if (rp_fast < 0)
+  {
+    const char *e = getenv("DOSAGS_RP_FAST"); rp_fast = (e && e[0] == '0') ? 0 : 1;
+    const char *v = getenv("DOSAGS_RP_VERIFY"); rp_verify = (v && v[0] == '1') ? 1 : 0;
+  }
+  return rp_fast == 1;
+}
+
+// 4-connected components of the value-1 pixels of a normalised mask (every walkable pixel is 1): exactly the set an
+// Allegro floodfill seeded on one of them fills (it spreads left/right along a row and to overlapping runs in the
+// rows above and below, never diagonally). Labels 1..n; 0 = not walkable. False if there are more than 65534.
+static bool rp_build_labels(const Bitmap *norm)
+{
+  // Two passes over the rows' runs (re-cut 2026-09-29: a pixel flood with a stack, a 64K-entry zero-fill and a
+  // divide per pixel cost ~71 ms on the 486 on a 320x200 mask). Pass 1 finds each row's runs of value-1 pixels;
+  // pass 2 unions every run with each run of the row above that shares a column -- 4-connectivity, the flood's rule.
+  // Only the runs and their labels are kept (rp_label_at() searches them).
+  const int W = norm->GetWidth(), H = norm->GetHeight();
+  rp_rx0.clear(); rp_rx1.clear();
+  rp_rowstart.assign(H + 1, 0);
+  for (int y = 0; y < H; ++y)
+  {
+    rp_rowstart[y] = (int)rp_rx0.size();
+    const uint8_t *row = norm->GetScanLine(y);
+    for (int x = 0; x < W;)
+    {
+      if (row[x] != 1) { ++x; continue; }
+      const int x0 = x;
+      while (x < W && row[x] == 1) ++x;
+      rp_rx0.push_back((int16_t)x0); rp_rx1.push_back((int16_t)(x - 1));
+    }
+  }
+  rp_rowstart[H] = (int)rp_rx0.size();
+  std::vector<int> parent(rp_rx0.size());
+  for (size_t i = 0; i < parent.size(); ++i) parent[i] = (int)i;
+  auto find = [&parent](int i) { while (parent[i] != i) { parent[i] = parent[parent[i]]; i = parent[i]; } return i; };
+  for (int y = 1; y < H; ++y)
+  {
+    int j = rp_rowstart[y - 1];
+    const int je = rp_rowstart[y];
+    for (int i = rp_rowstart[y]; i < rp_rowstart[y + 1]; ++i)
+    {
+      while (j < je && rp_rx1[j] < rp_rx0[i]) ++j;                // runs above that end left of this run
+      for (int k = j; k < je && rp_rx0[k] <= rp_rx1[i]; ++k)       // runs above that share a column
+      {
+        const int a = find(i), b = find(k);
+        if (a != b) parent[a > b ? a : b] = a < b ? a : b;
+      }
+    }
+  }
+  // labels 1..n by first appearance of each component (row-major)
+  std::vector<uint16_t> comp(parent.size(), 0);
+  rp_rlab.resize(parent.size());
+  unsigned next = 1;
+  for (size_t i = 0; i < parent.size(); ++i)
+  {
+    const int r = find((int)i);
+    if (comp[r] == 0)
+    {
+      if (next > 65534u)
+        return false;
+      comp[r] = (uint16_t)next++;
+    }
+    rp_rlab[i] = comp[r];
+  }
+  rp_lab_w = W; rp_lab_h = H;
+  return true;
+}
+
+// find_nearest_walkable_area() over the labels: a pixel counts where the flooded copy would read 232, i.e. where its
+// label is the source's. Same clamping, same order, same arithmetic, same suggestx/suggesty.
+static int rp_nearest_label(int fromX, int fromY, int toX, int toY, int destX, int destY, int granularity, uint16_t lab)
+{
+  if (fromX < 0) fromX = 0;
+  if (fromY < 0) fromY = 0;
+  if (toX >= rp_lab_w) toX = rp_lab_w - 1;
+  if (toY >= rp_lab_h) toY = rp_lab_h - 1;
+  int nearest = 99999, nearx = -1, neary = -1;
+  for (int ex = fromX; ex < toX; ex += granularity)
+  {
+    for (int ey = fromY; ey < toY; ey += granularity)
+    {
+      if (rp_label_at(ex, ey) != lab)
+        continue;
+      int thisis = (int)::sqrt((double)((ex - destX) * (ex - destX) + (ey - destY) * (ey - destY)));
+      if (thisis < nearest)
+      {
+        nearest = thisis;
+        nearx = ex;
+        neary = ey;
+      }
+    }
+  }
+  if (nearest < 90000) {
+    suggestx = nearx;
+    suggesty = neary;
+    return 1;
+  }
+  return 0;
+}
+
+// is_route_possible_flood() over the labels (source pixel walkable and inside the mask: checked by the caller)
+static int rp_route_possible_labels(int fromx, int fromy, int tox, int toy, const LegacyRouteFinder::PathfinderConfig &pfc)
+{
+  const uint16_t lab = rp_label_at(fromx, fromy);
+  if (tox >= 0 && toy >= 0 && tox < rp_lab_w && toy < rp_lab_h && rp_label_at(tox, toy) == lab)
+    return 1;
+  int tryFirstX = tox - pfc.ShortSweepRadius, tryToX = tox + pfc.ShortSweepRadius;
+  int tryFirstY = toy - pfc.ShortSweepRadius, tryToY = toy + pfc.ShortSweepRadius;
+  if (!rp_nearest_label(tryFirstX, tryFirstY, tryToX, tryToY, tox, toy, pfc.ShortSweepGranularity, lab))
+    rp_nearest_label(0, 0, rp_lab_w, rp_lab_h, tox, toy, pfc.FullSweepGranularity, lab);
+  return 0;
+}
+
+void dos_rp_report(FILE *log)
+{
+  if (log)
+    fprintf(log, "DOS-PORT rpcache fast=%d serial_hits=%lu compares=%lu label_answers=%lu verified=%lu serial_mismatch=%lu label_mismatch=%lu labels_ok=%d label_us=%lu\n",
+      rp_fast, rp_n_serial_hits, rp_n_compares, rp_n_label_answers, rp_n_verified, rp_n_serial_mismatch, rp_n_label_mismatch, rp_labels_ok ? 1 : 0, rp_label_us);
+}
 static int is_route_possible_flood(Bitmap *tempw, int fromx, int fromy, int tox, int toy, const LegacyRouteFinder::PathfinderConfig &pfc);
 
 static bool rp_cache_matches(const Bitmap *wallscreen, int maxgran)
@@ -220,14 +387,54 @@ static int is_route_possible(const Bitmap *wallscreen, int fromx, int fromy, int
   if (wallscreen->GetPixel(fromx, fromy) < 1)
     return 0;
 
-  if ((rp_req_mask == wallscreen && rp_cache_src != nullptr && rp_cache_maxgran == pfc.MaxGranularity) ||
-      rp_cache_matches(wallscreen, pfc.MaxGranularity))
+  // DOS-PORT patch 0319 (A): the same input serial as the cache was built/verified from is the same pixels
+  const bool fast = rp_fast_on();

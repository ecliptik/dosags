+    const ptrdiff_t di = _stackdataPtr - _stackdataBegin;
+    s_snap_datan = static_cast<size_t>(std::min<ptrdiff_t>(CC_STACK_DATA_SIZE, std::max<ptrdiff_t>(0, di + 8)));
+    DosVmSnapTake(s_snap0, fr);
+}
+
+void ccInstance::DosVmShadowEnd(DosVmFrame &fr, int32_t pc0, int k)
+{
+    const int32_t keep_pc = _pc;
+    DosVmSnapTake(s_snap1, fr);
+    DosVmSnapPut(s_snap0, fr);

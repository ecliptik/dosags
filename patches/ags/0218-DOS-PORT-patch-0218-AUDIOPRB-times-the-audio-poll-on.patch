 Engine/media/audio/audio_core.cpp        | 195 +++++++++++++----------
 Engine/media/audio/audioplayer.cpp       |  18 ++-
 Engine/platform/dos/dos_midi_backend.cpp |   8 +-
 4 files changed, 144 insertions(+), 88 deletions(-)

diff --git a/Engine/main/engine.cpp b/Engine/main/engine.cpp
index fe227ae54..3a4a4c235 100644
--- a/Engine/main/engine.cpp
+++ b/Engine/main/engine.cpp
@@ -396,8 +396,19 @@ void engine_init_keyboard()
     /* do nothing */
 }
 
+#ifdef __DJGPP__
+// DOS-PORT patch 0218: SDL patch 0199's switch for the temporary audio cost timings (AUDIOPRB).
+extern "C" bool SDL_DOSAudioDiagTiming(void);
+#endif
+
 void engine_init_audio()
 {
+#ifdef __DJGPP__
+    // DOS-PORT patch 0218: latch SDL_HINT_DOS_AUDIO_DIAG_TIMING here, on the main thread and before any audio
+    // exists: the OPL register write it gates can later run from the IRQ-0 music pump, where reading a hint
+    // is not safe.
+    (void)SDL_DOSAudioDiagTiming();
+#endif
     if (usetup.AudioEnabled)
     {
         Debug::Printf("Initializing audio");

+++ b/Engine/CMakeLists.txt
@@ -473,6 +473,19 @@ target_sources(engine
     platform/dos/dos_audio_decode.h
     platform/dos/dos_audio_mixer.cpp
     platform/dos/dos_audio_mixer.h
+    platform/dos/dos_midi_backend.cpp
+    platform/dos/dos_midi_backend.h

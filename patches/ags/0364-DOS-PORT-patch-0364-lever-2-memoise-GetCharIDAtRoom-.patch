+// DOS-PORT patch 0364 lever 2: inside the fast VM the scripts ask the same (x, y, hit) several times a tick with
+// nothing that changes characters in between (MMD: 4 calls a tick inside the VM, 3 of them repeats). A small memo
+// keyed by the generation dos_cmemo_gen, which everything that might change what this reads bumps (dos_englev.h);
+// used only when the innermost engine call from the fast VM is on the whitelist (cc_instance_vm.cpp).
+// Restores char_lowest_yp with the result, as the scan sets it.
+struct DosCharMemo { uint32_t gen; int x, y, hit, result, lowest; };
+static DosCharMemo dos_cmemo[4];
+static unsigned dos_cmemo_next = 0;
 int GetCharIDAtRoom(int x, int y, int hit_options)
+{
+    if (dos_englev_on && dos_cmemo_curpure())
+    {
+#ifdef DOSAGS_VMTRACE
+        ++dos_cm_look;
+#endif
+        for (const DosCharMemo &m : dos_cmemo)
+        {
+            if (m.gen == dos_cmemo_gen && m.x == x && m.y == y && m.hit == hit_options)
+            {
+#ifdef DOSAGS_VMTRACE
+                ++dos_cm_hit;
+                if (dos_englev_shadow())
+                {
+                    ++dos_cm_check;
+                    const int r = GetCharIDAtRoomImpl(x, y, hit_options);
+                    if (r != m.result || char_lowest_yp != m.lowest)
+                    {
+                        if (dos_cm_bad < 10)
+                            Debug::Printf("DOS-PORT cmemo MISMATCH x=%d y=%d hit=%d memo=%d/%d scan=%d/%d", x, y, hit_options,
+                                m.result, m.lowest, r, char_lowest_yp);
+                        ++dos_cm_bad;
+                    }
+                }
+#endif
+                char_lowest_yp = m.lowest;
+                return m.result;
+            }
+        }
+        const int r = GetCharIDAtRoomImpl(x, y, hit_options);
+        DosCharMemo &m = dos_cmemo[dos_cmemo_next++ & 3];
+        m.gen = dos_cmemo_gen; m.x = x; m.y = y; m.hit = hit_options; m.result = r; m.lowest = char_lowest_yp;
+        dos_cmemo_live = 1;
+        return r;
+    }
+    return GetCharIDAtRoomImpl(x, y, hit_options);
+}
+
+static int GetCharIDAtRoomImpl(int x, int y, int hit_options)
+#else
+int GetCharIDAtRoom(int x, int y, int hit_options)
+#endif
 {
     const bool only_clickable = (hit_options & kHit_Interactable) != 0;
     int cc,sppic,lowestyp=0,lowestwas=-1;

+#include "platform/platform.h"
+
+#if AGS_PLATFORM_OS_DOS
+
+// *************** DOS DRIVER ***************
+
+#include <sys/vfs.h>
+#include "platform/base/agsplatformdriver.h"
+
+// DOS-PORT: extends AGSPlatformDriver directly, not AGSPlatformXDGUnix --
+// the XDG unix layer (config/save directory search paths following the
+// XDG Base Directory spec) has no DOS equivalent and isn't wanted here;
+// AGSPlatformDriver's own base defaults (every save/config directory
+// resolves to ".") already match this hub's recommended DOS filesystem
+// policy, confirmed while researching PLATFORM-SURFACE.md. The five
+// directory methods are not overridden below for that reason -- they
+// inherit those "." defaults as-is.
+struct AGSDOS : AGSPlatformDriver {
+    uint64_t GetDiskFreeSpaceMB(const AGS::Common::String &path) override;
+    eScriptSystemOSID GetSystemOSID() override;
+    int  InitializeCDPlayer() override;
+    int  CDPlayerCommand(int cmdd, int datt) override;
+    void ShutdownCDPlayer() override;
+};
+
+uint64_t AGSDOS::GetDiskFreeSpaceMB(const AGS::Common::String &path) {
+    // DOS-PORT: DJGPP's statfs() (confirmed present and linkable by
+    // tests/probes/djgpp-runtime/) reports free space in f_bsize-sized
+    // blocks (both plain `long` under DJGPP's own <sys/vfs.h>) -- runtime
+    // correctness under DOSBox-X not yet verified (PATCH-SEQUENCE.md's
+    // own open item), only that this compiles and links.
+    struct statfs fs;
+    if (statfs(path.GetCStr(), &fs) != 0)
+        return 0;
+    return (static_cast<uint64_t>(fs.f_bsize) * static_cast<uint64_t>(fs.f_bfree)) / (1024 * 1024);
+}
+
+eScriptSystemOSID AGSDOS::GetSystemOSID() {
+    return eOS_DOS;
+}
+
+// DOS-PORT: no CD-audio support on this backend -- matches patch 0007's
+// own CMake-level Cda::Cda gate (never linked for DOS in the first
+// place), consistent "no CD, always fail" stub, same shape as every
+// other platform driver's CD stub where CD support isn't wired up.
+int AGSDOS::InitializeCDPlayer() {
+    return -1;
+}
+
+int AGSDOS::CDPlayerCommand(int /*cmdd*/, int /*datt*/) {
+    return -1;
+}
+
+void AGSDOS::ShutdownCDPlayer() {
+}
+
+AGSPlatformDriver *AGSPlatformDriver::CreateDriver()
+{
+    return new AGSDOS();
+}
+
+#endif // AGS_PLATFORM_OS_DOS

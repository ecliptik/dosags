@@ -450,7 +454,21 @@ RunScFuncResult RunScriptFunction(ccInstance *sci, const String &tsname, size_t
         return res;
     }
 
+    // DOS-PORT patch 0079: bracket the actual VM bytecode call, not the
+    // whole RunScriptFunction wrapper -- PrepareTextScript()'s own
+    // "does this instance even have this function" lookup above returns
+    // early (kScFnRes_NotFound) for the overwhelming majority of calls
+    // (every module without the requested callback is tried and skipped
+    // every tick), and counting that fast-fail lookup as "script VM
+    // execution" would swamp the real number with near-zero-cost misses.
+#ifdef __DJGPP__
+    const uclock_t _dos_port_script_vm_t0 = uclock();
+#endif
     const ccInstError inst_ret = curscript->Inst->CallScriptFunction(tsname, numParam, params);
+#ifdef __DJGPP__
+    dos_port_tick_record(dos_port_tick_timing.script_vm,

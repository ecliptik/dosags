+#ifdef __DJGPP__
+// LAB-PLAY (lab worktree only, not a port patch): DOSAGS_LABCLICKS=lc:x:y[,lc:x:y...] clicks the left button at
+// game point (x, y) when the loop counter first reaches lc, through the same calls as patch 0247. Lets an in-play
+// fixture walk MMD's kids by pointing into the room view instead of 0247's fixed sweep (which lands in the verb bar).
+static int dos_lc_mode = -1, dos_lc_n = 0, dos_lc_next = 0;
+static long dos_lc_t[64]; static int dos_lc_x[64], dos_lc_y[64], dos_lc_b[64];
+long dos_lab_camchg = 0, dos_lab_vpchg = 0, dos_lab_invall = 0, dos_lab_invcam = 0, dos_lab_camx_moves = 0;
+static int dos_sd_mode = -1, dos_sd_n = 0; static long dos_sd_t[32];
+int dos_lab_sprdump_now()
+{
+    if (dos_sd_mode < 0)
+    {
+        dos_sd_mode = 0;
+        const char *e = getenv("DOSAGS_LAB_SPRDUMP");
+        while (e && *e && dos_sd_n < 32)
+        {
+            long t; int used = 0;
+            if (sscanf(e, "%ld%n", &t, &used) != 1) break;
+            dos_sd_t[dos_sd_n++] = t; e += used; if (*e == ',') e++;
+        }
+        dos_sd_mode = dos_sd_n > 0;
+    }
+    if (!dos_sd_mode) return 0;
+    const long lc = (long)get_loop_counter();
+    for (int i = 0; i < dos_sd_n; ++i) if (dos_sd_t[i] == lc) return 1;
+    return 0;
+}
+static int dos_ck_mode = -1, dos_ck_n = 0, dos_ck_next = 0; static long dos_ck_t[64];
+#ifndef DOSAGS_RELEASE
+extern void dos_lab_checkpoint(long lc);
+#else
+static void dos_lab_checkpoint(long) {}   // LAB-PLAY: the release flavour has no phase totals to dump
+#endif
+static void dos_lab_ckpt()
+{
+    if (dos_ck_mode < 0)
+    {
+        dos_ck_mode = 0;
+        const char *e = getenv("DOSAGS_LAB_CKPT");
+        while (e && *e && dos_ck_n < 64)
+        {
+            long t; int used = 0;
+            if (sscanf(e, "%ld%n", &t, &used) != 1) break;
+            dos_ck_t[dos_ck_n++] = t; e += used; if (*e == ',') e++;
+        }
+        dos_ck_mode = dos_ck_n > 0;
+    }
+    if (!dos_ck_mode || dos_ck_next >= dos_ck_n) return;
+    const long lc = (long)get_loop_counter();
+    while (dos_ck_next < dos_ck_n && lc >= dos_ck_t[dos_ck_next])
+    {
+        const uclock_t _t0 = uclock();
+        dos_lab_checkpoint(lc); dos_ck_next++;
+        Debug::Printf("DOS-PORT labck lc=%ld self_us=%lld", lc, (long long)dos_port_tick_elapsed_us(_t0));
+    }
+}
+static void dos_lab_clicks()
+{
+    if (dos_lc_mode < 0)
+    {
+        dos_lc_mode = 0;
+        const char *e = getenv("DOSAGS_LABCLICKS");
+        while (e && *e && dos_lc_n < 64)
+        {
+            long t; int x, y, used = 0, b = 1, used2 = 0;
+            if (sscanf(e, "%ld:%d:%d%n", &t, &x, &y, &used) != 3) break;
+            e += used;
+            if (*e == ':' && sscanf(e, ":%d%n", &b, &used2) == 1) e += used2;   // 4th field: 1 click (default), 0 move only
+            dos_lc_t[dos_lc_n] = t; dos_lc_x[dos_lc_n] = x; dos_lc_y[dos_lc_n] = y; dos_lc_b[dos_lc_n] = b; dos_lc_n++;
+            if (*e == ',') e++;
+        }
+        if (dos_lc_n > 0) { dos_lc_mode = 1; Debug::Printf("DOS-PORT labclicks n=%d", dos_lc_n); }
+    }
+    if (dos_lc_mode != 1 || dos_lc_next >= dos_lc_n)
+        return;
+    const long lc = (long)get_loop_counter();
+    if (lc < dos_lc_t[dos_lc_next])
+        return;

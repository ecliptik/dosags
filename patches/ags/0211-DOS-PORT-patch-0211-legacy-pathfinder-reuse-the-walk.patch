+    return is_route_possible_flood(tempw, fromx, fromy, tox, toy, pfc);
+  }
+
   Bitmap *tempw = BitmapHelper::CreateBitmapCopy(wallscreen, 8);
   if (tempw == nullptr)
     quit("no memory for route calculation");
@@ -237,6 +295,27 @@ static int is_route_possible(const Bitmap *wallscreen, int fromx, int fromy, int
   }
   walk_area_granularity[0] = pfc.MaxGranularity;
 
+  // DOS-PORT patch 0211: keep the analysis for the next call on the same mask
+  delete rp_cache_src;
+  delete rp_cache_norm;
+  rp_cache_src = BitmapHelper::CreateBitmapCopy(wallscreen, 8);
+  rp_cache_norm = BitmapHelper::CreateBitmapCopy(tempw, 8);
+  if (rp_cache_src == nullptr || rp_cache_norm == nullptr)
+  {
+    delete rp_cache_src; rp_cache_src = nullptr;
+    delete rp_cache_norm; rp_cache_norm = nullptr;
+  }
+  memcpy(rp_cache_gran, walk_area_granularity, sizeof(rp_cache_gran));
+  rp_cache_maxgran = pfc.MaxGranularity;
+
+  return is_route_possible_flood(tempw, fromx, fromy, tox, toy, pfc);
+}

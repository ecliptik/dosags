new file mode 100644
index 000000000..fb4432339
--- /dev/null
+++ b/Engine/platform/dos/dos_audio_mixer.h
@@ -0,0 +1,105 @@
+//=============================================================================
+//
+// Adventure Game Studio (AGS)
+//
+// Copyright (C) 1999-2011 Chris Jones and 2011-2026 various contributors
+// The full list of copyright holders can be found in the Copyright.txt
+// file, which is part of this source code distribution.
+//
+// The AGS source code is provided under the Artistic License 2.0.
+// A copy of this license can be found in the file License.txt and at
+// https://opensource.org/license/artistic-2-0/
+//
+//=============================================================================
+//
+// DOS-PORT (Sound milestone, S1): a small fixed-voice PCM mixer feeding one
+// SDL3 audio stream at Tier-2 (11025 Hz mono). Replaces mojoAL for DOS --
+// see PLAN.md's "Sound milestone plan" Architecture section ("Replace,
+// don't port"). Each DOS OpenAlSource acquires one voice from this mixer
+// instead of a real OpenAL source; sdldecoder.cpp's DOS implementation
+// converts every clip to this exact format ONCE at load (dossage's own
+// 0039 lesson -- converting per-chunk cost 43% of every frame), so PutData()
+// is a plain byte copy into a voice ring and the mixdown itself is
+// add-and-clip, no per-chunk resampling.
+//
+//=============================================================================
+#ifndef __AGS_EE_PLATFORM_DOS__DOS_AUDIO_MIXER_H
+#define __AGS_EE_PLATFORM_DOS__DOS_AUDIO_MIXER_H
+#include <cstddef>
+#include <SDL3/SDL.h>
+
+// Tier-2 device format: 11025 Hz mono, signed 16-bit -- doskutsu/dossage's
+// own established default (PLAN.md's "What the shared layer provides,
+// and what it measured"). Not hint-overridable yet in S1: the golden-
+// reference in-profile workload this milestone targets is Tier-2 only:
+// wiring SDL_HINT_DOS_AUDIO_TIER2-equivalent selection is left for when a
+// game actually needs a different tier.
+#define DOS_AUDIO_MIXER_RATE     11025
+#define DOS_AUDIO_MIXER_CHANNELS 1
+#define DOS_AUDIO_MIXER_FORMAT   SDL_AUDIO_S16
+
+// Voice budget: 3 reserved (speech/ambient/music, matching AGS's own
+// SCHAN_SPEECH/SCHAN_AMBIENT/SCHAN_MUSIC reservation in audiodefines.h)
+// + 5 normal, per PLAN.md's Architecture section.
+#define DOS_AUDIO_MIXER_MAX_VOICES 8
+
+// Opens the SDL3 audio device/stream at the Tier-2 format via
+// SDL_OpenAudioDeviceStream(), after requesting the DOS SB PCM backend
+// open at the same frame rate (SDL_DOSAudioSetDeviceFrameRate) so no
+// logical->physical resampler gets inserted. Idempotent: returns true
+// immediately if already open. Returns false on failure (caller, i.e.
+// sys_audio_init(), is expected to fall back to AudioEnabled=false, the
+// same already-handled path this port used before this milestone).
+bool dos_audio_mixer_init();
+
+// Closes the audio stream/device and releases all voices. Safe to call
+// even if never successfully opened.
+void dos_audio_mixer_shutdown();
+
+// Tells if the mixer currently has an open device/stream.
+bool dos_audio_mixer_is_open();
+
+// Acquires one free voice slot for a new OpenAlSource. Returns a voice
+// id in [0, DOS_AUDIO_MIXER_MAX_VOICES) or -1 if every voice is in use
+// (caller then plays back silently -- the same "gracefully do nothing"
+// contract patch 0023's stub already established for a missing device).
+int dos_audio_mixer_voice_acquire();
+// Releases a voice acquired above (called from OpenAlSource's dtor).
+void dos_audio_mixer_voice_release(int voice);
+
+// Appends already-Tier2-format PCM bytes into the given voice's ring.
+// Returns the number of bytes actually accepted (0 if voice < 0, the
+// device isn't open, or the ring has no room -- matching OpenAlSource's
+// existing "0 means try again later" PutData() contract).
+size_t dos_audio_mixer_voice_write(int voice, const void *data, size_t bytes);
+// Bytes still buffered (not yet mixed out) for the given voice.
+size_t dos_audio_mixer_voice_queued(int voice);
+// Marks the voice active (mixed into the output) or inactive (silent,
+// ring left untouched so a Pause() can Resume() without losing data).
+void dos_audio_mixer_voice_set_active(int voice, bool active);
+// Drops all buffered data and marks the voice inactive (Stop()).
+void dos_audio_mixer_voice_stop(int voice);
+// Sets per-voice linear gain (0.0 - 1.0); applied at mixdown.
+void dos_audio_mixer_voice_set_volume(int voice, float volume);
+
+// Mixes every active voice's pending PCM into the shared SDL3 stream (a
+// target-depth top-up, not run-to-cap, per the hub's docs/audio.md
+// convention) and services the DOS SB ring via SDL_DOSAudioPump(). Call
+// once per audio_core_entry_poll() cycle -- see audio_core.cpp -- which
+// is itself already reached from both WaitForNextFrame() and (this
+// milestone's own fix) update_polled_stuff(), so the fast-forward path
+// gets serviced too.
+void dos_audio_mixer_pump();
+
+// Cumulative count of pump cycles where at least one ACTIVE voice had
+// no data to mix (a real underrun, not merely an idle mixer with zero
+// active voices) -- the audio_vital_status "underruns=" field.
+int dos_audio_mixer_underrun_count();
+
+// Builds "pcm=<device>@<rate><ch><bits>,voices=<n>,underruns=<n>;midi=none"
+// into a static buffer (S1 has no MIDI backend yet -- "midi=none" is the
+// deliberate, honest placeholder PLAN.md's S1 line calls for; S4 replaces
+// it once a real backend exists). Returns "NA" if the device never opened.
+const char *dos_audio_mixer_status_string();
+
+#endif // __AGS_EE_PLATFORM_DOS__DOS_AUDIO_MIXER_H
-- 

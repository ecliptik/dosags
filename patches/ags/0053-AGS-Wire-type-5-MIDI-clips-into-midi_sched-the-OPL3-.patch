+void AudioPlayer::MidiInit()
+{
+    bool success = (_midiSched != nullptr) && (_midiSink != nullptr);
+    if (success)
+        midi_sched_start(_midiSched, MidiNowMs());
+    _playState = success ? _onLoadPlayState : PlayStateError;
+}
+

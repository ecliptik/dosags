@@ -668,10 +708,38 @@ void update_invalid_region(Bitmap *ds, Bitmap *src, const DirtyRects &rects, boo
 
 void update_invalid_region(Bitmap *ds, color_t fill_color, const DirtyRects &rects)
 {
+#ifdef __DJGPP__
+    // DOS-PORT patch 0136: the bitmap overload two functions up opens with
+    // exactly this guard; this one does not, and the omission costs a full
+    // scanline walk per frame for nothing.
+    //
+    // With no dirty regions the loop below still runs over every scanline
+    // of the surface, and its inner "merge identical rows" while-loop does
+    // a 36-byte memcmp per row -- 360 memcmp calls to discover there is
+    // nothing to fill. Measured as sc_preroom: 1,737 ms, 60% of
+    // construct_room_view and 55% of scene_construct, the single largest
+    // component of what I had been calling draw-list building.
+    //
+    // BlackRects is the letterbox//between-viewport region. For a game
+    // whose room viewport fills the virtual screen it is initialised and
+    // permanently empty, so this is the common case, not the edge case.
+    if (rects.NumDirtyRegions == 0)
+    {
+        dos_port_tick_timing.black_fill_skipped++;
+        return;
+    }
+    dos_port_tick_timing.black_fill_done++;
+#endif
     ds->SetClip(rects.Viewport);
 
     if (rects.NumDirtyRegions == WHOLESCREENDIRTY)
     {
+#ifdef __DJGPP__
+        dos_port_tick_timing.black_fill_px +=
+            (long long)rects.Viewport.GetWidth() * rects.Viewport.GetHeight();
+        dos_port_tick_timing.black_fill_rects++;
+        dos_port_tick_timing.black_fill_whole++;   // patch 0137
+#endif
         ds->FillRect(rects.Viewport, fill_color);
     }
     else
@@ -680,6 +748,38 @@ void update_invalid_region(Bitmap *ds, color_t fill_color, const DirtyRects &rec
         const int surf_height = rects.SurfaceSize.Height;
         {
             const PlaneScaling &tf = rects.Room2Screen;
+#ifdef __DJGPP__
+            // DOS-PORT patch 0138: skip empty rows without a memcmp.
+            //
+            // Measured, after a wrong guess and then an area measurement
+            // that redirected it: this loop paints 1,177 px/frame across
+            // 1.54 rects -- the FILLING is free. The cost is the scan. The
+            // original runs a 36-byte memcmp per scanline to merge
+            // identical rows, 360 calls per frame, and for an empty row
+            // there is nothing to merge and nothing to fill. Testing
+            // numSpans first turns those into an int load.
+            //
+            // Output is identical: the original merges runs of empty rows
+            // and then fills none of them, because numSpans is 0.
+            for (int i = 0; i < surf_height; )
+            {
+                if (dirtyRow[i].numSpans == 0) { ++i; continue; }
+                int rowsInOne = 1;
+                while ((i + rowsInOne < surf_height) && (memcmp(&dirtyRow[i], &dirtyRow[i + rowsInOne], sizeof(IRRow)) == 0))
+                    rowsInOne++;
+                const IRRow &dirty_row = dirtyRow[i];
+                for (int k = 0; k < dirty_row.numSpans; k++)
+                {
+                    Rect src_r(dirty_row.span[k].x1, i, dirty_row.span[k].x2, i + rowsInOne - 1);
+                    Rect dst_r = tf.ScaleRange(src_r);
+                    dos_port_tick_timing.black_fill_px +=
+                        (long long)dst_r.GetWidth() * dst_r.GetHeight();
+                    dos_port_tick_timing.black_fill_rects++;
+                    ds->FillRect(dst_r, fill_color);
+                }
+                i += rowsInOne;
+            }
+#else
             for (int i = 0, rowsInOne = 1; i < surf_height; i += rowsInOne, rowsInOne = 1)
             {
                 // if there are rows with identical masks, do them all in one go
@@ -695,6 +795,7 @@ void update_invalid_region(Bitmap *ds, color_t fill_color, const DirtyRects &rec
                     ds->FillRect(dst_r, fill_color);
                 }
             }
+#endif
         }
     }
 }
@@ -712,6 +813,22 @@ void update_room_invreg_and_reset(int view_index, Bitmap *ds, Bitmap *src, bool
     if (view_index < 0 || RoomCamRects.size() == 0)
         return;
     
+#ifdef __DJGPP__
+    // patch 0126: time the background restore on its own. It sits inside
+    // scene_construct's bracket but is pixel work, not list building --
+    // so scene_construct's 24.3%% cannot be read as "scaffolding" until
+    // this is subtracted out.
+    dos_port_tick_timing.bg_calls++;
+    {
+    DosPortTickScope _dp_bg(dos_port_tick_timing.bg_restore);
+#endif
     update_invalid_region(ds, src, RoomCamRects[view_index], no_transform);
+#ifdef __DJGPP__
+    }
+    if ((dos_port_tick_timing.bg_calls % 500) == 0)
+        AGS::Common::Debug::Printf("DOS-PORT bgstruct calls=%ld whole=%ld px=%ld slow_px=%ld",
+            dos_port_tick_timing.bg_calls, dos_port_tick_timing.bg_whole,
+            (long)dos_port_tick_timing.bg_px, (long)dos_port_tick_timing.bg_slow_px);
+#endif
     RoomCamRects[view_index].Reset();
 }

// room1.asc -- BENCH fixture's only room. License: MIT.
//
// Interactions tell the AutoPilot module they ran through its exported
// flags: Hotspot/Object.RunInteraction() is DEFERRED by the engine (it
// queues the handler, Engine/script/script.cpp run_interaction_script),
// so the module can only poll for the handler's own side effect.

function room_AfterFadeIn()
{
}

function hSign_Look()
{
  aChime.Play();
  Display("A plain wooden sign. It says BENCH.");
  ap_look_done = 1;
}

function hSign_Interact()
{
  Display("It is nailed to the wall.");
}

function hSign_UseInv()
{
  if (player.ActiveInventory == iKey) {
    Display("The key does not fit a sign.");
    ap_use_done = 1;
  }
}

function oKey_Interact()
{
  player.AddInventory(iKey);
  oKey.Visible = false;
  aChime.Play();
}

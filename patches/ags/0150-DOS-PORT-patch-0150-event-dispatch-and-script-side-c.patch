+#endif
 
     RuntimeScriptValue rval_null;
     if (evp->Type == kAGSEvent_Script)
@@ -230,7 +322,24 @@ void process_event(const AGSEvent *evp)
             else if (obj.ObjEvent == kRoomEvent_AfterFadein)
             {
                 in_room_transition = false;

+    // bg_whole counts the frames that took the whole-surface Blit.
+    long bg_calls = 0, bg_whole = 0;
+    long long bg_px = 0;
+    long long bg_slow_px = 0;    // pixels that went the non-memcpy Blit arm
+    // patch 0162: span count and a coarse length histogram. Mean span
+    // length decides whether the restore's 28% headroom is reachable by
+    // reducing per-memcpy overhead, or whether it is the same short-run
+    // trap that limited the run-based blit to 0.48 ms.
+    long bg_spans = 0;
+    long bg_span_lt16 = 0, bg_span_lt64 = 0, bg_span_ge64 = 0;
+    // patch 0136: how often the empty-BlackRects fill was skipped, versus
+    // actually had something to fill. If "done" is near zero the whole
+    // scanline walk was always for nothing.
+    long black_fill_skipped = 0, black_fill_done = 0;
+    long long black_fill_px = 0;     // patch 0137: area actually painted

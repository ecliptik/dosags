+    _pc = curpc;
+    _returnValue = -1;
+    if ((curpc < 0) || (static_cast<uint32_t>(curpc) >= _runningInst->_codesize))
+    {
+        cc_error("specified code offset is not valid");
+        return kInstErr_Generic;
+    }
+    DosVmCallStack func_callstack(16);
+    DosVmFrame fr;
+    fr.codeInst = _runningInst;
+    fr.dbase = fr.codeInst->_scriptData->dcode.data();
+    fr.dstart = fr.codeInst->_scriptData->dstart.data();
+    fr.codesize = fr.codeInst->_codesize;
+    fr.fcs = &func_callstack;
+    fr.curnest = 0;
+    fr.num_args_to_func = -1;
+    fr.next_call_needs_object = 0;
+    fr.was_just_callas = -1;
+    fr.loopIterationCheckDisabled = 0;
+    fr.loopIterations = 0u;
+    fr.loopCheckIterations = 0u;
+    fr.thisbase[0] = 0;
+    fr.funcstart[0] = _pc;
+    fr.timeout = std::chrono::milliseconds(_timeoutCheckMs);
+    _lastAliveTs = FastClock::now();

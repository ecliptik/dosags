+
+size_t OpenAlSource::PutData(const SoundBufferPtr &data)
+{
+    if (_voice < 0 || !data.Data() || data.Size() == 0)
+        return 0u;
+    const size_t accepted = dos_audio_mixer_voice_write(_voice, data.Data(), data.Size());
+    if (accepted > 0)
+    {
+        const float dur_ms = data.DurationMs();
+        _predictTs = data.Timestamp() >= 0.f ? (data.Timestamp() + dur_ms) : (_predictTs + dur_ms);

+static int dos_r3l_mode = -1; static long dos_r3l_lo = 0, dos_r3l_hi = -1;
+int dos_lab_r3log_now()
+{
+    if (dos_r3l_mode < 0)
+    {
+        dos_r3l_mode = 0;
+        const char *e = getenv("DOSAGS_LAB_R3LOG");

+#endif
 #ifdef __DJGPP__
                 // DOS-PORT: paired with new_room()'s own "start" timestamp
                 // (room.cpp) for room-transition-latency instrumentation --
@@ -242,7 +351,14 @@ void process_event(const AGSEvent *evp)
                 {

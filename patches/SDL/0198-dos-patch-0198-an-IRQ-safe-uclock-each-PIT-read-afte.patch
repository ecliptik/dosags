+#include "SDL_internal.h"
+
+#ifdef SDL_TIMER_DOS
+
+#include <time.h> /* uclock_t */
+#include <SDL3/SDL_dosident.h>
+
+/* dosags patch 0198: an IRQ-safe uclock().
+
+   DJGPP's uclock() latches PIT channel 0 (port 43h) and reads its two count bytes from port 40h with
+   interrupts ON. The SB ISR times itself on the same counter (SDL_DOSAudioReadTimer in PIT mode). An SB
+   IRQ between the main thread's latch and its byte reads finds the 8254 mid-sequence -- its own latch is
+   ignored while one is pending, and it reads the main thread's leftover byte plus a live one -- so the
+   ISR's delta is garbage (the 22-54 ms isr_max outliers; hub docs/timing.md) and the main thread's value
+   is off too.
+
+   The port links with -Wl,--wrap=uclock (ld maps DJGPP's leading underscore itself), so every call to
+   uclock() in the program -- ags, this library, libc -- comes here, and each one after the first runs
+   with interrupts off for the read alone: EFLAGS saved, cli, the read, EFLAGS restored, so a caller
+   already at IF=0 stays there.
+
+   The FIRST call runs as the caller left the interrupt flag: it reprograms channel 0 and then waits for
+   the BIOS tick at 0040:006C to change, which never happens at IF=0 (a hang). DJGPP repeats that setup
+   only after a program restart (unexec), which these programs never do.
+
+   This file is its own object on purpose. __real_uclock must be a STRONG reference: a weak one does not
+   pull libc's uclock.o out of the archive and resolves to 0. Only a program linked with the wrap flag (or
+   one calling SDL_DOSUclockWrapStats) pulls this object in, so a program linked without the flag -- a
+   probe -- is unaffected. */
+extern uclock_t __real_uclock(void);
+uclock_t __wrap_uclock(void);
+
+static volatile int dos_uclock_initialised = 0;
+static Uint32 dos_uclock_first_calls = 0, dos_uclock_wrapped_calls = 0;
+
+uclock_t __wrap_uclock(void)
+{
+    uclock_t r;
+    unsigned long flags;
+    if (!dos_uclock_initialised) {
+        r = __real_uclock(); /* interrupts as the caller left them: see above */
+        dos_uclock_first_calls++;
+        dos_uclock_initialised = 1;
+        return r;
+    }
+    __asm__ __volatile__("pushfl\n\tpopl %0\n\tcli" : "=r"(flags) : : "memory");
+    r = __real_uclock();
+    __asm__ __volatile__("pushl %0\n\tpopfl" : : "r"(flags) : "memory", "cc");
+    dos_uclock_wrapped_calls++;
+    return r;
+}
+
+void SDL_DOSUclockWrapStats(Uint32 *first, Uint32 *wrapped)
+{
+    if (first) {
+        *first = dos_uclock_first_calls;
+    }
+    if (wrapped) {
+        *wrapped = dos_uclock_wrapped_calls;
+    }
+}
+
+#endif /* SDL_TIMER_DOS */

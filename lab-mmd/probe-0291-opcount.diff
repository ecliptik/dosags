+        room, why, (unsigned long)ticks, tot, dp_argmat - dp_s_argmat, dp_lsp_calls - dp_s_lsp_c,
+        dp_lsp_steps - dp_s_lsp_s, dp_fw_calls - dp_s_fw_c, dp_fw_steps - dp_s_fw_s);
+    AGS::Common::Debug::Printf("DOS-PORT opcount room=%d fixups none=%lld gdata=%lld func=%lld string=%lld import=%lld datadata=%lld stack=%lld other=%lld",
+        room, dp_fix_n[0] - dp_s_fix[0], dp_fix_n[1] - dp_s_fix[1], dp_fix_n[2] - dp_s_fix[2], dp_fix_n[3] - dp_s_fix[3],
+        dp_fix_n[4] - dp_s_fix[4], dp_fix_n[5] - dp_s_fix[5], dp_fix_n[6] - dp_s_fix[6], dp_fix_n[7] - dp_s_fix[7]);
+    for (int t = 0; t < 16; ++t)

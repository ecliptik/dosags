+#ifdef __DJGPP__
+// DOS-PORT patch 0179: split the AfterFadein scene-setup cost.
+//
+// BENCH8's AfterFadein dispatch is 570 ms in ONE call, and the anim4/anim12
+// pair puts it at ~30 ms per object on a ~410 ms zero-object baseline. Two
+// different things: the per-object part is what BeginScene's loop does, the
+// baseline is not and a bracket on the loop would say nothing about it.
+//
+// Within the per-object part, script_vm brackets CallScriptFunction, so our
+// script's own bytecode and the engine work it triggers are currently one
+// number -- which is the fixture-versus-port question, and it has gone the
+// port's way twice and the fixture's way never. These three brackets
+// separate the engine calls from each other and from the script.
+//
+// Generality is why this is worth more than Gate 2: at ~30 ms each, ANY AGS
+// game entering a room with twenty objects freezes for six hundred
+// milliseconds on this port, every room change.
+#include <time.h>

             for (int r = 0; r < scale_y; r++)
             {
                 std::memcpy(dst_row_base + (size_t)r * (size_t)dst->pitch, row_buf.data(), dst_row_bytes);
             }
+            _t0 = uclock();
+            vmemcpy_us += (_t0 - _t1) * 1000000LL / UCLOCKS_PER_SEC;
         }
     }
+    dos_port_tick_record(dos_port_tick_timing.fastblit_hreplicate, hrep_us);
+    dos_port_tick_record(dos_port_tick_timing.fastblit_vmemcpy, vmemcpy_us);
 

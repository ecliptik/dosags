+#ifdef __DJGPP__
+// LAB-R2 probe (lab worktree only, not a port patch). DOSAGS_R2P=1: per-character prep / blit timing, the cache path
+// each character takes each frame, input-key reuse counts, and lab TICKS.BIN kinds (7 wait_next_frame, 8 sc_prep_chars,
+// 9 character blit us per pass, 10 bg_restore, 13 rb_sprite_time us per pass, 14 character blit px per pass).
+// DOSAGS_R2P=lo:hi does all that and, for lo <= lc <= hi, hashes each character's final image, splits the restore's px
+// (kinds 11 total, 12 inside character rects) and logs one line per character per frame. It only reads game state.
+int dos_r2p_mode = -1;
+static long dos_r2p_lo = 0, dos_r2p_hi = -1;
+int dos_r2p()
+{
+    if (dos_r2p_mode < 0)
+    {
+        dos_r2p_mode = 0;
+        const char *e = getenv("DOSAGS_R2P");
+        if (e && sscanf(e, "%ld:%ld", &dos_r2p_lo, &dos_r2p_hi) == 2) dos_r2p_mode = 2;
+        else if (e && e[0] == '1') dos_r2p_mode = 1;
+        Debug::Printf("DOS-PORT r2p mode=%d lo=%ld hi=%ld", dos_r2p_mode, dos_r2p_lo, dos_r2p_hi);
+    }
+    return dos_r2p_mode;
+}
+int dos_r2p_detail()
+{
+    if (dos_r2p() != 2) return 0;
+    const long lc = (long)get_loop_counter();
+    return lc >= dos_r2p_lo && lc <= dos_r2p_hi;
+}
+int dos_r2_path = 0, dos_r2_xform = 0, dos_r2_tinted = 0, dos_r2_crop = -1;
+struct DosR2Key { int pic, view, loop, frame, tr, tg, tb, ta, tl, ll, zoom, mir, w, h, x, y, basel, transp; };
+struct DosR2Char
+{
+    long frames = 0, path[5] = {0, 0, 0, 0, 0}, xform = 0, tinted = 0, crop_called = 0, crop_changed = 0;
+    long key_same = 0, pos_same = 0, pic_same = 0, wbchg = 0, notified = 0;
+    long hashed = 0, img_same = 0, ks_img_diff = 0, kd_img_same = 0;
+    long long us_con = 0, us_prep = 0, us_blit = 0, px_blit = 0, n_blit = 0, px_img = 0;
+    DosR2Key prev; bool prev_valid = false; unsigned long prev_hash = 0; bool prev_hash_valid = false;
+    int w = 0, h = 0, spw = 0, sph = 0;
+};
+DosR2Char dos_r2c[64];
+const void *dos_r2_bmp[64]; int dos_r2_bmp_ch[64]; int dos_r2_nbmp = 0;
+const void *dos_r2_ddb[64]; int dos_r2_nddb = 0;
+long long dos_r2_pass_us = 0, dos_r2_pass_px = 0;
+static int dos_r2_last_room = -1000;
+static long long dos_r2_us(uclock_t a, uclock_t b) { return (long long)(b - a) * 1000000LL / UCLOCKS_PER_SEC; }
+static unsigned long dos_r2_hash(const Bitmap *b)
+{
+    unsigned long h = 2166136261UL;
+    const int bw = b->GetWidth() * b->GetBPP();
+    for (int y = 0; y < b->GetHeight(); ++y)
+    {
+        const unsigned char *row = b->GetScanLine(y);
+        for (int x = 0; x < bw; ++x) { h ^= row[x]; h *= 16777619UL; }
+    }
+    h ^= (unsigned long)b->GetWidth() * 31UL + (unsigned long)b->GetHeight();
+    return h & 0xFFFFFFFFUL;
+}
+void dos_r2_char_blit(int ch, long long us, long long px)
+{
+    if (ch < 0 || ch >= 64) return;
+    dos_r2c[ch].us_blit += us; dos_r2c[ch].px_blit += px; dos_r2c[ch].n_blit++;
+    dos_r2_pass_us += us; dos_r2_pass_px += px;
+}
+int dos_r2_is_char_ddb(const void *d)
+{
+    for (int i = 0; i < dos_r2_nddb; ++i) if (dos_r2_ddb[i] == d) return 1;

+// DOS-PORT patch 0297: remember what FindGUIID answered. Old verb-template scripts call it by name
+// dozens of times a tick (Maniac Mansion Deluxe: 23/tick, each re-scanning GUI names and falling into
+// a case-insensitive compare). The answer is a pure function of the query and the GUI names, and GUI
+// names are set only when game data loads (GUIMain::ReadFromFile; no script API renames a GUI and a
+// save restore does not touch them), so a remembered answer is exact until the GUI list is replaced --
+// FindGUIIDCacheReset() is called where that happens (game unload, game load). An entry is keyed by the
+// query pointer and checked against a copy of the query TEXT, so a reused pointer with different text
+// misses and scans. Only successful finds are remembered: a miss still quits exactly as before.
+struct FindGUIIDCacheEntry { const char *key; char text[32]; int result; };
+static FindGUIIDCacheEntry findguiid_cache[16];
+void FindGUIIDCacheReset()
+{
+    for (auto &e : findguiid_cache) { e.key = nullptr; e.text[0] = 0; e.result = -1; }
+}
+static int FindGUIIDScan(const char* GUIName);
+int FindGUIID (const char* GUIName) {
+    FindGUIIDCacheEntry &e = findguiid_cache[((unsigned)(uintptr_t)GUIName >> 2) & 15];
+    if (GUIName && e.key == GUIName && strcmp(e.text, GUIName) == 0)
+        return e.result;
+    const int found = FindGUIIDScan(GUIName);
+    if (found >= 0 && GUIName && strlen(GUIName) < sizeof(e.text))
+    {
+        e.key = GUIName;
+        strcpy(e.text, GUIName);
+        e.result = found;
+    }
+    return found;
+}

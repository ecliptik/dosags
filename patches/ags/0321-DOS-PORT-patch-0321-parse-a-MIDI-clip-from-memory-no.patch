@@ -56,18 +57,19 @@ class AudioPlayer
 {
 public:
     AudioPlayer(int handle, std::unique_ptr<SDLDecoder> decoder);
-    // DOS-PORT (Sound milestone, S4): MIDI-mode constructor. midi_path is a
-    // real DOS file path (8.3) the caller has already written the clip's
-    // SMF bytes to -- midi_sched_open() reads a file, not a memory buffer,
-    // and shared/audio is not this patch's to extend with a buffer-based
-    // open (see dos_midi_backend.h's own header note). repeat mirrors the
+    // DOS-PORT (Sound milestone, S4): MIDI-mode constructor. DOS-PORT patch
+    // 0321: midi_data is the clip's SMF bytes as the asset reader loaded
+    // them; midi_sched_open_mem() (shared/audio) parses them in place, so

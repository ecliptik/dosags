+#ifdef __DJGPP__
+// LAB-R2 probe (lab worktree only, not a port patch). DOSAGS_R2P=1: per-character prep / blit timing, the cache path
+// each character takes each frame, input-key reuse counts, and lab TICKS.BIN kinds (7 wait_next_frame, 8 sc_prep_chars,
+// 9 character blit us per pass, 10 bg_restore, 13 rb_sprite_time us per pass, 14 character blit px per pass).
+// DOSAGS_R2P=lo:hi does all that and, for lo <= lc <= hi, hashes each character's final image, splits the restore's px
+// (kinds 11 total, 12 inside character rects) and logs one line per character per frame. It only reads game state.
+int dos_r2p_mode = -1;
+static long dos_r2p_lo = 0, dos_r2p_hi = -1;
+int dos_r2p()
+{
+    if (dos_r2p_mode < 0)
+    {
+        dos_r2p_mode = 0;
+        const char *e = getenv("DOSAGS_R2P");
+        if (e && sscanf(e, "%ld:%ld", &dos_r2p_lo, &dos_r2p_hi) == 2) dos_r2p_mode = 2;
+        else if (e && e[0] == '1') dos_r2p_mode = 1;
+        Debug::Printf("DOS-PORT r2p mode=%d lo=%ld hi=%ld", dos_r2p_mode, dos_r2p_lo, dos_r2p_hi);
+    }
+    return dos_r2p_mode;
+}
+int dos_r2p_detail()
+{
+    if (dos_r2p() != 2) return 0;
+    const long lc = (long)get_loop_counter();
+    return lc >= dos_r2p_lo && lc <= dos_r2p_hi;
+}
+int dos_r2_path = 0, dos_r2_xform = 0, dos_r2_tinted = 0, dos_r2_crop = -1;
+struct DosR2Key { int pic, view, loop, frame, tr, tg, tb, ta, tl, ll, zoom, mir, w, h, x, y, basel, transp; };
+struct DosR2Char
+{
+    long frames = 0, path[5] = {0, 0, 0, 0, 0}, xform = 0, tinted = 0, crop_called = 0, crop_changed = 0;
+    long key_same = 0, pos_same = 0, pic_same = 0, wbchg = 0, notified = 0;
+    long hashed = 0, img_same = 0, ks_img_diff = 0, kd_img_same = 0;
+    long long us_con = 0, us_prep = 0, us_blit = 0, px_blit = 0, n_blit = 0, px_img = 0;
+    DosR2Key prev; bool prev_valid = false; unsigned long prev_hash = 0; bool prev_hash_valid = false;
+    int w = 0, h = 0, spw = 0, sph = 0;
+};
+DosR2Char dos_r2c[64];
+const void *dos_r2_bmp[64]; int dos_r2_bmp_ch[64]; int dos_r2_nbmp = 0;
+const void *dos_r2_ddb[64]; int dos_r2_nddb = 0;
+long long dos_r2_pass_us = 0, dos_r2_pass_px = 0;
+static int dos_r2_last_room = -1000;
+static long long dos_r2_us(uclock_t a, uclock_t b) { return (long long)(b - a) * 1000000LL / UCLOCKS_PER_SEC; }
+static unsigned long dos_r2_hash(const Bitmap *b)
+{
+    unsigned long h = 2166136261UL;
+    const int bw = b->GetWidth() * b->GetBPP();
+    for (int y = 0; y < b->GetHeight(); ++y)
+    {
+        const unsigned char *row = b->GetScanLine(y);
+        for (int x = 0; x < bw; ++x) { h ^= row[x]; h *= 16777619UL; }
+    }
+    h ^= (unsigned long)b->GetWidth() * 31UL + (unsigned long)b->GetHeight();
+    return h & 0xFFFFFFFFUL;
+}
+void dos_r2_char_blit(int ch, long long us, long long px)
+{
+    if (ch < 0 || ch >= 64) return;
+    dos_r2c[ch].us_blit += us; dos_r2c[ch].px_blit += px; dos_r2c[ch].n_blit++;
+    dos_r2_pass_us += us; dos_r2_pass_px += px;
+}
+int dos_r2_is_char_ddb(const void *d)
+{
+    for (int i = 0; i < dos_r2_nddb; ++i) if (dos_r2_ddb[i] == d) return 1;
+    return 0;
+}
+static void dos_r2_char_done(int ch, const CharacterInfo &ci, const CharacterExtras &cx, const ObjectCache &cs,
+    ObjTexture &a, int atx, int aty, int basel, uclock_t t0, uclock_t t1, uclock_t t2, bool wbc)
+{
+    if (ch < 0 || ch >= 64) return;
+    DosR2Char &c = dos_r2c[ch];
+    c.frames++;
+    c.path[(dos_r2_path >= 0 && dos_r2_path < 5) ? dos_r2_path : 0]++;
+    c.xform += dos_r2_xform; c.tinted += dos_r2_tinted;
+    if (dos_r2_crop >= 0) { c.crop_called++; c.crop_changed += dos_r2_crop; }
+    c.us_con += dos_r2_us(t0, t1); c.us_prep += dos_r2_us(t1, t2);
+    const DosR2Key k = { cs.sppic, ci.view, ci.loop, ci.frame, cs.tintr, cs.tintg, cs.tintb, cs.tintamnt, cs.tintlight,
+                         cs.lightlev, cs.zoom, (int)cs.mirrored, cx.width, cx.height, atx, aty, basel, ci.transparency };
+    const bool notified = a.IsChangeNotified();
+    const bool ks = c.prev_valid && !wbc && !notified && memcmp(&k, &c.prev, sizeof(k)) == 0;
+    const bool ps = c.prev_valid && k.x == c.prev.x && k.y == c.prev.y && k.basel == c.prev.basel;
+    const bool pc = c.prev_valid && k.pic == c.prev.pic && k.mir == c.prev.mir && k.w == c.prev.w && k.h == c.prev.h;
+    c.key_same += ks; c.pos_same += ps; c.pic_same += pc; c.wbchg += wbc; c.notified += notified;
+    if (a.Bmp)
+    {
+        c.w = a.Bmp->GetWidth(); c.h = a.Bmp->GetHeight();
+        c.px_img += (long long)c.w * c.h;
+        const int sp = cs.sppic < 0 ? -cs.sppic : cs.sppic;
+        if (spriteset.DoesSpriteExist(sp)) { c.spw = game.SpriteInfos[sp].Width; c.sph = game.SpriteInfos[sp].Height; }
+    }
+    if (dos_r2p_detail() && a.Bmp)
+    {
+        const unsigned long hs = dos_r2_hash(a.Bmp.get());
+        int is = -1;
+        if (c.prev_hash_valid)
+        {
+            is = (hs == c.prev_hash) ? 1 : 0;
+            c.hashed++; c.img_same += is;
+            if (ks && !is) c.ks_img_diff++;
+            if (!ks && c.prev_valid && is) c.kd_img_same++;
+        }
+        c.prev_hash = hs; c.prev_hash_valid = true;
+        Debug::Printf("DOS-PORT r2f lc=%u ch=%d pic=%d vlf=%d/%d/%d path=%d xf=%d tint=%d/%d/%d/%d/%d lev=%d zoom=%d mir=%d"
+            " sz=%dx%d sp=%dx%d at=%d,%d basel=%d tr=%d crop=%d wbc=%d ks=%d ps=%d is=%d h=%08lx us_c=%lld us_p=%lld",
+            (unsigned)get_loop_counter(), ch, k.pic, k.view, k.loop, k.frame, dos_r2_path, dos_r2_xform, k.tr, k.tg, k.tb,
+            k.ta, k.tl, k.ll, k.zoom, k.mir, c.w, c.h, c.spw, c.sph, atx, aty, basel, k.transp, dos_r2_crop, (int)wbc,
+            (int)ks, (int)ps, is, hs, dos_r2_us(t0, t1), dos_r2_us(t1, t2));
+    }
+    else
+        c.prev_hash_valid = false;
+    c.prev = k; c.prev_valid = true;
+    if (dos_r2_nbmp < 64 && a.Bmp) { dos_r2_bmp[dos_r2_nbmp] = a.Bmp.get(); dos_r2_bmp_ch[dos_r2_nbmp] = ch; dos_r2_nbmp++; }
+    if (dos_r2_nddb < 64 && a.Ddb) dos_r2_ddb[dos_r2_nddb++] = a.Ddb;
+}
+void dos_r2_dump(FILE *f, long lc, bool ck)
+{
+    for (int i = 0; i < 64; ++i)
+    {
+        const DosR2Char &c = dos_r2c[i];
+        if (!c.frames) continue;
+        char line[640];
+        snprintf(line, sizeof(line), "%s lc=%ld ch=%d name=%s frames=%ld path=%ld/%ld/%ld/%ld/%ld xform=%ld tinted=%ld crop=%ld/%ld"
+            " key_same=%ld pos_same=%ld pic_same=%ld wbchg=%ld notified=%ld hashed=%ld img_same=%ld ks_img_diff=%ld kd_img_same=%ld"
+            " us_con=%lld us_prep=%lld us_blit=%lld px_blit=%lld n_blit=%lld px_img=%lld sz=%dx%d sp=%dx%d",
+            ck ? "DOS-PORT labck c=r2char" : "DOS-PORT r2char", lc, i, (i < game.numcharacters) ? game.chars[i].scrname : "?",
+            c.frames, c.path[0], c.path[1], c.path[2], c.path[3], c.path[4], c.xform, c.tinted, c.crop_called, c.crop_changed,
+            c.key_same, c.pos_same, c.pic_same, c.wbchg, c.notified, c.hashed, c.img_same, c.ks_img_diff, c.kd_img_same,
+            c.us_con, c.us_prep, c.us_blit, c.px_blit, c.n_blit, c.px_img, c.w, c.h, c.spw, c.sph);
+        if (f) fprintf(f, "%s\n", line); else Debug::Printf("%s", line);
+    }
+    extern long long dos_r2_bgpx_all, dos_r2_bgpx_char; extern long dos_r2_rect_over, dos_r2_restores;
+    char line[256];
+    snprintf(line, sizeof(line), "%s lc=%ld restores=%ld bgpx_all=%lld bgpx_char=%lld rect_over=%ld",
+        ck ? "DOS-PORT labck c=r2bg" : "DOS-PORT r2bg", lc, dos_r2_restores, dos_r2_bgpx_all, dos_r2_bgpx_char, dos_r2_rect_over);
+    if (f) fprintf(f, "%s\n", line); else Debug::Printf("%s", line);
+}
+#endif

+        dos_savemem_fallback++; dos_savemem_last_path = 2;
+        std::unique_ptr<Stream> out(new Stream(std::make_unique<BufferedStream>(std::move(fs))));
+        dos_save_body(out.get(), user_text, user_image, select_cmp, compress_data);
+        dos_savemem_last_bytes = (long)out->GetLength();

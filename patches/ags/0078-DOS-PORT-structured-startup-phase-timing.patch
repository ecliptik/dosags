+                        debug_script_log("script_vm_init_ms=%ld", st.script_vm_init_ms);
+                        debug_script_log("gfxmode_init_ms=%ld", st.gfxmode_init_ms);
+                        debug_script_log("sprite_index_init_ms=%ld", st.sprite_index_init_ms);
+                        debug_script_log("sprite_precache_ms=%ld", st.sprite_precache_ms);
+                        debug_script_log("sprite_precache_view_count=%d", st.precache_view_count);
+                        debug_script_log("sprite_precache_frame_count=%d", st.precache_frame_count);
+                        for (int i = 0; i < 3; ++i)
+                            debug_script_log("sprite_precache_slowest%d_view=%d sprite_precache_slowest%d_ms=%ld",
+                                i + 1, st.precache_slowest[i].view, i + 1, st.precache_slowest[i].ms);
+                        debug_script_log("first_room_load_ms=%ld", st.first_room_load_ms);
+                        debug_script_log("total_to_first_frame_ms=%ld", t_ms);
+                        debug_script_log("[DOS-PORT-STARTUP-END]");
+                    }
                 }
 #endif
                 run_on_event(kScriptEvent_RoomAfterFadein, displayed_room);
diff --git a/Engine/ac/game.cpp b/Engine/ac/game.cpp
index 0169e83bc..b71f51d3e 100644
--- a/Engine/ac/game.cpp
+++ b/Engine/ac/game.cpp
@@ -13,6 +13,9 @@
 //=============================================================================
 #include "ac/game.h"
 #include <stdio.h>
+#ifdef __DJGPP__
+#include "main/dos_port_startup_timing.h" // DosPortStartupTiming, patch 0078
+#endif
 #include "ac/common.h"
 #include "ac/view.h"
 #include "ac/audiochannel.h"
@@ -1941,6 +1944,36 @@ void precache_view(int view, int first_loop, int last_loop, bool with_sounds)
         dur_sp_load / total_frames, dur_tx_make / total_frames, total_sounds, dur_sound_load);
     Debug::Printf("\tSprite cache: %zu -> %zu KB, texture cache: %zu -> %zu KB",
         spcache_before / 1024u, spcache_after / 1024u, txcache_before / 1024u, txcache_after / 1024u);
+
+#ifdef __DJGPP__
+    // DOS-PORT patch 0078: fold this call's own already-computed cost
+    // into the startup report's running aggregate (call count, frame
+    // count, total ms, slowest-3-by-total-ms) -- every field this
+    // function already prints above, just accumulated instead of only
+    // printed once and discarded. Every call during the game's lifetime
+    // contributes (not just the startup-time ones); the startup report
+    // only reads this struct once, at first-room-ready, so later
+    // in-game precache_view() calls (e.g. Game.PrecacheView from script)
+    // simply do not affect a report that already printed.
+    {
+        const long call_ms = (long)(dur_sp_load + dur_tx_make + dur_sound_load);
+        DosPortStartupTiming &t = dos_port_startup_timing;
+        t.precache_view_count++;
+        t.precache_frame_count += total_frames;
+        // Insertion into the fixed-size slowest-3 array, descending by ms.
+        for (int i = 0; i < 3; ++i)
+        {
+            if (call_ms > t.precache_slowest[i].ms)
+            {
+                for (int j = 2; j > i; --j)
+                    t.precache_slowest[j] = t.precache_slowest[j - 1];
+                t.precache_slowest[i].view = view;
+                t.precache_slowest[i].ms = call_ms;
+                break;
+            }
+        }
+    }
+#endif
 }
 
 bool load_game_font(int at_index, const FontInfo &finfo, GameDataVersion data_ver)

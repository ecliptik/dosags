+// Build the real table, reusing it when its inputs are unchanged (patch
+// 0113). Called eagerly when the room declares darkening, and lazily from
+// the blend entry points when a script turns darkening on later.
+void dos_port_build_light_table()
+{
+    if (game.color_depth != 1)
+        return;
+    dp_ensure_identity_table();
+
+    // Cache key is every input create_light_table() branches on: the
+    // palette AND whether rgb_map is set. With rgb_map non-null it takes a

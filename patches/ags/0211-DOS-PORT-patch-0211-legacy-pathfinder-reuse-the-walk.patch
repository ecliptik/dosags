 static int walk_area_granularity[MAX_WALK_AREAS];
+
+// DOS-PORT patch 0211: is_route_possible's analysis of the walkable mask -- two full passes over it
+// (the second column-major) that measure each area's average width and normalise every walkable
+// pixel to 1 -- depends only on the mask's own pixels and MaxGranularity, yet ran on every call:
+// twice per walk request whose target is not walkable (the nearest-walkable retry), and again for
+// every request while the mask had not changed. On DOSBox-X at fixed 40000 cycles that was 44 ms
+// per call, 88 ms of a 98-231 ms request (dosags RT2a); on the 486 the walk stalls are 250-370 ms.
+// The result is kept with a copy of the mask it came from; a call on a byte-identical mask (same
+// size, same MaxGranularity) reuses it, so the outputs -- walk_area_granularity[] and the
+// normalised copy the flood fill starts from -- are the same values the passes would produce.
+static int rp_cache_gran[MAX_WALK_AREAS];
+static int rp_cache_maxgran = -1;
+static int is_route_possible_flood(Bitmap *tempw, int fromx, int fromy, int tox, int toy, const LegacyRouteFinder::PathfinderConfig &pfc);
+
+static bool rp_cache_matches(const Bitmap *wallscreen, int maxgran)
+{
+  if (!rp_cache_src || rp_cache_maxgran != maxgran ||
+      rp_cache_src->GetWidth() != wallscreen->GetWidth() || rp_cache_src->GetHeight() != wallscreen->GetHeight())
+    return false;
+  // Compared a 32-bit word at a time: DJGPP's memcmp is a byte loop (8 instructions a byte), which
+  // made this test cost ~13 ms per call at fixed 40000 cycles for a 320x200 mask.
+  const int w = wallscreen->GetWidth();
+  for (int y = 0; y < wallscreen->GetHeight(); y++)
+  {
+    const uint8_t *a = rp_cache_src->GetScanLine(y);
+    const uint8_t *b = wallscreen->GetScanLine(y);
+    int x = 0;
+    for (; x + 4 <= w; x += 4)
+    {
+      uint32_t wa, wb;
+      memcpy(&wa, a + x, 4);
+      memcpy(&wb, b + x, 4);
+      if (wa != wb)
+        return false;
+    }
+    for (; x < w; x++)
+      if (a[x] != b[x])
+        return false;
+  }
+  return true;
+}
+
 static int is_route_possible(const Bitmap *wallscreen, int fromx, int fromy, int tox, int toy, const LegacyRouteFinder::PathfinderConfig &pfc)
 {

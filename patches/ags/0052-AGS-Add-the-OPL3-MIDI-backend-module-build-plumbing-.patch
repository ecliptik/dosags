+    # own top-level Makefile (-DDOS_PORT_SHARED_AUDIO_DIR=<repo>/.sdl-dos-ports/
+    # shared/audio) rather than hardcoded here, so this CMakeLists.txt does
+    # not need to know the hub subtree's path relative to Engine/.
+    ${DOS_PORT_SHARED_AUDIO_DIR}/midi_sched.c
+    ${DOS_PORT_SHARED_AUDIO_DIR}/opl3_sink.c
 
     platform/windows/win_ex_handling.cpp
     platform/windows/win_ex_handling.h
@@ -607,7 +620,18 @@ endif()
 
 get_target_property(ENGINE_SOURCES engine SOURCES)
 # Set ROOT to parent directory to include Plugins/
-source_group(TREE ${CMAKE_CURRENT_SOURCE_DIR}/.. PREFIX "Source Files" FILES ${ENGINE_SOURCES})
+#
+# DOS-PORT (Sound milestone, S4): skip on DOS. This is IDE-only source-tree
+# grouping (Visual Studio/Xcode folders), never consulted by this port's
+# own CLI Makefile build. source_group(TREE ...) requires every file in
+# ENGINE_SOURCES to live under its ROOT -- true for every existing Engine
+# source (all under vendor/ags), but S4 added two real compiled sources
+# from the hub's .sdl-dos-ports/shared/audio/ subtree
+# (DOS_PORT_SHARED_AUDIO_DIR, see platform/dos/ above), a different top-
+# level directory entirely, which this call would otherwise hard error on.
+if (NOT DOS)
+    source_group(TREE ${CMAKE_CURRENT_SOURCE_DIR}/.. PREFIX "Source Files" FILES ${ENGINE_SOURCES})
+endif ()
 
 # Standalone exe

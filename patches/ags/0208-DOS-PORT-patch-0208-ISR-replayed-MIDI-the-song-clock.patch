From 1a6501e38244474c2cf2d56d1e33d0581cace678 Mon Sep 17 00:00:00 2001
From: Micheal Waltz <micheal@ecliptik.com>
Date: Wed, 23 Sep 2026 11:20:05 -0700
Subject: [PATCH] DOS-PORT: patch 0208 -- ISR-replayed MIDI: the song clock
 follows the measured IRQ period

WHY: with 0207 the planner advanced song time by the NOMINAL IRQ period (512 frames at 11025 Hz =
46439 us) per slot, so the music's tempo followed the Sound Blaster's actual playback rate: the
song clock read 0.988-0.996 of real time against the CMOS RTC on DOSBox-X (PLAN.md, MI cells), and
the PicoGUS's SB 2.0 time constant plays ~10989 Hz (-0.33%). The operator's decision: make it track
real time before the hardware round.

WHAT: at song start the planner records the IRQ count and uclock(); on every plan, once 43 IRQs
(~2 s) have passed, the real IRQ period is (uclock elapsed) / (IRQs elapsed) since the song
started, clamped to +-5% of nominal. Stamps are unchanged (IRQ indices, so the ISR replay and its
lateness are untouched); what changes is how much SONG time each slot advances: the measured period
instead of the nominal. uclock is only read (the PIT is never reprogrammed; hub docs/audio.md). The
error is one IRQ over the whole window and shrinks as the song plays. A slot skipped when the plan
falls behind now simply advances no song time (the old shift bookkeeping stays, unused). clk now
reports the song clock itself (song ms planned between polls), and the status gains
real_period_us.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Nz9XeKeVG8Ab7dm8esJsMu
---
 Engine/media/audio/audioplayer.cpp       | 41 +++++++++++++++++++++---
 Engine/media/audio/audioplayer.h         |  9 ++++++
 Engine/platform/dos/dos_midi_backend.cpp | 12 +++++--
 Engine/platform/dos/dos_midi_backend.h   |  2 ++
 4 files changed, 57 insertions(+), 7 deletions(-)

diff --git a/Engine/media/audio/audioplayer.cpp b/Engine/media/audio/audioplayer.cpp
index 725f47cc5..9c144a23f 100644
--- a/Engine/media/audio/audioplayer.cpp
+++ b/Engine/media/audio/audioplayer.cpp
@@ -118,6 +118,12 @@ void AudioPlayer::MidiIsrBegin()
         _midiPlanUs = (uint64_t)(_midiLastIrq + 2) * _midiPeriodUs;
         _midiShiftUs = _midiPlanUs;
         _midiResumed = false;
+        // DOS-PORT (patch 0208): calibration base -- IRQ count and uclock now.
+        _midiSongUs = 0;
+        _midiLastSongMs = 0;
+        _midiCalIrq0 = _midiLastIrq;
+        _midiCalUs0 = (uint64_t)uclock() * 1000000ULL / UCLOCKS_PER_SEC;
+        _midiRealPeriodUs = _midiPeriodUs;
     }
     dos_midi_backend_set_tick_mode(_midiIsr, _midiIsr ? _midiPeriodUs : 0, lookahead);
 }
@@ -150,16 +156,41 @@ void AudioPlayer::MidiIsrPlan()
         _midiPlanUs = floor_us;
     }
     _midiResumed = false;
+    // DOS-PORT (patch 0208): the real IRQ period, measured against uclock
+    // (read only -- the PIT is never reprogrammed) since the song started.
+    // Used once 43 IRQs (~2 s) have elapsed, clamped to +-5% of nominal; the
+    // quantisation error is one IRQ over the whole window, so it only
+    // shrinks as the song plays.
+    {
+        const uint32_t dirq = now - _midiCalIrq0;
+        if (dirq >= 43)
+        {
+            const uint64_t us_now = (uint64_t)uclock() * 1000000ULL / UCLOCKS_PER_SEC;
+            uint64_t real = (us_now - _midiCalUs0) / dirq;
+            const uint64_t lo = (uint64_t)_midiPeriodUs * 95 / 100, hi = (uint64_t)_midiPeriodUs * 105 / 100;
+            if (real < lo) real = lo;
+            if (real > hi) real = hi;
+            _midiRealPeriodUs = (uint32_t)real;
+        }
+    }
     const uint64_t horizon = (uint64_t)(now + _midiLookIrqs) * _midiPeriodUs;
     while (_midiPlanUs + _midiPeriodUs <= horizon && SDL_DOSMidiDeferFree() > 512)
     {
         _midiPlanUs += _midiPeriodUs;
+        _midiSongUs += _midiRealPeriodUs; // DOS-PORT (patch 0208): real time per slot
         SDL_DOSMidiDeferSetStamp((uint32_t)(_midiPlanUs / _midiPeriodUs));
-        midi_sched_tick(_midiSched, MidiSongMs());
+        midi_sched_tick(_midiSched, _midiSongUs / 1000u + 1000u);
     }
     SDL_DOSMidiDeferSetStamp(now); // anything written outside the plan goes out at once
-    dos_midi_backend_note_tick(0, (uint32_t)((uint64_t)(now - _midiLastIrq) * _midiPeriodUs / 1000u),
-        get_loop_counter());
+    // DOS-PORT (patch 0208): report the song clock itself (song ms planned
+    // since the last poll; the lookahead is a constant offset after the
+    // first poll), so clk witnesses what the listener hears.
+    {
+        const uint64_t song_ms = _midiSongUs / 1000u;
+        dos_midi_backend_note_tick(0, (uint32_t)(song_ms - _midiLastSongMs), get_loop_counter());
+        _midiLastSongMs = song_ms;
+    }
+    dos_midi_backend_note_isr_period(_midiRealPeriodUs);
     _midiLastIrq = now;
 }
 
@@ -247,7 +278,7 @@ void AudioPlayer::MidiInit()
             if (!(silent && silent[0] == '1' && silent[1] == '\0'))
             {
                 MidiIsrBegin(); // DOS-PORT (patch 0207)
-                midi_sched_start(_midiSched, _midiIsr ? MidiSongMs() : MidiNowMs());
+                midi_sched_start(_midiSched, _midiIsr ? _midiSongUs / 1000u + 1000u : MidiNowMs());
             }
         }
     }
@@ -425,7 +456,7 @@ void AudioPlayer::MidiPlay()
             dos_midi_backend_prepare_song(_midiSink, _midiBackendKind, _midiSched);
             MidiIsrBegin(); // DOS-PORT (patch 0207)
             _midiLastDispatched = 0;
-            midi_sched_start(_midiSched, _midiIsr ? MidiSongMs() : MidiNowMs());
+            midi_sched_start(_midiSched, _midiIsr ? _midiSongUs / 1000u + 1000u : MidiNowMs());
         }
         _playState = (_midiSched && _midiSink) ? PlayStatePlaying : PlayStateError;
         break;
diff --git a/Engine/media/audio/audioplayer.h b/Engine/media/audio/audioplayer.h
index 71f0d51c8..7c80cf234 100644
--- a/Engine/media/audio/audioplayer.h
+++ b/Engine/media/audio/audioplayer.h
@@ -175,6 +175,15 @@ private:
     uint32_t _midiLastIrq = 0;
     bool _midiResumed = false;
     uint64_t MidiSongMs() const { return (_midiPlanUs - _midiShiftUs) / 1000u + 1000u; }
+    // DOS-PORT (patch 0208): the song clock advances by the MEASURED IRQ
+    // period (IRQ count against uclock since song start), not the nominal
+    // one, so it tracks real time even when the device plays a little off
+    // its nominal rate. _midiSongUs is the song time actually planned.
+    uint64_t _midiSongUs = 0;
+    uint32_t _midiCalIrq0 = 0;
+    uint64_t _midiCalUs0 = 0;
+    uint32_t _midiRealPeriodUs = 0;
+    uint64_t _midiLastSongMs = 0;
     void MidiIsrBegin();
     void MidiIsrEnd(bool flush);
     void MidiIsrPlan();      // DOS-PORT (patch 0206): MidiNowMs() at the last MidiPoll()  // midi_sched_dispatched() as of the last MidiPoll()
diff --git a/Engine/platform/dos/dos_midi_backend.cpp b/Engine/platform/dos/dos_midi_backend.cpp
index 193202f89..1675acb3e 100644
--- a/Engine/platform/dos/dos_midi_backend.cpp
+++ b/Engine/platform/dos/dos_midi_backend.cpp
@@ -50,6 +50,7 @@ bool g_tick_isr = false;
 uint32_t g_tick_period_us = 0;
 uint32_t g_tick_lookahead = 0;
 uint32_t g_plan_behind = 0;
+uint32_t g_real_period_us = 0; // DOS-PORT (patch 0208)
 int g_rtc_last_s = -1;
 
 // Seconds since midnight from the CMOS RTC (BCD or binary per status B),
@@ -380,6 +381,11 @@ void dos_midi_backend_set_tick_mode(bool isr, uint32_t period_us, uint32_t looka
         isr ? " (writes planned ahead, replayed by the SB IRQ)" : " (main loop)");
 }
 
+void dos_midi_backend_note_isr_period(uint32_t period_us)
+{
+    g_real_period_us = period_us;
+}
+
 void dos_midi_backend_note_plan_behind()
 {
     g_plan_behind++;
@@ -432,10 +438,12 @@ void dos_midi_backend_status_fragment(char *buf, size_t bufsize)
         SDL_DOSMidiDeferStats(&wr, &late, &late_max, &burst, &full);
         SDL_DOSMidiDeferStats2(&dropped, &sync);
         std::snprintf(buf, bufsize, "midi=%s,events=%llu%s,midi_tick=isr,period_us=%u,lookahead=%u,isr_writes=%u,"
-            "late_writes=%u,late_max_ms=%u,isr_burst=%u,qfull=%u,qsync=%u,qdropped=%u,plan_behind=%u,clk=%llu/%ds",
+            "late_writes=%u,late_max_ms=%u,isr_burst=%u,qfull=%u,qsync=%u,qdropped=%u,plan_behind=%u,clk=%llu/%ds,"
+            "real_period_us=%u",
             kind_name(g_last_kind), (unsigned long long)g_events_dispatched, chip, g_tick_period_us, g_tick_lookahead,
             (unsigned)wr, (unsigned)late, (unsigned)((uint64_t)late_max * g_tick_period_us / 1000u), (unsigned)burst,
-            (unsigned)full, (unsigned)sync, (unsigned)dropped, g_plan_behind, (unsigned long long)g_song_ms, rtc_s);
+            (unsigned)full, (unsigned)sync, (unsigned)dropped, g_plan_behind, (unsigned long long)g_song_ms, rtc_s,
+            g_real_period_us);
         return;
     }
     std::snprintf(buf, bufsize, "midi=%s,events=%llu%s,midi_tick=poll,late_max_ms=%u,late_hist=%llu/%llu/%llu/%llu/%llu/%llu,"
diff --git a/Engine/platform/dos/dos_midi_backend.h b/Engine/platform/dos/dos_midi_backend.h
index a7cf59d05..c3ea3261b 100644
--- a/Engine/platform/dos/dos_midi_backend.h
+++ b/Engine/platform/dos/dos_midi_backend.h
@@ -166,6 +166,8 @@ void dos_midi_backend_note_tick(uint32_t events, uint32_t gap_ms, uint32_t loop_
 int dos_midi_backend_defer_kind(DosMidiBackendKind kind);
 void dos_midi_backend_set_tick_mode(bool isr, uint32_t period_us, uint32_t lookahead_irqs);
 void dos_midi_backend_note_plan_behind();
+// DOS-PORT (patch 0208): the measured IRQ period the planner is using.
+void dos_midi_backend_note_isr_period(uint32_t period_us);
 
 // Builds "midi=<backend>,events=<n>" (e.g. "midi=wb,events=42") into buf.

@@ -105,6 +105,21 @@ SDL_AudioFormat dos_audio_mixer_format();
 // own shared/audio/gus_pcm_stream.
 bool dos_audio_mixer_init();
 
+// DOS-PORT patch 0355 (model C, MIDI-only): opens the mixer with NO PCM device,
+// for sys_audio_init() when the SB cannot open and the backend is not gus.
+// Voices work exactly as on the SB path (acquire/write/queued/stop), but
+// dos_audio_mixer_pump() drains every active voice against uclock() at
+// DOS_AUDIO_MIXER_RATE in MIX_CHUNK_SAMPLES steps and discards the samples, so
+// a clip reaches PlayStateFinished after its real duration (AudioPlayer::
+// Poll(): decoder EOS and an empty voice). A pump gap is credited at most
+// NULL_MAX_GAP_CHUNKS chunks (~232 ms), about what the SB path has queued ahead
+// (TARGET_QUEUED_BYTES + one chunk): after a longer main-loop stall the SB
+// device plays silence and the clip resumes where it was, so model C does the
+// same. dos_audio_mixer_format() stays S16 (decode cost as on the SB path).
+// Status: "pcm=none@...", the SB-only fields NA as under GUS; mixed= counts
+// the chunks drained. Never reached on the SB or GUS paths.
+bool dos_audio_mixer_init_midi_only();
+
 // Closes the audio stream/device and releases all voices. Safe to call
 // even if never successfully opened.
 void dos_audio_mixer_shutdown();

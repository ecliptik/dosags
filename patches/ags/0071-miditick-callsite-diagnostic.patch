@@ -451,6 +475,8 @@ void dos_diag_close_window()
     d.voicestart_us_sum = 0; d.voicestart_min_us = UINT64_MAX; d.voicestart_max_us = 0;
     d.voicestop_calls_sum = 0;
     d.voicestop_us_sum = 0; d.voicestop_min_us = UINT64_MAX; d.voicestop_max_us = 0;
+    d.miditick_calls_sum = 0;

 }
 
 void dos_diag_record_audio_poll(uint64_t slots_us, uint64_t pump_us)
@@ -555,6 +581,19 @@ void dos_diag_record_voicestop(uint32_t calls, uint32_t min_us, uint32_t mean_us
     if ((uint64_t)max_us > d.voicestop_max_us) d.voicestop_max_us = max_us;
 }
 
+// S7-GUS continuation: same shape, for the midi_sched_tick() call-site
+// bracket (audioplayer.cpp).
+void dos_diag_record_miditick(uint32_t calls, uint32_t min_us, uint32_t mean_us, uint32_t max_us)
+{
+    if (calls == 0)
+        return;
+    AudioPollDiag &d = g_audio_poll_diag;
+    d.miditick_calls_sum += calls;
+    d.miditick_us_sum += (uint64_t)mean_us * calls;
+    if ((uint64_t)min_us < d.miditick_min_us) d.miditick_min_us = min_us;
+    if ((uint64_t)max_us > d.miditick_max_us) d.miditick_max_us = max_us;
+}
+
 } // anonymous namespace
 
 // Declared in audio_core.h (DJGPP-gated); called from quit.cpp right
@@ -585,7 +624,8 @@ void dos_diag_dump_audio_poll(FILE *fp)
             "voicevol(calls=%lu min_us=%lu mean_us=%lu max_us=%lu) "

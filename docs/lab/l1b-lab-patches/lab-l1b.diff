+int l1b_hidx(const void *h)
+{
+    if (!s_l1b_hready)
+    {
+        for (int i = 0; i < 256; ++i) { s_l1b_hk[i] = nullptr; s_l1b_hv[i] = -1; }
+        for (int i = 0; i < kVmH_Count; ++i)
+        {
+            unsigned s = (reinterpret_cast<uintptr_t>(s_vm_handlers[i]) >> 2) & 255;
+            while (s_l1b_hk[s] && s_l1b_hk[s] != s_vm_handlers[i]) s = (s + 1) & 255;
+            if (!s_l1b_hk[s]) { s_l1b_hk[s] = s_vm_handlers[i]; s_l1b_hv[s] = i; }
+        }
+        s_l1b_hready = true;
+    }
+    unsigned s = (reinterpret_cast<uintptr_t>(h) >> 2) & 255;
+    for (int k = 0; k < 256; ++k, s = (s + 1) & 255)
+    {
+        if (s_l1b_hk[s] == h) return s_l1b_hv[s];
+        if (!s_l1b_hk[s]) break;
+    }
+    return kVmH_Count + 1;

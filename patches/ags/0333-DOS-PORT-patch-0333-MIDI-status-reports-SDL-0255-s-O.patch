 // shutdown_sound()) still reports the real final state instead of the
 // "never opened" NA sentinel. Left at "NA" if the device was never
 // opened at all, so that genuine case is still distinguishable.
-char g_last_status[1024] = "NA"; // patch 0252: 512 -> 640, room for mixed=,...,inflight= beside 0213's fields; patch 0275: 640 -> 768; patch 0331: -> 1024
+char g_last_status[1280] = "NA"; // patch 0252: 512 -> 640, room for mixed=,...,inflight= beside 0213's fields; patch 0275: 640 -> 768; patch 0331: -> 1024; patch 0333: -> 1280
 
 void format_status_string(char *buf, size_t bufsize)
 {
@@ -178,7 +178,7 @@ void format_status_string(char *buf, size_t bufsize)
     const int bits = static_cast<int>(SDL_AUDIO_BITSIZE(fmt));
     const char chan_letter = (DOS_AUDIO_MIXER_CHANNELS == 1) ? 'm' : 's';
     const char *device = g_gus_backend ? "gus" : "sb";
-    char midi_fragment[640]; // DOS-PORT (patch 0275): 320 -> 400, room for plan_behind_at=; patch 0331: -> 640
+    char midi_fragment[768]; // DOS-PORT (patch 0275): 320 -> 400, room for plan_behind_at=; patch 0331: -> 640; patch 0333: -> 768
     // DOS-PORT (Sound milestone, S4): dos_midi_backend owns the real
     // "midi=<backend>,events=<n>" fragment now -- S1 hardcoded ";midi=none"
     // here since no MIDI backend existed yet.
@@ -642,7 +642,7 @@ const char *dos_audio_mixer_status_string()
 {
     if (!g_stream && !g_gus_open)
         return g_last_status; // "NA" if never opened, else the shutdown-time snapshot
-    static char buf[1024];   // patch 0252: 512 -> 640; patch 0275: 640 -> 768; patch 0331: -> 1024
+    static char buf[1280];   // patch 0252: 512 -> 640; patch 0275: 640 -> 768; patch 0331: -> 1024; patch 0333: -> 1280
     format_status_string(buf, sizeof(buf));
     return buf;
 }

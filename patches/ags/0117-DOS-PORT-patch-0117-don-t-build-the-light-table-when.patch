 Common/gfx/allegrobitmap.h   |   4 +
 Engine/ac/region.cpp         | 294 +++++++++++++++++++----------------
 3 files changed, 194 insertions(+), 133 deletions(-)

diff --git a/Common/gfx/allegrobitmap.cpp b/Common/gfx/allegrobitmap.cpp
index 7c073f142..053534b06 100644
--- a/Common/gfx/allegrobitmap.cpp
+++ b/Common/gfx/allegrobitmap.cpp
@@ -379,6 +379,26 @@ void Bitmap::AAStretchBlt(const Bitmap *src, const Rect &src_rc, const Rect &dst
 // pixel loop), not a visual glitch.
 long dos_port_transblend_calls = 0;
 long dos_port_litblend_calls = 0;
+
+// DOS-PORT patch 0116: the lazy hook for the light table.
+//
+// These two methods are the ONLY route from AGS into Allegro's 8-bit
+// blenders, and so the only way the global color_map is ever
+// dereferenced (libsrc/allegro/src/c/cdefs8.h, reached via vtable8.c).
+// Patch 0116 stops building that table when nothing in the room can
+// darken, so if a SCRIPT enables darkening later the table has to be
+// built before the first blend -- here.
+//
+// A function pointer rather than a direct call because Common/ must not
+// depend on Engine/, where the table and the palette state live. Engine
+// installs it in generate_light_table() (Engine/ac/region.cpp).
+//
+// If it is null the blend still proceeds: color_map is never left null
+// once the engine has run, it points at an identity table, so a missed
+// or uninstalled hook renders one blend unblended instead of faulting.
+// That matters because cspr.h:545 dereferences color_map before the pixel
+// loop -- there is no graceful degradation available at the Allegro end.
+void (*dos_port_ensure_color_map)(void) = nullptr;
 #endif
 
 void Bitmap::TransBlendBlt(const Bitmap *src, int dst_x, int dst_y)
@@ -386,6 +406,13 @@ void Bitmap::TransBlendBlt(const Bitmap *src, int dst_x, int dst_y)
 	BITMAP *al_src_bmp = src->_alBitmap;
 #ifdef __DJGPP__
 	dos_port_transblend_calls++;
+	// Hooked as well as LitBlendBlt: Engine/ac/draw.cpp:1447 reaches this
+	// path on `src_has_alpha && alpha == 0xFF` with NO colour-depth test,
+	// so an 8-bit game with SPF_ALPHACHANNEL set on a sprite can land in
+	// _linear_draw_trans_sprite8. Pathological but not impossible, and
+	// hooking only the lit path would leave it as the crash.
+	if (dos_port_ensure_color_map != nullptr)
+		dos_port_ensure_color_map();
 #endif
 	draw_trans_sprite(_alBitmap, al_src_bmp, dst_x, dst_y);
 }
@@ -395,6 +422,8 @@ void Bitmap::LitBlendBlt(const Bitmap *src, int dst_x, int dst_y, int light_amou
 	BITMAP *al_src_bmp = src->_alBitmap;
 #ifdef __DJGPP__
 	dos_port_litblend_calls++;
+	if (dos_port_ensure_color_map != nullptr)
+		dos_port_ensure_color_map();
 #endif
 	draw_lit_sprite(_alBitmap, al_src_bmp, dst_x, dst_y, light_amount);
 }

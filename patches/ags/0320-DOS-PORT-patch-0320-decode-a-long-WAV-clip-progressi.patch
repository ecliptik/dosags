+// DOS-PORT patch 0320: decodes a progressive clip's samples [ready, upto) into its device buffer, in the device
+// format (the same per-sample conversion as convert_to_device_format()). Completing it releases the source bytes
+// it held and, with DOSAGS_PCM_INCR_VERIFY=1, compares the whole buffer with decode_clip()'s.
+void pcm_progress_to(const DosDecodedPcm &p, size_t upto)
+{
+    if (upto > p.samples)
+        upto = p.samples;
+    if (p.ready >= upto)
+        return;
+    const size_t a = p.ready, n = upto - a;
+    std::vector<int16_t> tmp(n);
+    dos_audio_decode_range(p.range, a, n, tmp.data());
+    if (p.fmt == SDL_AUDIO_U8)
+    {
+        for (size_t k = 0; k < n; k++)
+            p.device[a + k] = static_cast<uint8_t>((tmp[k] >> 8) + 128);
+    }
+    else
+        std::memcpy(p.device.data() + a * sizeof(int16_t), tmp.data(), n * sizeof(int16_t));
+    p.ready = upto;
+    g_pcm_incr_slices++;
+    if (p.ready == p.samples)
+    {
+        g_pcm_incr_done++;
+        static int verify = -1;
+        if (verify < 0) { const char *e = SDL_getenv("DOSAGS_PCM_INCR_VERIFY"); verify = (e && e[0] == '1') ? 1 : 0; }
+        if (verify == 1 && p.keep)
+        {
+            const std::shared_ptr<const DosDecodedPcm> whole = decode_clip(p.keep->data(), p.keep->size(), p.fmt);
+            g_pcm_incr_verified++;
+            if (!whole || whole->samples != p.samples || whole->device != p.device)
+                g_pcm_incr_mismatches++;
+        }
+        p.keep.reset();
+    }
+}
+
+// DOS-PORT patch 0320: a WAV PCM clip longer than two chunks, whose bytes stay alive (the sound cache's buffer),
+// is decoded progressively: its first chunk now, the rest as GetData() reaches it (opt-in: DOSAGS_PCM_INCR=1; default whole).
+std::shared_ptr<const DosDecodedPcm> decode_clip_start(const std::shared_ptr<std::vector<uint8_t>> &bytes,
+    const uint8_t *src, size_t src_size, SDL_AudioFormat fmt)
+{
+    static int incr = -1;
+    if (incr < 0) { const char *e = SDL_getenv("DOSAGS_PCM_INCR"); incr = (e && e[0] == '1') ? 1 : 0; }
+    DosPcmRangeSource range;
+    if (incr == 1 && bytes && src == bytes->data() && dos_audio_wav_range_source(src, src_size, range) &&
+        range.out_total > 2u * DECODED_CHUNK_SAMPLES)
+    {
+        std::shared_ptr<DosDecodedPcm> dec = std::make_shared<DosDecodedPcm>();
+        dec->samples = range.out_total;
+        dec->fmt = fmt;
+        dec->device.resize(range.out_total * (fmt == SDL_AUDIO_U8 ? 1u : sizeof(int16_t)));
+        dec->range = range;
+        dec->keep = bytes;
+        dec->ready = 0u;
+        g_pcm_incr++;
+        pcm_progress_to(*dec, DECODED_CHUNK_SAMPLES);
+        return dec;
+    }
+    return decode_clip(src, src_size, fmt);
+}
 } // namespace
 

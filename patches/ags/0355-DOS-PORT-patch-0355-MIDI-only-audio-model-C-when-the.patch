 // DOS-PORT patch 0252: PCM chunk accounting. Every chunk mixed while a voice
 // was active. SDL 0192 keeps the SB silence gate off while content is active,
@@ -196,7 +216,7 @@ void format_status_string(char *buf, size_t bufsize)
     const SDL_AudioFormat fmt = dos_audio_mixer_format();
     const int bits = static_cast<int>(SDL_AUDIO_BITSIZE(fmt));
     const char chan_letter = (DOS_AUDIO_MIXER_CHANNELS == 1) ? 'm' : 's';
-    const char *device = g_gus_backend ? "gus" : "sb";
+    const char *device = g_gus_backend ? "gus" : (g_null_open ? "none" : "sb"); // DOS-PORT patch 0355
     char midi_fragment[1136]; // DOS-PORT (patch 0275): 320 -> 400, room for plan_behind_at=; patch 0331: -> 640; patch 0333: -> 768; patch 0341: -> 1088 (worst case 1060 B with the RTC pump's and 0330-0333's fields, LAB-JOURNEYS 8.37); patch 0346: -> 1136 (preroll=, <= 48 B)
     // DOS-PORT (Sound milestone, S4): dos_midi_backend owns the real
     // "midi=<backend>,events=<n>" fragment now -- S1 hardcoded ";midi=none"
@@ -205,7 +225,7 @@ void format_status_string(char *buf, size_t bufsize)
     // DOS-PORT: 48 -> 96 (patch 0347), -> 128 (patch 0348), -> 160 (patch 0350: the six fields' "name=" strings are
     // 78 B, plus 6 x 10 digits = 138 B + NUL).
     char irq_fragment[160];
-    if (g_gus_backend)
+    if (g_gus_backend || g_null_open) // DOS-PORT patch 0355: no SB IRQ in model C either
         std::snprintf(irq_fragment, sizeof(irq_fragment),
             "pcm_irqs=NA,silent_irqs=NA,start_latency_irqs=NA,primes=NA,prime_retries=NA,topup_holds=NA");
     else
@@ -215,7 +235,7 @@ void format_status_string(char *buf, size_t bufsize)
             (unsigned)g_start_latency_irqs, (unsigned)g_primes,
             (unsigned)g_prime_retries, (unsigned)g_topup_holds); // DOS-PORT patches 0347, 0348, 0349
     char ring_fragment[160];
-    if (g_gus_backend)
+    if (g_gus_backend || g_null_open) // DOS-PORT patch 0355: no SB ring in model C either
         std::snprintf(ring_fragment, sizeof(ring_fragment),

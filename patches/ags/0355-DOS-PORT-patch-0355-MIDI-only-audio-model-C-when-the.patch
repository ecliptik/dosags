diff --git a/Engine/platform/base/sys_main.cpp b/Engine/platform/base/sys_main.cpp
index 97e64f878..20adfcf8f 100644
--- a/Engine/platform/base/sys_main.cpp
+++ b/Engine/platform/base/sys_main.cpp
@@ -308,6 +308,36 @@ void sys_renderer_set_output(const String &name)
 // too, not just PCM. Attempting-and-failing-into-model-B is what this fix
 // replaces; GUS now takes its own branch that never attempts the SB/
 // SDL_INIT_AUDIO path to begin with.
+//
+// DOS-PORT patch 0355 (model C, MIDI-only): reached ONLY from the two SB-path
+// failure returns below (no BLASTER / no DSP answered / the stream would not
+// open), never on the GUS path and never when the SB opens. Before it, those
+// returns disabled ALL audio, so an AdLib-only (OPL at 388h) or MPU-401-only
+// machine played no music although its MIDI sinks need no SB at all
+// (opl3_sink and waveblaster_sink drive their ports directly; the MPU port
+// defaults to 330h without BLASTER). Model C keeps the audio core and the MIDI
+// backend running and opens the mixer with NO PCM device: PCM voices are
+// drained against uclock() at the device rate and discarded, so a clip still
+// ends after its real duration (see dos_audio_mixer_init_midi_only()). The
+// MIDI tick is the main-loop poll: the ISR replay (patch 0207) and the RTC
+// pump (kind 3) are both released by the SB IRQ, which does not exist here
+// (SDL_DOSMidiDeferEnable() refuses without an open SB device and
+// SDL_DOSMidiDeferIrqNow() stays 0, so MidiIsrBegin() already picks poll).
+// Only for a hint naming a MIDI backend this port can open without the SB --
+// unset/auto/opl3 (OPL) or wb (MPU-401); "none", "adlib" (fails closed, see
+// dos_midi_backend.h) or anything else keep the old all-audio-off result.
+static bool sys_audio_init_midi_only(const char *backend_hint)
+{
+    const char *h = (backend_hint && backend_hint[0]) ? backend_hint : "auto";
+    if (SDL_strcasecmp(h, "auto") != 0 && SDL_strcasecmp(h, "opl3") != 0 && SDL_strcasecmp(h, "wb") != 0)
+        return false;
+    if (!dos_audio_mixer_init_midi_only())
+        return false;
+    Debug::Printf(kDbgMsg_Info, "DOS audio mode: MIDI-only (model C) -- no Sound Blaster PCM device; "
+        "MIDI backend %s, main-loop poll tick; PCM clips are silent and end after their real duration", h);
+    return true;
+}
+
 bool sys_audio_init(const String &driver_name)
 {
     (void)driver_name;
@@ -366,13 +396,13 @@ bool sys_audio_init(const String &driver_name)
     if (!SDL_InitSubSystem(SDL_INIT_AUDIO))
     {
         Debug::Printf(kDbgMsg_Error, "Failed to init SDL audio subsystem: %s", SDL_GetError());
-        return false;
+        return sys_audio_init_midi_only(backend_hint); // DOS-PORT patch 0355: model C, else false as before
     }
     if (!dos_audio_mixer_init())
     {
         Debug::Printf(kDbgMsg_Error, "Failed to open DOS audio device");
         SDL_QuitSubSystem(SDL_INIT_AUDIO);
-        return false;
+        return sys_audio_init_midi_only(backend_hint); // DOS-PORT patch 0355: model C, else false as before
     }
     gl_SysMainInfo.SDLSubsystems |= SDL_INIT_AUDIO;
     Debug::Printf(kDbgMsg_Info, "DOS audio device opened: %s", dos_audio_mixer_status_string());

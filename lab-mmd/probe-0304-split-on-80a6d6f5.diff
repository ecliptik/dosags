+#ifdef __DJGPP__
+// DOS-PORT probe 0304 (LAB ONLY, never in patches/): split the script event into the outermost VM
+// run, SCMD_CALLEXT marshalling and the API bodies (LAB-MMD.md 16.2). Raw uclock_t sums, converted
+// at dump; every read counted so its cost can be corrected. Nested runs started from inside an API
+// body count as API. DOSAGS_SPLIT=0 keeps the counts but takes no clock reads (check (a)).
+#include <time.h>
+extern int dp_split_in_evt;
+static int dp_split_on = -1, dp_split_depth = 0, dp_split_in_api = 0;
+static long long dp_split_run_t = 0, dp_split_marsh_t = 0, dp_split_api_t = 0, dp_split_reads = 0;
+static long dp_split_runs = 0, dp_split_ext = 0;
+static long long dp_split_pair_t = -1;
+static inline bool dp_split_active() { return dp_split_in_evt > 0 && dp_split_in_api == 0; }
+static inline void dp_split_init()
+{
+    if (dp_split_on >= 0) return;
+    const char *e = getenv("DOSAGS_SPLIT"); dp_split_on = (e && atoi(e) == 0) ? 0 : 1;
+    long long pair = 0;
+    for (int i = 0; i < 1000; ++i) { const uclock_t a = uclock(); const uclock_t b = uclock(); pair += (long long)(b - a); }
+    dp_split_pair_t = pair; // raw uclock ticks for 1000 back-to-back pairs
+}
+static inline uclock_t dp_split_now() { if (!dp_split_on) return 0; dp_split_reads++; return uclock(); }
+struct DpSplitRunScope
+{
+    bool timed; uclock_t t0;
+    DpSplitRunScope() : timed(false), t0(0)
+    {
+        dp_split_init();
+        if (dp_split_active() && dp_split_depth++ == 0) { timed = true; dp_split_runs++; t0 = dp_split_now(); }
+    }
+    ~DpSplitRunScope()
+    {
+        if (timed) { dp_split_run_t += (long long)(dp_split_now() - t0); dp_split_depth = 0; }
+        else if (dp_split_active() && dp_split_depth > 0) dp_split_depth--;
+    }
+};
+void dp_split_dump()
+{
+    Debug::Printf("DOS-PORT split on=%d runs=%ld callext=%ld reads=%ld run_t=%ld marsh_t=%ld api_t=%ld pair1000_t=%ld ucps=%ld",
+        dp_split_on, dp_split_runs, dp_split_ext, (long)dp_split_reads, (long)dp_split_run_t,
+        (long)dp_split_marsh_t, (long)dp_split_api_t, (long)dp_split_pair_t, (long)UCLOCKS_PER_SEC);
+}
+#endif

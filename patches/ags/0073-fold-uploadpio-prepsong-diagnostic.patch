+// S7-GUS continuation: same rollup-of-rollups shape, plus a running byte
+// total (not a mean -- bytes transferred is additive, not per-call-cost).
+void dos_diag_record_uploadpio(uint32_t calls, uint32_t min_us, uint32_t mean_us, uint32_t max_us, uint32_t bytes)
+{
+    if (calls == 0)
+        return;
+    AudioPollDiag &d = g_audio_poll_diag;
+    d.uploadpio_calls_sum += calls;
+    d.uploadpio_us_sum += (uint64_t)mean_us * calls;
+    d.uploadpio_bytes_sum += bytes;
+    if ((uint64_t)min_us < d.uploadpio_min_us) d.uploadpio_min_us = min_us;
+    if ((uint64_t)max_us > d.uploadpio_max_us) d.uploadpio_max_us = max_us;
+}
+
+void dos_diag_record_uploadsample(uint32_t calls, uint32_t min_us, uint32_t mean_us, uint32_t max_us, uint32_t bytes)
+{
+    if (calls == 0)
+        return;
+    AudioPollDiag &d = g_audio_poll_diag;
+    d.uploadsample_calls_sum += calls;
+    d.uploadsample_us_sum += (uint64_t)mean_us * calls;
+    d.uploadsample_bytes_sum += bytes;
+    if ((uint64_t)min_us < d.uploadsample_min_us) d.uploadsample_min_us = min_us;
+    if ((uint64_t)max_us > d.uploadsample_max_us) d.uploadsample_max_us = max_us;
+}
+
+void dos_diag_record_prepsong(uint32_t calls, uint32_t min_us, uint32_t mean_us, uint32_t max_us)
+{
+    if (calls == 0)
+        return;
+    AudioPollDiag &d = g_audio_poll_diag;
+    d.prepsong_calls_sum += calls;
+    d.prepsong_us_sum += (uint64_t)mean_us * calls;
+    if ((uint64_t)min_us < d.prepsong_min_us) d.prepsong_min_us = min_us;
+    if ((uint64_t)max_us > d.prepsong_max_us) d.prepsong_max_us = max_us;
+}
+
 } // anonymous namespace
 

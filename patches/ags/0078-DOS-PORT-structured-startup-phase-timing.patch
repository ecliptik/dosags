diff --git a/Engine/main/dos_port_startup_timing.h b/Engine/main/dos_port_startup_timing.h
new file mode 100644
index 000000000..6a0e99f5d
--- /dev/null
+++ b/Engine/main/dos_port_startup_timing.h
@@ -0,0 +1,70 @@
+//=============================================================================
+//
+// Adventure Game Studio (AGS)
+//
+// Copyright (C) 1999-2011 Chris Jones and 2011-2026 various contributors
+// The full list of copyright holders can be found in the Copyright.txt
+// file, which is part of this source code distribution.
+//
+// The AGS source code is provided under the Artistic License 2.0.
+// A copy of this license can be found in the file License.txt and at
+// https://opensource.org/license/artistic-2-0/
+//
+//=============================================================================
+//
+// DOS-PORT patch 0078: startup-phase timing, from process start to the
+// first interactive frame. Real phase boundaries read from source
+// (initialize_engine()'s own call order, main/engine.cpp; load_game_file(),
+// main/game_file.cpp), not guessed -- see that patch's own commit message
+// for the exact source citations.
+//
+// Each *_ms field is -1 ("not yet measured") until its own bracket closes;
+// the report at first-room-ready (ac/event.cpp) only prints fields that
+// are actually >= 0, so a field whose own instrumentation point was never
+// reached (shouldn't happen on the normal boot path, but a game that
+// fails partway through init might) never prints a fabricated number.
+//
+// One shared struct instance (main.cpp), not a dozen loose scalar
+// globals, so the report line can iterate/validate every field together
+// and the slowest-N precache array has somewhere sane to live.
+//
+//=============================================================================
+#ifndef __AGS_EE_MAIN__DOS_PORT_STARTUP_TIMING_H
+#define __AGS_EE_MAIN__DOS_PORT_STARTUP_TIMING_H
+
+#ifdef __DJGPP__
+
+// Caller must already have <time.h> included for uclock_t/uclock()/
+// UCLOCKS_PER_SEC -- not included here to avoid pulling it into every
+// translation unit that only wants the struct declaration.
+extern uclock_t dos_port_engine_start_uclock; // main.cpp
+
+static inline long dos_port_uclock_ms_since_start()
+{
+    return (long)((uclock() - dos_port_engine_start_uclock) * 1000 / UCLOCKS_PER_SEC);
+}
+
+struct DosPortStartupTiming
+{
+    long subsystem_init_ms = -1;      // engine_init_fonts..engine_init_debug
+    long gamedata_asset_load_ms = -1; // game_file.cpp: OpenMainGameFileFromDefaultAsset+ReadGameData..UpdateGameData/TryLoadGameScripts
+    long script_vm_init_ms = -1;      // game_file.cpp: InitGameState() (create_game_scripts() is inside it)
+    long gfxmode_init_ms = -1;        // engine_try_set_gfxmode_any()
+    long sprite_index_init_ms = -1;   // engine_init_sprites()
+    long sprite_precache_ms = -1;     // engine_init_game_settings()'s precache_view() calls, aggregate
+    int  precache_view_count = 0;
+    int  precache_frame_count = 0;
+    // Slowest 3 precache_view() calls by their own total ms (view id, ms),
+    // insertion-sorted descending in ac/game.cpp. -1/-1 means "no Nth call".
+    struct { int view = -1; long ms = -1; } precache_slowest[3];
+    long first_room_load_start_ms = -1;    // room.cpp load_new_room()'s own t_ms, first call only (temp holding value)
+    long first_room_load_ms = -1;          // room.cpp load_new_room() start .. event.cpp AfterFadein ready (final)
+    bool reported = false;            // report emitted once, at the first room-ready event
+};
+
+// Defined in main.cpp, alongside dos_port_engine_start_time/_uclock.
+extern DosPortStartupTiming dos_port_startup_timing;
+
+#endif // __DJGPP__
+
+#endif // __AGS_EE_MAIN__DOS_PORT_STARTUP_TIMING_H

// AutoPilot.asc -- the test harness's in-game driver. See
// tests/harness/README.md and PLAN.md's "Test harness (AGS Quest)"
// section for the design this implements.
//
// Armed only when game.debug_mode is true (i.e. only under --test), so
// the same package plays normally otherwise. Driven entirely by AGS
// script features (System.Log, *.RunInteraction, SaveGameSlot/
// RestoreGameSlot, QuitGame) -- never OS-level input injection.
//
// Every phase boundary logs one line, to both System.Log (-> stdout via
// --log-stdout=+mgs:all) and $SAVEGAMEDIR$/AUTOPLT.LOG:
//   AUTOPILOT phase=<name> status=<begin|ok|fail> tick=<TickCounter> room=<n> [k=v ...]
//
// Room-local Hotspots/Objects (e.g. hBench, oDoor1) are NOT visible to
// this module by name -- AGS only auto-generates those import
// declarations into the room script that owns them (Editor's
// Tasks.RegenerateScriptHeader, AppendRoomObjectsAndHotspotsToHeader,
// gated on the room currently open for editing). This module reaches
// them via Hotspot.GetByName()/Object.GetByName() instead.
//
// Hotspot/Object.RunInteraction() is itself DEFERRED, not synchronous
// -- Engine/script/script.cpp's run_interaction_script() queues the
// target function via QueueScriptFunction() rather than calling it
// inline (confirmed empirically: a HasInventory() check immediately
// after RunInteraction() reads stale state; the queued call actually
// ran several phases later, once the interpreter drained the queue).
// So every RunInteraction/RunObject this module issues is followed by
// a POLL (in repeatedly_execute, checking every frame) for its actual
// side effect, with a generous tick timeout -- never an immediate
// check. Room-changing interactions are the exception: those are
// confirmed by the real eEventEnterRoomAfterFadein event instead of a
// poll, since that fires only once the change has genuinely happened.
//
// Blocking calls (player.Walk with eBlock, WaitMouseKey, Wait, etc.)
// only run safely from repeatedly_execute (non-"_always") or a room's
// own AfterFadeIn -- never game_start or repeatedly_execute_always,
// both of which hard-quit() on a blocking call. All of this module's
// actual game-driving work happens in repeatedly_execute; on_event only
// sets flags/advances step (room transitions and SaveGameSlot/
// RestoreGameSlot are themselves deferred, non-blocking calls -- see
// Engine/ac/global_room.cpp's NewRoom and Engine/ac/global_game.cpp's
// SaveGameSlot/RestoreGameSlot, both just QueueAction and return).

int step;               // fine-grained state; part of save-game data
int entered_room;       // last room confirmed via eEventEnterRoomAfterFadein
int wait_deadline;       // TickCounter value a poll step gives up at
bool menu_clicked;       // one-shot guard for the menu phase's btnPlay click
bool cup_placing;        // which interior cup branch STEP_INTERIOR_CUP_WAIT is polling for
bool shot1_ok;           // SaveScreenShot("PH01.BMP") result -- room3, forest, settled
bool shot2_ok;           // SaveScreenShot("PH02.BMP") result -- room4, treehouse interior
bool shot3_ok;           // SaveScreenShot("PH03.BMP") result -- room3, balcony
int anim_frame0;         // oChandelier.Frame sampled at STEP_ANIM_WAIT entry
bool anim_sampled;       // one-shot guard: has anim_frame0 been sampled yet

#define STEP_BOOT 0
#define STEP_SPLASH 1
#define STEP_MENU 2
#define STEP_SETTLE 3
#define STEP_KEY_GO 4
#define STEP_KEY_WAIT 5
#define STEP_UNLOCK_GO 6
#define STEP_UNLOCK_WAIT 7
#define STEP_ENTER_GO 8
#define STEP_INTERIOR_WASH_GO 9
#define STEP_INTERIOR_WASH_WAIT 10
#define STEP_INTERIOR_CUP_GO 11
#define STEP_INTERIOR_CUP_WAIT 12
#define STEP_EXIT_GO 14
#define STEP_GEM_TO_ROOM4 15
#define STEP_GEM_TO_BALCONY 16
#define STEP_GEM_PICKUP_GO 17
#define STEP_GEM_PICKUP_WAIT 18
#define STEP_GEM_TO_INTERIOR 19
#define STEP_GEM_TO_GROUND 20
#define STEP_GEM_FOREST_GO 21
#define STEP_AUDIO 22
#define STEP_SHOTS 23
#define STEP_QUIT 24
#define STEP_DONE 25
#define STEP_DIALOG_SETTLE 26
// slice 8: appended out of logical sequence order, same precedent as
// STEP_DIALOG_SETTLE above -- values aren't renumbered when a phase is
// inserted into the middle of the existing walkthrough.
#define STEP_ANIM_WAIT 27
#define STEP_GUIMENU_WAIT 28

// The settle window (~3s of ticks) is the only fixed-duration wait;
// everything else waits ONLY on the poll's own success/timeout check.
#define SETTLE_TICKS_MULT 3
#define POLL_TICKS_MULT 20

// The dialog's default (no custom GUI, DialogOptionsGUI=0 -- see
// Engine/ac/dialog.cpp's OPT_DIALOGIFACE <= 0 check) plain-surface
// options render as a full-width text list anchored to the BOTTOM of the
// 640x360 screen. "Leave" is the dialog's own last always-on option (ID
// 14) -- picked because it needs no further game state (unlike the
// inventory-gated branch under "Objects and Inventory" -> "Inventory",
// which would need a second, differently-positioned click this design
// doesn't attempt). Coordinates found by reading the real rendered
// screen (a live DOSBox-X capture while the options screen sat waiting
// for input), not computed from font metrics -- see PLAN.md's
// eleventh-session "Current state" section.
#define DIALOG_LEAVE_X 150
#define DIALOG_LEAVE_Y 354

void WriteLog(const string line)
{
  System.Log(eLogInfo, "%s", line);
  File *f = File.Open("$SAVEGAMEDIR$/AUTOPLT.LOG", eFileAppend);
  if (f != null) {
    f.WriteRawLine(line);
    f.Close();
  }
}

void LogNamed(const string name, const string status, int room)
{
  WriteLog(String.Format("AUTOPILOT phase=%s status=%s tick=%d room=%d", name, status, Game.TickCounter, room));
}

// AGS's compiler does not allow chaining a method call directly onto
// another call's return value (Hotspot.GetByName("x").RunInteraction(m)
// fails to compile with "structure required on left side of '.'") --
// these go through an intermediate local instead.
void RunHotspot(const string name, CursorMode mode)
{
  Hotspot *h = Hotspot.GetByName(name);
  h.RunInteraction(mode);
}

void RunObject(const string name, CursorMode mode)
{
  Object *o = Object.GetByName(name);
  o.RunInteraction(mode);
}

void ArmPoll()
{
  wait_deadline = Game.TickCounter + GetGameSpeed() * POLL_TICKS_MULT;
}

// Kicks off the dialog phase once interior's own object/inventory work
// is done. Shared by both STEP_INTERIOR_WASH_WAIT's and
// STEP_INTERIOR_CUP_WAIT's "interior" completion branches, which
// otherwise duplicate this transition.
//
// Uses Dialog.DisplayOptions(), not Dialog.Start()/dRedMage.Start().
// Three real, empirically-confirmed engine facts ruled out every other
// path tried first (see PLAN.md's eleventh-session "Current state" for
// the full account):
//  1. cRedMage.RunInteraction(eModeTalkto) (a real player's own click
//     path, via GlobalScript.asc's cRedMage_AnyClick) branches on the
//     GLOBAL Mouse.Mode, not on RunInteraction's own mood argument --
//     nothing sets Mouse.Mode there, so the interaction silently no-ops.
//     Mouse.Mode only gets set by this room's own per-tick
//     GetLocationType(mouse.x,mouse.y) check, so the mouse has to
//     already be positioned over cRedMage for at least one full tick
//     first.
//  2. dRedMage.Start() (== RunDialog(), which always runs option 0 --
//     the "@S" entry point -- first) is ITSELF deferred when called
//     from script (Engine/ac/global_dialog.cpp's RunDialogOption():
//     "if (inside_script) get_executingscript()->QueueAction(...); else
//     do_conversation(dlg);" -- script is always inside_script), NOT a
//     synchronous blocking call like player.Walk(...,eBlock). Worse,
//     @S's own intro text ("What would you like to learn about?") runs
//     as an ordinary blocking Say() BEFORE the options screen exists,
//     and that Say()'s own per-frame housekeeping drains any
//     already-queued click regardless of the IgnoreUserInputAfterText-
//     TimeoutMs debounce (which only gates whether a drained click is
//     ACTED on, not whether it gets drained) -- so a click queued before
//     Start() is silently wasted before the options screen ever exists
//     to see it.
//  3. Dialog.DisplayOptions() sidesteps both: Engine/ac/dialog.cpp's own
//     Dialog_DisplayOptions() calls show_dialog_options() directly, with
//     no inside_script/QueueAction detour and no "@S" intro text --  it
//     shows the options screen immediately and synchronously, then hands
//     the chosen option's ID straight back to script (never running that
//     option's own topic script, which this phase does not need).
//
// The one remaining requirement -- Mouse.SetPosition() updates
// sys_mouse_x/y (where a Click() injects) immediately, but the SEPARATE
// mousex/mousey pair DialogOptions::Run() actually hover-tests against
// is only refreshed by Mouse::Poll(), a once-per-tick sync -- so
// Click() still needs at least one tick's gap after SetPosition(), the
// same class of settle requirement fact 1 above already needed for
// Mouse.Mode.
void StartDialogPhase()
{
  LogNamed("dialog", "begin", entered_room);
  Mouse.SetPosition(DIALOG_LEAVE_X, DIALOG_LEAVE_Y);
  wait_deadline = Game.TickCounter + 2;
  step = STEP_DIALOG_SETTLE;
}

// slice 8: runs once room 4's own interior object/inventory work is done.
// Confirms room4.asc's own always-running chandelier animation
// (room_Load(): "oChandelier.SetView(4); oChandelier.Animate(0, 4,
// eRepeat, eNoBlock);" -- looping, non-blocking, started by the room
// itself, not by this module) is actually advancing frame by frame, not
// just nominally "on". Object.Frame is sampled twice, spaced by a poll
// window, rather than trusting Object.Animating alone: a bare flag
// wouldn't catch a stuck-but-still-"cycling" bug, while a real frame
// value change is direct proof playback is advancing. Both
// Object.Animating (IsObjectAnimating()) and Object.Frame read the same
// per-game-loop animation state the engine's own update sets every tick
// (Engine/ac/object.cpp) -- no script call is needed to arm this check,
// only to observe it.
void StartAnimPhase()
{
  LogNamed("anim", "begin", entered_room);
  anim_sampled = false;
  step = STEP_ANIM_WAIT;
}

// slice 8: the audio/shots/quit tail end of the walkthrough, split out of
// what used to be an inline block at the end of the STEP_GEM_TO_GROUND
// on_event branch so the new guimenu phase's own success AND fail/timeout
// paths can both reach the same, already-reviewed tail without
// duplicating it. Named rm, not room, to avoid shadowing AGS's own
// global "room" variable.
void FinishRun(int rm)
{
  LogNamed("audio", "begin", rm);
  // slice 4 (pre-Sound-milestone): our own overlay clips (SB PCM WAV +
  // MIDI, since stock AGS Quest ships OGG-only SFX and no music at all)
  // exercised the audio-clip-loading/parsing path end to end while audio
  // itself was still stubbed at the engine level -- a single
  // fire-and-forget Play() was enough, since there was nothing to
  // observe either way.
  //
  // S1 (Sound milestone) landed real PCM playback, which makes a single
  // ~240ms Play() useless for a REAL-HARDWARE capture: vcctrl's line-out
  // feed needs a genuine, sustained audible window to poll against, and
  // the very next lines here call QuitGame(), tearing the audio device
  // down almost immediately. So this phase now plays the existing chime
  // on repeat for several real seconds instead of a single blip -- same
  // CC0 asset, no new asset authored.
  //
  // Tried first: a manual script-side loop re-firing Play() every ~15
  // ticks. Confirmed harmless on-screen (all phases/screenshots still
  // matched under DOSBox-X) but RUNMANIFEST's own audio_vital_status
  // showed underruns=20 -- one per retrigger, versus underruns=0 for a
  // single Play() call in S1's own original validation -- almost
  // certainly the mixer's channel briefly starving at each re-trigger
  // boundary, not a persistent device fault. Switched to AudioClip's own
  // native repeat flag instead (Play(eAudioPriorityNormal, eRepeat)),
  // which loops at the engine/mixer level without the script re-issuing
  // Play() at all -- this is also the idiomatic way a real game loops
  // SFX/music, so it exercises what S1 actually needs to get right.
  // Wait() is safe here per this file's own header note (FinishRun runs
  // from repeatedly_execute, not an "_always" handler, so a blocking
  // call is fine).
  AudioChannel* chime_ch = aAutopilotChime.Play(eAudioPriorityNormal, eRepeat);
  Wait(300);
  if (chime_ch != null) chime_ch.Stop();
  // S4: mAutopilotTune (MIDI, generate_assets.py's build_midi()) now has a
  // real backend (shared/audio's midi_sched + OPL3 sink, hoisted by S3).
  // The tune is a fixed 8-note eighth-note melody at 96 PPQ / the SMF's
  // own default 500000us-per-quarter tempo (build_midi() emits no tempo
  // meta-event) -- 96/2 ticks * (500000/96) us = 250ms per note, 8 notes =
  // ~2s total. Wait(120) is 3s at the engine's default 40 ticks/s, a
  // comfortable margin over that ~2s so the whole melody (all 8 note-on/
  // note-off pairs plus the leading program-change) actually dispatches
  // before QuitGame() tears the sink down below -- a single fire-and-
  // forget Play() with no wait, like the chime originally had, would give
  // the scheduler at most one tick before the run ends, undercounting
  // audio_vital_status's own "events=" field the same way the chime's own
  // original ~240ms Play() undercounted a real-hardware capture window
  // (see this function's own comment above).
  mAutopilotTune.Play();
  Wait(120);
  LogNamed("audio", "ok", rm);
  LogNamed("shots", "begin", rm);
  // slice 5: the three inline SaveScreenShot() calls (settle/room3,
  // interior/room4, gem-balcony/room3) already did the real capturing
  // as each moment happened -- SaveScreenShot can only capture the
  // CURRENT frame, not retroactively, so this phase is a completion
  // check, not a capture trigger.
  if (shot1_ok && shot2_ok && shot3_ok) {
    LogNamed("shots", "ok", rm);
  } else {
    WriteLog(String.Format("AUTOPILOT shots_detail ph01=%d ph02=%d ph03=%d", shot1_ok, shot2_ok, shot3_ok));
    LogNamed("shots", "fail", rm);
  }
  step = STEP_QUIT;
  LogNamed("quit", "begin", rm);
  QuitGame(0);
}

bool PollTimedOut()
{
  return Game.TickCounter > wait_deadline;
}

function game_start()
{
  if (!game.debug_mode) return;
  // Auto-advance all Say()/Display() text purely on a timer, so the
  // whole run needs no simulated key/mouse input to get past dialogue.
  Speech.SkipStyle = eSkipTime;
  game.skip_display = eSkipTime;
  Game.TextReadingSpeed = 1000;
  Game.MinimumTextDisplayTimeMs = 50;
  // Engine/ac/display.cpp's own auto-timer-skip path calls
  // play.SetIgnoreInput() whenever text closes via SKIP_AUTOTIMER (i.e.
  // every single line the above skip settings ever close) -- a real
  // 500ms WALL-CLOCK debounce (GamePlayState::IsIgnoringInput() reads
  // Clock::now(), unrelated to DOSBox-X's own --fast tick rate) meant to
  // stop a text-dismissing click from also registering as the next
  // click. The dialog phase's own pre-queued Mouse.Click() (the only
  // script path to choose an option) is queued before dRedMage.Start()
  // even begins, i.e. before its own intro line's auto-skip fires this
  // same debounce -- confirmed empirically to silently eat that queued
  // click otherwise (Engine/main/game_run.cpp's RunControls() pops the
  // event off the queue regardless of IsIgnoringInput(), so it's not
  // just delayed, it's gone). Zero disables the debounce outright.
  Game.IgnoreUserInputAfterTextTimeoutMs = 0;
  // slice 4: our own OFL TTF font (id 3, overlay/assets/PressStart2P-
  // Regular.ttf) replaces the default WFN bitmap fonts for BOTH speech
  // (Character.Say -- room3's own intro cutscene) and narrator text
  // (Display/@OVERHOTSPOT@), set here so every render from the very
  // first frame on uses it -- exercises the TTF text path stock AGS
  // Quest (WFN-only) never touches.
  Game.NormalFont = 3;
  Game.SpeechFont = 3;
  step = STEP_BOOT;
  LogNamed("boot", "begin", 0);
}

function repeatedly_execute()
{


  if (!game.debug_mode) return;

  if (step == STEP_MENU) {
    if (!menu_clicked) {
      menu_clicked = true;
      btnPlay.Click(eMouseLeft);
    }
    return;
  }

  if (step == STEP_SETTLE) {
    if (Game.TickCounter > wait_deadline) {
      LogNamed("settle", "ok", entered_room);
      // slice 5: the "First room renders" milestone's own gate is "a
      // matching expected/ hash for the room-3 screenshot" -- capture
      // it here, the one genuinely static moment in this phase (before
      // any walking/interaction starts). SaveScreenShot's own filename
      // argument, with no "$...$" token prefix, resolves to
      // $SAVEGAMEDIR$ automatically (Engine/ac/global_game.cpp's
      // SaveScreenShot4) -- the same directory AUTOPLT.LOG already
      // lands in, so no new staging/collection work was needed.
      shot1_ok = (SaveScreenShot("PH01.BMP") == 1);
      player.Walk(88, 286, eBlock, eWalkableAreas);
      RunHotspot("hBench", eModeInteract);
      ArmPoll();
      step = STEP_KEY_WAIT;
      LogNamed("key", "begin", entered_room);
    }
    return;
  }

  if (step == STEP_KEY_WAIT) {
    if (player.HasInventory(iKey)) {
      LogNamed("key", "ok", entered_room);
    } else if (PollTimedOut()) {
      LogNamed("key", "fail", entered_room);
    } else {
      return; // keep waiting
    }
    LogNamed("unlock", "begin", entered_room);
    // ActiveInventory must stay set until the deferred RunObject call
    // below has actually run and consumed it -- oDoor1_AnyClick reads
    // player.ActiveInventory itself, and clearing it right after
    // issuing the (queued, not immediate) interaction cleared it
    // before the handler ever saw it. Cleared once the wait resolves.
    player.ActiveInventory = iKey;
    RunObject("oDoor1", eModeUseinv);
    ArmPoll();
    step = STEP_UNLOCK_WAIT;
    return;
  }

  if (step == STEP_UNLOCK_WAIT) {
    Object *door1 = Object.GetByName("oDoor1");
    if (door1.Graphic == 8) {
      LogNamed("unlock", "ok", entered_room);
    } else if (PollTimedOut()) {
      LogNamed("unlock", "fail", entered_room);
    } else {
      return; // keep waiting
    }
    player.ActiveInventory = null;
    LogNamed("enter", "begin", entered_room);
    RunHotspot("hEntrance", eModeInteract);
    step = STEP_ENTER_GO;
    // deferred room change -- room 4's own AfterFadein (on_event) confirms.
    return;
  }

  if (step == STEP_INTERIOR_WASH_WAIT) {
    if (player.HasInventory(iGem2) || PollTimedOut()) {
      Object *cup = Object.GetByName("oCupOnTable");
      if (player.HasInventory(iBlueCup)) {
        // Placing the held cup back on the table -- hTable_AnyClick
        // reads player.ActiveInventory itself, and only clears it (via
        // LoseInventory) once the deferred call actually runs, so it
        // must stay set until the wait below resolves, not right after
        // issuing the (queued, not immediate) interaction.
        cup_placing = true;
        player.ActiveInventory = iBlueCup;
        RunHotspot("hTable", eModeUseinv);
        ArmPoll();
        step = STEP_INTERIOR_CUP_WAIT;
      } else if (cup.Visible) {
        cup_placing = false;
        RunObject("oCupOnTable", eModeInteract);
        ArmPoll();
        step = STEP_INTERIOR_CUP_WAIT;
      } else {
        // cup already placed/gone -- nothing left to exercise here.
        LogNamed("interior", "ok", entered_room);
        StartAnimPhase();
      }
    }
    return;
  }

  if (step == STEP_INTERIOR_CUP_WAIT) {
    // Placing the cup succeeds when it's no longer held; picking it up
    // succeeds when it is -- opposite conditions for the two branches
    // STEP_INTERIOR_WASH_WAIT could have taken above.
    bool done;
    bool cup_ok;
    if (cup_placing) {
      cup_ok = !player.HasInventory(iBlueCup);
      done = cup_ok || PollTimedOut();
    } else {
      cup_ok = player.HasInventory(iBlueCup);
      done = cup_ok || PollTimedOut();
    }
    if (done) {
      if (cup_placing) player.ActiveInventory = null;
      if (cup_ok) {
        LogNamed("interior", "ok", entered_room);
      } else {
        LogNamed("interior", "fail", entered_room);
      }
      StartAnimPhase();
    }
    return;
  }

  if (step == STEP_ANIM_WAIT) {
    Object *chand = Object.GetByName("oChandelier");
    if (!anim_sampled) {
      anim_sampled = true;
      anim_frame0 = chand.Frame;
      ArmPoll();
    } else if (chand.Frame != anim_frame0) {
      WriteLog(String.Format("AUTOPILOT anim_detail frame0=%d frame1=%d animating=%d", anim_frame0, chand.Frame, chand.Animating));
      LogNamed("anim", "ok", entered_room);
      StartDialogPhase();
    } else if (PollTimedOut()) {
      WriteLog(String.Format("AUTOPILOT anim_detail frame0=%d frame1=%d animating=%d", anim_frame0, chand.Frame, chand.Animating));
      LogNamed("anim", "fail", entered_room);
      StartDialogPhase();
    }
    return;
  }

  if (step == STEP_GUIMENU_WAIT) {
    // btnOpenMenu.Click() (issued in on_event's STEP_GEM_TO_GROUND branch
    // below) is deferred via the same QueueScriptFunction() path as every
    // other RunInteraction/RunObject/RunHotspot call in this module
    // (Engine/ac/gui.cpp's process_interface_click(), confirmed by
    // reading it directly rather than assumed synchronous) -- so this is
    // a poll, same as everywhere else, not an immediate check.
    if (gInGameMenu.Visible) {
      LogNamed("guimenu", "ok", entered_room);
      btnOpenMenu.Click(eMouseLeft); // best-effort: close it back before quitting
      FinishRun(entered_room);
    } else if (PollTimedOut()) {
      LogNamed("guimenu", "fail", entered_room);
      FinishRun(entered_room);
    }
    return;
  }

  if (step == STEP_DIALOG_SETTLE) {
    if (PollTimedOut()) {
      Mouse.Click(eMouseLeft);
      // Dialog.DisplayOptions() is a plain synchronous BLOCKING call
      // (like player.Walk(...,eBlock) elsewhere in this module) -- see
      // StartDialogPhase()'s own comment for why this, and not
      // dRedMage.Start(), is what makes the pre-queued click above
      // actually reach the options screen. Returns the chosen option's
      // 1-based ID (14 == "Leave") without running that option's own
      // topic script -- exactly what this phase needs to confirm: the
      // coordinate-based click reached the right row, nothing more.
      int chosen = dRedMage.DisplayOptions();
      WriteLog(String.Format("AUTOPILOT dialog_detail chosen=%d", chosen));
      if (chosen == 14) {
        LogNamed("dialog", "ok", entered_room);
      } else {
        LogNamed("dialog", "fail", entered_room);
      }
      LogNamed("save", "begin", entered_room);
      // Advance step to STEP_EXIT_GO before saving, so the save
      // snapshot (and this live copy) both resume at the exit step once
      // restored -- see PLAN.md's engine facts on module-global
      // round-tripping.
      step = STEP_EXIT_GO;
      SaveGameSlot(1, "autopilot");
      // deferred -- eEventGameSaved (on_event) confirms completion.
    }
    return;
  }

  if (step == STEP_GEM_PICKUP_WAIT) {
    if (player.HasInventory(iGem)) {
      LogNamed("gem", "ok", entered_room);
    } else if (PollTimedOut()) {
      LogNamed("gem", "fail", entered_room);
    } else {
      return; // keep waiting
    }
    RunHotspot("hBackDoorway", eModeInteract);
    step = STEP_GEM_TO_INTERIOR;
    // deferred room change -- room 4's AfterFadein confirms.
    return;
  }
}

function on_event(EventType event, int data)
{
  if (!game.debug_mode) return;

  if (event == eEventEnterRoomAfterFadein) {
    entered_room = data;

    if (step == STEP_BOOT && data == 1) {
      LogNamed("boot", "ok", data);
      step = STEP_SPLASH;
      LogNamed("splash", "begin", data);
    }
    else if (step == STEP_SPLASH && data == 2) {
      LogNamed("splash", "ok", data);
      step = STEP_MENU;
      LogNamed("menu", "begin", data);
    }
    else if (step == STEP_MENU && data == 3) {
      LogNamed("menu", "ok", data);
      // intro's own cutscene (StartCutscene/EndCutscene in room3's own
      // room_FirstLoad) already ran to completion, auto-advanced by the
      // skip settings from game_start, before this AfterFadein fired --
      // so intro is already over by the time we see this event.
      LogNamed("intro", "begin", data);
      LogNamed("intro", "ok", data);
      step = STEP_SETTLE;
      LogNamed("settle", "begin", data);
      wait_deadline = Game.TickCounter + GetGameSpeed() * SETTLE_TICKS_MULT;
    }
    else if (step == STEP_ENTER_GO && data == 4) {
      LogNamed("enter", "ok", data);
      LogNamed("interior", "begin", data);
      shot2_ok = (SaveScreenShot("PH02.BMP") == 1);
      RunHotspot("hWashBasin", eModeInteract);
      ArmPoll();
      step = STEP_INTERIOR_WASH_WAIT;
    }
    else if (step == STEP_EXIT_GO && data == 3) {
      LogNamed("exit", "ok", data);
      LogNamed("gem", "begin", data);
      RunHotspot("hEntrance", eModeInteract);
      step = STEP_GEM_TO_ROOM4;
      // deferred room change -- room 4's AfterFadein confirms.
    }
    else if (step == STEP_GEM_TO_ROOM4 && data == 4) {
      RunHotspot("hUpperExit", eModeInteract);
      step = STEP_GEM_TO_BALCONY;
      // deferred room change -- room 3's AfterFadein (balcony) confirms.
    }
    else if (step == STEP_GEM_TO_BALCONY && data == 3) {
      shot3_ok = (SaveScreenShot("PH03.BMP") == 1);
      RunObject("oGem", eModeInteract);
      ArmPoll();
      step = STEP_GEM_PICKUP_WAIT;
    }
    else if (step == STEP_GEM_TO_INTERIOR && data == 4) {
      RunHotspot("hFrontExit", eModeInteract);
      step = STEP_GEM_TO_GROUND;
      // deferred room change -- room 3's AfterFadein (ground) confirms.
    }
    else if (step == STEP_GEM_TO_GROUND && data == 3) {
      RunHotspot("hForest", eModeInteract);
      // slice 8: btnOpenMenu is the real in-game-menu opener
      // (GlobalScript.asc's btnOpenMenu_OnClick toggles gInGameMenu --
      // the same GUI that hosts the Save/Load buttons per this game's own
      // feature inventory), made visible from room3.asc's room_FirstLoad
      // onward via gGameMenuOpener.Visible = true -- already true by this
      // point in the walkthrough. Button.Click() has no positional
      // requirement (unlike the dialog phase's coordinate-based
      // Mouse.Click()), so no settle wait is needed before issuing it.
      LogNamed("guimenu", "begin", data);
      btnOpenMenu.Click(eMouseLeft);
      ArmPoll();
      step = STEP_GUIMENU_WAIT;
    }
  }
  else if (event == eEventGameSaved) {
    LogNamed("save", "ok", entered_room);
    LogNamed("restore", "begin", entered_room);
    RestoreGameSlot(1);
  }
  else if (event == eEventRestoreGame) {
    LogNamed("restore", "ok", entered_room);
    LogNamed("exit", "begin", entered_room);
    RunHotspot("hFrontExit", eModeInteract);
    // step is already STEP_EXIT_GO (restored from the save snapshot);
    // deferred room change -- room 3's AfterFadein confirms.
  }
}

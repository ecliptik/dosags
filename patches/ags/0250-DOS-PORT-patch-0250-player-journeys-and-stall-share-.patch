+void dos_journey_fadein_begin();              // current_fade_in_effect() entry
+void dos_journey_fadein_end(int room);        // current_fade_in_effect(), every exit
+void dos_journey_save_request(int slot);      // SaveGameSlot() entry
+void dos_journey_save_exec(int slot);         // save_game() entry
+void dos_journey_save_done(int slot, bool ok);// save_game(): written (before GameSaved) or failed;

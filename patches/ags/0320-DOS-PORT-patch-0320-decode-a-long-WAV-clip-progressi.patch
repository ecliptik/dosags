 bool dos_audio_decode_pcm(const uint8_t *data, size_t size, std::vector<int16_t> &out_pcm);
 
+// DOS-PORT patch 0320: range decoding of a WAV PCM clip. A clip whose decode is one WAV data chunk (what
+// dos_audio_decode_pcm() decodes for it) can be decoded a range of output samples at a time: output sample i
+// depends only on the source frames floor(i * rate / RATE) and the one after it, so any range comes out exactly
+// as the same samples of the whole-clip decode.
+struct DosPcmRangeSource
+{
+    const uint8_t *data = nullptr; // the data chunk's first byte (inside the caller's buffer)
+    size_t frames = 0;             // whole source frames in the chunk
+    int rate = 0, channels = 0, bits = 0;
+    size_t out_total = 0;          // output samples the whole-clip decode produces
+};
+// True, with `src` filled, if dos_audio_decode_pcm() would decode `data` as WAV through exactly one data chunk
+// into a non-empty result; false otherwise (the caller decodes the clip whole).
+bool dos_audio_wav_range_source(const uint8_t *data, size_t size, DosPcmRangeSource &src);
+// Writes output samples [a, a + n) of that decode into out[0..n).
+void dos_audio_decode_range(const DosPcmRangeSource &src, size_t a, size_t n, int16_t *out);
+
 #endif // __AGS_EE_PLATFORM_DOS__DOS_AUDIO_DECODE_H

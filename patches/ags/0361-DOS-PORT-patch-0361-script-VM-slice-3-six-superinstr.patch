+// slice 3: the shadow check (LAB ONLY, DOSAGS_VM_SHADOW=1 in a -DDOSAGS_VMTRACE build). At a
+// superinstruction: snapshot the VM state (S0), run it natively (S1), restore S0, run its
+// constituents one by one with DosVmStep -- Run()'s own text -- (S2), compare S1 with S2 field for
+// field, count a mismatch, and go on from S2. State: the 8 registers, the stack entries up to two
+// past SP, the stack data up to 8 bytes past its pointer, the frame's scalars and arrays, the
+// engine-call argument stack (content and position), the call-stack depth and the line numbers.
+struct DosVmSnap
+{
+    RuntimeScriptValue regs[CC_NUM_REGISTERS];
+    std::vector<RuntimeScriptValue> stack;
+    std::vector<uint8_t> data;
+    uint8_t *dataptr = nullptr;
+    DosVmFrame frame;
+    std::vector<RuntimeScriptValue> fcs_entries;
+    ptrdiff_t fcs_head = 0, fcs_end = 0;
+    uint32_t callsz = 0;
+    int line = 0, curline = 0;
+};
+static DosVmSnap s_snap0, s_snap1, s_snap2;
+static size_t s_snap_stackn = 0, s_snap_datan = 0;
+
+bool ccInstance::DosVmShadowOn()
+{
+    static int on = -1;
+    if (on < 0) { const char *e = getenv("DOSAGS_VM_SHADOW"); on = (e && e[0] == '1') ? 1 : 0; }
+    return on != 0;
+}
+
+void ccInstance::DosVmSnapTake(DosVmSnap &sn, const DosVmFrame &fr) const
+{
+    for (int i = 0; i < CC_NUM_REGISTERS; ++i) sn.regs[i] = _registers[i];
+    sn.stack.assign(_stackBegin, _stackBegin + s_snap_stackn);
+    sn.data.assign(_stackdataBegin, _stackdataBegin + s_snap_datan);
+    sn.dataptr = _stackdataPtr;
+    sn.frame = fr;
+    sn.fcs_entries = fr.fcs->_entries;
+    sn.fcs_head = fr.fcs->_head - fr.fcs->_entries.data();
+    sn.fcs_end = fr.fcs->_end - fr.fcs->_entries.data();
+    sn.callsz = _callStackSize;
+    sn.line = _lineNumber;
+    sn.curline = currentline;
+}
+
+void ccInstance::DosVmSnapPut(const DosVmSnap &sn, DosVmFrame &fr)
+{
+    for (int i = 0; i < CC_NUM_REGISTERS; ++i) _registers[i] = sn.regs[i];
+    std::copy(sn.stack.begin(), sn.stack.end(), _stackBegin);
+    std::copy(sn.data.begin(), sn.data.end(), _stackdataBegin);
+    _stackdataPtr = sn.dataptr;
+    DosVmCallStack *fcs = fr.fcs;
+    fr = sn.frame;
+    fr.fcs = fcs;
+    fcs->_entries = sn.fcs_entries;
+    fcs->_head = fcs->_entries.data() + sn.fcs_head;
+    fcs->_end = fcs->_entries.data() + sn.fcs_end;
+    _callStackSize = sn.callsz;
+    _lineNumber = sn.line;
+    currentline = sn.curline;
+}
+
+static bool SameRsv(const RuntimeScriptValue &a, const RuntimeScriptValue &b)
+{
+    return a.Type == b.Type && a.IValue == b.IValue && a.Ptr == b.Ptr && a.MgrPtr == b.MgrPtr && a.Size == b.Size;
+}
+
+static bool SnapEqual(const DosVmSnap &a, const DosVmSnap &b)
+{
+    for (int i = 0; i < CC_NUM_REGISTERS; ++i) if (!SameRsv(a.regs[i], b.regs[i])) return false;
+    if (a.stack.size() != b.stack.size() || a.data != b.data || a.dataptr != b.dataptr) return false;
+    for (size_t i = 0; i < a.stack.size(); ++i) if (!SameRsv(a.stack[i], b.stack[i])) return false;
+    const DosVmFrame &x = a.frame, &y = b.frame;
+    if (x.curnest != y.curnest || x.num_args_to_func != y.num_args_to_func ||
+        x.next_call_needs_object != y.next_call_needs_object || x.was_just_callas != y.was_just_callas ||
+        x.loopIterationCheckDisabled != y.loopIterationCheckDisabled || x.loopIterations != y.loopIterations ||
+        x.loopCheckIterations != y.loopCheckIterations ||
+        memcmp(x.thisbase, y.thisbase, sizeof(x.thisbase)) || memcmp(x.funcstart, y.funcstart, sizeof(x.funcstart)))
+        return false;
+    if (a.fcs_end - a.fcs_head != b.fcs_end - b.fcs_head) return false;
+    for (ptrdiff_t i = 0; i < a.fcs_end - a.fcs_head; ++i)
+        if (!SameRsv(a.fcs_entries[a.fcs_head + i], b.fcs_entries[b.fcs_head + i])) return false;
+    return a.callsz == b.callsz && a.line == b.line && a.curline == b.curline;
+}

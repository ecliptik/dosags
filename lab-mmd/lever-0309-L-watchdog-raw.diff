diff --git a/Engine/util/time_util.h b/Engine/util/time_util.h
index b4ca3bc25..5a0913038 100644
--- a/Engine/util/time_util.h
+++ b/Engine/util/time_util.h
@@ -75,7 +75,11 @@ struct DosUclockClock
     typedef std::chrono::time_point<DosUclockClock> time_point;
     static constexpr bool is_steady = true;
 
-    static time_point now() noexcept
+    // DOS-PORT patch 0309: now() split in two, same values. now_raw() is the clamped uclock()
+    // reading (one monotonic clamp, shared by every caller as before); from_raw() is the conversion,
+    // two 64-bit divides. A caller that only compares readings occasionally (the script watchdog,
+    // ccInstance::Run) can store raw readings and convert them only when it compares.
+    static uclock_t now_raw() noexcept
     {
         static uclock_t last = 0;
         uclock_t t = uclock();
@@ -83,10 +87,18 @@ struct DosUclockClock
             t = last;
         else
             last = t;
+        return t;
+    }
+    static time_point from_raw(uclock_t t) noexcept
+    {
         const long long secs = t / UCLOCKS_PER_SEC;
         const long long rem = t - secs * UCLOCKS_PER_SEC;
         return time_point(duration(secs * 1000000000LL + rem * 1000000000LL / UCLOCKS_PER_SEC));
     }
+    static time_point now() noexcept
+    {
+        return from_raw(now_raw());
+    }
 };

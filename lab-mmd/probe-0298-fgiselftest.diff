+// DOS-PORT probe 0298 v4 (LAB ONLY, never a gate binary; LAB-MMD.md 12.1 amendment 2): cached FindGUIID
+// against the uncached scan. Per query (each GUI name and, for g-names, its stripped/upper/lower forms, one
+// buffer each): a lookup and, immediately, a second lookup of the same pointer (a guaranteed cache hit),
+// both compared with the scan. dp_fgi_snapshot() records the cache's resident keys that point into these
+// buffers; dp_fgi_check_resident() looks exactly those up first after a restore: each must hit and match.
+static char dp_q[64][40];
+static int dp_nq = -1;
+static const char *dp_res_key[16]; static int dp_nres = 0;
+static void dp_fgi_build()
+{
+    if (dp_nq >= 0) return;
+    dp_nq = 0;
+    for (int i = 0; i < game.numgui && dp_nq < 64; ++i)
+    {
+        const Common::String &nm = guis[i].GetName();
+        if (nm.IsEmpty() || nm.GetLength() >= 31) continue;
+        snprintf(dp_q[dp_nq++], 40, "%s", nm.GetCStr());
+        if (nm[0u] == 'g' && nm.GetLength() > 1)
+            for (int f = 0; f < 3 && dp_nq < 64; ++f)
+            {
+                snprintf(dp_q[dp_nq], 40, "%s", nm.GetCStr() + 1);
+                for (char *c = dp_q[dp_nq]; *c && f > 0; ++c)
+                    *c = (char)(f == 1 ? toupper((unsigned char)*c) : tolower((unsigned char)*c));
+                dp_nq++;
+            }
+    }
+}
+static bool dp_is_test_buf(const char *p) { return p >= &dp_q[0][0] && p < &dp_q[64][0]; }
+void dp_fgi_snapshot()
+{
+    dp_nres = 0;
+    for (const auto &e : findguiid_cache) if (e.key && dp_is_test_buf(e.key)) dp_res_key[dp_nres++] = e.key;
+}
+void dp_fgi_check_resident(const char *phase, unsigned long tick)
+{
+    long hits = 0, mism = 0;
+    for (int i = 0; i < dp_nres; ++i)
+    {
+        const long h0 = dp_fgi_hit_count;
+        const int got = FindGUIID(dp_res_key[i]);
+        if (dp_fgi_hit_count > h0) hits++;
+        if (got != FindGUIIDScan(dp_res_key[i])) mism++;
+    }
+    Debug::Printf("DOS-PORT fgiselftest phase=%s tick=%lu resident=%d resident_hits=%ld resident_mismatches=%ld",
+        phase, tick, dp_nres, hits, mism);
+}
+void dp_fgi_selftest(const char *phase, unsigned long tick)
+{
+    dp_fgi_build();

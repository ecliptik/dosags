diff -ruN s6/Engine/main/dos_levercount.h raw/Engine/main/dos_levercount.h
--- a/Engine/main/dos_levercount.h	1969-12-31 16:00:00.000000000 -0800
+++ b/Engine/main/dos_levercount.h	2026-11-06 03:36:01.361905474 -0800
@@ -0,0 +1,29 @@
+// DOS-PORT patch 0359 probe (LAB ONLY, make AGS_RUNSTATS_DEF=-DDOSAGS_LEVERCOUNT): calls-per-tick counts for
+// the levers outside the VM (MMD-REMAINDER.md levers 1, 2, 3, 4). Never in a measured binary.
+#ifndef DOS_LEVERCOUNT_H
+#define DOS_LEVERCOUNT_H
+#ifdef DOSAGS_LEVERCOUNT
+enum
+{
+    kLC_Fmt,            // String::FromFormatV / FormatV (each is two vsnprintf passes)
+    kLC_DbgScriptPrint, // debug_script_print_impl (debug_script_log / _warn / _print)
+    kLC_DbgPrint,       // DebugManager::Print (every Debug::Printf, already formatted)
+    kLC_ScriptSprintf,  // ScriptSprintf (StrFormat, String.Format, ...)
+    kLC_CharIdAt,       // GetCharIDAtRoom
+    kLC_CharIdAtRepeat, // ... with the same (x, y, hit_options) as an earlier call in the same tick
+    kLC_CharIdAtChars,  // ... characters that reach the sprite test
+    kLC_CharScale,      // update_character_scale (past its on/room check)
+    kLC_CharScaleSame,  // ... with inputs AND outputs equal to that character's previous call
+    kLC_FixupLoop,      // FixupCharacterLoopAndFrame
+    kLC_MoveAndAnim,    // UpdateCharacterMoveAndAnim (past its on check)
+    kLC_Follower, kLC_Idle, kLC_Animating, kLC_Moving,
+    kLC_GuiAt,          // GetGUIAt
+    kLC_Count
+};
+extern unsigned long dos_lc[kLC_Count];
+extern unsigned long dos_lc_tick;
+#define DOS_LC(i) (++dos_lc[(i)])
+#else
+#define DOS_LC(i)
+#endif
+#endif

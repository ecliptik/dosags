From 4f78277d4370b1a071d8e9ac5239aa17a65099ec Mon Sep 17 00:00:00 2001
From: Micheal Waltz <services.claude@accounts.ecliptik.com>
Date: Thu, 24 Sep 2026 21:35:21 -0700
Subject: [PATCH] DOS-PORT: patch 0234 -- skip an unchanged GUI's invalidation
 only when re-compositing it is idempotent

Why: 0169/0191 skip an unchanged GUI's invalidation, but the GUI is still
composited over its whole rect every frame (0170's clip is opt-in and off),
onto last frame's pixels, which already contain it. That is only harmless
for an opaque or masked blit, or binary (0/255) alpha at full opacity. A GUI
with Transparency > 0 at 16/32 bpp, or with a partial-alpha texture, blends
onto itself every frame wherever nothing else marked, and drifts toward its
own colour (dosags LAB-S32.md 17 D1, 21). No existing fixture shows a static
translucent or partial-alpha GUI, which is why no gate has seen it.

What: C3's idempotence condition, applied to GUIs. The skip now also
requires transparency 0 and a texture without partial alpha; 8 bpp (masked
whatever the value) is always idempotent. Partial alpha is found by scanning
the texture's alpha once per sync -- the texture is rebuilt only when the
GUI changes -- so alpha-textured GUIs whose alpha is only 0/255 (AGS
Quest's) stay skippable instead of losing 0169's gain. A refused skip marks
as before. DOSAGS_BREAK_D1=1 restores the old unconditional skip (the gate's
control). Manifest line: DOS-PORT guiidem refused= alpha_binary= alpha_partial=.
---
 Engine/ac/draw.cpp   | 51 +++++++++++++++++++++++++++++++++++++++++++-
 Engine/main/quit.cpp |  4 ++++
 2 files changed, 54 insertions(+), 1 deletion(-)

diff --git a/Engine/ac/draw.cpp b/Engine/ac/draw.cpp
index 2d32d5d92..347bcd346 100644
--- a/Engine/ac/draw.cpp
+++ b/Engine/ac/draw.cpp
@@ -443,6 +443,44 @@ long dos_port_gui_flush_n = 0;            // old rects invalidated ahead of the
 long dos_port_gui_flush_late_n = 0;       // ... found only when the GUI was drawn, a frame late
 long dos_port_gui_flush_tally[64] = {0};  // which GUI, and why: not drawn / picture properties / content flag
 long dos_port_gui_flush_hidden_n = 0, dos_port_gui_flush_props_n = 0, dos_port_gui_flush_flag_n = 0;
+// DOS-PORT patch 0234: 0169's skip is only safe for an IDEMPOTENT composite. A skipped GUI is still
+// composited over its whole rect every frame, onto last frame's pixels, which already contain it
+// (0170's clip is opt-in and off). A translucent GUI (Transparency > 0 at 16/32 bpp) or a partial-
+// alpha GUI texture blends onto itself there every frame and drifts toward its own colour. So:
+// skip only when transparency is 0 and the texture has no partial alpha. Partial alpha is found by
+// scanning the texture's alpha once per sync (the texture is rebuilt only when the GUI changes), so
+// alpha-textured GUIs whose alpha is only 0/255 -- AGS Quest's (LAB-S32 7.1) -- stay skippable.
+// 8 bpp draws masked whatever the transparency: always idempotent.
+//   DOSAGS_BREAK_D1=1 -> gate control only: the pre-0234 unconditional skip
+static bool dos_port_gui_alpha_partial[64];   // set at the GUI's last texture sync
+long dos_port_gui_refused_n = 0;                // skips refused as non-idempotent
+long dos_port_gui_alpha_binary_n = 0, dos_port_gui_alpha_partial_n = 0;   // alpha syncs by class
+
+static bool dos_port_bitmap_alpha_partial(const Bitmap *bmp)
+{
+    if (!bmp || bmp->GetColorDepth() != 32) return false;
+    const int w = bmp->GetWidth(), h = bmp->GetHeight();
+    for (int y = 0; y < h; ++y)
+    {
+        const uint32_t *row = reinterpret_cast<const uint32_t *>(bmp->GetScanLine(y));
+        for (int x = 0; x < w; ++x)
+        {
+            const uint32_t a = row[x] >> 24;
+            if (a != 0 && a != 0xFF) return true;
+        }
+    }
+    return false;
+}
+
+static bool dos_port_gui_idempotent(int index, const GUIMain &gui)
+{
+    static int _brk = -1;
+    if (_brk < 0) { const char *e = getenv("DOSAGS_BREAK_D1"); _brk = (e && e[0] == '1') ? 1 : 0; }
+    if (_brk) return true;
+    if (game.GetColorDepth() <= 8) return true;
+    if (gui.GetTransparency() != 0) return false;
+    return !(index >= 0 && index < 64 && dos_port_gui_alpha_partial[index]);
+}
 // DOS-PORT patch 0197: the same gap as the pre-0191 GUI bug, for room Objects. ObjectOff() (and
 // the off-screen case in prepare_objects_for_drawing() itself) marks nothing -- ObjectOff() calls
 // no invalidation function at all (compare SetObjectBaseline three functions above it in
@@ -3030,6 +3068,14 @@ void draw_gui_and_overlays()
                             repair_alpha_channel(gbg.Bmp.get(), spriteset[gui.GetBgImage()]);
                         }
                     }
+#ifdef __DJGPP__
+                    if (index >= 0 && index < 64)   // patch 0234: classify the texture's alpha once per sync
+                    {
+                        const bool _partial = is_alpha && dos_port_bitmap_alpha_partial(gbg.Bmp.get());
+                        dos_port_gui_alpha_partial[index] = _partial;
+                        if (is_alpha) { if (_partial) dos_port_gui_alpha_partial_n++; else dos_port_gui_alpha_binary_n++; }
+                    }
+#endif
                     sync_object_texture(gbg, is_alpha);
 #if (AGS_PLATFORM_DEBUG)
                     gbg.Ddb->SetTag(String::FromFormat("GUI%d:%s", gui.GetID(), gui.GetName().GetCStr()));
@@ -3157,7 +3203,10 @@ void draw_gui_and_overlays()
                 const bool _tracked = index >= 0 && index < 64;
                 const bool _unch = _tracked &&
                     !dos_port_gui_was_changed[index] && !dos_port_gui_was_ctrls[index];
-                const bool _skip = _h && _unch && dos_port_gui_prev[index].SameAs(gui);
+                // patch 0234: and only when re-compositing it over itself is idempotent
+                const bool _same = _h && _unch && dos_port_gui_prev[index].SameAs(gui);
+                const bool _skip = _same && dos_port_gui_idempotent(index, gui);
+                if (_same && !_skip) dos_port_gui_refused_n++;
                 if (_unch) dos_port_gui_noinval_n++;
                 if (_tracked)
                 {
diff --git a/Engine/main/quit.cpp b/Engine/main/quit.cpp
index a917762be..e74d94a57 100644
--- a/Engine/main/quit.cpp
+++ b/Engine/main/quit.cpp
@@ -695,6 +695,10 @@ void quit(const char *quitmsg)
                     Debug::Printf("DOS-PORT guiskip flushed=%ld late=%ld hidden=%ld props=%ld flag=%ld",   // patch 0191
                         dos_port_gui_flush_n, dos_port_gui_flush_late_n,
                         dos_port_gui_flush_hidden_n, dos_port_gui_flush_props_n, dos_port_gui_flush_flag_n);
+                    // patch 0234: skips refused as non-idempotent, and alpha-texture syncs by class
+                    extern long dos_port_gui_refused_n, dos_port_gui_alpha_binary_n, dos_port_gui_alpha_partial_n;
+                    Debug::Printf("DOS-PORT guiidem refused=%ld alpha_binary=%ld alpha_partial=%ld",
+                        dos_port_gui_refused_n, dos_port_gui_alpha_binary_n, dos_port_gui_alpha_partial_n);
                     for (int _g = 0; _g < 64; ++_g)
                         if (dos_port_gui_flush_tally[_g])
                             Debug::Printf("DOS-PORT guiflush idx=%d n=%ld", _g, dos_port_gui_flush_tally[_g]);
-- 

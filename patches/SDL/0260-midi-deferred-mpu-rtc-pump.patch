+volatile Uint8 g_mdq_kind = 0;             /* 0 off, 1 OPL3, 2 MPU-401 blind direct, 3 MPU-401 RTC-paced (0260) */
 volatile Uint8 g_mdq_hold = 0;             /* 1 = ISR writes nothing, capture refuses */
 static volatile Uint32 g_mdq_head = 0;     /* consumer (ISR) index, monotonic */
 static volatile Uint32 g_mdq_tail = 0;     /* producer (main thread) index, monotonic */
@@ -1828,6 +1828,302 @@ static volatile Uint8 g_mdq_paused = 0;
 #define MDQ_B0_VOICE(reg) ((((reg) & 0xFF) >= 0xB0 && ((reg) & 0xFF) <= 0xB8) \
     ? (int)(((reg) & 0xFF) - 0xB0) + (((reg) >= 0x100) ? 9 : 0) : -1)
 
+/* ========================================================================
+ * DOS-PORT patch 0260: MPU-401 bytes paced by the CMOS RTC periodic
+ * interrupt (queue kind 3).
+ * ========================================================================
+ * The WaveBlaster's default transport (SDL/0097-0098, TIMED-DELAY) needs at
+ * least tx_delay (320 us) between two MPU data bytes -- the fix for the
+ * DreamBlaster's input overrun. The SB IRQ comes every ~46 ms, so replaying
+ * a slot's bytes there means busy-waiting milliseconds with interrupts off,
+ * and a dense slot (over 200 bytes in the games measured) still spills.
+ * PIT channel 0 cannot be sped up: uclock() reads it, and the ports pace and
+ * measure with uclock() directly.
+ *
+ * The RTC's periodic interrupt (IRQ 8) runs from its own 32.768 kHz crystal
+ * and never touches the PIT. While kind 3 is enabled this ISR owns IRQ 8 at
+ * 2048 Hz (488 us): the SB ISR releases the queue head when its stamp comes
+ * due and sets PIE; each RTC tick writes at most one byte, only when at least
+ * tx_delay of RTC time has passed since the previous one; PIE goes off again
+ * when nothing is due. Integer and port I/O only; code and data locked.
+ *
+ * IRQ 8 is not ours alone: the AT BIOS's INT 15h AH=86h wait -- which DJGPP's
+ * delay(), and therefore SDL_Delay, uses -- counts down on it through the BIOS
+ * data area (0040:0098 user-flag far pointer, 0040:009C count in us,
+ * 0040:00A0 active flag). Replacing the vector without honouring that would
+ * make every SDL_Delay hang, so this ISR services the contract itself, by the
+ * real tick period read from register A: count down; at expiry count = 0
+ * (what DOSBox-X's INT 15h/86h loop waits for), active flag cleared, bit 7 set
+ * at the user flag (what the IBM AT BIOS loop waits for).
+ *
+ * Port 70h (the CMOS index) is shared with every other CMOS reader; this code
+ * touches it only with interrupts off (ISRs, or under cli on the main thread).
+ */
+#define MDQ_RTC_RATE_BITS 5u                /* register A rate select: 32768 >> (5 - 1) = 2048 Hz */
+#define MDQ_BDA_WAIT_PTR 0x498u             /* 0040:0098 far pointer to the user wait flag */
+#define MDQ_BDA_WAIT_COUNT 0x49Cu           /* 0040:009C wait count, us */
+#define MDQ_BDA_WAIT_ACTIVE 0x4A0u          /* 0040:00A0 bit 0 = wait in progress */
+static DOS_InterruptHook g_rtc_hook;
+static volatile Uint8 g_rtc_installed = 0;
+static volatile Uint8 g_rtc_pie = 0;        /* PIE set on the pump's behalf */
+static volatile Uint32 g_rtc_gap_us = 0;    /* minimum spacing between two MPU bytes */
+static volatile Uint32 g_rtc_since_us = 0;  /* RTC time since the previous byte (capped at the gap) */
+static volatile Uint32 g_rtc_ticks = 0;     /* RTC interrupts taken */
+static volatile Uint32 g_rtc_waits = 0;     /* BIOS INT 15h/86h waits this ISR completed */
+static volatile Uint32 g_rtc_seen_irq = 0;  /* SB IRQ index the pump last saw */
+static volatile Uint32 g_rtc_us_in_irq = 0; /* RTC time since the pump first saw that index */
+static volatile Uint32 g_rtc_lat_max_us = 0;/* longest release-to-write of an on-time byte */
+static volatile Uint32 g_rtc_slot_bytes = 0;/* bytes written since the SB IRQ index changed */
+static volatile Uint8 g_rtc_last_status = 0; /* last channel status byte on the wire, 0 = unknown */
+static volatile Uint8 g_rtc_pending_status = 0; /* status to re-send before the queue head (resume) */
+static Uint8 g_rtc_resume_status = 0;       /* the message the pump was in when a pause cut it */
+static volatile Uint16 g_rtc_dos_sel = 0;   /* _dos_ds, copied so the ISR reads locked data only */
+static Uint8 g_rtc_saved_a = 0;
+static Uint8 g_rtc_saved_pie = 0;
+static Uint8 g_rtc_saved_mask = 0;
+static bool g_rtc_atexit = false;
+static Uint32 g_rtc_rate_hz = 0;             /* rate of the last install (stats) */
+static bool g_rtc_locked = false;
+
+/* Interrupts must be off around every call (port 70h is shared). */
+static Uint8 MidiRtcRead(Uint8 reg)
+{
+    outportb(0x70, reg);
+    return inportb(0x71);
+}
+
+static void MidiRtcWrite(Uint8 reg, Uint8 val)
+{
+    outportb(0x70, reg);
+    outportb(0x71, val);
+}
+
+/* SB ISR: the head is due and the pump is idle -> start the RTC ticks. */
+static void MidiRtcKick(Uint32 irq_now)
+{
+    if (g_rtc_pie || g_mdq_hold || g_mdq_head == g_mdq_tail) {
+        return;
+    }
+    __asm__ __volatile__("" ::: "memory"); /* read the entry after seeing the tail */
+    if ((Sint32)(irq_now - g_mdq_stamp[g_mdq_head & (MIDI_DEFER_QUEUE - 1u)]) < 0) {
+        return;
+    }
+    MidiRtcWrite(0x0B, (Uint8)(MidiRtcRead(0x0B) | 0x40));
+    g_rtc_pie = 1;
+}
+
+/* The tick period in us for register A's rate bits (32.768 kHz time base). */
+static Uint32 MidiRtcPeriodUs(Uint8 reg_a)
+{
+    const Uint32 rs = reg_a & 0x0Fu;
+    if (rs == 0) {
+        return 0;
+    }
+    if (rs < 3) {
+        return (rs == 1) ? 3906u : 7813u;
+    }
+    return (15625u << (rs - 1u)) >> 9; /* 1e6 / (32768 >> (rs - 1)) */
+}
+
+/* The AT BIOS INT 70h wait duty. Returns true while a wait is still running. */
+static bool MidiRtcBiosWait(Uint32 period_us)
+{
+    const Uint16 sel = g_rtc_dos_sel;
+    if (!(_farpeekb(sel, MDQ_BDA_WAIT_ACTIVE) & 0x01) || period_us == 0) {
+        return false;
+    }
+    const Uint32 count = _farpeekl(sel, MDQ_BDA_WAIT_COUNT);
+    if (count > period_us) {
+        _farpokel(sel, MDQ_BDA_WAIT_COUNT, count - period_us);
+        return true;
+    }
+    _farpokel(sel, MDQ_BDA_WAIT_COUNT, 0);
+    _farpokeb(sel, MDQ_BDA_WAIT_ACTIVE, 0);
+    {
+        const Uint32 fp = _farpeekl(sel, MDQ_BDA_WAIT_PTR);
+        const Uint32 lin = ((fp >> 16) << 4) + (fp & 0xFFFFu);
+        _farpokeb(sel, lin, (Uint8)(_farpeekb(sel, lin) | 0x80));
+    }
+    g_rtc_waits++;
+    return false;
+}
+
+/* IRQ 8. Interrupts are off for the whole handler. */
+/* One byte to the MPU from the pump; the gap restarts. */
+static void MidiRtcPut(Uint8 v)
+{
+    outportb(g_mdq_mpu_base, v);
+    g_rtc_since_us = 0;
+    if (v >= 0x80) {
+        g_rtc_last_status = (v < 0xF0) ? v : 0; /* system messages cancel running status */
+    }
+    g_rtc_slot_bytes++;
+    if (g_rtc_slot_bytes > g_mdq_burst_max) {
+        g_mdq_burst_max = g_rtc_slot_bytes;
+    }
+}
+
+/* IRQ 8. Interrupts are off for the whole handler. */
+static void MidiRtcISR(void)
+{
+    (void)MidiRtcRead(0x0C); /* acknowledge; unread, register C holds IRQ 8 asserted */
+    const Uint32 period = MidiRtcPeriodUs(MidiRtcRead(0x0A));
+    bool keep = MidiRtcBiosWait(period);
+    g_rtc_ticks++;
+    if (g_mdq_kind == 3 && !g_mdq_hold) {
+        const Uint32 irq_now = dos_port_audio_irq_count;
+        if (irq_now != g_rtc_seen_irq) {
+            g_rtc_seen_irq = irq_now;
+            g_rtc_us_in_irq = 0;
+            g_rtc_slot_bytes = 0;
+        } else {
+            g_rtc_us_in_irq += period;
+        }
+        if (g_rtc_since_us < g_rtc_gap_us) {
+            g_rtc_since_us += period;
+        }
+        Uint32 idx = 0;
+        Sint32 late = -1;
+        if (g_mdq_head != g_mdq_tail) {
+            __asm__ __volatile__("" ::: "memory"); /* read the entry after seeing the tail */
+            idx = g_mdq_head & (MIDI_DEFER_QUEUE - 1u);
+            late = (Sint32)(irq_now - g_mdq_stamp[idx]);
+        }
+        if (late >= 0) {
+            keep = true;
+            if (g_rtc_since_us >= g_rtc_gap_us) {
+                if (g_rtc_pending_status) {
+                    /* a pause cut a message: its status first, then the rest of it */
+                    MidiRtcPut(g_rtc_pending_status);
+                    g_rtc_pending_status = 0;
+                } else {
+                    MidiRtcPut(g_mdq_val[idx]);
+                    g_mdq_head = g_mdq_head + 1u;
+                    g_mdq_written++;
+                    if (late >= 1) {
+                        g_mdq_late++;
+                        if ((Uint32)late > g_mdq_late_max) {
+                            g_mdq_late_max = (Uint32)late;
+                        }
+                    } else if (g_rtc_us_in_irq > g_rtc_lat_max_us) {
+                        g_rtc_lat_max_us = g_rtc_us_in_irq;
+                    }
+                }
+            }
+        }
+    }
+    if (!keep) {
+        MidiRtcWrite(0x0B, (Uint8)(MidiRtcRead(0x0B) & ~0x40));
+        g_rtc_pie = 0;
+    }
+    DOS_EndOfInterrupt(8);
+}
+static void MidiRtcISR_End(void) {}
+
+/* Main thread. Put IRQ 8 and the RTC back as they were. Idempotent. */
+static void MidiRtcUninstall(void)
+{
+    if (!g_rtc_installed) {
+        return;
+    }
+    DOS_DisableInterrupts();
+    {
+        const Uint8 b = MidiRtcRead(0x0B);
+        MidiRtcWrite(0x0B, (Uint8)((b & ~0x40) | g_rtc_saved_pie));
+        const Uint8 a = MidiRtcRead(0x0A);
+        MidiRtcWrite(0x0A, (Uint8)((a & 0xF0) | (g_rtc_saved_a & 0x0F)));
+        (void)MidiRtcRead(0x0C);
+    }
+    g_rtc_pie = 0;
+    DOS_EnableInterrupts();
+    DOS_UnhookInterrupt(&g_rtc_hook, false);
+    if (g_rtc_saved_mask) {
+        outportb(0xA1, (Uint8)(inportb(0xA1) | 0x01)); /* IRQ 8 was masked before us */
+    }
+    g_rtc_installed = 0;
+    dos_port_dbg_log("audio: patch 0260 RTC pump uninstalled -- register A rate bits restored "
+                     "to %u, PIE %s, IRQ 8 %s; ticks=%u bios_waits=%u lat_max_us=%u",
+                     (unsigned)(g_rtc_saved_a & 0x0F), g_rtc_saved_pie ? "on" : "off",
+                     g_rtc_saved_mask ? "re-masked" : "left unmasked", (unsigned)g_rtc_ticks,
+                     (unsigned)g_rtc_waits, (unsigned)g_rtc_lat_max_us);
+}
+
+static void MidiRtcAtExit(void)
+{
+    MidiRtcUninstall();
+}
+
+/* Main thread. Own IRQ 8 at 2048 Hz, PIE off until the SB ISR kicks. */
+static bool MidiRtcInstall(Uint32 gap_us)
+{
+    if (g_rtc_installed) {
+        return true;
+    }
+    if (_farpeekb(_dos_ds, MDQ_BDA_WAIT_ACTIVE) & 0x01) {
+        dos_port_dbg_log("audio: patch 0260 RTC pump refused -- a BIOS INT 15h wait is in progress");
+        return false;
+    }
+    /* ticks, waits and lat_max are run totals (one install per song) */
+    g_rtc_dos_sel = (Uint16)_dos_ds;
+    g_rtc_gap_us = gap_us;
+    g_rtc_since_us = gap_us;
+    g_rtc_seen_irq = dos_port_audio_irq_count;
+    g_rtc_us_in_irq = 0;
+    g_rtc_slot_bytes = 0;
+    g_rtc_last_status = 0;
+    g_rtc_pending_status = 0;
+    g_rtc_pie = 0;
+    g_rtc_rate_hz = 32768u >> (MDQ_RTC_RATE_BITS - 1u);
+    /* The compiler does not keep these functions in source order (the ISR
+       has been laid out after its end marker), so a range lock alone cannot
+       be trusted: the pump runs only under the whole-image lock (0194). */
+    if (!DOS_LockProgramText()) {
+        dos_port_dbg_log("audio: patch 0260 RTC pump refused -- program code lock not held");
+        return false;
+    }
+    if (!g_rtc_locked) {
+        DOS_LockCode(MidiRtcRead, MidiRtcISR_End);
+        DOS_LockCode(MidiRtcISR, MidiRtcISR_End); /* logged, not locked, if laid out after its end */
+        DOS_LockVariable(g_rtc_pie);
+        DOS_LockVariable(g_rtc_gap_us);
+        DOS_LockVariable(g_rtc_since_us);
+        DOS_LockVariable(g_rtc_ticks);
+        DOS_LockVariable(g_rtc_waits);
+        DOS_LockVariable(g_rtc_seen_irq);
+        DOS_LockVariable(g_rtc_us_in_irq);
+        DOS_LockVariable(g_rtc_lat_max_us);
+        DOS_LockVariable(g_rtc_slot_bytes);
+        DOS_LockVariable(g_rtc_dos_sel);
+        DOS_LockVariable(g_rtc_last_status);
+        DOS_LockVariable(g_rtc_pending_status);
+        g_rtc_locked = true;
+    }
+    DOS_DisableInterrupts();
+    g_rtc_saved_a = MidiRtcRead(0x0A);
+    {
+        const Uint8 b = MidiRtcRead(0x0B);
+        g_rtc_saved_pie = (Uint8)(b & 0x40);
+        MidiRtcWrite(0x0B, (Uint8)(b & ~0x40));
+    }
+    MidiRtcWrite(0x0A, (Uint8)((g_rtc_saved_a & 0xF0) | MDQ_RTC_RATE_BITS));
+    (void)MidiRtcRead(0x0C); /* clear stale flags so IRQ 8 can edge again */
+    g_rtc_saved_mask = (Uint8)(inportb(0xA1) & 0x01);
+    DOS_EnableInterrupts();
+    DOS_HookInterruptReplace(8, MidiRtcISR, &g_rtc_hook); /* unmasks IRQ 8 and the cascade */
+    g_rtc_installed = 1;
+    if (!g_rtc_atexit) {
+        atexit(MidiRtcAtExit); /* the RTC must not stay at 2048 Hz, or hooked, past exit */
+        g_rtc_atexit = true;
+    }
+    dos_port_dbg_log("audio: patch 0260 RTC pump installed -- IRQ 8 at %u Hz (register A "
+                     "0x%02x -> rate bits %u), byte gap %u us, PIE was %s, IRQ 8 was %s; "
+                     "MPU bytes released by the SB IRQ, written one per RTC tick",
+                     (unsigned)(32768u >> (MDQ_RTC_RATE_BITS - 1u)), (unsigned)g_rtc_saved_a,
+                     (unsigned)MDQ_RTC_RATE_BITS, (unsigned)gap_us,
+                     g_rtc_saved_pie ? "on" : "off", g_rtc_saved_mask ? "masked" : "unmasked");
+    return true;
+}
+
 static void MidiDeferWriteOne(Uint32 idx)
 {
     const Uint16 reg = g_mdq_reg[idx];
@@ -1864,6 +2160,10 @@ static void MidiDeferDrain(Uint32 irq_now)
     if (g_mdq_hold) {
         return; /* chip detect/init/shutdown in progress on the main thread */
     }
+    if (g_mdq_kind == 3) {
+        MidiRtcKick(irq_now); /* DOS-PORT patch 0260: the RTC pump writes kind 3 */
+        return;
+    }
     if (g_mdq_draining) {
         return; /* DOS-PORT patch 0253: nested entry while interrupts are on */
     }
@@ -2134,6 +2434,7 @@ void SDL_DOSMidiDeferFlush(void)
     MidiDeferShadowReset(); /* patch 0251: queued writes are dropped unplayed */
     DOS_DisableInterrupts();
     g_mdq_head = g_mdq_tail;
+    g_rtc_pending_status = 0; /* DOS-PORT patch 0260: nothing left to resume into */
     DOS_EnableInterrupts();
 }
 
@@ -2165,6 +2466,17 @@ void SDL_DOSMidiDeferStats2(Uint32 *dropped, Uint32 *sync)
     if (sync) *sync = g_mdq_sync;
 }
 
+/* DOS-PORT patch 0260 */
+void SDL_DOSMidiDeferRtcStats(Uint32 *rate_hz, Uint32 *gap_us, Uint32 *ticks, Uint32 *bios_waits,
+                              Uint32 *lat_max_us)
+{
+    if (rate_hz) *rate_hz = g_rtc_rate_hz;
+    if (gap_us) *gap_us = g_rtc_gap_us;
+    if (ticks) *ticks = g_rtc_ticks;
+    if (bios_waits) *bios_waits = g_rtc_waits;
+    if (lat_max_us) *lat_max_us = g_rtc_lat_max_us;
+}
+
 void SDL_DOSMidiDeferStats(Uint32 *written, Uint32 *late, Uint32 *late_max, Uint32 *burst_max, Uint32 *full)
 {
     if (written) *written = g_mdq_written;
@@ -2197,6 +2509,23 @@ bool SDL_DOSMidiDeferEnable(int kind)
         g_mdq_kind = 0; /* the ISR stops draining; capture refuses */
         DOS_EnableInterrupts();
         Uint32 done = 0;
+        if (k == 3) {
+            /* DOS-PORT patch 0260: the pump is stopped and IRQ 8 handed back
+               first; what is left goes out at the transport's own spacing,
+               interrupts on (a 320 us wait per byte is too long for cli). */
+            MidiRtcUninstall();
+            if (g_rtc_pending_status && g_mdq_head != g_mdq_tail) {
+                SDL_DOSMpu401PaceDelay();
+                outportb(g_mdq_mpu_base, g_rtc_pending_status);

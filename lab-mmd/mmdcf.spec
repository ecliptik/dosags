# MMD-CS at cycles=fixed 40000 (tools/dosbox-x.conf): character select, no input, 1000 ticks; B = baseline, P = probe, O = probe with API clock pairs off
MMDCF-B1 AGSBASE.EXE 1000
MMDCF-P1 AGSPROBE.EXE 1000
MMDCF-O1 AGSPROBE.EXE 1000 DOSAGS_MMDPROBE_APITIME=0
MMDCF-O2 AGSPROBE.EXE 1000 DOSAGS_MMDPROBE_APITIME=0
MMDCF-P2 AGSPROBE.EXE 1000
MMDCF-B2 AGSBASE.EXE 1000

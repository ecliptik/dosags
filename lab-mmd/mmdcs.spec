# MMD-CS: character select, no input, 1000 ticks; B = baseline, P = probe, O = probe with API clock pairs off
MMDCS-B1 AGSBASE.EXE 1000
MMDCS-P1 AGSPROBE.EXE 1000
MMDCS-O1 AGSPROBE.EXE 1000 DOSAGS_MMDPROBE_APITIME=0
MMDCS-O2 AGSPROBE.EXE 1000 DOSAGS_MMDPROBE_APITIME=0
MMDCS-P2 AGSPROBE.EXE 1000
MMDCS-B2 AGSBASE.EXE 1000

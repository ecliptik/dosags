+++ b/Engine/main/dos_port_tick_timing.h
@@ -386,6 +386,65 @@ struct DosPortTickTiming
     long blits_unscaled = 0;
     // patch 0120: the redundant RAM->RAM present copy, eliminated by
     // aliasing AGS's virtual screen onto the window surface.
+    // patch 0125: render_backbuffer structure -- batches, per-batch
+    // surface clears and their area, and sprites composited.
+    long rb_calls = 0, rb_batches = 0, rb_clears = 0, rb_sprites = 0;
+    long rb_clipped_sprites = 0;   // patch 0170: composites clipped to the dirty bbox
+    // patch 0171: why the clip did not engage, per condition
+    long rb_clip_flagged = 0, rb_clip_noflag = 0;
+    long rb_clip_notvs = 0, rb_clip_novalid = 0, rb_clip_isfull = 0;
+    // patch 0173: would stage 1.5 ever fire, and how much does the overlap

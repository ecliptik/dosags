// AutoPilot.asc -- the BENCH fixture's TAS: one scripted scene per run,
// chosen by BENCH.CFG, each a fixed window of logic ticks. License: MIT.
//
// Armed only when game.debug_mode is set (i.e. under --test), so the
// same package plays normally otherwise. Driven purely by AGS script --
// never OS-level input -- so it runs identically under DOSBox-X and on
// real hardware.
//
// Log grammar is the AGS Quest harness's, unchanged, so parse-results.py
// and the RUNMANIFEST tooling need nothing new:
//   AUTOPILOT phase=<name> status=<begin|ok|fail> tick=<n> room=<n> [k=v ...]
// written to System.Log (stdout under --log-stdout=+mgs:all) and to
// $SAVEGAMEDIR$/AUTOPLT.LOG.
//
// AGS script cannot read the environment. Scene selection comes from a
// small text file the harness stages next to the package:
//   $INSTALLDIR$/BENCH.CFG      (read-only location, reading is allowed)
//     scene=<idle|walk|anim|text|gui|audio|full>   default: full
//     hold_ticks=<n>                               default: 1000
//     objects=<n>        (anim: spinners, 0..12)   default: 4
//     midshot=<0|1>      extra capture PH02.BMP at the window's midpoint,
//                        a MOTION WITNESS for a human to look at -- off by
//                        default because a file write inside the window
//                        perturbs a benchmark cell, and never hash-gated
//                        (which frame it catches depends on frame rate)
// Missing file or key -> the default; an unknown scene -> fail + quit.
//
// Every scene ends the same way: motion stopped and everything put in a
// FIXED pose, SETTLE_TICKS of stillness, SaveScreenShot("PH01.BMP"),
// QuitGame. The capture is ALWAYS named PH01.BMP (the midshot PH02.BMP):
// one scene per run means one capture per run, and those are names the
// real-hardware runner already collects, so it needs no change. To keep
// the check able to tell scenes apart -- a stale PH01.BMP left on the
// target by a DIFFERENT scene must not pass -- the fixed pose is
// scene-specific: the character stands at x = 40 + 24 * scene. The capture is therefore identical whatever the frame rate
// was during the window -- a correctness hash, not a sample of motion.
// SETTLE_TICKS is 40, not a handful: under DOSAGS_FIXED_TIMESTEP a slow
// machine renders as rarely as one tick in six (MAX_CATCHUP=5), and the
// screenshot copies the last RENDERED frame, so the pose must survive
// several renders before the capture. Those 40 static ticks sit inside
// the run's RUNMANIFEST window (4% of a 1000-tick scene) -- a known,
// constant dilution, the same in every arm of a comparison.
//
// Blocking calls are only safe from repeatedly_execute (not game_start,
// not repeatedly_execute_always); all driving happens there. Save and
// restore are deferred by the engine and confirmed through on_event.

int ap_look_done;
int ap_use_done;
export ap_look_done;
export ap_use_done;

#define SC_IDLE 0
#define SC_WALK 1
#define SC_ANIM 2
#define SC_TEXT 3
#define SC_GUI 4
#define SC_AUDIO 5
#define SC_FULL 6
// SC_DARK: the ONLY scene that makes the engine dereference color_map.
//
// Patch 0117 stops building the light table when nothing in the room can
// darken, on the evidence that nothing ever read it -- over Trilby's whole
// 5000-tick benchmark on real hardware, "colormap_consumers transblend=0
// litblend=0". That makes the consumer path one that has NEVER executed in
// testing, and a missed hook there is a hard fault rather than a glitch
// (libsrc/allegro/src/c/cspr.h:545 dereferences color_map before the pixel
// loop). This scene exists to execute that path on purpose.
//
// Two levers, both needed, and it took finding both to explain why an
// earlier attempt with an engine-side env var produced nothing:
//   - region[0].LightLevel = -100: region 0 is what get_local_tint falls
//     back to when the character stands on no region (Engine/ac/draw.cpp:
//     1799-1802), so no region mask has to be authored.
//   - player.IgnoreLighting = false: BENCH8's character is generated with
//     UseRoomAreaLighting=False, and EVERYTHING in get_local_tint --
//     including the ambient play.rtint_* branch -- sits inside
//     "if (use_region_tint)" (Engine/ac/draw.cpp:1717). With the flag set,
//     no amount of ambient darkening can reach a blend.
//
// 8-bit can only darken, never tint or lighten (Engine/ac/draw.cpp:1737),
// so the light level is NEGATIVE deliberately.
#define SC_DARK 7
#define SC_BAD 99

#define ST_BOOT 0
#define ST_RUN 1
#define ST_SETTLE 2
#define ST_DONE 3
// `full` sub-steps
#define ST_F_LOOK 10
#define ST_F_PICKUP 11
#define ST_F_USE 12
#define ST_F_SAVING 13
#define ST_F_RESTORED 14

#define SETTLE_TICKS 40
#define POLL_TICKS 800
#define MAX_SPINNERS 12
#define SPINNER_FIRST_OBJECT 1

int scene = SC_FULL;
int hold_ticks = 1000;
int objects_n = 4;
int midshot = 0;
bool midshot_done;
int step = ST_BOOT;          // part of save-game data, like the rest
int t0;                      // tick the scene window opened at
int deadline;                // poll timeout / settle end
int leg;                     // walk: current waypoint
int beat;                    // text/gui/audio: last period index handled
int cur_room;
Overlay *text_ov;

String SceneName(int s)
{
  if (s == SC_IDLE) return "idle";
  if (s == SC_WALK) return "walk";
  if (s == SC_ANIM) return "anim";
  if (s == SC_TEXT) return "text";
  if (s == SC_GUI) return "gui";
  if (s == SC_AUDIO) return "audio";
  if (s == SC_FULL) return "full";
  if (s == SC_DARK) return "dark";
  return "unknown";
}

// DOS-PORT 2026-09-20: hold the log handle open across the run.
//
// This used to open, write and close per line. Measured on HW-486-66:
// File.Open is 142.4 ms, Close 7.7 ms, WriteRawLine 0.13 ms -- 150 ms per
// line, and 1,201 ms across the run's 8 opens, on a 128 s run. That is
// 0.9% of the gate's own measured window spent re-opening a log file,
// against a Gate 2 shortfall of 0.4%. The benchmark was measuring its own
// logging.
//
// Removing harness overhead, NOT changing the benchmark: the log content
// is byte-identical -- same lines, same order, same text. Only the number
// of opens changes, from one per line to one per run.
//
// The handle is closed explicitly before QuitGame (repeatedly_execute), so
// the final lines are flushed rather than relying on teardown.
File *logf;

void WriteLog(const string line)
{
  System.Log(eLogInfo, "%s", line);
  if (logf == null) logf = File.Open("$SAVEGAMEDIR$/AUTOPLT.LOG", eFileAppend);
  if (logf != null) logf.WriteRawLine(line);
}

void CloseLog()
{
  if (logf != null) {
    logf.Close();
    logf = null;
  }
}

void LogPhase(const string name, const string status)
{
  WriteLog(String.Format("AUTOPILOT phase=%s status=%s tick=%d room=%d", name, status, Game.TickCounter, cur_room));
}

void ParseLine(String line)
{
  int eq = line.IndexOf("=");
  if (eq <= 0) return;
  String key = line.Substring(0, eq);
  String val = line.Substring(eq + 1, line.Length - eq - 1);
  // a CRLF file read on a host that only strips LF leaves a trailing CR
  if (val.Length > 0 && val.Chars[val.Length - 1] == 13) val = val.Truncate(val.Length - 1);
  if (key == "scene") {
    scene = SC_BAD;
    int s = 0;
    while (s <= SC_DARK) {
      if (val == SceneName(s)) scene = s;
      s++;
    }
  }
  else if (key == "hold_ticks") hold_ticks = val.AsInt;
  else if (key == "objects") objects_n = val.AsInt;
  else if (key == "midshot") midshot = val.AsInt;
}

void ReadConfig()
{
  File *f = File.Open("$INSTALLDIR$/BENCH.CFG", eFileRead);
  if (f == null) return;
  while (!f.EOF) {
    String line = f.ReadRawLineBack();
    if (line != null) ParseLine(line);
  }
  f.Close();
  if (hold_ticks < 1) hold_ticks = 1;
  if (objects_n < 0) objects_n = 0;
  if (objects_n > MAX_SPINNERS) objects_n = MAX_SPINNERS;
}

// ---- fixed pose every scene returns to before its capture --------------
void FixedPose()
{
  player.StopMoving();
  player.x = 40 + 24 * scene;
  player.y = 170;
  player.Loop = 0;
  player.Frame = 0;
  int i = 0;
  while (i < MAX_SPINNERS) {
    Object *o = object[SPINNER_FIRST_OBJECT + i];
    if (o.Animating) o.StopAnimating();
    if (o.Visible) o.SetView(VSPINNER, 0, 0);
    i++;
  }
  if (text_ov != null && text_ov.Valid) text_ov.Remove();
  text_ov = null;
  gMenu.Visible = false;
  Game.StopAudio();
  Mouse.SetPosition(160, 100);
}

void Finish(bool ok)
{
  if (ok) LogPhase(SceneName(scene), "ok");
  else LogPhase(SceneName(scene), "fail");
  FixedPose();
  deadline = Game.TickCounter + SETTLE_TICKS;
  step = ST_SETTLE;
}

void WalkLeg()
{
  // A loop that crosses BEHIND the pillar (feet above its baseline, 151)
  // on the way out and IN FRONT of it on the way back.
  if (leg == 0) player.Walk(300, 140, eNoBlock, eWalkableAreas);
  else if (leg == 1) player.Walk(300, 186, eNoBlock, eWalkableAreas);
  else if (leg == 2) player.Walk(20, 186, eNoBlock, eWalkableAreas);
  else player.Walk(20, 140, eNoBlock, eWalkableAreas);
  leg = (leg + 1) % 4;
}

void BeginScene()
{
  t0 = Game.TickCounter;
  beat = -1;
  LogPhase(SceneName(scene), "begin");
  WriteLog(String.Format("AUTOPILOT config scene=%s hold_ticks=%d objects=%d midshot=%d", SceneName(scene), hold_ticks, objects_n, midshot));
  if (scene == SC_WALK) {
    leg = 0;
    player.x = 20;
    player.y = 140;
    WalkLeg();
  }
  else if (scene == SC_ANIM) {
    int i = 0;
    while (i < objects_n) {
      Object *o = object[SPINNER_FIRST_OBJECT + i];
      o.Visible = true;
      o.SetView(VSPINNER, 0, 0);
      o.Animate(0, 1, eRepeat, eNoBlock, eForwards);
      i++;
    }
  }
  else if (scene == SC_AUDIO) {
    aTune.Play(eAudioPriorityNormal, eRepeat);
  }
  else if (scene == SC_DARK) {
    // Make the player character actually subject to room lighting, then
    // darken the area it stands in. Both are required; see SC_DARK above.
    player.IgnoreLighting = false;
    region[0].LightLevel = -100;
    WriteLog("AUTOPILOT dark region0_light=-100 ignore_lighting=0");
  }
  else if (scene == SC_FULL) {
    ap_look_done = 0;
    LogPhase("look", "begin");
    hotspot[1].RunInteraction(eModeLookat);
    deadline = Game.TickCounter + POLL_TICKS;
    step = ST_F_LOOK;
    return;
  }
  step = ST_RUN;
}

void RunWindow()
{
  int elapsed = Game.TickCounter - t0;
  if (elapsed >= hold_ticks) {
    Finish(true);
    return;
  }
  if (midshot != 0 && !midshot_done && elapsed >= hold_ticks / 2) {
    midshot_done = true;
    if (SaveScreenShot("PH02.BMP") == 1) LogPhase("midshot", "ok");
    else LogPhase("midshot", "fail");
  }
  int b = elapsed / 20;
  if (scene == SC_WALK) {
    if (!player.Moving) WalkLeg();
  }
  else if (scene == SC_TEXT && b != beat) {
    beat = b;
    if (text_ov != null && text_ov.Valid) text_ov.Remove();
    text_ov = Overlay.CreateTextual(8, 8 + (b % 6) * 14, 304, eFontPressStart2P, 1,
                                    "Line %d: the quick brown fox jumps.", b);
    if (b % 4 == 0) player.SayBackground("Tick tock.");
  }
  else if (scene == SC_GUI && b != beat) {
    beat = b;
    gMenu.Visible = (b % 2 == 1);
  }
  else if (scene == SC_AUDIO && (elapsed / 40) != beat) {
    beat = elapsed / 40;
    aChime.Play();
  }
}

void RunFull()
{
  bool timed_out = (Game.TickCounter >= deadline);
  if (step == ST_F_LOOK) {
    if (ap_look_done == 0 && !timed_out) return;
    if (ap_look_done == 0) { LogPhase("look", "fail"); Finish(false); return; }
    LogPhase("look", "ok");
    LogPhase("pickup", "begin");
    object[0].RunInteraction(eModeInteract);
    deadline = Game.TickCounter + POLL_TICKS;
    step = ST_F_PICKUP;
  }
  else if (step == ST_F_PICKUP) {
    if (!player.HasInventory(iKey) && !timed_out) return;
    if (!player.HasInventory(iKey)) { LogPhase("pickup", "fail"); Finish(false); return; }
    LogPhase("pickup", "ok");
    LogPhase("useinv", "begin");
    ap_use_done = 0;
    player.ActiveInventory = iKey;
    hotspot[1].RunInteraction(eModeUseinventory);
    deadline = Game.TickCounter + POLL_TICKS;
    step = ST_F_USE;
  }
  else if (step == ST_F_USE) {
    if (ap_use_done == 0 && !timed_out) return;
    if (ap_use_done == 0) { LogPhase("useinv", "fail"); Finish(false); return; }
    LogPhase("useinv", "ok");
    player.ActiveInventory = null;
    LogPhase("gui", "begin");
    gMenu.Visible = true;
    LogPhase("gui", "ok");
    LogPhase("save", "begin");
    // step is set BEFORE the (deferred) save so the snapshot and the
    // live copy both resume at the same place after the restore.
    step = ST_F_RESTORED;
    deadline = Game.TickCounter + POLL_TICKS;
    btnSave.Click(eMouseLeft);
  }
  else if (step == ST_F_RESTORED) {
    // waiting for on_event's eEventGameSaved -> eEventRestoreGame
    if (timed_out) { LogPhase("restore", "fail"); Finish(false); }
  }
}

function game_start()
{
  if (!game.debug_mode) return;
  ReadConfig();
  // Display()/Say() must advance by timer alone: there is no player.
  game.skip_display = 2;
  Speech.SkipStyle = eSkipTime;
  Game.MinimumTextDisplayTimeMs = 500;
  Game.TextReadingSpeed = 40;
  LogPhase("boot", "begin");
}

function repeatedly_execute()
{
  if (!game.debug_mode) return;
  if (step == ST_RUN) RunWindow();
  else if (step >= ST_F_LOOK) RunFull();
  else if (step == ST_SETTLE && Game.TickCounter >= deadline) {
    bool ok = (SaveScreenShot("PH01.BMP") == 1);
    if (ok) LogPhase("shot", "ok");
    else LogPhase("shot", "fail");
    LogPhase("quit", "begin");
    step = ST_DONE;
    CloseLog();   // flush before the engine tears down
    QuitGame(0);
  }
}

function on_event(EventType event, int data)
{
  if (!game.debug_mode) return;
  if (event == eEventEnterRoomAfterFadein) {
    cur_room = data;
    if (step == ST_BOOT) {
      LogPhase("boot", "ok");
      if (scene == SC_BAD) {
        LogPhase("config", "fail");
        scene = SC_IDLE;
        Finish(false);
        return;
      }
      Mouse.SetPosition(160, 100);
      BeginScene();
    }
  }
  else if (event == eEventGameSaved) {
    LogPhase("save", "ok");
    LogPhase("restore", "begin");
    btnLoad.Click(eMouseLeft);
  }
  else if (event == eEventRestoreGame) {
    // DOS-PORT 2026-09-21: a restore puts the script's globals back as they were
    // at save time, so logf now names a handle the restore has closed, and the
    // next WriteLog fails with "FileWriteRawLine: invalid file handle" and ends
    // the run (found by the `full` scene once it was validated at 16 bit and at
    // 8 bit again). Drop the stale handle so WriteLog reopens in append mode.
    // Nothing else changes: WriteLog and CloseLog are untouched and no scene but
    // `full` ever restores, so the gate scene's path is byte for byte the same.
    logf = null;
    if (step == ST_F_RESTORED) {
      LogPhase("restore", "ok");
      btnClose.Click(eMouseLeft);
      Finish(true);
    }
  }
}

 {
+    if (_isMidi) { MidiPoll(); return; }
+
     if (_playState == PlaybackState::PlayStateInitial)
         Init();
     if (_playState != PlayStatePlaying)
@@ -65,8 +125,33 @@ void AudioPlayer::Poll()
     }
 }
 
+void AudioPlayer::MidiPoll()
+{
+    if (_playState == PlaybackState::PlayStateInitial)
+        Init();
+    if (_playState != PlayStatePlaying)
+        return;
+    if (!_midiSched || !_midiSink)
+        return;
+
+    midi_sched_tick(_midiSched, MidiNowMs());
+
+    const uint64_t total = midi_sched_dispatched(_midiSched);
+    if (total > _midiLastDispatched)
+    {
+        dos_midi_backend_add_dispatched(total - _midiLastDispatched);
+        _midiLastDispatched = total;
+    }
+    // midi_sched_tick() loops the song from the start at end-of-song, its
+    // own unconditional documented behavior -- this player never reaches
+    // PlayStateFinished on its own; only an explicit Stop() ends playback,
+    // matching how background music is actually used in a real game.
+}
+
 void AudioPlayer::Play()
 {
+    if (_isMidi) { MidiPlay(); return; }
+
     switch (_playState)
     {
     case PlayStateInitial:
@@ -84,8 +169,54 @@ void AudioPlayer::Play()
     }
 }
 
+void AudioPlayer::MidiPlay()
+{
+    switch (_playState)
+    {
+    case PlayStateInitial:
+        _onLoadPlayState = PlayStatePlaying;
+        break;
+    case PlayStateStopped:
+        // MidiStop() closed the sink to guarantee real silence (see its
+        // own comment) -- reopen + rebind before restarting the song.
+        if (!_midiSink)
+        {
+            _midiSink = dos_midi_backend_open(&_midiBackendKind);
+            if (_midiSink && _midiSched)
+            {
+                midi_sched_sink sink;
+                opl3_sink_bind(_midiSink, &sink);
+                opl3_sink_load_bank(_midiSink, "OPL3BANK.DAT", nullptr);
+                midi_sched_set_sink(_midiSched, &sink);
+            }
+        }
+        if (_midiSched && _midiSink)
+            midi_sched_start(_midiSched, MidiNowMs());
+        _playState = (_midiSched && _midiSink) ? PlayStatePlaying : PlayStateError;
+        break;
+    case PlayStatePaused:
+        // Fold the just-ended pause into the running offset so MidiNowMs()
+        // keeps reporting a continuous, pause-aware clock -- midi_sched_
+        // start() only knows how to arm from the song start, not resume
+        // from an arbitrary position, so this offset is what makes Pause()
+        // -> Play() hold position instead of jumping the schedule forward
+        // by however long the game was paused.
+        if (_midiPauseStartedMs != 0)
+        {
+            _midiPauseOffsetMs += MidiNowMsRaw() - _midiPauseStartedMs;
+            _midiPauseStartedMs = 0;
+        }
+        _playState = PlayStatePlaying;
+        break;
+    default:
+        break;
+    }
+}
+
 void AudioPlayer::Pause()
 {
+    if (_isMidi) { MidiPause(); return; }
+
     switch (_playState)
     {
     case PlayStateInitial:
@@ -100,8 +231,26 @@ void AudioPlayer::Pause()
     }
 }
 
+void AudioPlayer::MidiPause()
+{
+    switch (_playState)
+    {
+    case PlayStateInitial:
+        _onLoadPlayState = PlayStatePaused;
+        break;
+    case PlayStatePlaying:
+        _playState = PlayStatePaused;
+        _midiPauseStartedMs = MidiNowMsRaw();
+        break;
+    default:
+        break;
+    }
+}
+
 void AudioPlayer::Stop()
 {
+    if (_isMidi) { MidiStop(); return; }
+
     switch (_playState)
     {
     case PlayStateInitial:
@@ -118,8 +267,44 @@ void AudioPlayer::Stop()
     }
 }
 
+void AudioPlayer::MidiStop()
+{
+    switch (_playState)
+    {
+    case PlayStateInitial:
+        _onLoadPlayState = PlayStateStopped;
+        break;
+    case PlayStatePlaying:
+    case PlayStatePaused:
+        _playState = PlayStateStopped;
+        // opl3_sink has no partial "silence everything, keep the chip
+        // open" entry point -- only per-note NOTE_OFF via a real MIDI
+        // event, or a full close() that unconditionally KEY-OFFs all 18
+        // voices (opl3_sink.h's own documented contract). Reusing close()
+        // is the only way, with today's shared/ surface, to guarantee a
+        // Stop() doesn't leave a note physically hanging; MidiPlay()
+        // reopens and rebinds on the next Stopped -> Playing transition.
+        if (_midiSink)
+        {
+            opl3_sink_close(_midiSink);
+            _midiSink = nullptr;
+        }
+        _midiPauseOffsetMs = 0;
+        _midiPauseStartedMs = 0;
+        break;
+    default:
+        break;
+    }
+}

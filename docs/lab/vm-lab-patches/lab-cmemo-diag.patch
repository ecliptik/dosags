 // No bump is needed after a call returns: the bump came before it, nothing is memoised inside a non-whitelisted
 // call, and a nested VM run bumps on its own exit. Out of line so the fast loop keeps no value live across the
 // call (a first version with locals here cost the loop its register allocation: +0.32 ms/tick at fixed cycles).
+#ifdef DOSAGS_VMTRACE
+// lab only: which bump last invalidated the memo (site, function), for the miss histogram below
+static int s_cm_cursite = 0; static const void *s_cm_curfn = nullptr;
+static int s_cm_bsite = 0; static const void *s_cm_bfn = nullptr;
+static const void *s_cm_pfn[32]; static unsigned s_cm_pn[32]; static int s_cm_pfn_n = 0;
+static void dos_cm_pure_seen(const void *f)
+{
+    int i = 0;
+    for (; i < s_cm_pfn_n; ++i) if (s_cm_pfn[i] == f) break;
+    if (i == s_cm_pfn_n && s_cm_pfn_n < 32) { s_cm_pfn[i] = f; s_cm_pn[i] = 0; ++s_cm_pfn_n; }
+    if (i < 32) ++s_cm_pn[i];
+}
+static unsigned s_cm_snap[4][32]; static unsigned s_cm_need[32]; static unsigned s_cm_hits = 0;
+static void dos_cm_dump();
+void dos_cm_diag_store(int slot) { for (int i = 0; i < 32; ++i) s_cm_snap[slot & 3][i] = s_cm_pn[i]; }
+void dos_cm_diag_hit(int slot)
+{
+    for (int i = 0; i < s_cm_pfn_n; ++i) if (s_cm_pn[i] != s_cm_snap[slot & 3][i]) ++s_cm_need[i];
+    if (++s_cm_hits % 1000 == 0) dos_cm_dump();
+}
+#define VM_MEMO_SITE(S, P) (s_cm_cursite = (S), s_cm_curfn = (const void *)(P))
+#define VM_MEMO_BUMPED(S, P) (s_cm_bsite = (S), s_cm_bfn = (P))
+#else
+#define VM_MEMO_SITE(S, P) ((void)0)
+#define VM_MEMO_BUMPED(S, P) ((void)0)
+#endif
 __attribute__((noinline)) static void dos_memo_bump()
 {
+#ifdef DOSAGS_VMTRACE
+    VM_MEMO_BUMPED(s_cm_cursite, s_cm_curfn);
+#endif
     ++dos_cmemo_gen;
     dos_cmemo_live = 0;
 }

+//=============================================================================
+//
+// DOS-PORT probe 0290 (LAB ONLY, never a gate binary; see LAB-MMD.md 2.2):
+// what process_events_dispatch actually is.
+//
+// script_vm and process_events_dispatch are inclusive brackets: the time a
+// script spends in the interpreter, in engine API calls it makes, and in
+// game ticks a blocking call pumps all land in one number. This splits it:
+//  - per script entry function: inclusive us, instructions, API us, nested us;
+//  - per script function reached (entry or SCMD_CALL/CALLAS target):
+//    exclusive instructions, API calls/us;
+//  - per engine API (SCMD_CALLEXT target): calls, us exclusive of nested ticks;
+//  - per dispatch: nested ticks, max tick depth, render_to_screen inside it;
+//  - per event type: us, instructions, API us, nested us;
+//  - per room segment: the tick's phase deltas.
+// Tables reset at each room change, so each room reports on its own.
+//
+// Cost model: one global increment per VM instruction; a hash lookup per
+// script call/return; a uclock() pair per API call (switchable off with
+// DOSAGS_MMDPROBE_APITIME=0 to measure that pair's own cost), per event and
+// per dispatch.
+//
+//=============================================================================
+#ifndef __AGS_EE_MAIN__DOS_PORT_MMDPROBE_H
+#define __AGS_EE_MAIN__DOS_PORT_MMDPROBE_H
+
+#ifdef __DJGPP__
+#include <stdint.h>
+#include <time.h>
+
+#define DP_MMD_FN_CAP   256
+#define DP_MMD_API_CAP  256
+#define DP_MMD_STACK    128
+
+struct DpMmdFn
+{
+    const void *script;     // ccScript*
+    int32_t pc;             // function start
+    long calls;
+    long long insns;        // exclusive
+    long api_n;
+    long long api_us;
+    int first_line;
+    int is_entry;
+    // entry-only (inclusive, nested ticks split out):
+    long entry_calls;
+    long long entry_us;
+    long long entry_insns;      // instructions while this entry was running, minus nested
+    long long entry_api_us;
+    long entry_api_n;
+    long long entry_nested_us;
+    long entry_nested_n;
+    long long entry_max_us;
+    char name[64];
+};
+
+struct DpMmdApi
+{
+    const void *key;
+    long n;
+    long long us;
+    long long max_us;
+    long nested_n;          // calls that ran nested ticks
+    char name[48];
+};
+
+struct DpMmdEntryFrame
+{
+    int fn;
+    uclock_t t0;
+    uint32_t insn0;
+    long long api_us;
+    long api_n;
+    long long nested_us;
+    long nested_n;
+    uint32_t nested_insns;
+};
+
+struct DpMmdTop
+{
+    long long us;
+    uint32_t tick;
+    long long nested_us;
+    long nested_n;
+    long rts_n;
+    long long rts_us;
+    uint32_t insns;
+    unsigned evmask;
+    int events;
+};
+
+struct DpMmdSeg
+{
+    int room;
+    uint32_t tick0;
+    uclock_t t0;
+    // phase snapshots (total_us) at segment start
+    long long s_ugo, s_ped, s_svm, s_guip, s_guic, s_rts, s_rb, s_rew, s_scene, s_pres;
+    long s_ugo_n, s_rts_n, s_rtspt_n;
+    // dispatch
+    long d_n;
+    long long d_us, d_max;
+    long long d_nested_us;
+    long d_nested_n;
+    int d_maxdepth;
+    long d_rts_n;
+    long long d_rts_us;
+    long long d_insns;
+    long long d_api_us;
+    long d_api_n;
+    DpMmdTop top[3];
+    // per event type (0..5), object split by sub-type (0..7)
+    long e_n[6]; long long e_us[6], e_insns[6], e_api_us[6], e_nested_us[6];
+    long o_n[8]; long long o_us[8], o_insns[8], o_api_us[8];
+};
+
+extern uint32_t dp_mmd_insns;          // global VM instruction counter
+extern int dp_mmd_cur_fn;              // fn index being billed
+extern uint32_t dp_mmd_last_switch;
+extern int dp_mmd_fn_sp;
+extern int dp_mmd_fn_stack[DP_MMD_STACK];
+extern DpMmdFn dp_mmd_fns[DP_MMD_FN_CAP];
+extern int dp_mmd_nfns;
+extern DpMmdApi dp_mmd_apis[DP_MMD_API_CAP];
+extern int dp_mmd_napis;
+extern DpMmdEntryFrame dp_mmd_entries[DP_MMD_STACK];
+extern int dp_mmd_entry_sp;
+extern int dp_mmd_api_time;            // DOSAGS_MMDPROBE_APITIME (default 1)
+extern long long dp_mmd_api_us_total;
+extern long dp_mmd_api_n_total;
+extern long dp_mmd_uclock_reads;
+extern int dp_mmd_in_dispatch;
+extern DpMmdSeg dp_mmd_seg;
+extern long dos_tick_nested_n;         // game_run.cpp (probe addition)
+extern long long dos_tick_nested_us;   // game_run.cpp (patch 0159)
+extern int dp_mmd_dispatch_maxdepth;   // max tick depth seen inside dispatch
+
+// Look up or insert a function; returns its index (0 = overflow bucket).
+int dp_mmd_fn_lookup(const void *script, int32_t pc, const char *entry_name);
+int dp_mmd_api_lookup(const void *key, const void *rsv /* RuntimeScriptValue* */);
+void dp_mmd_seg_check();               // dump + reset if displayed_room changed
+void dp_mmd_dump(const char *why);     // print the current segment
+
+static inline void dp_mmd_bill()
+{
+    dp_mmd_fns[dp_mmd_cur_fn].insns += (uint32_t)(dp_mmd_insns - dp_mmd_last_switch);
+    dp_mmd_last_switch = dp_mmd_insns;
+}
+
+static inline void dp_mmd_push_fn(int fn)
+{
+    dp_mmd_bill();
+    if (dp_mmd_fn_sp < DP_MMD_STACK)
+        dp_mmd_fn_stack[dp_mmd_fn_sp] = fn;
+    dp_mmd_fn_sp++;
+    dp_mmd_fns[fn].calls++;
+    dp_mmd_cur_fn = fn;
+}
+
+// restore the fn stack to a saved depth (after a Run() returns, normally or not)
+static inline void dp_mmd_restore_fn(int sp)
+{
+    dp_mmd_bill();
+    dp_mmd_fn_sp = sp;
+    dp_mmd_cur_fn = (sp > 0 && sp <= DP_MMD_STACK) ? dp_mmd_fn_stack[sp - 1] : 0;
+}
+
+static inline long long dp_mmd_us(uclock_t a, uclock_t b)
+{
+    long long d = (long long)(b - a) * 1000000LL / UCLOCKS_PER_SEC;
+    return d < 0 ? 0 : d;
+}
+
+static inline uclock_t dp_mmd_clock()
+{
+    dp_mmd_uclock_reads++;
+    return uclock();
+}
+
+#endif // __DJGPP__
+#endif // __AGS_EE_MAIN__DOS_PORT_MMDPROBE_H

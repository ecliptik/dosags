+    g_null_open = false;
     if (g_stream)
     {
         SDL_DestroyAudioStream(g_stream);
@@ -354,7 +406,7 @@ void dos_audio_mixer_shutdown()
 
 bool dos_audio_mixer_is_open()
 {
-    return g_stream != nullptr || g_gus_open;
+    return g_stream != nullptr || g_gus_open || g_null_open; // DOS-PORT patch 0355: g_null_open
 }
 
 int dos_audio_mixer_voice_acquire()
@@ -390,6 +442,17 @@ void dos_audio_mixer_voice_release(int voice)
 {
     if (voice < 0 || voice >= DOS_AUDIO_MIXER_MAX_VOICES)

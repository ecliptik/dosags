+// DOS-PORT patch 0216: one decoded clip -- its samples already in the mixer's device format, their
+// count, and that format. Built once per decode and never changed after, so every play of the clip
+// can share it (the PCM cache in sdldecoder.cpp) instead of decoding it again.
+struct DosDecodedPcm
+{
+    std::vector<uint8_t> device; // what GetData() hands out
+    size_t samples = 0u;         // mono samples at the mixer rate; position/duration key off this
+    SDL_AudioFormat fmt = SDL_AUDIO_UNKNOWN;
+};
+
+// DOS-PORT patch 0216: writes the PCM cache's counters as one "DOS-PORT pcmcache ..." line (quit.cpp,
+// RUNMANI.LOG).
+void dos_pcm_cache_report(FILE *log);
+
 class SDLDecoder
 {
 public:
@@ -219,30 +234,13 @@ private:
     String _sampleExt = "";
     bool _repeat = false;
 
-    std::vector<int16_t> _pcm; // decoded intermediate, always mono S16 @ mixer rate --
-                               // dos_audio_decode_pcm()'s own fixed output shape,
-                               // backend-independent (see .cpp's own Open()).
-                               // Kept alive for the clip's whole lifetime (NOT
-                               // freed after _pcmDevice is derived from it) --
-                               // Seek()/GetPositionMs()/GetDurationMs() all key
-                               // position/total off _pcm.size() (sample count is
-                               // format-independent), so it stays the source of
-                               // truth for those regardless of which device
-                               // format _pcmDevice holds. A real, bounded (clips
-                               // are already <=1MB via MaxLoadAtOnce) memory
-                               // cost under GUS -- both representations coexist
-                               // -- accepted rather than engineered away.
-    std::vector<uint8_t> _pcmDevice; // _pcm converted ONCE (at Open()) to the
-                               // ACTIVE backend's real device format
-                               // (dos_audio_mixer_format()) -- what GetData()
-                               // actually hands out. DOS-PORT (S5 GUS,
-                               // "Correction #1"): this indirection is what
-                               // lets GUS's own 8-bit-unsigned requirement
-                               // coexist with SB's 16-bit signed format without
-                               // touching dos_audio_decode.cpp's WAV/VOC parsers
-                               // at all -- they always decode to the SAME
-                               // 16-bit intermediate; only this last conversion
-                               // step branches on the active backend.
+    // DOS-PORT patch 0216: the decoded clip, shared and immutable (see DosDecodedPcm). It replaces
+    // _pcm (the 16-bit intermediate, which after the device conversion was kept only for its sample
+    // count) and _pcmDevice (the device-format copy); a cached clip is now held once, not twice per
+    // playing decoder. The format split this preserves: the WAV/VOC decode always produces the same
+    // 16-bit intermediate, and only the conversion to DosDecodedPcm::device branches on the backend
+    // (SB 16-bit signed, GUS 8-bit unsigned).
+    std::shared_ptr<const DosDecodedPcm> _pcm;
     size_t _readSamples = 0u;
     bool _opened = false;

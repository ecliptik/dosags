@@ -147,6 +279,34 @@ bool SDLDecoder::Open(float pos_ms)
         return true;
     }
 
+    // DOS-PORT patch 0216: a clip played before, still in the sound cache, is not decoded again.
+    const SDL_AudioFormat fmt = dos_audio_mixer_format();
+    std::shared_ptr<std::vector<uint8_t>> src_bytes; // the sound cache's buffer, if we were given one
+    if (_sampleData && !_sampleData->empty() && pcm_cache_cap() > 0u)

+++ b/libsrc/allegro/src/c/cdefs24.h
@@ -20,7 +20,22 @@
 
 #define PP_DEPTH               24
 
-#define PIXEL_PTR              unsigned char*
+/* DOS-PORT patch 0161: a typedef, not a macro.
+ *
+ * As "#define PIXEL_PTR unsigned short*", the declaration
+ *     PIXEL_PTR a = x, b = y;
+ * declares b as a plain unsigned short holding a truncated address,

diff --git a/Engine/main/dos_port_tick_timing.h b/Engine/main/dos_port_tick_timing.h
index 66b8b64ac..6eec16186 100644
--- a/Engine/main/dos_port_tick_timing.h
+++ b/Engine/main/dos_port_tick_timing.h
@@ -159,6 +159,7 @@
 #define __AGS_EE_MAIN__DOS_PORT_TICK_TIMING_H
 
 #ifdef __DJGPP__
+#include <time.h>   // uclock()
 
 // Caller must already have <time.h> included for uclock_t/uclock()/
 // UCLOCKS_PER_SEC -- not included here, same convention as
@@ -490,6 +491,24 @@ static inline long long dos_port_tick_elapsed_us(uclock_t t0)
     return (long long)(uclock() - t0) * 1000000LL / UCLOCKS_PER_SEC;
 }
 
+// DOS-PORT patch 0315: an off switch for the fine-grained timing. Every phase scope, event-type scope and render
+// timer below reads uclock() -- a PIT read over port I/O, ~4.35 us on a 486 -- and together they made ~89 reads a
+// game tick on the target (LAB-MMD 44), in every build, costing the player that time and inflating what they
+// measure. They are OFF by default -- on the target, turning them off took 0.69 ms/tick off MMD's logic
+// (LAB-MMD 45.3) -- and DOSAGS_TICKSTATS_FINE=1 turns them on (read once); the benchmark harness sets it by
+// default so its per-phase figures keep their meaning. The scopes marked coarse (the update_game_once total,
+// render_to_screen, scene_construct -- the bracket the logic figure is computed from) stay on either way, so
+// both settings report that figure the same way.
+// The setting is read once at startup (main.cpp's ags_entry_point sets the flag); every site tests one global,
+// so the switch costs a load and a branch per scope and no code per site beyond that.
+extern int dos_port_tick_fine_flag;
+static inline bool dos_port_tick_fine_on() { return dos_port_tick_fine_flag > 0; }
+static inline uclock_t dos_port_fine_uclock() { return dos_port_tick_fine_on() ? uclock() : 0; }
+static inline long long dos_port_fine_elapsed_us(uclock_t t0)
+{
+    return dos_port_tick_fine_on() ? dos_port_tick_elapsed_us(t0) : 0;
+}
+
 static inline void dos_port_tick_record_us(DosPortTickPhaseStats &stats, long long sample_us)
 {
     stats.calls++;
@@ -519,10 +538,13 @@ static inline void dos_port_tick_record_us(DosPortTickPhaseStats &stats, long lo
 class DosPortTickScope
 {
 public:
-    explicit DosPortTickScope(DosPortTickPhaseStats &stats)
-        : _stats(stats), _t0(uclock()) {}
+    // patch 0315: coarse scopes time whatever DOSAGS_TICKSTATS_FINE says; the rest only when it is on
+    explicit DosPortTickScope(DosPortTickPhaseStats &stats, bool coarse = false)
+        : _stats(stats), _on(coarse || dos_port_tick_fine_on()), _t0(_on ? uclock() : 0) {}
     ~DosPortTickScope()
     {
+        if (!_on)
+            return;
         // Microseconds, not milliseconds -- see DosPortTickPhaseStats's
         // own total_us comment for why summing pre-truncated ms samples
         // was silently discarding real aggregate time. uclock_t is
@@ -532,6 +554,7 @@ public:
     }
 private:
     DosPortTickPhaseStats &_stats;
+    bool _on;
     uclock_t _t0;
 };
 

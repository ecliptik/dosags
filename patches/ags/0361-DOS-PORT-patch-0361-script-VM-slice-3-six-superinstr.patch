+// ---- slice 3: superinstructions -------------------------------------------------------------
+// DOSAGS_VM_FUSE=<mask> (default all in fast mode; 0 in fastnofuse/fastgeneric) selects them:
+enum
+{
+    kVmF_FarCall    = 0x01, // farpush ax; setfuncargs N; movl ax,IMPORT; farcall ax; farsubsp M
+    kVmF_LocalLoad  = 0x02, // mov sp,mar; subi mar,K; memread4 R
+    kVmF_LocalStore = 0x04, // mov sp,mar; subi mar,K; memwrite4 R
+    kVmF_PushMovlPop= 0x08, // push ax; movl ax,L (no fixup / FUNCTION); pop bx
+    kVmF_PopBinMov  = 0x10, // pop bx; sub|add|cmpeq|gte bx,ax; mov bx,ax
+    kVmF_CmpMovJz   = 0x20, // cmpeq|cmpne|gt|lt|gte|lte bx,ax; mov bx,ax; jzi (valid target)
+    kVmF_All        = 0x3F
+};
+static unsigned VmFuseMask()
+{
+    static int m = -1;
+    if (m < 0)
+    {
+        const char *e = getenv("DOSAGS_VM_FUSE");
+        m = e ? static_cast<int>(strtol(e, nullptr, 0)) & kVmF_All : kVmF_All;
+        if (s_vm_nofuse || ccInstance::DosVmMode() == ccInstance::kDosVm_FastGeneric)
+            m = 0;
+        if (ccInstance::DosVmMode() >= ccInstance::kDosVm_Fast)
+            Debug::Printf("DOS-PORT vmfuse mask=0x%02x", m);
+    }
+    return static_cast<unsigned>(m);
+}
+
+// A superinstruction lives in the opcode slot of its FIRST instruction; every constituent keeps its
+// own single handler in its own slot, so entering the group anywhere but its start runs the singles.
+// Operands are read from the constituents' own decoded slots (by opcode, VM-DESIGN 2.2).
+static void VmFusePass(const intptr_t *code, const uint8_t *fix, intptr_t *dc, const uint32_t *starts,
+    uint32_t n, const char *name)
+{
+    const unsigned mask = VmFuseMask();
+    if (!mask) return;
+    unsigned long sites[kVmH_Count] = { 0 };
+#define OPAT(p) static_cast<int>(code[(p)] & INSTANCE_ID_REMOVEMASK)
+#define ISSTART(p) ((starts[(p) >> 5] >> ((p) & 31)) & 1u)
+    for (uint32_t pc = 0; pc < n; pc += 1 + s_argc[OPAT(pc)])
+    {
+        const int op0 = OPAT(pc);
+        int h = -1;
+        if ((mask & kVmF_FarCall) && op0 == SCMD_PUSHREAL && pc + 10 < n && code[pc + 1] == SREG_AX &&
+            OPAT(pc + 2) == SCMD_NUMFUNCARGS && code[pc + 3] >= 0 &&
+            OPAT(pc + 4) == SCMD_LITTOREG && code[pc + 5] == SREG_AX && fix[pc + 6] == FIXUP_IMPORT &&
+            OPAT(pc + 7) == SCMD_CALLEXT && code[pc + 8] == SREG_AX &&
+            OPAT(pc + 9) == SCMD_SUBREALSTACK && code[pc + 10] >= 0)
+            h = kVmH_SFarCall;
+        else if ((mask & (kVmF_LocalLoad | kVmF_LocalStore)) && op0 == SCMD_REGTOREG && pc + 7 < n &&
+            code[pc + 1] == SREG_SP && code[pc + 2] == SREG_MAR &&
+            OPAT(pc + 3) == SCMD_SUB && code[pc + 4] == SREG_MAR &&
+            (code[pc + 7] == SREG_AX || code[pc + 7] == SREG_BX || code[pc + 7] == SREG_CX || code[pc + 7] == SREG_DX))
+        {
+            if ((mask & kVmF_LocalLoad) && OPAT(pc + 6) == SCMD_MEMREAD) h = kVmH_SLocalLoad;
+            else if ((mask & kVmF_LocalStore) && OPAT(pc + 6) == SCMD_MEMWRITE) h = kVmH_SLocalStore;
+        }
+        else if ((mask & kVmF_PushMovlPop) && op0 == SCMD_PUSHREG && pc + 6 < n && code[pc + 1] == SREG_AX &&
+            OPAT(pc + 2) == SCMD_LITTOREG && code[pc + 3] == SREG_AX &&
+            (fix[pc + 4] == FIXUP_NOFIXUP || fix[pc + 4] == FIXUP_FUNCTION) &&
+            OPAT(pc + 5) == SCMD_POPREG && code[pc + 6] == SREG_BX)
+            h = kVmH_SPushMovlPop;
+        else if ((mask & kVmF_PopBinMov) && op0 == SCMD_POPREG && pc + 7 < n && code[pc + 1] == SREG_BX &&
+            code[pc + 3] == SREG_BX && code[pc + 4] == SREG_AX &&
+            OPAT(pc + 5) == SCMD_REGTOREG && code[pc + 6] == SREG_BX && code[pc + 7] == SREG_AX)
+        {
+            switch (OPAT(pc + 2))
+            {
+            case SCMD_SUBREG:  h = kVmH_SPopSubMov; break;
+            case SCMD_ADDREG:  h = kVmH_SPopAddMov; break;
+            case SCMD_ISEQUAL: h = kVmH_SPopEqMov; break;
+            case SCMD_GTE:     h = kVmH_SPopGteMov; break;
+            default: break;
+            }
+        }
+        else if ((mask & kVmF_CmpMovJz) && pc + 7 < n && code[pc + 1] == SREG_BX && code[pc + 2] == SREG_AX &&
+            OPAT(pc + 3) == SCMD_REGTOREG && code[pc + 4] == SREG_BX && code[pc + 5] == SREG_AX &&
+            OPAT(pc + 6) == SCMD_JZ)
+        {
+            const long long target = static_cast<long long>(pc) + 6 + 2 + code[pc + 7];
+            if (target >= 0 && target < n && ISSTART(static_cast<uint32_t>(target)))
+            {
+                switch (op0)
+                {
+                case SCMD_ISEQUAL:  h = kVmH_SEqJz; break;
+                case SCMD_NOTEQUAL: h = kVmH_SNeJz; break;
+                case SCMD_GREATER:  h = kVmH_SGtJz; break;
+                case SCMD_LESSTHAN: h = kVmH_SLtJz; break;
+                case SCMD_GTE:      h = kVmH_SGteJz; break;
+                case SCMD_LTE:      h = kVmH_SLteJz; break;
+                default: break;
+                }
+            }
+        }
+        if (h >= 0)
+        {
+            dc[pc] = reinterpret_cast<intptr_t>(s_vm_handlers[h]);
+            ++sites[h];
+        }
+    }
+#undef OPAT
+#undef ISSTART
+    Debug::Printf("DOS-PORT vmfusesites script=%s farcall=%lu localload=%lu localstore=%lu pushmovlpop=%lu"
+        " popbinmov=%lu cmpmovjz=%lu", name, sites[kVmH_SFarCall], sites[kVmH_SLocalLoad], sites[kVmH_SLocalStore],

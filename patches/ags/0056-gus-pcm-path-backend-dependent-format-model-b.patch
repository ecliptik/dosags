@@ -31,6 +32,34 @@ namespace
 // (dos_audio_mixer.h, capped at 32 KB) comfortably topped up without
 // ever holding more than a fraction of a second buffered ahead.
 const size_t DECODED_CHUNK_SAMPLES = 2048u; // ~186 ms at 11025 Hz mono
+
+// DOS-PORT (S5 GUS, "Correction #1"): converts the decoder's own
+// always-16-bit-signed intermediate (_pcm, dos_audio_decode_pcm()'s fixed
+// output shape) into the mixer's ACTUAL active device format, ONCE --
+// dossage's own 0039 lesson (convert once at load, never per-chunk)
+// applies here exactly as it does to the WAV/VOC decode itself. SB (S16):
+// a straight byte-copy, native endianness already matches what
+// SDL_AUDIO_S16 expects on this little-endian target. GUS (U8 unsigned):
+// each sample's top 8 bits, bias-flipped to unsigned -- the exact inverse
+// of dos_audio_decode.cpp's own unsigned8->signed16 upconversion
+// (`(frame[c] - 128) * 256`), so a round-trip through both conversions
+// reproduces the original 8-bit sample exactly.
+void convert_to_device_format(const std::vector<int16_t> &pcm, SDL_AudioFormat fmt,
+    std::vector<uint8_t> &out)
+{
+    if (fmt == SDL_AUDIO_U8)
+    {
+        out.resize(pcm.size());
+        for (size_t i = 0; i < pcm.size(); i++)
+            out[i] = static_cast<uint8_t>((pcm[i] >> 8) + 128);
+        return;
+    }
+    // S16 (or anything else -- there is no other backend format today):
+    // a plain byte-copy of the already-16-bit-signed intermediate.
+    out.resize(pcm.size() * sizeof(int16_t));
+    if (!pcm.empty())
+        std::memcpy(out.data(), pcm.data(), out.size());
+}
 } // namespace
 
 //-----------------------------------------------------------------------------

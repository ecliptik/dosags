+static bool dos_lab_cr_toggle_now(int charid)
+{
+    if (dos_lab_pair("DOSAGS_LAB_CR_TOGGLE", dos_lab_tog_k, dos_lab_tog_ch, 1) <= 0 || charid != dos_lab_tog_ch) return false;
+    if ((dos_cr_scene % dos_lab_tog_k) != 0) return false;
+    dos_lab_cr_toggles++;
